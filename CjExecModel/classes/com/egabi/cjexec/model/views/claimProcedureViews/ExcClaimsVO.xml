    <SQLQuery><![CDATA[SELECT EXCCLAIMSEO.ID,                                                            
       EXCCLAIMSEO.CLAIM_NUMBER,                                                            
       EXCCLAIMSEO.CLAIM_YEAR,                                                            
       EXCCLAIMSEO.DECISION_ID,                                                            
       EXCCLAIMSEO.FIXED_PENALTY_AMOUNT,                                                            
       EXCCLAIMSEO.FIXED_PENALTY_FEES,                                                            
       EXCCLAIMSEO.CLAIM_TOTAL,                                                            
       EXCCLAIMSEO.DAILY_PENALTY_REMAINING,                                                            
       EXCCLAIMSEO.DAILY_PENALTY_FLAG,                                                            
       EXCCLAIMSEO.CLAIM_DECISION_DATE,                                                            
       EXCCLAIMSEO.CLAIM_REMARKS,                                                            
       EXCCLAIMSEO.ACTIVE_FLAG,                                                            
       EXCCLAIMSEO.CLAIM_SEQUENCE_NUMBER,                                                            
       EXCCLAIMSEO.DELETED_BY,                                                            
       EXCCLAIMSEO.DELETED_DATE,                                                            
       EXCCLAIMSEO.ID_NUMBER,                                                            
       EXCCLAIMSEO.PARTY_NAME,                                                            
       EXCCLAIMSEO.UPDATED_BY,                                                            
       EXCCLAIMSEO.UPDATED_DATE,                                                            
       EXCCLAIMSEO.CREATED_BY,                                                            
       EXCCLAIMSEO.CREATED_DATE,                                                            
       EXCCLAIMSEO.CLAIM_COLYA_ID,                                                            
       EXCCLAIMSEO.CLAIM_PARTIAL_ID,                                                            
       EXCCLAIMSEO.CLAIM_POLICE_STATION_ID,                                                            
       EXCCLAIMSEO.CLAIM_TYPE_ID,                                                            
       EXCCLAIMSEO.REPEATED_CLAIM_FLAG,                                                            
       EXCCLAIMSEO.DAILY_PENALTY_AMOUNT,                                                            
       EXCCLAIMSEO.CLAIM_RES_PARTY_ID,                                                            
       EXCCLAIMSEO.CLAIM_FOLDER_ID,                                                            
       EXCCLAIMSEO.PENALTY_DUE_DATE,                                                       
       EXCCLAIMSEO.ORIGINAL_PENALTY_DUE_DATE,                                                      
       EXCCLAIMSEO.BUSINESS_CASE_ID ,                                                      
       EXCCLAIMSEO.PARTY_ID ,                                             
       EXCCLAIMSEO.DAILY_PENALTY_FEES,                                             
       (SELECT C.CLAIM_YEAR FROM EXC_CLAIM_YEARS C WHERE C.ID = EXCCLAIMSEO.CLAIM_YEAR) CLAIM_YEAR_NAME,                                            
       (SELECT B.CASE_NUMBER FROM BUSINESS_CASE B WHERE B.ID = EXCCLAIMSEO.BUSINESS_CASE_ID) BUSINESS_CASE_NUMBER,                                          
      exc_folder_data.folder_type as exc_folder_type,    
      exc_folder_data.criminal_type as exc_folder_criminal_type,   
      exc_folder_data.is_active as exc_folder_active,                       
       EXCCLAIMSEO.CLAIM_TOTAL_ORIGINAL,                                         
       EXCCLAIMSEO.PAR_POLICE_ID ,                                         
       EXCCLAIMSEO.DECISIONS_IDS   ,                                       
       EXCCLAIMSEO.COURT_FEES    ,                                       
       EXCCLAIMSEO.LAWYER_FEES   ,                                      
       EXCCLAIMSEO.LAST_DAILY_PENALTY_DATE   ,                                      
       EXCCLAIMSEO.Business_Case_Number_Full    ,                                      
       EXCCLAIMSEO.Exc_Folder_Id        ,   EXCCLAIMSEO.Previous_Paied  ,                         
        EXCCLAIMSEO.Work_Penalty_Flag    ,EXCCLAIMSEO.Deleted_Flag  , EXCCLAIMSEO.Combined_Order    , EXCCLAIMSEO.Cancel_Amount    , court_bc_hearing_res_parties.BC_DEGREE_SPEC_ID                       
FROM  EXC_CLAIMS EXCCLAIMSEO     inner join exc_folder_data               
  on exc_folder_data.id =EXCCLAIMSEO.Exc_Folder_Id   
    inner join court_bc_hearing_res_parties on court_bc_hearing_res_parties.id = exc_folder_data.res_party_id
  where   
  EXCCLAIMSEO.Deleted_Flag = :p_claim_deleted   
  and    
  exc_folder_data.folder_type != 35   
order by id desc]]></SQLQuery>
