  <SQLQuery><![CDATA[SELECT FOLDER.YEAR || '/' || FOLDER.SEQUENCE_NUMBER || '/' ||  DECODE(FOLDER.FOLDER_TYPE , '2' , 'حبس' , '3' , 'غرامة')  || '/' || ENTS.ENTITY_NAME || ' ' || DECODE(FOLDER.REPEATED_FLAG , 'N' , '' , 'Y' , 'مكرر') INVENTORY_NUMBER ,                         
TO_CHAR(DATES.HEARING_DATE , 'yyyy-mm-dd') HEARING_DATE ,                                                                              
FOLDER.SEQUENCE_NUMBER ,                                                                                 
FOLDER.POLICE_STATION_ENTITY_ID ,                                                                                 
FOLDER.YEAR ,                                                                                 
FOLDER.FOLDER_TYPE ,                                                                                 
DECODE(FOLDER.REPEATED_FLAG , 'N' , 'غير مكرر' , 'Y' , 'مكرر') REPEATED_FLAG ,                                                                              
FOLDER.ID  FOLDER_ID  ,                                                                         
FOLDER.RES_PARTY_ID ,                                                                
FOLDER_TYPES.FOLDER_NAME ,                                                        
PROC.ADVANCE_PAYMENT_AMOUNT ,                                                        
PROC.ADVANCE_PAYMENT_DATE ,                                                        
FOLDER.IMPRISONMENT_START_DATE ,                                                        
FOLDER.IMPRISONMENT_END_DATE ,                                           
TO_CHAR(PROC.PROCEDURE_DATE , 'yyyy-mm-dd') PROCEDURE_DATE ,                                    
ACTS.ACTION_TYPE PROCEDURE_TYPE,                                    
PROC.ID ,                                             
ACTS_TYPES.NAME ACTS_TYPES_NAME ,                                      
RES_PART.PARTY_ID ,                     
ACTS.ACTION_TYPE ,      
ACTS_TYPES.MAPPING_FILE_TYPES ,     
RES.ID RESERVATION_ID                                       
FROM EXC_FOLDER_DATA FOLDER , COURT_BC_HEARING_RES_PARTIES RES_PART ,  COURT_BC_HEARING_RESERVATION RES , COURT_CIRCLES_DATES_HEARING DATES ,                                                 
    EXC_LKP_FOLDER_TYPES FOLDER_TYPES , EXC_FOLDER_PROCEDURES PROC , EXC_LKP_ACTION_TYPES ACTION_TYPES , EXC_FOLDER_ACTIONS ACTS , ENTITY ENTS ,                                             
    EXC_LKP_ACTION_TYPES ACTS_TYPES                                                                 
WHERE  FOLDER.FOLDER_TYPE = FOLDER_TYPES.ID                                                          
AND FOLDER.ID = ACTS.FOLDER_RECORD_ID                                                  
AND ACTS.PROCEDURE_ID = PROC.ID                                                  
AND ACTS.ACTION_TYPE = ACTION_TYPES.ID                                                 
AND RES_PART.ID = FOLDER.RES_PARTY_ID                                                 
AND RES_PART.COURT_BC_HEARING_RES_ID = RES.ID                                                 
AND DATES.ID = RES.CIRCLE_HEARING_DATE_ID                                                 
AND ENTS.ID = FOLDER.POLICE_STATION_ENTITY_ID                                             
AND ACTS_TYPES.ID = ACTS.ACTION_TYPE 
AND ACTS.DELETED_FLAG <> ('Y')]]></SQLQuery>
