  <SQLQuery><![CDATA[SELECT  
EexFolderActions.ID AS    ID, 
FOLDER.ID AS FOLDER_ID,   
       EexFolderProcedures.PROCEDURE_TEXT,   
       FOLDER.is_active,   
       EEXFOLDERACTIONS.ACTION_TYPE,   
       EEXFOLDERACTIONS.IS_ACTIVE AS F_ACTIONS_ACTIVE, --('O'=Approve) --('X' = Reject)   
       EexFolderActions.EXPATRIATE_APPROVAL AS F_EXPATRIATE_APPROVAL, --('O'=Approve) --('X' = Reject)   
       EexFolderActions.EXP_APPROVAL_DATE AS EXP_APPROVAL_DATE,   
       EEXFOLDERACTIONS.DECISION_ID AS DECISION_ID,   
       (SELECT ACTION_DECISION.DESC_DECISION   
          FROM EXC_LKP_ACTION_DECISION ACTION_DECISION   
         WHERE ACTION_DECISION.ID = EEXFOLDERACTIONS.DECISION_ID)   
          AS DESC_DECISION,   
       EEXFOLDERACTIONS.PROCEDURE_ID,   
       FOLDER.RES_PARTY_ID,   
       RES_PART.PARTY_ID,   
       CAS.CASE_NUMBER,   
       PAR_POLICE.PAR_YEAR CASE_YEAR,   
       CAS_TYPE.NAME CAS_TYPE_NAME,   
       POLICE.ENTITY_NAME,   
          PAR_POLICE.PAR_YEAR   
       || '/'   
       || PAR_POLICE.POLICE_NUMBER   
       || '/'   
       || CAS_TYPE.NAME   
       || '/'   
       || POLICE.ENTITY_NAME   
          AS BUSINESS_CASE_NUMBER,   
       CAS.ID AS BUSINESS_CASE_ID,   
       FOLDER.IS_ACTIVE,   
       FOLDER.NOTES,   
       FOLDER.JUDGMENT_TEXT,   
       FOLDER.EXECUTION_FLAG,   
       FOLDER.CLAIM_ISSUE_FLAG,   
       FOLDER.CRIMINAL_TYPE,   
       FOLDER.SEQUENCE_NUMBER,   
       FOLDER.POLICE_STATION_ENTITY_ID,   
       FOLDER.YEAR,   
       FOLDER.FOLDER_TYPE,   
       FOLDER.REPEATED_FLAG,   
       FOLDER.OBJECTION_TYPE,   
       FOLDER.GUILTLESSNESS_FLAG,   
          FOLDER.YEAR   
       || '/'   
       || FOLDER.SEQUENCE_NUMBER   
       || '/'   
       || FOLDER_TYPE.FOLDER_NAME   
       || '/'   
       || POLICE.ENTITY_NAME   
       || '/'   
       || DECODE (FOLDER.REPEATED_FLAG,  'N', '',  'Y', 'مكرر')   
          AS INVENTORY_NUMBER,   
       ROW_NUMBER ()   
          OVER (PARTITION BY PARTY_ID ORDER BY PARTY_ID, HEARING_DATE DESC)   
          ORDER_RAWS,   
       1 AS FLG_TYPE,   
       FOLDER_TYPE.FOLDER_NAME Folder_Name,   
       DECODE (JUD_TYP.id, 3, 'نيابة عامة', DEGREES.NAME)   
          DEGREE_NAME,   
       RES_PART.BC_DEGREE_SPEC_ID DEGREE_ID,   
       CAS_TYPE.ID CAS_TYPE_ID,   
       (SELECT NVL (ENTITY_DEGREE, 0)   
          FROM ENTITY   
         WHERE id = cas.entity_id)   
          AS ENT_DEG,   
       POLICE.PARENT_ENTITY_ID,   
       PARTIES.NICKNAME,   
       RES_PART.ATTENDANCE,   
       (SELECT ID   
          FROM EXC_COURT_BC_SESSION_JUDGMENT   
         WHERE COURT_BC_HEARING_RES_ID = RES.ID)   
          session_Id,   
       DECODE (RES_PART.ATTENDANCE,   
               '4', 'ح ت',   
               '1', 'ح',   
               '2', 'ح أ',   
               '3', 'غ',   
               '5', 'غ ق')   
          AS ATTENDANCE_NAME,   
          PARTIES.FNAME   
       || ' '   
       || PARTIES.SNAME   
       || ' '   
       || PARTIES.TNAME   
       || ' '   
       || PARTIES.FOURTHNAME   
          AS PARTY_NAME,   
       PARTIES.ID_NUMBER,   
       NVL (PARTIES.UPDATE_TYPE, 'N') AS UPDATE_TYPE,   
       PARTIES.UNKNOWN_ID,   
       TO_CHAR (DATES.HEARING_DATE, 'yyyy-mm-dd') HEARING_DATE,   
       PAR_POLICE.ORIGIN_ENTITY,   
       JUD_TYP.NAME JUDGEMENT_TYPE_NAME,   
       SESS.JUDGMENT_TYPE,   
       DATES.ID HEARING_DATE_ID,   
       PARTIES.ID_TYPE,   
       RES.ID RESERVATION_ID,   
       RES.PROSECUTION_JUDEGEMENT_FLAG,   
       CAS.JOURNALIST_FLAG,   
       PAR_POLICE.id POLICE_ID,   
       RES_PART.AMOUNT,   
       RES_PART.GUARANTEE,   
       RES_PART.GUARANTEE_DATE,   
       RES_PART.GUARANTEE_NUMBER,   
       RES_PART.GURANTEE_AMOUNT,   
       RES_PART.IN_PRISON_DAYS,   
       RES_PART.IN_PRISON_MONTHS,   
       RES_PART.IN_PRISON_YEARS,   
       RES_PART.DAILY_PAYMENTS,   
       RES_PART.PROSECUTION_OBJECTION   
  FROM EXC_FOLDER_DATA FOLDER,   
       EXC_FOLDER_actions EexFolderActions,   
       EXC_FOLDER_PROCEDURES EexFolderProcedures,   
       COURT_BC_HEARING_RES_PARTIES RES_PART,   
       COURT_BC_HEARING_RESERVATION RES,   
       PAR_PARTIES PARTIES,   
       BUSINESS_CASE CAS,   
       PAR_POLICE_AUTHORITY_REPORT PAR_POLICE,   
       ENTITY POLICE,   
       COURT_CIRCLES_DATES_HEARING DATES,   
       BUSINESS_CASE_DEGREES DEGREES,   
       BUSINESS_CASE_TYPE CAS_TYPE,   
       EXC_LKP_FOLDER_TYPES FOLDER_TYPE,   
       EXC_COURT_BC_SESSION_JUDGMENT SESS,   
       EXC_LKP_JUDGMENT_TYPES JUD_TYP   
 WHERE     FOLDER.RES_PARTY_ID = RES_PART.ID   
       AND FOLDER.id = EexFolderActions.FOLDER_RECORD_ID   
       AND EexFolderActions.PROCEDURE_ID = EexFolderProcedures.id   
       AND RES_PART.COURT_BC_HEARING_RES_ID = RES.ID   
       AND RES_PART.PARTY_ID = PARTIES.ID   
       AND RES.BUSINESS_CASE_ID = CAS.ID   
       AND CAS.ID = PAR_POLICE.BUSINESS_CASE_ID   
       AND PAR_POLICE.ORIGIN_ENTITY = POLICE.ID   
       AND DATES.ID(+) = RES.CIRCLE_HEARING_DATE_ID   
       AND RES_PART.BC_DEGREE_SPEC_ID = DEGREES.ID   
       AND CAS.CASE_TYPE = CAS_TYPE.ID   
       AND FOLDER_TYPE.ID = FOLDER.FOLDER_TYPE   
       AND RES.ID = SESS.COURT_BC_HEARING_RES_ID   
       AND SESS.JUDGMENT_TYPE = JUD_TYP.ID   
       AND FOLDER.JUDGEMENT_STATUS IN (2, 5) --(2=تم حصر الحكم) --(5=تم تقسيط الغرامة)   
       AND FOLDER_TYPE.ID != 8                             --(!=8 دفتر تدابير)   
       AND FOLDER.FOLDER_TYPE != 35                    --(!=35  دفتر  حذف    )   
       AND EDIT_PROC IS NULL   
       --and FOLDER.is_active in ('Y','E','O','X') --('O'=Approve) --('X' = Reject)   
       --AND EEXFOLDERACTIONS.IS_ACTIVE = 'O'   
       AND EEXFOLDERACTIONS.ACTION_TYPE NOT IN (167)             --(رغبة في الطعن)   
       AND EexFolderActions.DELETED_FLAG = 'N'   
       AND :pent = :pent   
       AND CAS.ID = :bcidp   
       AND (1 = 1 OR CASE_NUMBER = :pCaseNumber)   
       AND (1 = 1 OR CAS_TYPE.ID = :pCaseType)   
       AND (1 = 1 OR PAR_POLICE.PAR_YEAR = :pCaseYear)   
       AND (1 = 1 OR Origin_Entity = :pCaseOrigin)]]></SQLQuery>
