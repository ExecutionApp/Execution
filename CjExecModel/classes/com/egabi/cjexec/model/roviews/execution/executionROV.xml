  Name="executionROV"
  Version="12.2.1.0.31"
  InheritPersonalization="merge"
  BindingStyle="OracleName"
  CustomQuery="true"
  PageIterMode="Full">
  <DesignTime>
    <Attr Name="_isExpertMode" Value="true"/>
  </DesignTime>
  <Properties>
    <SchemaBasedProperties>
      <LABEL
        ResId="com.egabi.cjexec.model.roviews.execution.executionROV_LABEL"/>
    </SchemaBasedProperties>
  </Properties>
  <Variable
    Name="P_FOLDER_ID"
    Kind="where"
    Type="java.math.BigDecimal"/>
  <ViewAccessor
    Name="CrimPlaceROV1"
    ViewObjectName="com.egabi.cjexec.model.roviews.execution.CrimPlaceROV"
    RowLevelBinds="true"/>
  <ListBinding
    Name="LOV_JudicialEntityId"
    ListVOName="CrimPlaceROV1"
    ListRangeSize="-1"
    NullValueFlag="none"
    MRUCount="0">
    <AttrArray Name="AttrNames">
      <Item Value="JudicialEntityId"/>
    </AttrArray>
    <AttrArray Name="AttrExpressions"/>
    <AttrArray Name="ListAttrNames">
      <Item Value="Id"/>
    </AttrArray>
    <AttrArray Name="ListDisplayAttrNames">
      <Item Value="EntityName"/>
    </AttrArray>
    <DisplayCriteria/>
  </ListBinding>
  <SQLQuery><![CDATA[select AR.JUDICIAL_ENTITY_ID,   
       AR.INCIDENT_DATE,   
       FD.JUDGMENT_TEXT,   
       FD.IMPRISONMENT_END_DATE,   
       FD.IMPRISONMENT_START_DATE,   
       (SELECT DESCRIPTION_DES   
          FROM form_case_description d   
         WHERE     COURT_CIRCLE_DATE_ID = HEAR.ID   
               AND d.BUSINESS_CASE_ID = RES.BUSINESS_CASE_ID   
               AND COURT_FLAG = 1)   
          subjects ,  
          FD.EXECUTION_PROCEDUR_ID EXECUTION_PROCEDUR_ID  
  FROM EXC_FOLDER_DATA fd,   
       COURT_BC_HEARING_RES_PARTIES rp,   
       COURT_BC_HEARING_RESERVATION res,   
       COURT_CIRCLES_DATES_HEARING hear,   
       PAR_POLICE_AUTHORITY_REPORT ar   
          
       where FD   .RES_PARTY_ID = RP.ID   
       AND RP.COURT_BC_HEARING_RES_ID = RES.ID   
       AND RES.CIRCLE_HEARING_DATE_ID = HEAR.ID   
       AND AR.BUSINESS_CASE_ID = RES.BUSINESS_CASE_ID   
          
       and fd.id=:P_FOLDER_ID]]></SQLQuery>
  <ViewAttribute
    Name="JudicialEntityId"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.math.BigDecimal"
    ColumnType="NUMBER"
    AliasName="JUDICIAL_ENTITY_ID"
