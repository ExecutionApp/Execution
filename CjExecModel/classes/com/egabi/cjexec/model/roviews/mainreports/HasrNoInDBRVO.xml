<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE ViewObject SYSTEM "jbo_03_01.dtd">
<!---->
<ViewObject
  xmlns="http://xmlns.oracle.com/bc4j"
  Name="HasrNoInDBRVO"
  Version="12.2.1.0.31"
  InheritPersonalization="merge"
  BindingStyle="OracleName"
  CustomQuery="true"
  ComponentClass="com.egabi.cjexec.model.baseclasses.GenericVOImpl"
  PageIterMode="Full">
  <DesignTime>
    <Attr Name="_isExpertMode" Value="true"/>
  </DesignTime>
  <Properties>
    <SchemaBasedProperties>
      <LABEL
        ResId="com.egabi.cjexec.model.roviews.mainreports.HasrNoInDBRVO_LABEL"/>
    </SchemaBasedProperties>
  </Properties>
  <Variable
    Name="entityIdBind"
    Kind="where"
    Type="java.lang.String"/>
  <Variable
    Name="yearBind"
    Kind="where"
    Type="java.lang.String"/>
  <Variable
    Name="folderTypeBind"
    Kind="where"
    Type="java.lang.String"/>
  <Variable
    Name="criminalType"
    Kind="where"
    Type="java.lang.String"/>
  <Variable
    Name="fromHasr"
    Kind="where"
    Type="java.lang.String"/>
  <Variable
    Name="toHasr"
    Kind="where"
    Type="java.lang.String"/>
  <Variable
    Name="appealFlag"
    Kind="where"
    Type="java.lang.String"/>
  <SQLQuery><![CDATA[SELECT :yearBind || '/' || SEQUENCE_NUMBER  || '/'|| decode(:folderTypeBind,1,'حبس منفذ' ,  2,'حبس غير منفذ',  3, 'غرامة',5,'أمن دولة حبس',6,'أمن دولة غرامة')  SEQUENCE_NUMBER                               
  FROM (  SELECT SEQUENCE_NUMBER                                 
            FROM (    SELECT LEVEL SEQUENCE_NUMBER                                
                        FROM DUAL                                 
                  CONNECT BY LEVEL <= (999999))                                 
           WHERE     SEQUENCE_NUMBER NOT IN                                 
                        (SELECT FD.SEQUENCE_NUMBER                                 
                           FROM EXC_FOLDER_DATA FD , ENTITY POLICE , ENTITY GOZEYA , ENTITY PAREN                                          
    WHERE FD.POLICE_STATION_ENTITY_ID = POLICE.ID                                            
    AND POLICE.PARENT_ENTITY_ID = GOZEYA.ID                                          
    AND GOZEYA.PARENT_ENTITY_ID = PAREN.ID                                 
    AND FD.POLICE_STATION_ENTITY_ID = :entityIdBind                   
    AND FD.CRIMINAL_TYPE = :criminalType          
    and APPEAL_FLAG = :appealFlag       
    AND (FD.YEAR = :yearBind)                                
    AND FD.FOLDER_TYPE = :folderTypeBind             
    AND FD.SEQUENCE_NUMBER > 0             
    )          
    AND (SEQUENCE_NUMBER BETWEEN :fromHasr AND :toHasr OR :fromHasr IS NULL OR :toHasr IS NULL)       
          
    ORDER BY SEQUENCE_NUMBER)]]></SQLQuery>
  <ViewAttribute
    Name="SequenceNumber"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Precision="136"
    Type="java.lang.String"
    ColumnType="VARCHAR2"
    AliasName="SEQUENCE_NUMBER"
    Expression="SEQUENCE_NUMBER"
    SQLType="VARCHAR">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="136"/>
    </DesignTime>
  </ViewAttribute>
  <ResourceBundle>
    <PropertiesBundle
      PropertiesFile="com.egabi.cjexec.model.CjExecModelBundle"/>
  </ResourceBundle>
</ViewObject>
