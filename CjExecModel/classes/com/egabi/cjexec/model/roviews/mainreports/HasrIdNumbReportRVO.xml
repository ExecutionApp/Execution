  <Variable
    Name="createdDateBind"
    Kind="where"
    Type="java.lang.String"/>
  <Variable
    Name="gozeyaIdBind"
    Kind="where"
    Type="java.lang.String"/>
  <Variable
    Name="createdDateToBind"
    Kind="where"
    Type="java.lang.String"/>
  <SQLQuery><![CDATA[/* Formatted on 17/08/2020 06:08:43 م (QP5 v5.287) */           
SELECT NVL (ALL_HASR, 0) COUNT_HASR,           
       NVL (HASR_WITH_IDNUM, 0) COUNT_ID_NUMB,           
       GOZEYA_ENTITY_NAME,           
       PARENT_ENTITY_NAME,           
       NVL (ROUND (HASR_WITH_IDNUM * 100 / ALL_HASR), 0) || ' %'           
          TOTAL_PERCENTAGE           
  FROM (  SELECT COUNT (FD.ID) ALL_HASR,           
                 Paren.Id ID,           
                 Paren.ENTITY_NAME GOZEYA_ENTITY_NAME,           
                 master.ENTITY_NAME PARENT_ENTITY_NAME           
            FROM EXC_FOLDER_DATA FD,           
                 COURT_BC_HEARING_RES_PARTIES RES,           
                 PAR_PARTIES PP,           
                 ENTITY master,           
                 ENTITY GOZEYA,           
                 ENTITY PAREN           
           WHERE     RES.ID = FD.RES_PARTY_ID           
                 AND RES.PARTY_ID = PP.ID           
                 AND FD.POLICE_STATION_ENTITY_ID = GOZEYA.ID           
                 AND GOZEYA.PARENT_ENTITY_ID = PAREN.ID           
                 AND PAREN.PARENT_ENTITY_ID = Master.ID           
                 AND (   GOZEYA.PARENT_ENTITY_ID IN           
                            (SELECT id           
                               FROM entity           
                              WHERE PARENT_ENTITY_ID = :gozeyaIdBind)           
                      OR GOZEYA.PARENT_ENTITY_ID = :gozeyaIdBind)           
                 AND (  FD.CREATED_DATE BETWEEN TO_DATE(:createdDateBind , 'dd/mm/yyyy')              
                                                                       AND TO_DATE(:createdDateToBind , 'dd/mm/yyyy')              
                       OR to_char(FD.CREATED_DATE, 'dd/mm/yyyy') =:createdDateBind)             
        GROUP BY Paren.Id, PAREN.ENTITY_NAME, master.ENTITY_NAME) TAB1           
       FULL OUTER JOIN           
       (  SELECT COUNT (FD.ID) HASR_WITH_IDNUM, Paren.ID ID           
            FROM EXC_FOLDER_DATA FD,           
                 COURT_BC_HEARING_RES_PARTIES RES,           
                 PAR_PARTIES PP,           
                 ENTITY master,           
                 ENTITY GOZEYA,           
                 ENTITY PAREN           
           WHERE     RES.ID = FD.RES_PARTY_ID           
                 AND RES.PARTY_ID = PP.ID           
                 AND FD.POLICE_STATION_ENTITY_ID = GOZEYA.ID           
                 AND GOZEYA.PARENT_ENTITY_ID = PAREN.ID           
                 AND PAREN.PARENT_ENTITY_ID = Master.ID           
                 AND (   GOZEYA.PARENT_ENTITY_ID IN           
                            (SELECT id           
                               FROM entity           
                              WHERE PARENT_ENTITY_ID = :gozeyaIdBind)           
                      OR GOZEYA.PARENT_ENTITY_ID = :gozeyaIdBind)           
                 AND (  FD.CREATED_DATE BETWEEN TO_DATE(:createdDateBind , 'dd/mm/yyyy')              
                                                                       AND TO_DATE(:createdDateToBind , 'dd/mm/yyyy')             
                       OR to_char(FD.CREATED_DATE, 'dd/mm/yyyy') =:createdDateBind)             
                 AND PP.ID_NUMBER IS NOT NULL           
        GROUP BY PAREN.Id, PAREN.ENTITY_NAME, Master.ENTITY_NAME) TAB2           
          ON TAB1.ID = TAB2.ID]]></SQLQuery>
