  <Properties>
    <SchemaBasedProperties>
      <LABEL
        ResId="com.egabi.cjexec.model.roviews.mainreports.TotalProceduresReportRVO_LABEL"/>
    </SchemaBasedProperties>
  </Properties>
  <Variable
    Name="createdDateBind"
    Kind="where"
    Type="java.lang.String"/>
  <Variable
    Name="gozeyaIdBind"
    Kind="where"
    Type="java.lang.String"/>
  <Variable
    Name="createdDateToBind"
    Kind="where"
    Type="java.lang.String"/>
  <SQLQuery><![CDATA[/* Formatted on 13/08/2020 10:23:24 ص (QP5 v5.287) */            
SELECT COUNT (PROC.ID) COUNT_PROCEDURES,            
       GOZEYA.ENTITY_NAME GOZEYA_ENTITY_NAME,            
       PAREN.ENTITY_NAME PARENT_ENTITY_NAME,            
       USR.USERNAME USER_NAME            
  FROM EXC_FOLDER_PROCEDURES PROC,            
       ENTITY GOZEYA,            
       ENTITY PAREN,            
       SEC_USERS USR            
 WHERE     PROC.PROSECUTION_ID = GOZEYA.ID            
       AND GOZEYA.PARENT_ENTITY_ID = PAREN.ID            
       AND PROC.CREATED_BY = USR.ID            
       AND (PROC.PROSECUTION_ID IN (select id from entity where PARENT_ENTITY_ID = :gozeyaIdBind) or PROC.PROSECUTION_ID = :gozeyaIdBind)            
AND (  PROC.CREATED_DATE BETWEEN TO_DATE(:createdDateBind , 'dd/mm/yyyy')                
                                                                       AND TO_DATE(:createdDateToBind , 'dd/mm/yyyy')                
                       OR to_char(PROC.CREATED_DATE, 'dd/mm/yyyy') =:createdDateBind)              
GROUP BY GOZEYA.ENTITY_NAME , PAREN.ENTITY_NAME , USR.USERNAME]]></SQLQuery>
