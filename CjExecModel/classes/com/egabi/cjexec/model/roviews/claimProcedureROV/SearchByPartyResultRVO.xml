    <SQLQuery><![CDATA[SELECT                                                       
ROW_NUMBER () OVER (PARTITION BY RES_PART.PARTY_ID ORDER BY RES_PART.PARTY_ID,HEARING_DATE DESC )ORDER_RAWS ,                                                      
FOLDER.YEAR || '/' || FOLDER.SEQUENCE_NUMBER  || '/' || decode (FOLDER.FOLDER_TYPE , 2 , 'حبس' ,3 ,'غرامة' ) || '/' || DECODE(FOLDER.REPEATED_FLAG , 'N' , 'غير مكرر' , 'Y' , 'مكرر') AS INVENTORY_NUMBER ,                                                                                                      
PARTIES.PARTY_FIXED_FULL_NAME AS PARTY_NAME , PARTIES.ID_NUMBER ,                                                                                                     
PAR_POLICE.PAR_YEAR || '/' || PAR_POLICE.POLICE_NUMBER || '/' || CAS_TYPE.NAME|| '/' || POLICE.ENTITY_NAME AS BUSINESS_CASE_NUMBER                                   
, POLICE.ENTITY_NAME ,                                                                                                     
TO_CHAR(DATES.HEARING_DATE , 'yyyy-mm-dd') HEARING_DATE ,                                                                                                     
FOLDER.SEQUENCE_NUMBER ,                
FOLDER.CRIMINAL_TYPE,                
decode (FOLDER.FOLDER_TYPE , 2 , 'حبس' ,3 ,'غرامة' ) Folder_Name                                                    
,                                                                                                     
FOLDER.POLICE_STATION_ENTITY_ID ,                                                                                                      
FOLDER.YEAR ,                                                                                                      
FOLDER.FOLDER_TYPE ,                                                                                                    
FOLDER.REPEATED_FLAG ,                        
FOLDER.EXECUTION_FLAG,                 
DECODE(FOLDER.EXECUTION_FLAG, 1, 'مطلوب', 2, 'غير مطلوب', 3, 'تم التنفيذ', 4, 'محبوس') EXECUTION_FLAG_NAME,                 
FOLDER.ID AS FOLDER_ID  ,                                                                                              
RES_PART.PARTY_ID ,                                                                                            
FOLDER.RES_PARTY_ID ,                                                                                          
CAS.CASE_NUMBER ,                                                                                           
PAR_POLICE.PAR_YEAR CASE_YEAR ,                                                                                           
DEGREES.NAME DEGREE_NAME ,                                                                                          
RES_PART.BC_DEGREE_SPEC_ID DEGREE_ID ,                                                                                          
POLICE.ID POLICE_ID  ,                                                                                               
CAS_TYPE.ID CAS_TYPE_ID ,                                                                                       
CAS_TYPE.NAME CAS_TYPE_NAME ,                                                              
POLICE.PARENT_ENTITY_ID ,                                                         
CAS.ID AS BUSINESS_CASE_ID ,                                                        
PARTIES.NICKNAME ,                                                     
RES_PART.ATTENDANCE  ,                                           
(SELECT ID FROM EXC_COURT_BC_SESSION_JUDGMENT  where COURT_BC_HEARING_RES_ID = RES.ID ) session_Id ,                                           
DECODE(RES_PART.ATTENDANCE , '1' , 'ح' , '2' , 'ح أ' , '3' , 'غ') AS ATTENDANCE_NAME  ,                                                 
FOLDER.NOTES ,                            
FOLDER.JUDGMENT_TEXT,               
PARTY_CLAIMS.PARTY_ID as PARTY_ID_XX,              
PARTY_CLAIMS.CLAIM_TOTAL as REMAINING ,               
PARTY_CLAIMS.CLAIM_TOTAL_ORIGINAL as TOTAL,              
CASE WHEN NVL(PARTY_CLAIMS.CLAIM_TOTAL_ORIGINAL, 0) > 0 THEN 'Y' ELSE 'N' END PARTY_CLAIM_FLAG,              
             
--(SELECT rtrim( xmlcast( xmlagg( xmlelement(e, CRIMINAL.NAME  || ',') order by PARTIESXX.PARTY_ID) as clob), ',')             
--(SELECT LISTAGG(CRIMINAL.NAME ,  ' | ')  WITHIN GROUP (order by PARTIESXX.PARTY_ID)               
--FROM PAR_CRIMINAL_TYPES CRIMINAL , FORM_CASE_DESCRIPTION_DES DES , FORM_CASE_DESCRIPTION_DES_PART DES_PART , FORM_CASE_DESCRIPTION_PARTIES PARTIESXX               
--WHERE CRIMINAL.ID = DES.DESCRIPTION_ID               
--AND DES_PART.FORM_CASE_DES_ID = DES.ID               
--AND DES_PART.FORM_CASE_PARTY_ID = PARTIESXX.ID               
--AND RES_PART.PARTY_ID  = PARTIESXX.PARTY_ID  )            
'00' CRIMES               
                                                                       
FROM EXC_FOLDER_DATA FOLDER , COURT_BC_HEARING_RES_PARTIES RES_PART , COURT_BC_HEARING_RESERVATION RES , PAR_PARTIES PARTIES , BUSINESS_CASE CAS ,                                                                                                     
    PAR_POLICE_AUTHORITY_REPORT PAR_POLICE , ENTITY POLICE , COURT_CIRCLES_DATES_HEARING DATES , BUSINESS_CASE_DEGREES DEGREES , BUSINESS_CASE_TYPE CAS_TYPE ,                                                                          
    EXC_LKP_FOLDER_TYPES FOLDER_TYPE   ,              
--    (SELECT XX.PARTY_ID_XX, XX.TOTAL, XX.REMAINING FROM (              
--(SELECT DISTINCT TRIM(REGEXP_SUBSTR(C.PARTY_ID,'[^,]+', 1, level)) PARTY_ID_XX, CLAIM_TOTAL REMAINING, CLAIM_TOTAL_ORIGINAL TOTAL, ID FROM EXC_CLAIMS C              
--CONNECT BY INSTR(C.PARTY_ID, ',', 1, LEVEL -1) > 0)               
--) XX )      
EXC_CLAIMS PARTY_CLAIMS              
              
      
              
WHERE FOLDER.RES_PARTY_ID = RES_PART.ID                                                                                                     
AND RES_PART.COURT_BC_HEARING_RES_ID = RES.ID                                                                                                     
AND RES_PART.PARTY_ID = PARTIES.ID                                                                                                     
AND RES.BUSINESS_CASE_ID = CAS.ID                                                                                                     
AND CAS.ID = PAR_POLICE.BUSINESS_CASE_ID                                                                                                     
AND PAR_POLICE.ORIGIN_ENTITY = POLICE.ID                                                                                                     
AND DATES.ID = RES.CIRCLE_HEARING_DATE_ID                                                                                         
AND RES_PART.BC_DEGREE_SPEC_ID = DEGREES.ID                                                                                             
AND CAS.CASE_TYPE = CAS_TYPE.ID                                                                            
AND FOLDER_TYPE.ID = FOLDER.FOLDER_TYPE              
AND FOLDER.id = PARTY_CLAIMS.EXC_FOLDER_ID (+)              
AND FOLDER.JUDGEMENT_STATUS = 2            
and RES_PART.PARTY_ID  = :ParPartyIdBind]]></SQLQuery>
