<!DOCTYPE ViewObject SYSTEM "jbo_03_01.dtd">
<!---->
<ViewObject
  xmlns="http://xmlns.oracle.com/bc4j"
  Name="PartyFoldersRVO"
  Version="12.2.1.0.31"
  InheritPersonalization="merge"
  BindingStyle="OracleName"
  CustomQuery="true"
  ComponentClass="com.egabi.cjexec.model.baseclasses.GenericVOImpl"
  PageIterMode="Full">
  <DesignTime>
    <Attr Name="_isExpertMode" Value="true"/>
  </DesignTime>
  <Properties>
    <SchemaBasedProperties>
      <LABEL
        ResId="com.egabi.cjexec.model.roviews.claimProcedureROV.PartyFoldersRVO_LABEL"/>
    </SchemaBasedProperties>
  </Properties>
  <Variable
    Name="ParPartyIdBind"
    Kind="where"
    Type="java.math.BigDecimal"/>
  <SQLQuery><![CDATA[SELECT FOLDER.ID AS FOLDER_ID,  
FOLDER.YEAR || '/' || FOLDER.SEQUENCE_NUMBER  || '/' || decode (FOLDER.FOLDER_TYPE , 2 , 'حبس' ,3 ,'غرامة' ) || '/' || DECODE(FOLDER.REPEATED_FLAG , 'N' , 'غير مكرر' , 'Y' , 'مكرر') AS SEQUENCE_NUMBER, 
FOLDER.JUDGMENT_TEXT   
FROM EXC_FOLDER_DATA FOLDER, COURT_BC_HEARING_RES_PARTIES RES   
WHERE FOLDER.RES_PARTY_ID = RES.ID   
AND RES.PARTY_ID = :ParPartyIdBind]]></SQLQuery>
  <ViewAttribute
    Name="FolderId"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.math.BigDecimal"
    ColumnType="NUMBER"
    AliasName="FOLDER_ID"
    Expression="FOLDER_ID"
    SQLType="NUMERIC"/>
  <ViewAttribute
    Name="SequenceNumber"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Precision="96"
    Type="java.lang.String"
    ColumnType="VARCHAR2"
    AliasName="SEQUENCE_NUMBER"
    Expression="SEQUENCE_NUMBER"
    SQLType="VARCHAR">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="96"/>
    </DesignTime>
  </ViewAttribute>
  <ViewAttribute
    Name="JudgmentText"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Precision="1000"
    Type="java.lang.String"
    ColumnType="VARCHAR2"
    AliasName="JUDGMENT_TEXT"
    Expression="JUDGMENT_TEXT"
    SQLType="VARCHAR">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="1000"/>
    </DesignTime>
  </ViewAttribute>
  <AttrArray Name="KeyAttributes">
    <Item Value="FolderId"/>
  </AttrArray>
  <ResourceBundle>
    <PropertiesBundle
      PropertiesFile="com.egabi.cjexec.model.CjExecModelBundle"/>
  </ResourceBundle>
</ViewObject>
