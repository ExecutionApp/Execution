<!DOCTYPE ViewObject SYSTEM "jbo_03_01.dtd">
<!---->
<ViewObject
  xmlns="http://xmlns.oracle.com/bc4j"
  Name="FolderAttendanceROVO"
  Version="12.2.1.0.31"
  InheritPersonalization="merge"
  BindingStyle="OracleName"
  CustomQuery="true"
  ComponentClass="com.egabi.cjexec.model.baseclasses.GenericVOImpl"
  PageIterMode="Full">
  <DesignTime>
    <Attr Name="_isExpertMode" Value="true"/>
  </DesignTime>
  <Properties>
    <SchemaBasedProperties>
      <LABEL
        ResId="com.egabi.cjexec.model.roviews.bcdetails.FolderAttendanceROVO_LABEL"/>
    </SchemaBasedProperties>
  </Properties>
  <SQLQuery><![CDATA[SELECT            
    EXC_LKP_FOLDER_TYPES.ID ID,         
     DECODE (  EXC_LKP_FOLDER_TYPES.ID,        
                   '1', 'حبس منفذ',      
                   '3', 'غرامة'      
                   ) as FOLDER_NAME  ,             
    EXC_LKP_FOLDER_TYPES.FOLDER_CATEGORY FOLDER_CATEGORY            
FROM            
    EXC_LKP_FOLDER_TYPES           
    where EXC_LKP_FOLDER_TYPES.ID in (1,3)]]></SQLQuery>
  <ViewAttribute
    Name="Id"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.math.BigDecimal"
    ColumnType="NUMBER"
    AliasName="ID"
    Expression="ID"
    SQLType="NUMERIC"/>
  <ViewAttribute
    Name="FolderName"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Precision="8"
    Type="java.lang.String"
    ColumnType="VARCHAR2"
    AliasName="FOLDER_NAME"
    Expression="FOLDER_NAME"
    SQLType="VARCHAR">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="8"/>
    </DesignTime>
  </ViewAttribute>
  <ViewAttribute
    Name="FolderCategory"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.math.BigDecimal"
    ColumnType="NUMBER"
    AliasName="FOLDER_CATEGORY"
    Expression="FOLDER_CATEGORY"
    SQLType="NUMERIC"/>
  <AttrArray Name="KeyAttributes">
    <Item Value="Id"/>
  </AttrArray>
  <ResourceBundle>
    <PropertiesBundle
      PropertiesFile="com.egabi.cjexec.model.CjExecModelBundle"/>
  </ResourceBundle>
</ViewObject>
