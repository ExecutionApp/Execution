  <Variable
    Name="pEntity"
    Kind="where"
    Type="java.math.BigDecimal"/>
  <Variable
    Name="pFolderType"
    Kind="where"
    Type="java.math.BigDecimal"/>
  <Variable
    Name="pYear"
    Kind="where"
    Type="java.math.BigDecimal"/>
  <SQLQuery><![CDATA[SELECT           
    LAST_NUMBER_TAB.ID ID,      
    EXC_LKP_FOLDER_TYPES.ID IDD ,         
    LAST_NUMBER_TAB.ENTITY_ID ENTITY_ID,           
    LAST_NUMBER_TAB.SEQ_NAME SEQ_NAME,           
    LAST_NUMBER_TAB.VALUE VALUE,           
    LAST_NUMBER_TAB.LEDGER_ID LEDGER_ID,           
    LAST_NUMBER_TAB.YEAR YEAR,           
    LAST_NUMBER_TAB.STARTS_WITH STARTS_WITH           
FROM           
    LAST_NUMBER_TAB  inner join EXC_LKP_FOLDER_TYPES on     
       LAST_NUMBER_TAB.seq_name= EXC_LKP_FOLDER_TYPES.FOLDER_NAME    
    where    LAST_NUMBER_TAB.YEAR > 2021       
    and   LAST_NUMBER_TAB.ENTITY_ID = :pEntity  
    and LAST_NUMBER_TAB.YEAR = :pYear  
    and EXC_LKP_FOLDER_TYPES.ID = :pFolderType]]></SQLQuery>
  <ViewAttribute
