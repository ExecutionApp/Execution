FROM COURT_CIRCLES_DATES_HEARING CO   , COURT_BC_HEARING_RESERVATION RES ,   COURT_BC_HEARING_RES_PARTIES PART ,BUSINESS_CASE_DEGREES deg                                                        
WHERE RES.CIRCLE_HEARING_DATE_ID = CO.ID     
and CO.BC_DEGREE_ID = deg.id                           
AND RES.ID = PART.COURT_BC_HEARING_RES_ID                
AND PART.POSTPONED = 0         
AND  PART.UNSPECIALIZED_FLAG = 0     
and PART.attendance is  null    
and RES.PROSECUTION_JUDEGEMENT_FLAG in( 1 , 0)      
and 1=0 
ORDER BY HEARING_DATE]]></SQLQuery>
