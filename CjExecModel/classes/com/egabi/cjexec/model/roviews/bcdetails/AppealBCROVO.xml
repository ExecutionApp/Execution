  <SQLQuery><![CDATA[select distinct bc.id , bc.entity_id ,(         
          
          
          
          
 select PAR_POLICE.police_number ||' - '||PAR_POLICE.par_year||' - '|| CAS_TYPE.NAME ||' - '||POLICE.ENTITY_NAME  as code          
         
 from par_police_authority_report PAR_POLICE,ENTITY POLICE,BUSINESS_CASE_TYPE CAS_TYPE where          
   PAR_POLICE.ORIGIN_ENTITY = POLICE.ID         
  AND PAR_POLICE.BUSINESS_CASE_TYPE = CAS_TYPE.ID         
  and    PAR_POLICE.business_case_id = bc.id          
  ) code, (         
 select PAR_POLICE.police_number              
 from par_police_authority_report PAR_POLICE,ENTITY POLICE,BUSINESS_CASE_TYPE CAS_TYPE where          
   PAR_POLICE.ORIGIN_ENTITY = POLICE.ID         
  AND PAR_POLICE.BUSINESS_CASE_TYPE = CAS_TYPE.ID         
  and    PAR_POLICE.business_case_id = bc.id          
  ) police_number             
           
  from business_case bc inner join           
court_bc_hearing_reservation res on bc.id = res.business_case_id         
 where  res.sent_to_court='C'  order by id desc]]></SQLQuery>
