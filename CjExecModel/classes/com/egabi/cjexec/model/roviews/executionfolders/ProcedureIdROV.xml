<?xml version="1.0" encoding="windows-1256" ?>
<!DOCTYPE ViewObject SYSTEM "jbo_03_01.dtd">
<!---->
<ViewObject
  xmlns="http://xmlns.oracle.com/bc4j"
  Name="ProcedureIdROV"
  Version="12.2.1.0.31"
  InheritPersonalization="merge"
  BindingStyle="OracleName"
  CustomQuery="true"
  PageIterMode="Full">
  <DesignTime>
    <Attr Name="_isExpertMode" Value="true"/>
  </DesignTime>
  <Properties>
    <SchemaBasedProperties>
      <LABEL
        ResId="com.egabi.cjexec.model.roviews.executionfolders.ProcedureIdROV_LABEL"/>
    </SchemaBasedProperties>
  </Properties>
  <Variable
    Name="P_folder_id"
    Kind="where"
    Type="java.math.BigDecimal"/>
  <Variable
    Name="P_Action_type"
    Kind="where"
    Type="java.math.BigDecimal"/>
  <SQLQuery><![CDATA[select    ID PROCEDURE_ID , P.CAPACITY_TYPE CAPACITY_TYPE   
from  EXC_FOLDER_PROCEDURES p   
where ID = (select 
max ( F.PROCEDURE_ID) 
from EXC_FOLDER_ACTIONS  f 
where  F.FOLDER_RECORD_ID =:P_folder_id    
and F.ACTION_TYPE=:P_Action_type   
)]]></SQLQuery>
  <ViewAttribute
    Name="ProcedureId"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.math.BigDecimal"
    ColumnType="NUMBER"
    AliasName="PROCEDURE_ID"
    Expression="PROCEDURE_ID"
    SQLType="NUMERIC"/>
  <ViewAttribute
    Name="CapacityType"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.math.BigDecimal"
    ColumnType="NUMBER"
    AliasName="CAPACITY_TYPE"
    Expression="CAPACITY_TYPE"
    SQLType="NUMERIC"/>
  <AttrArray Name="KeyAttributes">
    <Item Value="ProcedureId"/>
  </AttrArray>
  <ResourceBundle>
    <PropertiesBundle
      PropertiesFile="com.egabi.cjexec.model.CjExecModelBundle"/>
  </ResourceBundle>
</ViewObject>
