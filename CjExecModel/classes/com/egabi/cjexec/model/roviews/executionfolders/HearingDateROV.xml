    <SQLQuery><![CDATA[SELECT COURT_CIRCLES_DATES_HEARING.id, to_char( hearing_date ,'dd/mm/yy') || '  ' || ENTITY.ENTITY_NAME  hearing_date             
  FROM COURT_CIRCLES_DATES_HEARING  ,entity                
 WHERE        
