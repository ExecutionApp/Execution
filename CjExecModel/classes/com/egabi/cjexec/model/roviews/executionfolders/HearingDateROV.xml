  and COURT_CIRCLES_DATES_HEARING.entity_id = 91 --283  
  and COURT_CIRCLES_DATES_HEARING.BC_Degree_id =:P_BC_Degree_id 
  order by   ENTITY.ENTITY_NAME ,  hearing_date]]></SQLQuery>
