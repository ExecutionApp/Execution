  <SQLQuery><![CDATA[select  
   
  ROW_NUMBER () OVER (PARTITION BY PARTY_ID ORDER BY PARTY_ID,HEARING_DATE DESC)ORDER_RAWS , 
 -- distinct  
  PARTIES.PARTY_FIXED_FULL_NAME,PARTIES.ID_NUMBER , CAS.ID BUS_CASE_ID ,  PARTIES.id part_id,   CAS_TYPE.id CAS_TYPE, POLICE.id POLICE_ID,                                                
                               
 DECISIONS.id DECISIONS_IDS,   
--null DECISIONS_IDS,   
 CH_PARTIES.DECISION_ID DECISION_ID,   DATES.BC_DEGREE_ID  ,                                                          
      PAR_POLICE.PAR_YEAR|| '/'|| CAS.CASE_NUMBER|| '/'|| CAS_TYPE.NAME   || '/' || POLICE.ENTITY_NAME AS BUSINESS_CASE_NUMBER_FULL,                                                                                
      FOLDER.YEAR                                                                                  
      || '/'                                                                                  
      || FOLDER.SEQUENCE_NUMBER                                                                                  
      || '/'                                                                                  
      || DECODE (FOLDER.FOLDER_TYPE, 2, 'حبس', 3, 'غرامة')                                                                                  
      || '/'                                                                                  
      || DECODE (FOLDER.REPEATED_FLAG, 'Y', 'مكرر', 'N', 'غير مكرر')                                                                                  
      || '/'                                                                                  
      || POLICE.ENTITY_NAME AS SEQ_NUMBER_FULL                                                       
      ,                                                          
       DECISIONS.PENALTY_AMOUNT   ,                               
       DECISIONS.Work_AMOUNT,  FOLDER.id  folder_id,  FOLDER.police_station_entity_id ,                           
       DECISIONS.PENALTY_DUE_DATE    ,            
      (select max (id  ) from BUSINESS_CASE_LEDGER_SEQ where business_case_id = CAS.ID and case_schema_id in ( 3645 , 3647 , 3648) ) as kolaya ,               
      'N' as Combained                                   
      , (select   max(FEES_AMOUNT) from  EXC_COURT_BC_DECISION_FEES FEES where  FEES.DECISION_ID  =   CH_PARTIES.DECISION_ID and FEES.FEES_TYPE_ID =2 and COURT_FEES_FLAG Is null)   COURT_FEES                                
      , (select   max(FEES_AMOUNT) from  EXC_COURT_BC_DECISION_FEES FEES where  FEES.DECISION_ID  =   CH_PARTIES.DECISION_ID and FEES.FEES_TYPE_ID =1 and LAWYER_FEES_FLAG Is null)   LAWYER_FEES                                 
        , (DECISIONS.PENALTY_AMOUNT - ( ( select   nvl(Sum(CLAIM_TOTAL_ORIGINAL),0) from                   
        EXC_CLAIMS Claims where Claims.deleted_flag = 'N' and  Claims.DECISION_ID  =    DECISIONS.id) +   
          
        ( select nvl( sum (EXC_FOLDER_PROCEDURES.Advance_Payment_Amount ) ,0 ) from EXC_FOLDER_ACTIONS inner join EXC_FOLDER_PROCEDURES on EXC_FOLDER_ACTIONS.PROCEDURE_ID = EXC_FOLDER_PROCEDURES.id  
where EXC_FOLDER_ACTIONS.ACTION_TYPE in  (7 ,77) and EXC_FOLDER_ACTIONS.DELETED_FLAG = 'N' and EXC_FOLDER_ACTIONS.FOLDER_RECORD_ID = FOLDER.id and EXC_FOLDER_PROCEDURES.FEES_TYPE_ID = 3)  
          
     )  ) CLAIM_TOTAL_VALUE                                     
 FROM    EXC_FOLDER_DATA FOLDER left outer join EXC_FOLDER_ACTIONS folder_actions on  folder_actions.FOLDER_RECORD_ID   = FOLDER.id                                                                                          
   ,   COURT_BC_HEARING_RES_PARTIES RES_PART,                                                                                  
      COURT_BC_HEARING_RESERVATION RES,                                                                                  
      PAR_PARTIES PARTIES,                                                                                  
      BUSINESS_CASE CAS,                                                                                  
      PAR_POLICE_AUTHORITY_REPORT PAR_POLICE,                                                                                  
      ENTITY POLICE,                                                                                  
      COURT_CIRCLES_DATES_HEARING DATES,                                                                                  
      BUSINESS_CASE_DEGREES DEGREES,                                                                                  
      BUSINESS_CASE_TYPE CAS_TYPE,                                                                                  
      EXC_LKP_FOLDER_TYPES FOLDER_TYPE,                                                                                  
      EXC_COURT_BC_CHARGES_PARTIES CH_PARTIES,                                                                                  
      EXC_COURT_BC_CHARGE_DECISIONS DECISIONS                 
    WHERE FOLDER.RES_PARTY_ID            = RES_PART.ID                           
                                                                         
    AND RES_PART.COURT_BC_HEARING_RES_ID = RES.ID                                                                                  
    AND RES_PART.PARTY_ID                = PARTIES.ID                                                                                  
    AND RES.BUSINESS_CASE_ID             = CAS.ID                                                                                  
    AND CAS.ID                           = PAR_POLICE.BUSINESS_CASE_ID                                                                                  
    AND PAR_POLICE.ORIGIN_ENTITY         = POLICE.ID                                                                                  
    AND DATES.ID                         = RES.CIRCLE_HEARING_DATE_ID                                                                                  
    AND DATES.BC_DEGREE_ID               = DEGREES.ID                                                                                  
    AND CAS.CASE_TYPE                    = CAS_TYPE.ID                                                                                  
    AND FOLDER_TYPE.ID                   = FOLDER.FOLDER_TYPE                                                        
     AND CH_PARTIES.CHARGE_DECISION_ID           = DECISIONS.ID                                                                                  
    AND CH_PARTIES.RES_PARTY_ID                 = FOLDER.RES_PARTY_ID                                                              
   AND  (res_part.attendance    in(1,4) or                    
   ( DATES.BC_DEGREE_ID != 1 and DATES.BC_DEGREE_ID != 3 ) or folder_actions.ACTION_TYPE = 60                     
   or (  res_part.PREVIOUS_OBJECTION_FLAG ='Y'  ) )                           
 and DECISIONS.Stop_Execution_Flag  ='N'    
  and CH_PARTIES.deleted_flag  ='N'    
  AND FOLDER.CLAIM_ISSUE_FLAG    in ( 0 , 2)                                                         
  AND FOLDER.JUDGEMENT_STATUS    = 2                                                        
 AND ( :pflg=:pflg or  FOLDER.EXECUTION_FLAG    = 1 or FOLDER.is_active = 'Y' )    
 AND FOLDER.folder_type    != 35    
   AND FOLDER.is_active    = 'Y'                      
      AND (CAS.CASE_NUMBER = :bindCaseNumber )                                                              
       AND (PAR_POLICE.PAR_YEAR = :bindParYear OR :bindParYear IS NULL)                                                                  
       AND (   PAR_POLICE.ORIGIN_ENTITY = :bindOriginEntity                                                              
            OR :bindOriginEntity IS NULL)                                                              
       AND (   PAR_POLICE.BUSINESS_CASE_TYPE = :bindBusinessCaseType                                                              
            OR :bindBusinessCaseType IS NULL) 
          and (  
      ( :puser = 39 and FOLDER.CRIMINAL_TYPE = 1  and (    :bindBusinessCaseType = 4 or  DATES.BC_DEGREE_ID = 3  or DATES.BC_DEGREE_ID =4 or DATES.BC_DEGREE_ID =8)   )   
      or   ( :puser = 39 and FOLDER.CRIMINAL_TYPE = 2  and (DATES.BC_DEGREE_ID = 1  or DATES.BC_DEGREE_ID =7 or DATES.BC_DEGREE_ID =8)   )   
     or (  :bindBusinessCaseType != 4 and   :puser = 3 and FOLDER.CRIMINAL_TYPE = 1  and (DATES.BC_DEGREE_ID = 1 or DATES.BC_DEGREE_ID =2)   )     
     )]]></SQLQuery>
