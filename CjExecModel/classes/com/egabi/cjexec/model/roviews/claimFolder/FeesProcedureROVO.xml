  <SQLQuery><![CDATA[select * from (select distinct PARTIES.PARTY_FIXED_FULL_NAME,PARTIES.ID_NUMBER , CAS.ID BUS_CASE_ID ,  PARTIES.id part_id,   CAS_TYPE.id CAS_TYPE, POLICE.id POLICE_ID,                                                 
                                
 DECISIONS.id DECISIONS_IDS,    CH_PARTIES.DECISION_ID DECISION_ID,   DATES.BC_DEGREE_ID  ,                                                           
      PAR_POLICE.PAR_YEAR|| '/'|| CAS.CASE_NUMBER|| '/'|| CAS_TYPE.NAME   || '/' || POLICE.ENTITY_NAME AS BUSINESS_CASE_NUMBER_FULL,                                                                                 
      FOLDER.YEAR                                                                                   
      || '/'                                                                                   
      || FOLDER.SEQUENCE_NUMBER                                                                                   
      || '/'                                                                                   
      || DECODE (FOLDER.FOLDER_TYPE, 2, 'حبس', 3, 'غرامة')                                                                                   
      || '/'                                                                                   
      || DECODE (FOLDER.REPEATED_FLAG, 'Y', 'مكرر', 'N', 'غير مكرر')                                                                                   
      || '/'                                                                                   
      || POLICE.ENTITY_NAME AS SEQ_NUMBER_FULL                                                        
      ,          RES_PART.attendance ,                                                    
       DECISIONS.PENALTY_AMOUNT   ,   DECISIONS.GURANTEE_AMOUNT    ,                         
       DECISIONS.Work_AMOUNT,  FOLDER.id  folder_id,  FOLDER.police_station_entity_id ,                            
       DECISIONS.PENALTY_DUE_DATE                                      
      , (select   nvl (max(FEES_AMOUNT),0) from  EXC_COURT_BC_DECISION_FEES FEES where  FEES.DECISION_ID  =   CH_PARTIES.DECISION_ID and FEES.FEES_TYPE_ID =2 and COURT_FEES_FLAG Is null)   COURT_FEES                                 
      , (select   nvl(max(FEES_AMOUNT),0) from  EXC_COURT_BC_DECISION_FEES FEES where  FEES.DECISION_ID  =   CH_PARTIES.DECISION_ID and FEES.FEES_TYPE_ID =1 and LAWYER_FEES_FLAG Is null)   LAWYER_FEES                                  
        ,                    
                      
  (select nvl( sum (advance_payment_amount),0)                   
FROM     EXC_FOLDER_ACTIONS folder_actions                    
                     
inner join exc_folder_procedures procedures on                     
procedures.id = folder_actions.procedure_id                   
                   
where                           
folder_actions.FOLDER_RECORD_ID   = FOLDER.id                   
and    FOLDER_ACTIONS.ACTION_TYPE    =7                    
and fees_type_id = :bindtype   -- gurantee                   
and number_paid is not null                                                                        
  )   paied_gurantee , (select CLAIM_NUMBER    from EXC_CLAIMS inner join EXC_LKP_FEES_TYPES on            
 EXC_LKP_FEES_TYPES.CLAIM_FOLDERS_ID = EXC_CLAIMS.CLAIM_FOLDER_ID           
  inner join EXC_FOLDER_DATA on            
 EXC_FOLDER_DATA.id =   EXC_CLAIMS.EXC_FOLDER_ID             
   where EXC_CLAIMS.EXC_FOLDER_ID  =FOLDER.id           
   and folder_type != 35           
   and EXC_LKP_FEES_TYPES.id = :bindtype )     CLAIM_NUMBER                           
                   
 FROM    EXC_FOLDER_DATA FOLDER            
-- left outer join EXC_CLAIMS on     FOLDER.id =   EXC_CLAIMS.EXC_FOLDER_ID                                                                                     
   ,   COURT_BC_HEARING_RES_PARTIES RES_PART,                                                                                   
      COURT_BC_HEARING_RESERVATION RES,                                                                                   
      PAR_PARTIES PARTIES,                                                                                   
      BUSINESS_CASE CAS,                                                                                   
      PAR_POLICE_AUTHORITY_REPORT PAR_POLICE,                                                                                   
      ENTITY POLICE,                                                                                   
      COURT_CIRCLES_DATES_HEARING DATES,                                                                                   
      BUSINESS_CASE_DEGREES DEGREES,                                                                                   
      BUSINESS_CASE_TYPE CAS_TYPE,                                                                                   
      EXC_LKP_FOLDER_TYPES FOLDER_TYPE,                                                                                   
      EXC_COURT_BC_CHARGES_PARTIES CH_PARTIES,                                                                                   
      EXC_COURT_BC_CHARGE_DECISIONS DECISIONS                                                                                
    WHERE FOLDER.RES_PARTY_ID            = RES_PART.ID                            
      and FOLDER.folder_type != 35                                                                 
    AND RES_PART.COURT_BC_HEARING_RES_ID = RES.ID                                                                                   
    AND RES_PART.PARTY_ID                = PARTIES.ID                                                                                   
    AND RES.BUSINESS_CASE_ID             = CAS.ID                                                                                   
    AND CAS.ID                           = PAR_POLICE.BUSINESS_CASE_ID                                                                                   
    AND PAR_POLICE.ORIGIN_ENTITY         = POLICE.ID                                                                                   
    AND DATES.ID                         = RES.CIRCLE_HEARING_DATE_ID                                                                                   
    AND DATES.BC_DEGREE_ID               = DEGREES.ID                                                                                   
    AND CAS.CASE_TYPE                    = CAS_TYPE.ID                                                                                   
    AND FOLDER_TYPE.ID                   = FOLDER.FOLDER_TYPE                                                         
     AND CH_PARTIES.CHARGE_DECISION_ID           = DECISIONS.ID                                                                                   
    AND CH_PARTIES.RES_PARTY_ID                 = FOLDER.RES_PARTY_ID                                                               
                          
 -- and DECISIONS.Stop_Execution_Flag  ='N'                                                    
  AND FOLDER.CLAIM_ISSUE_FLAG    = 0                                                          
  AND FOLDER.JUDGEMENT_STATUS    = 2                                                         
   and folder.criminal_type =  :folderCriminalType                   
   AND FOLDER.is_active    = 'Y'                                                                      
       AND (   FOLDER.POLICE_STATION_ENTITY_ID = :bindOriginEntity                                                               
            OR :bindOriginEntity IS NULL)                                                               
                     
          AND (    :attend  = 0  OR RES_PART.attendance = :attend                                                               
          )           
               AND (  :deg   = 0 OR  DATES.BC_DEGREE_ID  = :deg                                                               
           )           
                                 
  AND DATES.HEARING_DATE BETWEEN TO_DATE(:DATE_FROM, 'yyyy-mm-dd')                                                             
       AND TO_DATE(:DATE_TO , 'yyyy-mm-dd')+1)                 
    where  ( COURT_FEES > 0 AND :bindtype= 2) or (LAWYER_FEES > 0 AND :bindtype = 1) or           
      (GURANTEE_AMOUNT > 0 AND :bindtype =4)]]></SQLQuery>
