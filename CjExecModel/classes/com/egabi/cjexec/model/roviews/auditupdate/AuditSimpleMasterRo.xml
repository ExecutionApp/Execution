  <SQLQuery><![CDATA[SELECT DISTINCT AUDS.BUSINESS_CASE_ID,       
                BC.CASE_NUMBER,       
                PPAR.PAR_YEAR,       
                PPAR.BUSINESS_CASE_TYPE,       
                BUSCASETYP.NAME,       
                BC.ENTITY_ID,       
                EN.ENTITY_NAME,       
                PPAR.ORIGIN_ENTITY,       
                EN_ORIGIN.ENTITY_NAME       
  FROM Audit_simple AUDS,       
       Business_case BC,       
       PAR_POLICE_AUTHORITY_REPORT PPAR,       
       ENTITY EN,       
       BUSINESS_CASE_TYPE BUSCASETYP,       
       ENTITY EN_ORIGIN       
 WHERE     AUDS.BUSINESS_CASE_ID = BC.ID       
       AND BC.ENTITY_ID = EN.ID       
       AND PPAR.BUSINESS_CASE_TYPE = BUSCASETYP.ID       
       AND PPAR.ORIGIN_ENTITY = EN_ORIGIN.ID       
       AND AUDS.BUSINESS_CASE_ID = PPAR.BUSINESS_CASE_ID       
       AND (TO_DATE(AUDS.CREATION_DATE, 'DD/MM/YYYY') >= TO_DATE(:bindStartDate, 'DD/MM/YYYY') OR :bindStartDate IS NULL)       
       AND (TO_DATE(AUDS.CREATION_DATE, 'DD/MM/YYYY') <= TO_DATE(:bindEndDate  , 'DD/MM/YYYY') OR :bindEndDate IS NULL)       
       AND (AUDS.USER_ID = :bindUserID OR :bindUserID IS NULL)       
       AND (BC.CASE_NUMBER = :bindCaseNumber OR :bindCaseNumber IS NULL)       
       AND (PPAR.PAR_YEAR = :bindParYear OR :bindParYear IS NULL)       
       AND (BC.ENTITY_ID = :bindEntityId OR AUDS.ENTITY_ID = :bindEntityId)       
       AND (   PPAR.ORIGIN_ENTITY = :bindOriginEntity       
            OR :bindOriginEntity IS NULL)       
       AND (   PPAR.BUSINESS_CASE_TYPE = :bindBusinessCaseType       
            OR :bindBusinessCaseType IS NULL)]]></SQLQuery>
