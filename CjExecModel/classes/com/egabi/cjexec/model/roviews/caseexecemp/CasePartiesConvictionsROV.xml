  <SQLQuery><![CDATA[SELECT FCDP.PARTY_ID,                   
       (SELECT NAME                   
          FROM PAR_CRIMINAL_TYPES                   
         WHERE ID = FCDD.DESCRIPTION_ID)                   
           CRIME,                   
       FCDD.DESCRIPTION_ID                   
           CRIMINAL_TYPE,                   
       FCDD.ID                   
           DECRIPTION_ID,                   
       COURT_CIRCLE_DATE_ID,                   
       FCDDP.FORM_CASE_PARTY_ID,                   
       FCDDP.ID                   
           PARTY_CRIME_ID,                   
       (SELECT CHARGE_DECISION_ID                   
          FROM EXC_COURT_BC_CHARGES_PARTIES                   
         WHERE PARTY_CRIME_ID = FCDDP.ID)                   
           CHARGE_DECISION_ID          
                           
  FROM FORM_CASE_DESCRIPTION_DES_PART  FCDDP,                   
       FORM_CASE_DESCRIPTION_DES       FCDD,                   
       FORM_CASE_DESCRIPTION_PARTIES   FCDP,                   
       FORM_CASE_DESCRIPTION           FCD                   
 WHERE     FCDDP.FORM_CASE_DES_ID = FCDD.ID                   
       AND FCDP.FORM_CASE_DESCRIPTION_ID = FCD.ID                   
       AND FCDD.FORM_CASE_DESCRIPTION_ID = FCD.ID                   
       AND FCDDP.FORM_CASE_PARTY_ID = FCDP.ID                 
       AND FCDDP.JUDGMENT_CLASSIFICATION = 2]]></SQLQuery>
