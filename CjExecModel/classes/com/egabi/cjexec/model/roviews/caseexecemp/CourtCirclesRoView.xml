<!DOCTYPE ViewObject SYSTEM "jbo_03_01.dtd">
<!---->
<ViewObject
  xmlns="http://xmlns.oracle.com/bc4j"
  Name="CourtCirclesRoView"
  Version="12.2.1.11.57"
  InheritPersonalization="merge"
  BindingStyle="OracleName"
  CustomQuery="true"
  PageIterMode="Full">
  <DesignTime>
    <Attr Name="_isExpertMode" Value="true"/>
  </DesignTime>
  <Properties>
    <SchemaBasedProperties>
      <LABEL
        ResId="com.egabi.cjexec.model.roviews.caseexecemp.CourtCirclesRoView_LABEL"/>
    </SchemaBasedProperties>
  </Properties>
  <Variable
    Name="bindCourtId"
    Kind="where"
    Type="java.lang.String"/>
  <SQLQuery><![CDATA[SELECT PARENT_ENTITY_ID COURT_ID,ENTITY_NAME DIR_NAME,ID DIR_ID    
                    FROM   ENTITY ENT  
                    WHERE  ENT.ENTITY_TYPE_ID =5
                    AND    PARENT_ENTITY_ID = :bindCourtId]]></SQLQuery>
  <ViewAttribute
    Name="CourtId"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.math.BigDecimal"
    ColumnType="NUMBER"
    AliasName="COURT_ID"
    Expression="COURT_ID"
    SQLType="NUMERIC"/>
  <ViewAttribute
    Name="DirName"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Precision="200"
    Type="java.lang.String"
    ColumnType="VARCHAR2"
    AliasName="DIR_NAME"
    Expression="DIR_NAME"
    SQLType="VARCHAR">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="200"/>
    </DesignTime>
  </ViewAttribute>
  <ViewAttribute
    Name="DirId"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.math.BigDecimal"
    ColumnType="NUMBER"
    AliasName="DIR_ID"
    Expression="DIR_ID"
    SQLType="NUMERIC"/>
  <ResourceBundle>
    <PropertiesBundle
      PropertiesFile="com.egabi.cjexec.model.CjExecModelBundle"/>
  </ResourceBundle>
  <AttrArray Name="KeyAttributes">
    <Item Value="DirId"/>
  </AttrArray>
</ViewObject>
