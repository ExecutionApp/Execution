  <SQLQuery><![CDATA[
/* Formatted on 09-Nov-19 7:19:15 PM (QP5 v5.313) */ 
SELECT 1  ID, 
       COURT_ID, 
       COURT_NAME, 
       DIR_ID, 
       DIR_NAME, 
       NULL  CASE_TYPE, 
       NULL  HEARING_DATE, 
       NULL  POLICE_NUMBER, 
       NULL PARTY_ID_NUMBER, 
       NULL PARTY_FULL_NAME, 
       NULL  ORIGIN_ENTITY, 
       NULL  CASE_DEGREE_ID, 
       NULL  CLASSIFIED_FLAG 
  FROM (SELECT COURT.ID COURT_ID,COURT.ENTITY_NAME COURT_NAME,COURT.ENTITY_TYPE_ID,
               NEABA.ID,NEABA.ENTITY_NAME,NEABA.ENTITY_TYPE_ID,
               CIRC.ID DIR_ID,CIRC.ENTITY_NAME DIR_NAME,CIRC.ENTITY_TYPE_ID   
        FROM   ENTITY NEABA,ENTITY COURT,ENTITY CIRC,SEC_USERS USR 
        WHERE  NEABA.ENTITY_TYPE_ID = 1
        AND    NEABA.COURT_ID  =  COURT.ID
        AND    CIRC.PARENT_ENTITY_ID =  COURT.ID
        AND    NEABA.ID = USR.ENTITY_ID
        AND    USR.ID = :sessionUser
        AND    ROWNUM=1)]]></SQLQuery>
