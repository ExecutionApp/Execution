<ViewObject
  xmlns="http://xmlns.oracle.com/bc4j"
  Name="FolderDataROV"
  Version="12.2.1.1.10"
  InheritPersonalization="merge"
  BindingStyle="OracleName"
  CustomQuery="true"
  PageIterMode="Full">
  <DesignTime>
    <Attr Name="_isExpertMode" Value="true"/>
  </DesignTime>
  <Variable
    Name="bindDecesionId"
    Kind="where"
    Type="java.lang.String"/>
  <SQLQuery><![CDATA[SELECT FD.ID,   FD.JUDGMENT_TEXT ,           
       FD.SEQUENCE_NUMBER,              
       FD.YEAR,              
       FD.YEAR || '/' || FD.SEQUENCE_NUMBER              
           COUNT_NUMBER,              
       PP.FNAME || ' ' || PP.SNAME || ' ' || PP.TNAME || ' ' || PP.FOURTHNAME              
           FULL_NAME,              
       PP.ID_NUMBER,             
       RP.JUDGEMENT_RESOLUTION_C,      
       (SELECT FOLDER_NAME FROM EXC_LKP_FOLDER_TYPES WHERE ID = FD.FOLDER_TYPE )   FOLDER_NAME,    
       FD.POLICE_STATION_ENTITY_ID    
  FROM EXC_FOLDER_DATA FD, COURT_BC_HEARING_RES_PARTIES RP, PAR_PARTIES PP              
 WHERE     RP.ID = FD.RES_PARTY_ID              
       AND RP.PARTY_ID = PP.ID            
       AND FD.JUDGEMENT_STATUS = 2         
       AND RP.PARTY_ID IN  
               (SELECT FCDP.PARTY_ID  
                  FROM FORM_CASE_DESCRIPTION_DES_PART  FCDDP,  
                       FORM_CASE_DESCRIPTION_DES       FCDD,  
                       FORM_CASE_DESCRIPTION_PARTIES   FCDP,  
                       FORM_CASE_DESCRIPTION           FCD  
                 WHERE     FCDDP.FORM_CASE_DES_ID = FCDD.ID  
                       AND FCDP.FORM_CASE_DESCRIPTION_ID = FCD.ID  
                       AND FCDD.FORM_CASE_DESCRIPTION_ID = FCD.ID  
                       AND FCDDP.FORM_CASE_PARTY_ID = FCDP.ID  
                       AND FCDP.PARTY_ID = RP.PARTY_ID  
                       AND FCDDP.JUDGMENT_CLASSIFICATION = 2)         
       AND RP.COURT_BC_HEARING_RES_ID =          
           (SELECT ECBSJ.COURT_BC_HEARING_RES_ID          
              FROM EXC_COURT_BC_SESSION_JUDGMENT  ECBSJ,          
                   EXC_COURT_BC_DECISION          ECBD          
             WHERE     ECBSJ.ID = ECBD.SESSION_JUDGMENT_ID          
                   AND ECBD.ID = :bindDecesionId)]]></SQLQuery>
