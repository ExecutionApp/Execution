    Kind="where"
    Type="java.lang.String"/>
  <SQLQuery><![CDATA[SELECT CBHR.ID       
             HEARING_RES_ID,       
            POLICE_NUMBER       
         || '  '       
         || (SELECT NAME       
               FROM BUSINESS_CASE_TYPE       
              WHERE ID = BC.BUSINESS_CASE_TYPE)       
         || '  '       
         || PAR_YEAR       
             AS CASE_NUMBER,       
         BC.BUSINESS_CASE_NAME,       
         HEARING_DATE,       
         (SELECT NAME       
            FROM BUSINESS_CASE_DEGREES       
           WHERE ID = CCDH.BC_DEGREE_ID)       
             CASE_DEGREE,     
             CCDH.BC_DEGREE_ID,    
         POLICE_NUMBER,       
         BC.BUSINESS_CASE_TYPE,       
         PAR_YEAR,       
         CCDH.ID       
             HEARING_DATE_ID,       
         COUNTS.COUNT_ALL,       
         COUNTS.CREATED,       
         COUNTS.DONE   ,   
         CSJ.CLASSIFIED_FLAG     
    FROM PAR_POLICE_AUTHORITY_REPORT  AR,       
         BUSINESS_CASE                BC,       
         COURT_CIRCLES_DATES_HEARING  CCDH,       
         COURT_BC_HEARING_RESERVATION CBHR,       
         EXC_COURT_BC_SESSION_JUDGMENT CSJ,       
         (SELECT COUNT (EXBD.CLASSIFIED_FLAG)                    CREATED,       
                 COUNT (DECODE (EXBD.CLASSIFIED_FLAG, 0, NULL, 1)) DONE,       
                 COUNT (CCDH.ID)                                 COUNT_ALL       
            FROM PAR_POLICE_AUTHORITY_REPORT  AR,       
                 BUSINESS_CASE                BC,       
                 COURT_CIRCLES_DATES_HEARING  CCDH,       
                 COURT_BC_HEARING_RESERVATION CBHR,       
                 EXC_COURT_BC_SESSION_JUDGMENT CSJ,       
                 EXC_COURT_BC_DECISION        EXBD       
           WHERE     AR.BUSINESS_CASE_ID = BC.ID       
                 AND CBHR.BUSINESS_CASE_ID = AR.BUSINESS_CASE_ID       
                 AND CBHR.CIRCLE_HEARING_DATE_ID = CCDH.ID       
                 AND CSJ.COURT_BC_HEARING_RES_ID = CBHR.ID       
                 AND EXBD.SESSION_JUDGMENT_ID(+) = CSJ.ID       
                 AND CCDH.ENTITY_ID = :bindCircleId       
                 AND CASE_TYPE = :bindCaseType       
                 AND CCDH.ID = nvl(:bindHearingDateId,CCDH.ID)      
                 AND AR.ORIGIN_ENTITY = NVL(:bindOriginEntityId,AR.ORIGIN_ENTITY)    
                 AND CCDH.BC_DEGREE_ID = :bindDegree       
                 AND CSJ.CLASSIFIED_FLAG = 0       
                 AND CSJ.JUDGMENT_TYPE = 1) COUNTS       
   WHERE     AR.BUSINESS_CASE_ID = BC.ID       
         AND CBHR.BUSINESS_CASE_ID = AR.BUSINESS_CASE_ID       
         AND CBHR.CIRCLE_HEARING_DATE_ID = CCDH.ID       
         AND CSJ.COURT_BC_HEARING_RES_ID = CBHR.ID       
         AND CCDH.ENTITY_ID = :bindCircleId       
         AND CASE_TYPE = :bindCaseType       
         AND CCDH.ID = NVL(:bindHearingDateId,CCDH.ID)    
         AND CCDH.BC_DEGREE_ID = :bindDegree       
         AND AR.ORIGIN_ENTITY = NVL(:bindOriginEntityId,AR.ORIGIN_ENTITY)    
         AND (AR.POLICE_NUMBER = :bindPoliceNumber OR :bindPoliceNumber IS NULL)       
         AND AR.ID IN       
                 (SELECT PP.PAR_ID       
                    FROM PAR_PARTIES PP       
                   WHERE     (   PP.ID_NUMBER = :bindIdNumber       
                              OR :bindIdNumber IS NULL)       
                         AND (   UPPER (       
                                        PP.FNAME       
                                     || ' '       
                                     || PP.SNAME       
                                     || ' '       
                                     || PP.TNAME       
                                     || ' '       
                                     || PP.FOURTHNAME) LIKE       
                                     UPPER ('%' || :bindPartyName || '%')       
                              OR :bindPartyName IS NULL)       
                         AND PP.PAR_ID = AR.ID)       
        -- AND CSJ.CLASSIFIED_FLAG = 0       
         AND CSJ.JUDGMENT_TYPE = 1       
ORDER BY 1 DESC]]></SQLQuery>
