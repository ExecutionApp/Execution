SELECT ID USER_ID,                        
       USERNAME,                        
       FIRST_NAME,                        
       LAST_NAME,                        
       ENTITY_ID,                        
       (select nvl (e.ENTITY_DEGREE , 0) from entity e where e.id = ENTITY_ID ) ENTITY_DEGREE ,   
