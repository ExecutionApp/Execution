        (select e.EXC_ERRAND_ENTITY_ID from entity e where e.id = ENTITY_ID ) EXC_ERRAND_ENTITY_ID ,    
        (select e.EXC_DIS_RULE_FLAG from entity e where e.id = ENTITY_ID ) Exc_DIS_RULE_FLAG ,    
       (select nvl (E.ENTITY_TYPE_ID , 0) from entity e where e.id = ENTITY_ID ) ENTITY_TYPE ,                    
       (SELECT                                
       e.PARENT_ENTITY_ID from ENTITY e where  e.id =ENTITY_ID ) PARENT_ENTITY_ID ,                
       (SELECT                                
       e.PARENT_ENTITY_ID from ENTITY e where  e.id =     (SELECT   PARENT_ENTITY_ID from ENTITY   where  id =ENTITY_ID ) )entity_appeal ,                   
       (select E.ENTITY_NAME from entity e where e.id = ENTITY_ID ) ENTITY_NAME ,                 
      (select E.exc_automation_flag from entity e where e.id = ENTITY_ID ) automation_flag ,      
       EXPIRED,                        
       EXPIRY_DATE,                        
       ROLE_ID,                        
       MANAGER_ID,                        
       JOB_ID,                        
