  <SQLQuery><![CDATA[SELECT COU.ID , TO_CHAR(COU.HEARING_DATE , 'yyyy-mm-dd')  || ' '  || ENTS.ENTITY_NAME  HEARING_DATE                                        
FROM  COURT_CIRCLES_DATES_HEARING COU, ENTITY ENTS                                         
WHERE COU.CAPACITY > 0    
AND COU.CIRCLES_ARCHIVE = 0 
AND COU.ENTITY_ID = ENTS.ID                  
AND COU.ENTITY_ID IN (                                         
SELECT ENT.ID FROM ENTITY ENT WHERE ENT.PARENT_ENTITY_ID =(SELECT EN.COURT_ID FROM ENTITY EN WHERE EN.ID = (:entityId)))                                         
AND (COU.BC_DEGREE_ID = DECODE(:degreeIdBind , 1 , 3 , 8 , 5 , 9 , 4 , 23 , 6 , 2 , 2 , 20 , 7 , 14 , 1,24,2,19, case when (:degreeIdBind = 19 and :firstDegree is null) then  2 else 1 end)                          
OR COU.BC_DEGREE_ID = DECODE(:postponedBind, 8, 2 , :postponedBind))  
AND COU.HEARING_DATE > TO_DATE ( :egraaDate, 'yyyy-mm-dd')  
AND COU.HEARING_DATE < decode(:prevDate ,null, sysdate,TO_DATE ( :prevDate, 'yyyy-mm-dd') )              
--AND COU.SOURCE is null   
AND :prevDegree = :prevDegree 
ORDER BY COU.HEARING_DATE desc, COU.ENTITY_ID]]></SQLQuery>
