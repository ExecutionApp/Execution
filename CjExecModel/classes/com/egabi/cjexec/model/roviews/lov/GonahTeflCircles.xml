    ColumnType="VARCHAR2"
    AliasName="HEARING_DATE"
    Expression="HEARING_DATE"
    SQLType="VARCHAR">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="211"/>
    </DesignTime>
  </ViewAttribute>
