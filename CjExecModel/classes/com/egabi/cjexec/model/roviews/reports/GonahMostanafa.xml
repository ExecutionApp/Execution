    Kind="where"
    Type="java.math.BigDecimal"/>
  <SQLQuery><![CDATA[select   
 null INVENTORY_NUMBER,  
   PAR_POLICE.PAR_YEAR   
         || '/'   
         || PAR_POLICE.POLICE_NUMBER   
         || '/'   
         || CAS_TYPE.NAME   
         || '/'   
         || ENTS.ENTITY_NAME   
            AS BUSINESS_CASE_NUMBER,  
           LEDGER.SEQ   
         || '/'   
         || LEDGER.YEAR   
         || '/'   
         || :label 
         --|| 'جنح مستأئف'   
         || '/'   
         || (SELECT ENTITY_NAME FROM ENTITY WHERE ID = LEDGER.ENTITY_ID) APPEAL_NUMBER,  
         null PROCEDURE_DATE,  
           null PROCEDURE_TYPE,  
          (select TO_CHAR (CIRCLES.HEARING_DATE, 'yyyy-mm-dd') from COURT_CIRCLES_DATES_HEARING CIRCLES   
          where id = (select b.CIRCLE_HEARING_DATE_ID from (select RES.* ,rank()over (partition by RES.BUSINESS_CASE_ID order by RES.created_date desc) rn  
            from COURT_BC_HEARING_RESERVATION RES  where RES.BUSINESS_CASE_ID = CAS.ID ) b   
             where b.rn=1)  
             )HEARING_DATE  
           ,  
              PARTIES.PARTY_FULL_NAME PARTY_FULL_NAME,   
null ACTS_TYPES_NAME,  
         PAR_POLICE.PAR_YEAR,   
         null POLICE_STATION_ENTITY_ID,  
         ENTS.PARENT_ENTITY_ID ENT_ID,   
            null DATE_ENT_RESERVATION,  
          DETAILS.CREATED_BY  
           
           
from  BUSINESS_CASE_DETAILS DETAILS, BUSINESS_CASE_LEDGER_SEQ LEDGER   
, PAR_POLICE_AUTHORITY_REPORT PAR_POLICE  
,ENTITY ENTS  
, BUSINESS_CASE_TYPE CAS_TYPe,  
BUSINESS_CASE CAS, PAR_PARTIES PARTIES  
where  DETAILS.ID = LEDGER.BUSINESS_CASE_DETAILS_ID   
         AND DETAILS.CASE_SCHEMA_ID = :caseSchemaId --3643   
         AND PAR_POLICE.BUSINESS_CASE_ID = DETAILS.BUSINESS_CASE_ID   
          AND PAR_POLICE.ORIGIN_ENTITY = ents.ID   
         AND CAS_TYPE.ID = CAS.CASE_TYPE   
          AND CAS.ID = DETAILS.BUSINESS_CASE_ID   
          AND CAS.ID = PARTIES.CREATED_BY_BUSINESS_CASE_ID  
          AND LEDGER.ENTITY_ID = :Nyabaa   
           AND LEDGER.YEAR = :YEAR   
          AND (LEDGER.SEQ = :FolderType OR :FolderType IS NULL)  
          and (1=1 or :DATE_FROM =:DATE_TO)  
order by LEDGER.SEQ asc]]></SQLQuery>
