  <SQLQuery><![CDATA[SELECT C.ID, to_number(C.CLAIM_NUMBER ) as CLAIM_NUMBER,                                             
C.PARTY_NAME,                                  
c.ID_NUMBER ,           
f.criminal_type ,                                
C.CLAIM_FOLDER_ID,                                             
Y.CLAIM_YEAR,                                             
C.CLAIM_TOTAL_ORIGINAL,--(C.CLAIM_TOTAL_ORIGINAL - C.FIXED_PENALTY_AMOUNT )                                  
C.CLAIM_TOTAL,  C.COMBINED_ORDER ,                             
C.FIXED_PENALTY_AMOUNT,             
C.cancel_amount ,             
C.CLAIM_SEQUENCE_NUMBER,                                                      
C.ORIGINAL_PENALTY_DUE_DATE,   r.BC_DEGREE_SPEC_ID    ,                                           
C.CREATED_DATE ,                                             
P.POLICE_NUMBER || '/' || P.PAR_YEAR || '/' || T.NAME || '/' || E.ENTITY_NAME   CASE_NUMBER,                                    
(SELECT USERNAME FROM SEC_USERS WHERE ID = C.CREATED_BY) CREATED_BY                                     
                                            
FROM EXC_CLAIMS C, BUSINESS_CASE B, EXC_CLAIM_YEARS Y,  exc_folder_data f ,                                           
PAR_POLICE_AUTHORITY_REPORT P, ENTITY E, BUSINESS_CASE_TYPE T   , court_bc_hearing_res_parties r                                                  
                                            
WHERE C.BUSINESS_CASE_ID = B.ID   
and r.id = f.res_party_id 
AND C.CLAIM_YEAR = Y.ID              
AND C.exc_folder_id = f.id                                                  
AND C.BUSINESS_CASE_ID = P.BUSINESS_CASE_ID                                                      
AND P.ORIGIN_ENTITY = E.ID                                                      
AND P.BUSINESS_CASE_TYPE = T.ID                                                     
AND Y.ID = :YEAR  
and   r.BC_DEGREE_SPEC_ID  = :degId 
and f.criminal_type =  :folderCriminalType       
AND c.CLAIM_POLICE_STATION_ID =:Nyabaa                                      
and C.CLAIM_FOLDER_ID = :ClaimFolderType                                
and C.DELETED_FLAG = 'N'                             
AND (:DATE_FROM is null or C.CREATED_DATE BETWEEN TO_DATE(:DATE_FROM, 'dd/mm/yyyy')                                                                     
  AND TO_DATE(:DATE_TO , 'dd/mm/yyyy')+1    )        
       
  and ( :END_NUM is null or ( to_number(C.CLAIM_NUMBER ) >= :START_NUM  and to_number(C.CLAIM_NUMBER ) <= :END_NUM))     
order by C.CLAIM_NUMBER asc]]></SQLQuery>
