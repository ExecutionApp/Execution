  CREATE TABLE "PRODCJ_26_11_2019"."NATIONAL_ID_SERVICE_LOG" 
   (	"ID" NUMBER NOT NULL ENABLE, 
	"USER_ID" NUMBER, 
	"ENTITY_ID" NUMBER, 
	"NATIONAL_ID" VARCHAR2(200 BYTE), 
	"CALL_DATE" TIMESTAMP (6) DEFAULT SYSDATE,
	"REQUEST" VARCHAR2(4000 BYTE), 
	"HTTP_CODE" NUMBER, 
	"HTTP_MESSAGE" VARCHAR2(4000 BYTE), 
	"RESPONSE_CODE" NUMBER, 
	"RESPONSE_MESSAGE" VARCHAR2(4000 BYTE),
	 CONSTRAINT "TABLE1_PK" PRIMARY KEY ("ID")
  USING INDEX PCTFREE 10 INITRANS 2 MAXTRANS 255 
  TABLESPACE "USERS"  ENABLE
   ) SEGMENT CREATION DEFERRED 
  PCTFREE 10 PCTUSED 40 INITRANS 1 MAXTRANS 255 
 NOCOMPRESS LOGGING
  TABLESPACE "USERS" ;



  CREATE OR REPLACE EDITIONABLE TRIGGER "PRODCJ_26_11_2019"."NATIONAL_ID_SERVICE_LOG_TRG" 
   before insert on "PRODCJ_26_11_2019"."NATIONAL_ID_SERVICE_LOG" 
   for each row 
begin  
   if inserting then 
      if :NEW."ID" is null then 
         select NATIONAL_ID_SERVICE_LOG_SEQ.nextval into :NEW."ID" from dual; 
      end if; 
   end if; 
end;

