CREATE OR REPLACE TRIGGER "FOLDER_EXECUTION_MOI_DATE_TRG" 
BEFORE UPDATE
ON EXC_FOLDER_DATA
REFERENCING NEW AS New OLD AS Old
FOR EACH ROW
BEGIN
  if :new.EXECUTION_MOI_FLAG = 3
  then
  :new.EXECUTION_UPDATE_DATE := sysdate;
  end if ;
END FOLDER_EXECUTION_MOI_DATE_TRG;
