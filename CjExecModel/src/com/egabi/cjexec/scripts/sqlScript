CREATE OR REPLACE TRIGGER  PAR_PART_TRIG
before INSERT or update  ON  PAR_PARTIES 
  
FOR EACH ROW
BEGIN 
 
         :NEW.party_full_name:=:NEW.fname||' '||:NEW.sname||' '||:NEW.tname||' '||:NEW.fourthname;
         
    :NEW.Party_Fixed_full_name :=  FIX_STRING (:NEW.party_full_name)  ;    

END;
