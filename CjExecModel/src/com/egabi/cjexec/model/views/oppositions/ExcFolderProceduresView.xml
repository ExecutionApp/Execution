    <SQLQuery><![CDATA[SELECT EXCFOLDERPROCEDURESEO.ID,                                  
       EXCFOLDERPROCEDURESEO.CAPACITY_TYPE,                                  
       EXCFOLDERPROCEDURESEO.COURT_CIRCLE_DATES_HEARING_ID,                                  
       EXCFOLDERPROCEDURESEO.RES_PARTY_ID ,                                
       EXCFOLDERPROCEDURESEO.CREATED_BY ,                                
       EXCFOLDERPROCEDURESEO.CREATED_DATE ,                                
       EXCFOLDERPROCEDURESEO.PROCEDURE_DATE ,                                
       EXCFOLDERPROCEDURESEO.PROCEDURE_SERIAL ,                                
       EXCFOLDERPROCEDURESEO.PROCEDURE_STATUS ,                                
       EXCFOLDERPROCEDURESEO.PROCEDURE_TEXT ,                               
       EXCFOLDERPROCEDURESEO.PROSECUTION_ID ,                            
       EXCFOLDERPROCEDURESEO.PRIMARY_LAWYER_ID ,                        
       EXCFOLDERPROCEDURESEO.SECONDARY_LAWYER_ID ,      
       PART.FNAME || ' ' || PART.SNAME || ' ' || PART.TNAME || ' ' || PART.FOURTHNAME AS FULL_NAME ,                                
       PART.ID_NUMBER ,                                
       PART.NICKNAME ,                             
       TO_CHAR(DATES.HEARING_DATE , 'yyyy-mm-dd') HEARING_DATE  ,                     
       PRIMARY_LAWER.NAME PRIMARY_LAWYER_NAME ,                     
       SECONDARY_LAWER.NAME SECONDARY_LAWYER_NAME ,                 
       PRIMARY_LAWER.RETAINER_NUMBER PRIMARY_RETAINER_NUMBER,                 
       SECONDARY_LAWER.RETAINER_NUMBER SECONDARY_RETAINER_NUMBER  ,              
       PART.AGE ,              
       PART.ADDRESS ,              
       PART.JOB_TITLE ,   
       EXCFOLDERPROCEDURESEO.ADVANCE_PAYMENT_AMOUNT ,  
       EXCFOLDERPROCEDURESEO.NUMBER_OF_INSTALLMENT  
FROM  EXC_FOLDER_PROCEDURES EXCFOLDERPROCEDURESEO , COURT_BC_HEARING_RES_PARTIES COURT_PARTY , PAR_PARTIES PART , COURT_BC_HEARING_RESERVATION RES ,                            
COURT_CIRCLES_DATES_HEARING DATES , PAR_LAWYERS PRIMARY_LAWER , PAR_LAWYERS SECONDARY_LAWER                            
WHERE EXCFOLDERPROCEDURESEO.RES_PARTY_ID = COURT_PARTY.ID                                
AND COURT_PARTY.PARTY_ID = PART.ID                            
AND COURT_PARTY.COURT_BC_HEARING_RES_ID = RES.ID                            
AND DATES.ID = RES.CIRCLE_HEARING_DATE_ID                     
AND EXCFOLDERPROCEDURESEO.PRIMARY_LAWYER_ID = PRIMARY_LAWER.ID                     
AND EXCFOLDERPROCEDURESEO.SECONDARY_LAWYER_ID = SECONDARY_LAWER.ID]]></SQLQuery>
