  <SQLQuery><![CDATA[SELECT EXCPROCEDURESLOGEO.ID,                                                  
       EXCPROCEDURESLOGEO.PROCEDURE_ID,                                                  
       EXCPROCEDURESLOGEO.ACTION_TYPE_ID,                                                  
       EXCPROCEDURESLOGEO.CREATED_BY,                                                  
       trunc(EXCPROCEDURESLOGEO.CREATED_DATE) AS CREATED_DATE ,                                                  
       EXCPROCEDURESLOGEO.ENTITY_ID,                                                  
       EXCPROCEDURESLOGEO.BUSINESS_CASE_ID,                                                  
       EXCPROCEDURESLOGEO.LOGGED_IN_ENTITY_ID,                                                  
       EXCPROCEDURESLOGEO.SEQUENCE_NUMBER,                                                  
       EXCPROCEDURESLOGEO.EXC_CLAIM_ID,                                                  
       EXCPROCEDURESLOGEO.MODE_TYPE ,                                             
       EXCPROCEDURESLOGEO.DOCUMENT_ID ,                                 
       EXCPROCEDURESLOGEO.FOLDER_TYPE_ID ,                                
       DECODE(EXCPROCEDURESLOGEO.FOLDER_TYPE_ID , '2' , 'حبس' , '3' , 'غرامة' , '5' , ' حبس غير منفذ ', '6' , 'حبس منفذ ') FOLDER_TYPE_NAME ,                                               
       EXCPROCEDURESLOGEO.REPEATED_FLAG ,                                            
       EXCPROCEDURESLOGEO.SEQUENCE_YEAR ,                                            
       EXCPROCEDURESLOGEO.DOCUMENT_ID2 ,                
       EXCPROCEDURESLOGEO.APPEAL_REQUEST ,               
       EXCPROCEDURESLOGEO.CRIMINAL_REQUEST ,           
       EXCPROCEDURESLOGEO.OPPOSITION_REQUEST ,         
       trunc(EXCPROCEDURESLOGEO.PROCEDURE_DATE) AS PROCEDURE_DATE ,                                       
       LOGGED_ENTITY.ENTITY_NAME AS LOGGED_ENTITY_NAME ,                                                
       CASE_ENTITY.ENTITY_NAME AS CASE_ENTITY_NAME ,                                                
       ACTION_TYPES.NAME AS ACTION_TYPE_NAME ,                                                
       CASE_TYPE.NAME AS CASE_TYPE_NAME ,                                                
       BUS_CASE.CASE_NUMBER ,                                                
       CASE_TYPE.ID AS CASE_TYPE_ID  ,                                                
       REPO.PAR_YEAR AS CASE_YEAR ,                                                
       SEC.FULL_NAME ,       (select  max (files.filename) from CRIMINAL_JUSTICE_FILES_DETAILS files where files.did  =      document_id  ) file_name ,                        
       EXCPROCEDURESLOGEO.SEQUENCE_YEAR || '/' || EXCPROCEDURESLOGEO.SEQUENCE_NUMBER || '/' || CASE_POLICE_ENTITY.ENTITY_NAME || '/' || CASE_TYPE.NAME || ' ' || DECODE(EXCPROCEDURESLOGEO.REPEATED_FLAG , 'N' , ' ' , 'Y' , 'مكرر') SEQUENCE_NUMBER_LONG                  
                                                       
FROM  EXC_PROCEDURES_LOG EXCPROCEDURESLOGEO , ENTITY LOGGED_ENTITY , ENTITY CASE_ENTITY , ENTITY CASE_POLICE_ENTITY ,EXC_LKP_ACTION_TYPES ACTION_TYPES ,                                                 
BUSINESS_CASE BUS_CASE , BUSINESS_CASE_TYPE CASE_TYPE , PAR_POLICE_AUTHORITY_REPORT REPO , SEC_USERS SEC                                                  
WHERE EXCPROCEDURESLOGEO.LOGGED_IN_ENTITY_ID = LOGGED_ENTITY.ID                                                
AND EXCPROCEDURESLOGEO.ENTITY_ID = CASE_ENTITY.ID                            
AND REPO.ORIGIN_ENTITY =   CASE_POLICE_ENTITY.ID                                          
AND EXCPROCEDURESLOGEO.ACTION_TYPE_ID = ACTION_TYPES.ID                                                
AND EXCPROCEDURESLOGEO.BUSINESS_CASE_ID = BUS_CASE.ID                                                
AND BUS_CASE.BUSINESS_CASE_TYPE = CASE_TYPE.ID                                                
AND REPO.BUSINESS_CASE_ID = BUS_CASE.ID                                              
AND EXCPROCEDURESLOGEO.CREATED_BY = SEC.ID  
and 1=0
ORDER BY EXCPROCEDURESLOGEO.ID DESC]]></SQLQuery>
