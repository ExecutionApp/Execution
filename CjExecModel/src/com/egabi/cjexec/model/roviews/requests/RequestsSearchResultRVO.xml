  <SQLQuery><![CDATA[SELECT  PROC.ID ,            
PROC.PROCEDURE_SERIAL ,              
PAR_VIEW.BC_NUMBER ,            
ACTS_TYPE.NAME ACTS_NAME ,           
PROC_STATUS.NAME PROC_NAME ,              
CAP_TYPE.NAME CAP_NAME ,             
PROC.PROCEDURE_DATE ,                      
ACTS_TYPE.ID ACTS_TYPE_ID ,       
ACTS.NEXT_ASSIGNED_USER ,     
ACTS.CLOSED_FLAG ,  
ACTS.FOLDER_RECORD_ID   
FROM EXC_FOLDER_ACTIONS ACTS              
, EXC_FOLDER_PROCEDURES PROC              
, COURT_BC_HEARING_RES_PARTIES RP             
, COURT_BC_HEARING_RESERVATION RESRV            
, PAR_POLICE_AUTHORITY_VIEW PAR_VIEW              
, EXC_LKP_ACTION_TYPES ACTS_TYPE                               
, EXC_LKP_PROCEDURE_STATUS PROC_STATUS                          
, EXC_LKP_CAPACITY_TYPE CAP_TYPE                     
WHERE ACTS.PROCEDURE_ID = PROC.ID                        
AND RP.COURT_BC_HEARING_RES_ID = RESRV.ID                
AND RP.ID=PROC.RES_PARTY_ID                       
AND RESRV.BUSINESS_CASE_ID = PAR_VIEW.BUSINESS_CASE_ID                          
AND ACTS.ACTION_TYPE = ACTS_TYPE.ID                          
AND PROC.PROCEDURE_STATUS = PROC_STATUS.ID                          
AND PROC.CAPACITY_TYPE = CAP_TYPE.ID             
AND ACTS_TYPE.ACTION_CATEGORY_ID = 2]]></SQLQuery>
