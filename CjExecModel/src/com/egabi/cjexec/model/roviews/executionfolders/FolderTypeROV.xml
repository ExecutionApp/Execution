  <SQLQuery><![CDATA[/* Formatted on 20/Nov/19 12:11:20 PM (QP5 v5.240.12305.39446) */               
SELECT 
FD.RESUMPTION_PROSECUTION RESUMPTION_PROSECUTION,          
FD.PRIMARY_PROSECUTION PRIMARY_PROSECUTION,        
FD.SECONDARY_PROSECUTION SECONDARY_PROSECUTION,       
HEAR.ENTITY_ID Circule_ID,               
       (SELECT E.ENTITY_NAME               
          FROM entity e               
         WHERE E.id = HEAR.ENTITY_id)               
          Circule_name,               
       HEAR.BC_DEGREE_ID,               
       fd.folder_type folder_type,               
       HEAR.ID hearing_date_id,               
       HEAR.hearing_date hearing_date,               
       fd.sequence_number sequence_number,               
       pp.id_number id_number,               
       pp.party_full_name party_full_name,               
       ar.police_number || ' ' || bc.NAME || ' ' || ar.par_year police_number,               
       PP.ADDRESS,               
       PP.AGE,               
       DECODE (PP.GENDER,  'F', 'انثى',  'M', 'ذكر') GENDER,               
       PP.NICKNAME,               
       RP.JUDGEMENT_RESOLUTION_C JUDGEMENT_RESOLUTION,               
       JS.NAME JUDGEMENT_STATUS,               
       FD.JUDGEMENT_STATUS JUDGEMENT_ID,               
       -- DECODE (rp.attendance, 1, 'حضور') attendance,               
       AT.NAME attendance,               
       RP.ID RES_PARTY_ID,               
       PP.job_title JOB_TITLE,               
       bcd.name DEGREE_NAME,               
       fd.ID FOLDER_ID,               
       RES.BUSINESS_CASE_ID BUSINESS_CASE_ID,               
       RP.PARTY_ID PARTY_ID,               
       rp.ID RESERVATION_ID,               
       AR.BUSINESS_CASE_TYPE TABLE_TYPE ,       
       FD.EXECUTION_PROCEDUR_ID  EXECUTION_PROCEDUR_ID       
       ,FD.YEAR  YEAR ,  
       FD.SEQUENCE_NUMBER  ||'/'|| FD.YEAR  seq   
  FROM EXC_FOLDER_DATA fd,               
       COURT_BC_HEARING_RES_PARTIES rp,               
       COURT_BC_HEARING_RESERVATION res,               
       COURT_CIRCLES_DATES_HEARING hear,               
       PAR_POLICE_AUTHORITY_REPORT ar,               
       EXC_LKP_FOLDER_TYPES ft,               
       PAR_PARTIES pp,               
       business_case_type bc,               
       business_CASE_DEGrees bcd,               
       EXC_LKP_JUDGMENT_STATUS js,               
       court_announcement_types at               
 WHERE                                  -----------join-----------------------               
      FD   .RES_PARTY_ID = RP.ID               
       AND RP.COURT_BC_HEARING_RES_ID = RES.ID               
       AND RES.CIRCLE_HEARING_DATE_ID = HEAR.ID               
       AND AR.BUSINESS_CASE_ID = RES.BUSINESS_CASE_ID               
       AND FD.FOLDER_TYPE = FT.ID               
       AND PP.ID = RP.PARTY_ID               
       AND ar.BUSINESS_CASE_TYPE = bc.ID               
       AND hear.BC_DEGREE_ID = bcd.id               
       AND FD.JUDGEMENT_STATUS = js.id               
       AND RP.ATTENDANCE = at.id               
       ------------------ MANDATORY-------------------               
       AND FT.FOLDER_CATEGORY = 1               
       AND FD.JUDGEMENT_STATUS <> 1               
       AND (FD.FOLDER_TYPE = :P_FOLDER_TYPE_ID)               
       AND AR.BUSINESS_CASE_TYPE =:P_TABLE_TYPE               
       And  HEAR.BC_DEGREE_ID =:P_BC_DEGREE_ID           
                  
       --     ------------------ Optional------------------- 
        AND (FD.RESUMPTION_PROSECUTION  =:P_RESUMPTION_PROSECUTION OR :P_RESUMPTION_PROSECUTION IS NULL)           
        AND (FD.PRIMARY_PROSECUTION =:P_PRIMARY_PROSECUTION OR :P_PRIMARY_PROSECUTION IS NULL)        
       AND (FD.SECONDARY_PROSECUTION =:P_SECONDARY_PROSECUTION OR :P_SECONDARY_PROSECUTION IS NULL)   
                 
       AND (hear.entity_id = :p_entity_id OR :p_entity_id IS NULL)               
       AND (HEAR.ID = :P_HEARING_DATE OR :P_HEARING_DATE IS NULL)       
                     
       AND (FD.SEQUENCE_NUMBER ||'/'|| fd.year = :SEQUENCE_NUMBER OR :SEQUENCE_NUMBER IS NULL)       
                     
       AND (PP.ID_NUMBER LIKE :P_id_number OR :P_id_number IS NULL)               
       AND (   PP.PARTY_FULL_NAME LIKE '%' || :p_party_full_name || '%'               
            OR :p_party_full_name IS NULL)]]></SQLQuery>
