  <SQLQuery><![CDATA[SELECT proc.id,          
  FOLDERr.JUDGMENT_TEXT ,          
  FOLDERr.FOLDER_TYPE,          
  PAR_POLICE.PAR_YEAR Case_year,          
  FOLDERr.Id FOLDER_ID,     FOLDERr.criminal_type , FOLDERr.POLICE_STATION_ENTITY_ID ,     
  FOLDERr.YEAR          
  || '/'          
  || FOLDERr.SEQUENCE_NUMBER          
  || '/'          
  || FOLDER_TYPE.FOLDER_NAME          
  || '/'          
  || POLICE.ENTITY_NAME AS INVENTORY_NUMBER,          
  PAR_POLICE.PAR_YEAR          
  || '/'          
  || PAR_POLICE.POLICE_NUMBER          
  || '/'          
  || CAS_TYPE.NAME          
  || '/'          
  || POLICE.ENTITY_NAME AS BUSINESS_CASE_NUMBER,          
  PARTIES.FNAME          
  || ' '          
  || PARTIES.SNAME          
  || ' '          
  || PARTIES.TNAME          
  || ' '          
  || PARTIES.FOURTHNAME AS PARTY_NAME ,          
  DECISIONS.PENALTY_AMOUNT ,          
  proc.ADVANCE_PAYMENT_AMOUNT,          
  proc.CLAIM_FOLDER_ID,          
  proc.PROCEDURE_DATE ,          
  proc.NUMBER_PAID          
FROM   EXC_FOLDER_DATA FOLDERr,        
EXC_FOLDER_ACTIONS action ,          
  EXC_FOLDER_PROCEDURES PROC ,          
         
  COURT_BC_HEARING_RES_PARTIES RES_PART,          
  COURT_BC_HEARING_RESERVATION RES,          
  PAR_PARTIES PARTIES,          
  BUSINESS_CASE CAS,          
  PAR_POLICE_AUTHORITY_REPORT PAR_POLICE,          
  ENTITY POLICE,          
  BUSINESS_CASE_DEGREES DEGREES,          
  BUSINESS_CASE_TYPE CAS_TYPE,          
  EXC_LKP_FOLDER_TYPES FOLDER_TYPE ,          
  EXC_COURT_BC_CHARGES_PARTIES CH_PARTIES,          
  EXC_COURT_BC_CHARGE_DECISIONS DECISIONS          
WHERE    
action.ACTION_TYPE            IN (7,77)          
AND proc.FEES_TYPE_ID                = 3          
AND action.DELETED_FLAG              ='N'          
AND proc.id                          = action.PROCEDURE_ID          
AND FOLDERr.id                        = action.FOLDER_RECORD_ID          
AND FOLDERr.RES_PARTY_ID              = RES_PART.ID          
AND RES_PART.COURT_BC_HEARING_RES_ID = RES.ID          
AND RES_PART.PARTY_ID                = PARTIES.ID          
AND RES.BUSINESS_CASE_ID             = CAS.ID          
AND CAS.ID                           = PAR_POLICE.BUSINESS_CASE_ID          
AND PAR_POLICE.ORIGIN_ENTITY         = POLICE.ID          
AND RES_PART.BC_DEGREE_SPEC_ID       = DEGREES.ID          
AND CAS.CASE_TYPE                    = CAS_TYPE.ID          
AND FOLDER_TYPE.ID                   = FOLDERr.FOLDER_TYPE          
AND CH_PARTIES.RES_PARTY_ID          = FOLDERr.RES_PARTY_ID          
AND CH_PARTIES.CHARGE_DECISION_ID    = DECISIONS.ID          
AND DECISIONS.Stop_Execution_Flag    ='N'          
AND CH_PARTIES.deleted_flag          ='N'          
AND proc.CLAIM_FOLDER_ID            IS NOT NULL          
and 1=:pFLag          
ORDER BY proc.id DESC]]></SQLQuery>
