<!---->
<ViewObject
  xmlns="http://xmlns.oracle.com/bc4j"
  Name="KolReservation"
  Version="12.2.1.0.31"
  InheritPersonalization="merge"
  BindingStyle="OracleName"
  CustomQuery="true"
  ComponentClass="com.egabi.cjexec.model.baseclasses.GenericVOImpl"
  PageIterMode="Full">
  <DesignTime>
    <Attr Name="_isExpertMode" Value="true"/>
  </DesignTime>
  <Properties>
    <SchemaBasedProperties>
      <LABEL
        ResId="com.egabi.cjexec.model.roviews.bcdetails.KolReservation_LABEL"/>
    </SchemaBasedProperties>
  </Properties>
  <Variable
    Name="entityId"
    Kind="where"
    Type="java.math.BigDecimal">
    <TransientExpression
      Name="VariableScript"
      CodeSourceName="KolReservation"/>
    <Properties>
      <SchemaBasedProperties>
        <DISPLAYHINT
          Value="Hide"/>
      </SchemaBasedProperties>
    </Properties>
  </Variable>
  <SQLQuery><![CDATA[SELECT COU.ID,          
         TO_CHAR (COU.HEARING_DATE, 'yyyy-mm-dd') || ' ' || ENTS.ENTITY_NAME       
            HEARING_DATE          
    FROM COURT_CIRCLES_DATES_HEARING COU, ENTITY ENTS          
   WHERE     --COU.CAPACITY > 0  AND        
          COU.ENTITY_ID = ENTS.ID  
          AND COU.CIRCLES_ARCHIVE = 0 
         AND COU.ENTITY_ID IN          
                (SELECT CIR.DESTINATION_ENTITY_ID          
                   FROM ENTITY_CIRCLES CIR          
                  WHERE    ( CIR.SOURCE_ENTITY_ID = :entityId     or      
                  CIR.SOURCE_ENTITY_ID in (select id from entity where entity.PARENT_ENTITY_ID = :entityId  )      
                       
                  )     
                        AND CIR.JOIN_TYPE = '1')          
         AND COU.BC_DEGREE_ID in (3,4)]]></SQLQuery>
  <ViewAttribute
    Name="Id"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.math.BigDecimal"
    ColumnType="NUMBER"
    AliasName="ID"
    Expression="ID"
    SQLType="NUMERIC">
    <Properties>
      <SchemaBasedProperties>
        <DISPLAYHINT
          Value="Hide"/>
      </SchemaBasedProperties>
    </Properties>
  </ViewAttribute>
  <ViewAttribute
    Name="HearingDate"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Precision="307"
    Type="java.lang.String"
    ColumnType="VARCHAR2"
    AliasName="HEARING_DATE"
    Expression="HEARING_DATE"
    SQLType="VARCHAR">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="307"/>
    </DesignTime>
    <Properties>
      <SchemaBasedProperties>
        <DISPLAYWIDTH
          Value="70"/>
        <LABEL
          ResId="com.egabi.cjexec.model.roviews.bcdetails.KolReservation.HearingDate_LABEL"/>
      </SchemaBasedProperties>
    </Properties>
  </ViewAttribute>
  <AttrArray Name="KeyAttributes">
    <Item Value="Id"/>
  </AttrArray>
  <ResourceBundle>
    <PropertiesBundle
      PropertiesFile="com.egabi.cjexec.model.CjExecModelBundle"/>
  </ResourceBundle>
</ViewObject>
