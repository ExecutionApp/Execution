  </DesignTime>
  <Properties>
    <SchemaBasedProperties>
      <LABEL
        ResId="com.egabi.cjexec.model.roviews.bcdetails.GozReservation_LABEL"/>
    </SchemaBasedProperties>
  </Properties>
  <Variable
    Name="entityId"
    Kind="where"
    Type="java.math.BigDecimal">
    <TransientExpression
      Name="VariableScript"
      CodeSourceName="GozReservation"/>
    <Properties>
      <SchemaBasedProperties>
        <DISPLAYHINT
          Value="Hide"/>
      </SchemaBasedProperties>
    </Properties>
  </Variable>
  <SQLQuery><![CDATA[SELECT COU.ID , TO_CHAR(COU.HEARING_DATE , 'yyyy-mm-dd')  || ' '  || ENTS.ENTITY_NAME   HEARING_DATE                                          
FROM  COURT_CIRCLES_DATES_HEARING COU, ENTITY ENTS                                           
WHERE COU.CAPACITY > 0  AND                                          
 COU.ENTITY_ID = ENTS.ID                    
AND COU.ENTITY_ID IN (                                           
SELECT ENT.ID FROM ENTITY ENT WHERE ENT.PARENT_ENTITY_ID =(SELECT EN.COURT_ID FROM ENTITY EN WHERE EN.ID = (:entityId)))                                           
AND COU.BC_DEGREE_ID in (1,2)                      
     
ORDER BY COU.HEARING_DATE , COU.ENTITY_ID]]></SQLQuery>
