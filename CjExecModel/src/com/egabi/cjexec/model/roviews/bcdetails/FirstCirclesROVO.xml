  ComponentClass="com.egabi.cjexec.model.baseclasses.GenericVOImpl"
  PageIterMode="Full">
  <DesignTime>
    <Attr Name="_isExpertMode" Value="true"/>
  </DesignTime>
  <Properties>
    <SchemaBasedProperties>
      <LABEL
        ResId="com.egabi.cjexec.model.roviews.bcdetails.FirstCirclesROVO_LABEL"/>
    </SchemaBasedProperties>
  </Properties>
  <Variable
    Name="degreeIdBind"
    Kind="where"
    Type="java.math.BigDecimal"/>
  <Variable
    Name="entityId"
    Kind="where"
    Type="java.math.BigDecimal">
    <TransientExpression
      Name="VariableScript"
      trustMode="trusted"
      CodeSourceName="FirstCirclesROVO"/>
  </Variable>
  <SQLQuery><![CDATA[/* Formatted on 7/27/2021 1:20:45 PM (QP5 v5.269.14213.34769) */  
  SELECT COU.ID,  
         TO_CHAR (COU.HEARING_DATE, 'yyyy-mm-dd') || ' ' || ENTS.ENTITY_NAME  
            HEARING_DATE  
    FROM COURT_CIRCLES_DATES_HEARING COU, ENTITY ENTS  
   WHERE     COU.ENTITY_ID = ENTS.ID  
   AND COU.CIRCLES_ARCHIVE = 0
         AND COU.ENTITY_ID IN (SELECT ENT.ID  
                                 FROM ENTITY ENT  
                                WHERE ENT.PARENT_ENTITY_ID =  
                                         (SELECT EN.COURT_ID  
                                            FROM ENTITY EN  
                                           WHERE EN.ID = ( :entityId)))  
         AND COU.BC_DEGREE_ID = :degreeIdBind  
           
         AND COU.SOURCE IS NULL  
ORDER BY COU.HEARING_DATE desc, COU.ENTITY_ID]]></SQLQuery>
  <ViewAttribute
    Name="Id"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.math.BigDecimal"
