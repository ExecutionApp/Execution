       FTS.CATEGORY_ID,     
       FTS.COLLECTION_FLAG,     
       FTS.CAN_BE_SCHEDULED,   
       FTS.ID FEES_SETTING_ID   
  FROM EXC_LKP_FEES_TYPES FT, EXC_LKP_FEES_SETTINGS FTS     
 WHERE     FT.ID = FTS.FEES_TYPE     
       AND CATEGORY_ID = 3     
       AND SYSDATE BETWEEN START_DATE AND NVL (END_DATE, SYSDATE + 1)]]></SQLQuery>
