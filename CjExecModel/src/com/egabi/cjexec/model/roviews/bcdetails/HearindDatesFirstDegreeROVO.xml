--AND COU.HEARING_DATE > decode(:prevDate ,null, sysdate,TO_DATE ( :prevDate, 'yyyy-mm-dd') )            
AND COU.SOURCE is null   
ORDER BY COU.HEARING_DATE , COU.ENTITY_ID]]></SQLQuery>
