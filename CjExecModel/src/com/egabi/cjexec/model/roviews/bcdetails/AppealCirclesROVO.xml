  <SQLQuery><![CDATA[/* Formatted on 25/11/2020 06:44:24 ص (QP5 v5.287) */      
/* this query return date of estanaf or tajeel estenaf or moarda estanafia or tageel moarda estanafia or moarda estanafia be el tamkeen or tageel moarda estanafia be el tamkeen  */      
      
  SELECT COU.ID,      
         TO_CHAR (COU.HEARING_DATE, 'yyyy-mm-dd') || ' ' || ENTS.ENTITY_NAME      
            HEARING_DATE      
    FROM COURT_CIRCLES_DATES_HEARING COU, ENTITY ENTS      
   WHERE     COU.CAPACITY > 0   
   AND COU.CIRCLES_ARCHIVE = 0 
         AND COU.ENTITY_ID = ENTS.ID      
         AND COU.ENTITY_ID IN      
                (SELECT CIR.DESTINATION_ENTITY_ID      
                   FROM ENTITY_CIRCLES CIR      
                  WHERE     CIR.SOURCE_ENTITY_ID = :entityId      
                        AND CIR.JOIN_TYPE = '1')      
         AND COU.BC_DEGREE_ID =   :degreeIdBind   
                      
             
        -- AND COU.SOURCE IS NULL      
ORDER BY COU.HEARING_DATE desc, COU.ENTITY_ID]]></SQLQuery>
