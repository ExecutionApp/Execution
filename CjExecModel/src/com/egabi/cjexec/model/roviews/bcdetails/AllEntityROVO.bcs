//Groovy Scripts for com.egabi.cjexec.model.roviews.bcdetails.AllEntityROVO

package com.egabi.cjexec.model.roviews.bcdetails

import oracle.jbo.script.annotation.VariableExpression;

@VariableExpression(path="pParent")
def pParent_VariableScript_Variable()
{
adf.context.current.sessionScope.userInfo.parentEntityId
}


@VariableExpression(path="allParam")
def allParam_VariableScript_Variable()
{
adf.context.current.pageFlowScope.get('allLovParam')
}


@VariableExpression(path="entAppeal")
def entAppeal_VariableScript_Variable()
{
adf.context.current.sessionScope.userInfo.entityAppeal
}


@VariableExpression(path="pErrandEnt")
def pErrandEnt_VariableScript_Variable()
{
adf.context.current.sessionScope.userInfo.errandEntUser
}

