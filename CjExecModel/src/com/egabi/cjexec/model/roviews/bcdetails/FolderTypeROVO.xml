<ViewObject
  xmlns="http://xmlns.oracle.com/bc4j"
  Name="FolderTypeROVO"
  Version="12.2.1.0.31"
  InheritPersonalization="merge"
  BindingStyle="OracleName"
  CustomQuery="true"
  ComponentClass="com.egabi.cjexec.model.baseclasses.GenericVOImpl"
  PageIterMode="Full">
  <DesignTime>
    <Attr Name="_isExpertMode" Value="true"/>
  </DesignTime>
  <Properties>
    <SchemaBasedProperties>
      <LABEL
        ResId="com.egabi.cjexec.model.roviews.bcdetails.FolderTypeROVO_LABEL"/>
    </SchemaBasedProperties>
  </Properties>
  <SQLQuery><![CDATA[SELECT                 
    EXC_LKP_FOLDER_TYPES.ID ID,              
  --   DECODE ( SUBSTR (EXC_LKP_FOLDER_TYPES.ID, 1, 3),         
   --      '1', ' حبس منفذ',          
    --               '2', 'حبس  ',            
   --                '3', 'غرامة  '    ,      
  --                 '12' ,'دفتر مدعى بالحق المدنى'  ,    
  --                 7,' براءة',    
 --                  10,' التصالح',    
  --                 32,' وفاه',    
 --                  33,'إنقضاء بمضى المدة'    
  --                 ) as FOLDER_NAME  ,     
                   FOLDER_NAME ,   
    EXC_LKP_FOLDER_TYPES.FOLDER_CATEGORY FOLDER_CATEGORY                 
FROM                 
    EXC_LKP_FOLDER_TYPES                
    where EXC_LKP_FOLDER_TYPES.ID in --(1,2 , 3, 12,7,10,32,33)   
    (1,2 , 3, 12,7,10,32,33 , 36 ,34 ,9,23,31,39,40,41,43,26,23 ,45,46,47,48 , 49 ,27 ,42 )]]></SQLQuery>
  <ViewAttribute
    Name="Id"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.math.BigDecimal"
    ColumnType="NUMBER"
    AliasName="ID"
    Expression="ID"
    SQLType="NUMERIC"/>
  <ViewAttribute
    Name="FolderName"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Precision="128"
    Type="java.lang.String"
    ColumnType="VARCHAR2"
    AliasName="FOLDER_NAME"
    Expression="FOLDER_NAME"
    SQLType="VARCHAR">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="128"/>
    </DesignTime>
  </ViewAttribute>
  <ViewAttribute
    Name="FolderCategory"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.math.BigDecimal"
    ColumnType="NUMBER"
    AliasName="FOLDER_CATEGORY"
    Expression="FOLDER_CATEGORY"
    SQLType="NUMERIC"/>
  <AttrArray Name="KeyAttributes">
    <Item Value="Id"/>
  </AttrArray>
  <ResourceBundle>
    <PropertiesBundle
      PropertiesFile="com.egabi.cjexec.model.CjExecModelBundle"/>
  </ResourceBundle>
</ViewObject>
