  <SQLQuery><![CDATA[SELECT RP.ID,         
       RP.COURT_BC_HEARING_RES_ID,         
       PP.ID_NUMBER,         
       PP.FNAME || ' ' || PP.SNAME || ' ' || PP.TNAME || ' ' || PP.FOURTHNAME         
           FULL_NAME,         
       /*NVL2 (         
           PP.ID_NUMBER,         
              SUBSTR (PP.ID_NUMBER, 6, 2)         
           || '/'         
           || SUBSTR (PP.ID_NUMBER, 4, 2)         
           || '/'         
           || DECODE (SUBSTR (PP.ID_NUMBER, 1, 1),         
                      1, '18',         
                      2, '19',         
                      3, '20')         
           || SUBSTR (PP.ID_NUMBER, 2, 2),         
           NULL)         
           AGE*/         
       PP.AGE,         
       NVL2 (         
           PP.ID_NUMBER,         
           DECODE (MOD (SUBSTR (PP.ID_NUMBER, 13, 1), 2),         
                   0, 'انثى',         
                   1, 'ذكر'),         
           '')         
           GENDER,         
       PP.ADDRESS,         
       PP.JOB_TITLE,         
       RP.JUDGMENT_CLASSIFICATION,         
       'إدانة'         
           CONVICTED,         
       (SELECT NAME         
          FROM CJ_ATTENDEES         
         WHERE ID = RP.ATTENDANCE)         
           ATTENDANCE,         
       PP.ID         
           PARTY_ID,         
       (SELECT CIRCLE_HEARING_DATE_ID         
          FROM COURT_BC_HEARING_RESERVATION         
         WHERE ID = RP.COURT_BC_HEARING_RES_ID)         
           COURT_CIRCLE_DATE_ID,         
       RP.JUDGEMENT_RESOLUTION_C ,         
       ( SELECT  max (FOLDER_ACTION_ID)              
 FROM  EXC_FOLDER_ACTIONS_ATTACH at,         
         exc_folder_actions fa,         
         exc_folder_procedures pr,         
         court_bc_hearing_res_parties rp           
   WHERE              
              
             
                
                
         AT   .FOLDER_ACTION_ID = fa.id         
         AND pr.id = FA.PROCEDURE_ID         
         AND rp.id = PR.RES_PARTY_ID         
         AND RP.PARTY_ID = PP.ID) FOLDER_ACTION_ID ,RP.PARTY_ORDER         
  FROM COURT_BC_HEARING_RES_PARTIES RP, PAR_PARTIES PP         
 WHERE     RP.PARTY_ID = PP.ID         
       AND RP.PARTY_ID IN         
               (SELECT FCDP.PARTY_ID         
                  FROM FORM_CASE_DESCRIPTION_DES_PART  FCDDP,         
                       FORM_CASE_DESCRIPTION_DES       FCDD,         
                       FORM_CASE_DESCRIPTION_PARTIES   FCDP,         
                       FORM_CASE_DESCRIPTION           FCD         
                 WHERE     FCDDP.FORM_CASE_DES_ID = FCDD.ID         
                       AND FCDP.FORM_CASE_DESCRIPTION_ID = FCD.ID         
                       AND FCDD.FORM_CASE_DESCRIPTION_ID = FCD.ID         
                       AND FCDDP.FORM_CASE_PARTY_ID = FCDP.ID         
                       AND FCDP.PARTY_ID = RP.PARTY_ID         
                       AND FCDDP.JUDGMENT_CLASSIFICATION = 2)]]></SQLQuery>
