  <Variable
    Name="bindHearingResId"
    Kind="where"
    Type="java.lang.String"/>
  <SQLQuery><![CDATA[SELECT CBHR.ID  
           HEARING_RES_ID,  
          POLICE_NUMBER  
       || '  '  
       || (SELECT NAME  
             FROM BUSINESS_CASE_TYPE  
            WHERE ID = BC.BUSINESS_CASE_TYPE)  
       || '  '  
       || PAR_YEAR  
           AS CASE_NUMBER,  
       BC.BUSINESS_CASE_NAME,  
       HEARING_DATE,  
       (SELECT NAME  
          FROM BUSINESS_CASE_DEGREES  
         WHERE ID = CCDH.BC_DEGREE_ID)  
           CASE_DEGREE,  
       POLICE_NUMBER,  
       BC.BUSINESS_CASE_TYPE,  
       PAR_YEAR,  
       CCDH.ID  
           HEARING_DATE_ID,  
       CSJ.JUDGEMENT_RESOLUTION,  
       (SELECT NAME  
          FROM EXC_LKP_JUDGMENT_TYPES  
         WHERE ID = CSJ.JUDGMENT_TYPE)  
           JUDGMENT_TYPE,  
       CSJ.ID  
           SESSION_JUDGMENT_ID  
  FROM PAR_POLICE_AUTHORITY_REPORT    AR,  
       BUSINESS_CASE                  BC,  
       COURT_CIRCLES_DATES_HEARING    CCDH,  
       COURT_BC_HEARING_RESERVATION   CBHR,  
       EXC_COURT_BC_SESSION_JUDGMENT  CSJ  
 WHERE     AR.BUSINESS_CASE_ID = BC.ID  
       AND CBHR.BUSINESS_CASE_ID = AR.BUSINESS_CASE_ID  
       AND CBHR.CIRCLE_HEARING_DATE_ID = CCDH.ID  
       AND CSJ.COURT_BC_HEARING_RES_ID = CBHR.ID  
       AND CBHR.ID = :bindHearingResId]]></SQLQuery>
