    ColumnType="VARCHAR2"
    AliasName="PARTY_FULL_NAME"
    Expression="PARTY_FULL_NAME"
    SQLType="VARCHAR">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="400"/>
    </DesignTime>
    <Properties>
      <SchemaBasedProperties>
        <LABEL
          ResId="com.egabi.cjexec.model.roviews.caseexecemp.CaseConvictedPartiesROV.FullName_LABEL"/>
      </SchemaBasedProperties>
    </Properties>
  </ViewAttribute>
