<?xml version="1.0" encoding="windows-1256" ?>
<!DOCTYPE ViewObject SYSTEM "jbo_03_01.dtd">
<!---->
<ViewObject
  xmlns="http://xmlns.oracle.com/bc4j"
  Name="PenaltySharedPartiesROV"
  Version="12.2.1.0.31"
  InheritPersonalization="merge"
  BindingStyle="OracleName"
  CustomQuery="true"
  PageIterMode="Full">
  <DesignTime>
    <Attr Name="_isExpertMode" Value="true"/>
  </DesignTime>
  <Variable
    Name="bindHearingResId"
    Kind="where"
    Type="java.lang.String"/>
  <SQLQuery><![CDATA[SELECT RP.ID,      
       RP.COURT_BC_HEARING_RES_ID,             
       PP.FNAME || ' ' || PP.SNAME || ' ' || PP.TNAME || ' ' || PP.FOURTHNAME             
           FULL_NAME      
  FROM COURT_BC_HEARING_RES_PARTIES RP, PAR_PARTIES PP      
 WHERE RP.PARTY_ID = PP.ID AND RP.JUDGMENT_CLASSIFICATION = 2   
 AND RP.COURT_BC_HEARING_RES_ID = :bindHearingResId]]></SQLQuery>
  <ViewAttribute
    Name="Id"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.math.BigDecimal"
    ColumnType="NUMBER"
    AliasName="ID"
    Expression="ID"
    SQLType="NUMERIC"/>
  <ViewAttribute
    Name="CourtBcHearingResId"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.math.BigDecimal"
    ColumnType="NUMBER"
    AliasName="COURT_BC_HEARING_RES_ID"
    Expression="COURT_BC_HEARING_RES_ID"
    SQLType="NUMERIC"/>
  <ViewAttribute
    Name="FullName"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Precision="403"
    Type="java.lang.String"
    ColumnType="VARCHAR2"
    AliasName="FULL_NAME"
    Expression="FULL_NAME"
    SQLType="VARCHAR">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="403"/>
    </DesignTime>
  </ViewAttribute>
  <AttrArray Name="KeyAttributes">
    <Item Value="Id"/>
  </AttrArray>
</ViewObject>
