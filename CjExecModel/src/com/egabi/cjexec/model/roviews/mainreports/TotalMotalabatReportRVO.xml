  Version="12.2.1.0.31"
  InheritPersonalization="merge"
  BindingStyle="OracleName"
  CustomQuery="true"
  ComponentClass="com.egabi.cjexec.model.baseclasses.GenericVOImpl"
  PageIterMode="Full">
  <DesignTime>
    <Attr Name="_isExpertMode" Value="true"/>
  </DesignTime>
  <Properties>
    <SchemaBasedProperties>
      <LABEL
        ResId="com.egabi.cjexec.model.roviews.mainreports.TotalMotalabatReportRVO_LABEL"/>
    </SchemaBasedProperties>
  </Properties>
  <Variable
    Name="createdDateBind"
    Kind="where"
    Type="java.lang.String"/>
  <Variable
    Name="gozeyaIdBind"
    Kind="where"
    Type="java.lang.String"/>
  <Variable
    Name="createdDateToBind"
    Kind="where"
    Type="java.lang.String"/>
  <SQLQuery><![CDATA[SELECT GOZEYA.ENTITY_NAME GOZEYA_ENTITY_NAME , PAREN.ENTITY_NAME PARENT_ENTITY_NAME , USR.USERNAME USER_NAME , COUNT(CLAIM.ID) COUNT_MOTALABAT            
           
FROM EXC_CLAIMS CLAIM , ENTITY POLICE , ENTITY GOZEYA , ENTITY PAREN , SEC_USERS USR            
WHERE CLAIM.CLAIM_POLICE_STATION_ID = POLICE.ID            
AND CLAIM.CLAIM_PARTIAL_ID = GOZEYA.ID           
AND CLAIM.CLAIM_COLYA_ID = PAREN.ID            
AND USR.ID = CLAIM.CREATED_BY         
AND (CLAIM.CLAIM_POLICE_STATION_ID = :gozeyaIdBind OR CLAIM.CLAIM_PARTIAL_ID = :gozeyaIdBind OR CLAIM.CLAIM_COLYA_ID = :gozeyaIdBind)        
AND (  CLAIM.CREATED_DATE BETWEEN TO_DATE(:createdDateBind , 'dd/mm/yyyy')            
                                                                       AND TO_DATE(:createdDateToBind , 'dd/mm/yyyy')            
                       OR to_char(CLAIM.CREATED_DATE, 'dd/mm/yyyy') =:createdDateBind)      
GROUP BY GOZEYA.ENTITY_NAME , PAREN.ENTITY_NAME , USR.USERNAME]]></SQLQuery>
