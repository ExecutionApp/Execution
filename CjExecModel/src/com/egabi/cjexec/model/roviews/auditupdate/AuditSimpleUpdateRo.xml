  <SQLQuery><![CDATA[/* Formatted on 5/2/2020 3:53:28 PM (QP5 v5.269.14213.34769) */                           
SELECT AUD.ID,                           
       AUD.TYPE,                           
       AUD.CREATED_BY,                           
       AUD.CREATION_DATE,                           
       AUD.EDITED_ATTRIBUTE,                           
       AUD.OLD_VALUE,                           
       AUD.NEW_VALUE,                           
       AUD.BUSINESS_CASE_ID,                           
       AUD.TECHNICAL_NAME,                           
       AUD.ENTITY_ID,                           
       ENTITY.ENTITY_NAME,                           
       AUD.USER_ID,                           
       AUD.TABLE_ID,                           
       PAR.PARTY_FULL_NAME,                           
       EFD.SEQUENCE_NUMBER,                           
       EFD.YEAR,                           
       EFD.REPEATED_FLAG,                           
       LFT.FOLDER_NAME                           
  FROM Audit_simple AUD,                           
       ENTITY,                           
       PAR_PARTIES PAR,                           
       EXC_FOLDER_DATA EFD,                           
       EXC_LKP_FOLDER_TYPES LFT                           
 WHERE     AUD.TECHNICAL_NAME <> 'UPDATED_BY'                           
       AND AUD.TECHNICAL_NAME <> 'UPDATED_DATE'                           
       AND AUD.TECHNICAL_NAME <> 'UPATED_BY'                           
       AND AUD.TECHNICAL_NAME <> 'UPATED_DATE'                       
       AND AUD.TECHNICAL_NAME <> 'UPDATE_BY'                         
       AND AUD.TECHNICAL_NAME <> 'BC_DEGREE_SPEC_ID'                      
       AND AUD.TECHNICAL_NAME <> 'POLICE_STATION_ENTITY_ID'                     
       AND AUD.TECHNICAL_NAME <> 'TRANS_FOLDER_ID'                  
       AND AUD.TECHNICAL_NAME <> 'DDOCNAME'                  
       AND AUD.TECHNICAL_NAME <> 'BUSINESSCASEID'            
       AND AUD.TECHNICAL_NAME <> 'USERID'            
       AND AUD.TECHNICAL_NAME <> 'CREATED_BY'          
       AND AUD.TECHNICAL_NAME <> 'CREATED_DATE'         
       AND AUD.TECHNICAL_NAME <> 'ENTITYID'    
       AND AUD.TECHNICAL_NAME <> 'ID'   
       AND AUD.ENTITY_ID = ENTITY.ID                           
       AND AUD.TABLE_ID = PAR.ID(+)                           
       AND AUD.FOLDER_DATA_ID = EFD.ID(+)                           
       AND EFD.FOLDER_TYPE = LFT.ID(+)]]></SQLQuery>
