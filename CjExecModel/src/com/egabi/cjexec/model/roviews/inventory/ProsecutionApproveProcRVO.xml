  <SQLQuery><![CDATA[SELECT                                                                                                                                            
ROW_NUMBER () OVER (PARTITION BY PARTY_ID ORDER BY PARTY_ID,HEARING_DATE DESC )ORDER_RAWS ,  1 as FLG_TYPE  ,                                                                                                                                       
FOLDER.YEAR || '/' || FOLDER.SEQUENCE_NUMBER  || '/' || FOLDER_TYPE.FOLDER_NAME || '/' || POLICE.ENTITY_NAME || '/' || DECODE(FOLDER.REPEATED_FLAG , 'N' , '' , 'Y' , 'مكرر') AS INVENTORY_NUMBER ,                                                                                                                 
PARTIES.FNAME || ' ' || PARTIES.SNAME || ' ' || PARTIES.TNAME || ' ' || PARTIES.FOURTHNAME AS PARTY_NAME , PARTIES.ID_NUMBER ,      nvl(PARTIES.UPDATE_TYPE ,'N')  as UPDATE_TYPE     ,       PARTIES.UNKNOWN_ID,                                                                                                                                                                                
PAR_POLICE.PAR_YEAR || '/' || PAR_POLICE.POLICE_NUMBER || '/' || CAS_TYPE.NAME|| '/' || POLICE.ENTITY_NAME AS BUSINESS_CASE_NUMBER ,                                                                                                                          
POLICE.ENTITY_NAME ,                                                                                                                                                                                          
TO_CHAR(DATES.HEARING_DATE , 'yyyy-mm-dd') HEARING_DATE ,                                                                                                                                                                                          
FOLDER.SEQUENCE_NUMBER ,                                                                                                                                         
FOLDER_TYPE.FOLDER_NAME Folder_Name,                                                                                                                                                                                          
FOLDER.POLICE_STATION_ENTITY_ID ,                                                                                                                                                                                           
FOLDER.YEAR ,                                                                                                                                                                                           
FOLDER.FOLDER_TYPE ,                                                                                                                                                                                         
FOLDER.REPEATED_FLAG ,                                                                                                                                                                                       
FOLDER.ID AS FOLDER_ID  ,                                                                                                                                                                                   
RES_PART.PARTY_ID ,                                                                                                                                                                                 
FOLDER.RES_PARTY_ID ,                                                                                                                                                                               
CAS.CASE_NUMBER ,                                                                                                                                                                                
PAR_POLICE.PAR_YEAR CASE_YEAR ,                                                                                                                                                                                
decode(JUD_TYP.id,3 ,'نيابة عامة',DEGREES.NAME) DEGREE_NAME ,                                                                                                                                     
RES_PART.BC_DEGREE_SPEC_ID DEGREE_ID ,                                                                                                                                                                              
CAS_TYPE.ID CAS_TYPE_ID ,                   
(select nvl(ENTITY_DEGREE , 0) from ENTITY where id = cas.entity_id) as ENT_DEG ,                  
CAS_TYPE.NAME CAS_TYPE_NAME ,                                                                                                                                                   
POLICE.PARENT_ENTITY_ID ,                                                                                                                                              
CAS.ID AS BUSINESS_CASE_ID ,                                                                                                                                             
PARTIES.NICKNAME ,                                                                                                                                          
RES_PART.ATTENDANCE  ,(SELECT                                                                                                                                         
   ID                                                                                                                                           
FROM EXC_COURT_BC_SESSION_JUDGMENT  where COURT_BC_HEARING_RES_ID = RES.ID ) session_Id ,                                                                                                                                
DECODE(RES_PART.ATTENDANCE , '4' , 'ح ت', '1' , 'ح' , '2' , 'ح أ' , '3' , 'غ','5','غ ق') AS ATTENDANCE_NAME ,                                                                                                                             
PAR_POLICE.ORIGIN_ENTITY ,                                                                                                                   
FOLDER.NOTES ,                                                                                                                   
FOLDER.JUDGMENT_TEXT ,                                                                                                           
JUD_TYP.NAME JUDGEMENT_TYPE_NAME ,                                                                                                           
SESS.JUDGMENT_TYPE ,                                                                                                         
FOLDER.IS_ACTIVE ,                                                                                                       
DATES.ID HEARING_DATE_ID   ,                                                                                                   
PARTIES.ID_TYPE  ,                                                                                                 
RES.ID RESERVATION_ID,                                                                                             
RES.PROSECUTION_JUDEGEMENT_FLAG ,                                                                                           
FOLDER.EXECUTION_FLAG,                                                                                       
FOLDER.CLAIM_ISSUE_FLAG  ,                                                                                     
CAS.JOURNALIST_FLAG,                                                                                     
FOLDER.CRIMINAL_TYPE ,                                                                                    
PAR_POLICE.id POLICE_ID ,                                                                                  
RES_PART.AMOUNT,                                                                                  
RES_PART.GUARANTEE, RES_PART.GUARANTEE_DATE, RES_PART.GUARANTEE_NUMBER, RES_PART.GURANTEE_AMOUNT,RES_PART.IN_PRISON_DAYS, RES_PART.IN_PRISON_MONTHS, RES_PART.IN_PRISON_YEARS,RES_PART.DAILY_PAYMENTS,RES_PART.PROSECUTION_OBJECTION,FOLDER.OBJECTION_TYPE ,                                        
FOLDER.GUILTLESSNESS_FLAG                                        
FROM EXC_FOLDER_DATA FOLDER , COURT_BC_HEARING_RES_PARTIES RES_PART , COURT_BC_HEARING_RESERVATION RES , PAR_PARTIES PARTIES , BUSINESS_CASE CAS ,                                                                                                                                                                                          
    PAR_POLICE_AUTHORITY_REPORT PAR_POLICE , ENTITY POLICE , COURT_CIRCLES_DATES_HEARING DATES , BUSINESS_CASE_DEGREES DEGREES , BUSINESS_CASE_TYPE CAS_TYPE ,                                                                                                                                                               
    EXC_LKP_FOLDER_TYPES FOLDER_TYPE , EXC_COURT_BC_SESSION_JUDGMENT SESS , EXC_LKP_JUDGMENT_TYPES JUD_TYP                                                                                                                                                                                          
WHERE FOLDER.RES_PARTY_ID = RES_PART.ID                                                                                                                                                                                          
AND RES_PART.COURT_BC_HEARING_RES_ID = RES.ID                                                                                                                                                                                          
AND RES_PART.PARTY_ID = PARTIES.ID                                                                                                                                                                                          
AND RES.BUSINESS_CASE_ID = CAS.ID                                                                                                                                                                                          
AND CAS.ID = PAR_POLICE.BUSINESS_CASE_ID                                                                                                                                                                                          
AND PAR_POLICE.ORIGIN_ENTITY = POLICE.ID                                                                                                                                                                                          
AND DATES.ID (+)= RES.CIRCLE_HEARING_DATE_ID                                                                                                                                                                              
AND RES_PART.BC_DEGREE_SPEC_ID = DEGREES.ID                                                                                                                                                                                   
AND CAS.CASE_TYPE = CAS_TYPE.ID                                                                                                                                                                 
AND FOLDER_TYPE.ID = FOLDER.FOLDER_TYPE                                                                                                                
AND RES.ID = SESS.COURT_BC_HEARING_RES_ID                                                                                                                        
AND SESS.JUDGMENT_TYPE = JUD_TYP.ID                                                                                                               
AND FOLDER.JUDGEMENT_STATUS in (2,5)                                                                       
AND FOLDER_TYPE.ID != 8                     
and FOLDER.FOLDER_TYPE != 35                   
AND EDIT_PROC is null              
and FOLDER.is_active in ( 'P'   ,'E'  )     
-- and (cas.entity_id = :pent  or cas.entity_id in (select id from entity where PARENT_ENTITY_ID = :pent) )     
and :pent = :pent   
AND CAS.ID  = :bcidp      
   
 AND ( 1=1 or CASE_NUMBER = :pCaseNumber  )                       
 AND (  1=1 or CAS_TYPE.ID = :pCaseType   )                          
 AND ( 1=1 or    PAR_POLICE.PAR_YEAR =   :pCaseYear   )                       
 AND (  1=1 or Origin_Entity = :pCaseOrigin  )   
  and rownum < 5]]></SQLQuery>
