  <SQLQuery><![CDATA[SELECT DISTINCT FOLDER.SEQUENCE_NUMBER || '/' || FOLDER.YEAR || '/' || FOLDER.FOLDER_TYPE || '/' || FOLDER.PRIMARY_PROSECUTION || '/' ||                                                  
    FOLDER.POLICE_STATION_ENTITY_ID AS INVENTORY_NUMBER ,                                                 
PARTIES.FNAME || ' ' || PARTIES.SNAME || ' ' || PARTIES.TNAME || ' ' || PARTIES.FOURTHNAME AS PARTY_NAME , PARTIES.ID_NUMBER ,                                                 
PAR_POLICE.POLICE_NUMBER || '/' || PAR_POLICE.ENTITY_ID || '/' || PAR_POLICE.PAR_YEAR AS BUSINESS_CASE_NUMBER ,    
CAS.CASE_NUMBER || '/' || PAR_POLICE.PAR_YEAR || '/' || CAS_TYPE.NAME || '/' || POLICE.ENTITY_NAME AS BUSINESS_CASE_NUMBER_FULL,    
POLICE.ENTITY_NAME ,                                                 
TO_CHAR(DATES.HEARING_DATE , 'yyyy-mm-dd') HEARING_DATE ,               
FOLDER.SEQUENCE_NUMBER ,                                                  
FOLDER.POLICE_STATION_ENTITY_ID ,                                                  
FOLDER.YEAR ,                                                  
FOLDER.FOLDER_TYPE ,                                                  
POLICE.PARENT_ENTITY_ID ,          
(select en.parent_entity_id from ENTITY en where en.id = POLICE.PARENT_ENTITY_ID) kolya_entity_id,        
(SELECT en.ENTITY_NAME FROM ENTITY en WHERE en.id = POLICE.ID) police_name,                  
(SELECT en.ENTITY_NAME FROM ENTITY en WHERE en.id = POLICE.PARENT_ENTITY_ID) partial_name,        
FOLDER.REPEATED_FLAG ,                                              
FOLDER.ID AS FOLDER_ID  ,                                          
RES_PART.PARTY_ID ,                                        
FOLDER.RES_PARTY_ID ,                                      
CAS.CASE_NUMBER ,                                       
PAR_POLICE.PAR_YEAR CASE_YEAR ,                                       
DEGREES.NAME DEGREE_NAME ,                                      
DEGREES.ID DEGREE_ID ,                                      
POLICE.ID POLICE_ID  ,                                           
CAS_TYPE.ID CAS_TYPE_ID ,                                   
CAS_TYPE.NAME CAS_TYPE_NAME ,                   
CAS.ID AS BUSINESS_CASE_ID ,                  
PARTIES.NICKNAME,            
Daily_PER_PARTY(FOLDER.RES_PARTY_ID) Daily_PER_PARTY,            
PENALTY_PER_PARTY(FOLDER.RES_PARTY_ID) PENALTY_PER_PARTY,  
TO_CHAR(DECISIONS.PENALTY_DUE_DATE, 'yyyy-mm-dd') PENALTY_DUE_DATE,             
DECODE (FOLDER.FOLDER_TYPE,  2, 'حبس',  3, 'غرامة') Folder_Name,      
FOLDER.SEQUENCE_NUMBER || '/' || FOLDER.YEAR || '/' || DECODE (FOLDER.FOLDER_TYPE,  2, 'حبس',  3, 'غرامة')|| '/' || POLICE.ENTITY_NAME AS SEQ_NUMBER_FULL, NULL AS ID                                   
FROM EXC_FOLDER_DATA FOLDER , COURT_BC_HEARING_RES_PARTIES RES_PART , COURT_BC_HEARING_RESERVATION RES , PAR_PARTIES PARTIES , BUSINESS_CASE CAS ,                                                 
    PAR_POLICE_AUTHORITY_REPORT PAR_POLICE , ENTITY POLICE , COURT_CIRCLES_DATES_HEARING DATES , BUSINESS_CASE_DEGREES DEGREES , BUSINESS_CASE_TYPE CAS_TYPE  
    , EXC_COURT_BC_CHARGES_PARTIES CH_PARTIES, EXC_COURT_BC_CHARGE_DECISIONS DECISIONS  
WHERE FOLDER.RES_PARTY_ID = RES_PART.ID                                                 
AND RES_PART.COURT_BC_HEARING_RES_ID = RES.ID                                                 
AND RES_PART.PARTY_ID = PARTIES.ID                                                 
AND RES.BUSINESS_CASE_ID = CAS.ID                                                 
AND CAS.ID = PAR_POLICE.BUSINESS_CASE_ID                                                 
AND PAR_POLICE.ORIGIN_ENTITY = POLICE.ID                                                 
AND DATES.ID = RES.CIRCLE_HEARING_DATE_ID                                     
AND DATES.BC_DEGREE_ID = DEGREES.ID                                         
AND CAS.CASE_TYPE = CAS_TYPE.ID                                   
AND FOLDER.JUDGEMENT_STATUS = 2           
and res_part.attendance != 3  
AND (Daily_PER_PARTY(FOLDER.RES_PARTY_ID) != 0 OR Daily_PER_PARTY(FOLDER.RES_PARTY_ID) != null OR PENALTY_PER_PARTY(FOLDER.RES_PARTY_ID) != 0  
      OR PENALTY_PER_PARTY(FOLDER.RES_PARTY_ID) != null)  
AND CH_PARTIES.CHARGE_DECISION_ID = DECISIONS.ID   
AND CH_PARTIES.RES_PARTY_ID = FOLDER.RES_PARTY_ID]]></SQLQuery>
