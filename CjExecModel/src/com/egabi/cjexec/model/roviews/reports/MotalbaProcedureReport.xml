  <SQLQuery><![CDATA[select proc.id, claim.PARTY_NAME , claim.CLAIM_NUMBER ||' - '||   years.CLAIM_YEAR || ' - '|| folders.name ||' - '|| (select entity_name from entity where entity.id = claim.CLAIM_POLICE_STATION_ID ) as claim_number                 
, claim.CLAIM_TOTAL_ORIGINAL , claim.claim_total , claim.fixed_penalty_amount, proc.PROCEDURE_AMOUNT,proc.PROCEDURE_TYPE_ID,type.NAME , proc.PROCEDURE_DATE                   
from exc_claims claim                  
inner join EXC_PROCEDURE_CLAIM proc on proc.claim_id = claim.id                 
inner join EXC_CLAIM_years years on claim.claim_year = years.id                 
inner join EXC_lkp_CLAIM_folders folders on claim.claim_folder_id = folders.id                  
inner join EXC_LKP_CLAIM_PROCEDURE_TYPES type  on proc.PROCEDURE_TYPE_ID = type.ID                 
                 
WHERE                                                                       
 ( :YEAR  =0 or years.ID = :YEAR   )                        
and claim.criminal_type =  :folderCriminalType                       
AND claim.CLAIM_POLICE_STATION_ID =:Nyabaa                                                      
and (:ClaimFolderType  = 0 or claim.CLAIM_FOLDER_ID = :ClaimFolderType )                                           
and claim.DELETED_FLAG = 'N'                                             
AND (:DATE_FROM is null or proc.PROCEDURE_DATE BETWEEN TO_DATE(:DATE_FROM, 'dd/mm/yyyy')                                                                                     
  AND TO_DATE(:DATE_TO , 'dd/mm/yyyy')+1    )                        
                       
  and ( :END_NUM is null or ( to_number(claim.CLAIM_NUMBER ) >= :START_NUM  and to_number(claim.CLAIM_NUMBER ) <= :END_NUM))                     
   and ( :procType =0 or proc.PROCEDURE_TYPE_ID =  :procType             
   )             
order by  proc.PROCEDURE_DATE desc]]></SQLQuery>
