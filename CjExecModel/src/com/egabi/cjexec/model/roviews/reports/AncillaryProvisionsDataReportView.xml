  <SQLQuery><![CDATA[
   SELECT  distinct
        null PROC_NUMBER,
         DECODE (             
            FOLDER.SEQUENCE_NUMBER,             
            NULL, '',             
            (  FOLDER.YEAR             
             || '/'             
             || FOLDER.SEQUENCE_NUMBER             
             || '/'             
             || FOLDER_TYPES.FOLDER_NAME             
             || '/'             
             || ENTS.ENTITY_NAME))             
            AS INVENTORY_NUMBER,             
            PAR_POLICE.PAR_YEAR             
         || '/'             
         || PAR_POLICE.POLICE_NUMBER             
         || '/'             
         || CAS_TYPE.NAME             
         || '/'             
         || ENTS.ENTITY_NAME             
            AS BUSINESS_CASE_NUMBER,           
            null PROCEDURE_DATE,             
          null PROCEDURE_TYPE,             
         null HEARING_DATE,
         PARTIES.PARTY_FULL_NAME PARTY_FULL_NAME,             
         --ACTION_TYPES.NAME ACTS_TYPES_NAME,             
         null ACTS_TYPES_NAME,
         PAR_POLICE.PAR_YEAR,             
         FOLDER.POLICE_STATION_ENTITY_ID,             
         ENTS.PARENT_ENTITY_ID ENT_ID,            
            null DATE_ENT_RESERVATION,   
            FOLDER.CREATED_BY  , 
             DEP_ORD.DEPENDENT_ORDER_TYPE, 
            (select NAME from EXC_LKP_DEPENDENT_ORDERS_TYPES where id=DEP_ORD.DEPENDENT_ORDER_TYPE) EXC_LKP_DEPENDENT_ORDERS_name
            ,FOLDER.CRIMINAL_TYPE 
    FROM EXC_FOLDER_DATA FOLDER,              
         COURT_BC_HEARING_RES_PARTIES RES_PART,              
         COURT_BC_HEARING_RESERVATION RES,              
         EXC_LKP_FOLDER_TYPES FOLDER_TYPES,              
              
         ENTITY ENTS,              
                 
         EXC_LKP_FEES_TYPES FEES_TYPES,              
         PAR_PARTIES PARTIES,              
         BUSINESS_CASE CAS,              
         PAR_POLICE_AUTHORITY_REPORT PAR_POLICE,              
        
         BUSINESS_CASE_TYPE CAS_TYPE  , 
          EXC_COURT_BC_CHRG_DEC_DEP_ORD DEP_ORD 
   WHERE     FOLDER.FOLDER_TYPE = FOLDER_TYPES.ID              
             
         AND RES_PART.ID = FOLDER.RES_PARTY_ID              
         AND RES_PART.COURT_BC_HEARING_RES_ID = RES.ID              
         AND PARTIES.ID = RES_PART.PARTY_ID              
         AND RES.BUSINESS_CASE_ID = CAS.ID              
         AND CAS.ID = PAR_POLICE.BUSINESS_CASE_ID              
         AND PAR_POLICE.ORIGIN_ENTITY = ents.ID                        
         AND CAS_TYPE.ID = CAS.CASE_TYPE    
          and FOLDER.id=DEP_ORD.FOLDER_ID 
        AND DEP_ORD.YEAR = :YEAR         
      /* AND (:P_policeId is null or  DEP_ORD.ENTITY_ID=:P_policeId) */
        AND (:P_CRIMINAL_TYPE is null or FOLDER.CRIMINAL_TYPE=:P_CRIMINAL_TYPE)
       and (:PROCEDURE_TYPE is null or DEP_ORD.DEPENDENT_ORDER_TYPE=:PROCEDURE_TYPE) 
        /*and (:Nyabaa is null or  DEP_ORD.ENTITY_ID=:Nyabaa) */
       and  DEP_ORD.ENTITY_ID=(case when :P_policeId is not  null then :P_policeId else :Nyabaa end)
       and (1=1 or :DATE_FROM =:DATE_TO)
   
]]></SQLQuery>
