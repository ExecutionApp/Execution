<ViewObject
  xmlns="http://xmlns.oracle.com/bc4j"
  Name="WebCamAttatchROV"
  Version="12.2.1.1.10"
  InheritPersonalization="merge"
  BindingStyle="OracleName"
  CustomQuery="true"
  PageIterMode="Full"
  ComponentClass="com.egabi.cjexec.model.baseclasses.GenericVOImpl">
  <DesignTime>
    <Attr Name="_isExpertMode" Value="true"/>
  </DesignTime>
  <Properties>
    <SchemaBasedProperties>
      <LABEL
        ResId="com.egabi.cjexec.model.roviews.attatchUCMWebCam.WebCamAttatchROV_LABEL"/>
    </SchemaBasedProperties>
  </Properties>
  <Variable
    Name="pPart"
    Kind="where"
    Type="java.lang.String"/>
  <SQLQuery><![CDATA[/* Formatted on 11/26/2019 6:03:18 PM (QP5 v5.139.911.3011) */         
  SELECT nvl ( MAX (document_id) , 0 )  as document_id  , PARTY_ID        
 FROM  EXC_FOLDER_ACTIONS_ATTACH at,   
         exc_folder_actions fa,   
         exc_folder_procedures pr,   
         court_bc_hearing_res_parties rp     
   WHERE        
        
       
          
          
         AT   .FOLDER_ACTION_ID = fa.id   
         AND pr.id = FA.PROCEDURE_ID   
         AND rp.id = PR.RES_PARTY_ID   
         AND RP.PARTY_ID = :pPart    
         AND attachment_type = 8   
GROUP BY PARTY_ID]]></SQLQuery>
  <ViewAttribute
    Name="DocumentId"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.math.BigDecimal"
    ColumnType="NUMBER"
    AliasName="DOCUMENT_ID"
    Expression="DOCUMENT_ID"
    SQLType="NUMERIC"/>
  <ViewAttribute
    Name="PartyId"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.math.BigDecimal"
    ColumnType="NUMBER"
    AliasName="PARTY_ID"
    Expression="PARTY_ID"
    SQLType="NUMERIC"/>
  <ResourceBundle>
    <PropertiesBundle
      PropertiesFile="com.egabi.cjexec.model.CjExecModelBundle"/>
  </ResourceBundle>
