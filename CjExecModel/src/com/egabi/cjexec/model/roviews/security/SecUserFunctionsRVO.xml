<?xml version="1.0" encoding="windows-1252" ?>
<!DOCTYPE ViewObject SYSTEM "jbo_03_01.dtd">
<!---->
<ViewObject
  xmlns="http://xmlns.oracle.com/bc4j"
  Name="SecUserFunctionsRVO"
    Version="12.2.1.0.31"
  InheritPersonalization="merge"
  BindingStyle="OracleName"
  CustomQuery="true"
  ComponentClass="com.egabi.cjexec.model.baseclasses.GenericVOImpl"
  PageIterMode="Full">
    <DesignTime>
        <Attr Name="_isExpertMode" Value="true"/>
    </DesignTime>
    <Properties>
        <SchemaBasedProperties>
            <LABEL
              ResId="com.egabi.cjexec.model.roviews.security.SecUserFunctionsRVO_LABEL"/>
        </SchemaBasedProperties>
    </Properties>
    <Variable
        Name="userIdParam"
      Kind="where"
      Type="java.lang.String"/>
    <Variable
        Name="roleIdParam"
        Kind="where"
        Type="java.lang.String"/>
    <SQLQuery><![CDATA[SELECT Function_Id,URL  
  FROM sec_functions   
 WHERE    function_id IN (SELECT function_id   
                            FROM sec_role_functions   
                           WHERE role_id = :roleIdParam)   
       OR     function_id IN (SELECT FUNCTION_ID   
                                FROM SEC_USER_FUNCTIONS   
                               WHERE user_id = :userIdParam)   
          AND FUNCTION_ID NOT IN (SELECT FUNCTION_ID   
                                    FROM SEC_USER_FUNCTION_EXCLUDE   
                                   WHERE user_id = :userIdParam)]]></SQLQuery>
    <ViewAttribute
        Name="FunctionId"
        IsUpdateable="false"
        IsPersistent="false"
        PrecisionRule="true"
        Type="java.math.BigDecimal"
        ColumnType="NUMBER"
        AliasName="FUNCTION_ID"
        Expression="FUNCTION_ID"
        SQLType="NUMERIC"/>
    <!-- SELECT FUNCTION_ID , USER_ID  
FROM SEC_USER_FUNCTIONS   
WHERE USER_ID = :uderIdBind -->
    <ViewAttribute
        Name="Url"
        IsUpdateable="false"
        IsPersistent="false"
        PrecisionRule="true"
        Precision="300"
        Type="java.lang.String"
        ColumnType="VARCHAR2"
        AliasName="URL"
        Expression="URL"
        SQLType="VARCHAR">
        <DesignTime>
            <Attr Name="_DisplaySize" Value="300"/>
        </DesignTime>
    </ViewAttribute>
    <ResourceBundle>
        <PropertiesBundle
          PropertiesFile="com.egabi.cjexec.model.CjExecModelBundle"/>
    </ResourceBundle>
</ViewObject>
