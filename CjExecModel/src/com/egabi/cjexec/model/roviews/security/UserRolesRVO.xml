FROM SEC_ROLE_FUNCTIONS RF , SEC_ROLE ROL , SEC_USERS USR     
WHERE RF.ROLE_ID = ROL.ID     
AND USR.ROLE_ID = ROL.ID     
AND RF.ROLE_ID = :roleIdBind    
AND USR.ID = :userIdBind]]></SQLQuery>
