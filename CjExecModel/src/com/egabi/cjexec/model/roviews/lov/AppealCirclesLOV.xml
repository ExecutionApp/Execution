  <SQLQuery><![CDATA[WITH rule_entities AS (         
    SELECT to_char(:entId )   entity_id, to_char(:ruleId)    rule_id FROM dual         
    UNION ALL         
    SELECT to_char(:entId1),  to_char(:ruleId1)  FROM dual         
    UNION ALL         
    SELECT to_char(:entId2),  to_char(:ruleId2)  FROM dual         
    UNION ALL         
    SELECT to_char(:entId3),  to_char(:ruleId3)  FROM dual         
    UNION ALL         
    SELECT to_char(:entId4),  to_char(:ruleId4)  FROM dual         
    UNION ALL         
    SELECT to_char(:entId5),  to_char(:ruleId5)  FROM dual         
    UNION ALL         
    SELECT to_char(:entId6),  to_char(:ruleId6)  FROM dual         
    UNION ALL         
    SELECT to_char(:entId7),  to_char(:ruleId7)  FROM dual         
    UNION ALL         
    SELECT to_char(:entId8),  to_char(:ruleId8)  FROM dual         
    UNION ALL         
    SELECT to_char(:entId9),  to_char(:ruleId9)  FROM dual         
    UNION ALL         
    SELECT to_char(:entId10), to_char(:ruleId10) FROM dual         
    UNION ALL         
    SELECT to_char(:entId11), to_char(:ruleId11) FROM dual         
    UNION ALL         
    SELECT to_char(:entId12), to_char(:ruleId12) FROM dual         
    UNION ALL         
    SELECT to_char(:entId13), to_char(:ruleId13) FROM dual         
    UNION ALL         
    SELECT to_char(:entId14), to_char(:ruleId14) FROM dual         
    UNION ALL         
    SELECT to_char(:entId15), to_char(:ruleId15) FROM dual         
    UNION ALL         
    SELECT to_char(:entId16), to_char(:ruleId16) FROM dual         
    UNION ALL         
    SELECT to_char(:entId17), to_char(:ruleId17) FROM dual         
    UNION ALL         
    SELECT to_char(:entId18), to_char(:ruleId18) FROM dual         
    UNION ALL         
    SELECT to_char(:entId19), to_char(:ruleId19) FROM dual         
)   
  
 ( SELECT COU.ID,                              
         TO_CHAR (COU.HEARING_DATE, 'yyyy-mm-dd') || ' ' || ENTS.ENTITY_NAME                              
            HEARING_DATE                              
    FROM COURT_CIRCLES_DATES_HEARING COU, ENTITY ENTS                              
WHERE (:delay = 'Y' or COU.CAPACITY > 0  )                    
   and COU.CIRCLES_ARCHIVE = 0                  
         AND COU.ENTITY_ID = ENTS.ID                              
         AND COU.ENTITY_ID IN                              
                (SELECT CIR.DESTINATION_ENTITY_ID                              
                   FROM ENTITY_CIRCLES CIR                              
                  WHERE     CIR.SOURCE_ENTITY_ID = :entityId                              
                        AND CIR.JOIN_TYPE = '1')                              
       --  AND COU.BC_DEGREE_ID =                              
         --       CASE                              
          --         WHEN     :degreeIdBind IS NOT NULL                              
          --              AND (   :degreeIdBind IN (1, 14, 19)                              
           --                  OR (    :degreeIdBind = 24                              
               --                  AND ( :prevDegree = 1 OR :prevDegree = 14)))                              
          --         THEN                              
             --         DECODE ( :degreeIdBind,  1, 3,  14, 3,  24, 3,  19, 3)                              
            --       ELSE                              
            --          CASE                              
                --         WHEN     :degreeIdBind IS NOT NULL                              
                      --        AND (   :degreeIdBind IN (9, 23, 19)                              
                         --          OR (    :degreeIdBind = 24                              
                                  --     AND (   :prevDegree = 9                              
                                 --           OR :prevDegree = 23)))                              
                    --     THEN                              
                     --       DECODE ( :degreeIdBind,                              
                      --              24, 4,                              
                      --              9, 4,                              
                     --               23, 4,                              
                    --                19, 4)                              
                     --    WHEN     :degreeIdBind IS NOT NULL                              
                        --      AND (   :degreeIdBind IN (2, 8)                              
                         --          OR (    :degreeIdBind = 24                              
                           --            AND ( :prevDegree = 2 OR :prevDegree = 8  )))                              
                      --   THEN                              
                          --  DECODE ( :degreeIdBind,  2, 3,  8, 3,24,3)                              
                        -- ELSE                              
                    --    --    NULL                              
                    --  END                              
               -- END                    
               and ( :degreeIdBind = :degreeIdBind                 
                 or  :prevDegree = :prevDegree )                 
                 and COU.BC_DEGREE_ID = :postponedBindd                 
                               
         AND COU.HEARING_DATE >  NVL(TO_DATE(:prevDate, 'yyyy-mm-dd'), SYSDATE)                    
         AND COU.HEARING_DATE  >= sysdate                  
     and  (:delay = 'Y' or('N' = :RDF OR COU.HEARING_DATE  < sysdate      )     )                     
                      
                         
                         
)      
  union   
 ( SELECT COU.ID,                                
         TO_CHAR (COU.HEARING_DATE, 'yyyy-mm-dd') || ' ' || ENTS.ENTITY_NAME                                
                          
  FROM  COURT_CIRCLES_DATES_HEARING COU, ENTITY ENTS                                                                              
WHERE  COU.ENTITY_ID = ENTS.ID                                                       
                                                                           
AND COU.BC_DEGREE_ID = :postponedBindd                                                           
             
                 
AND COU.HEARING_DATE  >= sysdate     
and COU.id in (select COURT_BC_HEARING_RESERVATION.CIRCLE_HEARING_DATE_ID from COURT_BC_HEARING_RESERVATION where COURT_BC_HEARING_RESERVATION.BUSINESS_CASE_ID = :bcidp  ))   
    
     
union                  
                  
(SELECT                  
    cou.ID,                  
      TO_CHAR (COU.HEARING_DATE, 'yyyy-mm-dd') || ' ' || ENTS.ENTITY_NAME HEARING_DATE                   
                     
FROM COURT_CIRCLES_DATES_HEARING cou                  
JOIN ENTITY ents                  
    ON ents.id = cou.entity_id                  
JOIN rule_entities re                  
    ON re.entity_id = cou.entity_id                  
JOIN CASE_DISTRIBUTION_RULES cdr                  
    ON cdr.rule_id = re.rule_id                  
WHERE                  
                  
(:pnum = 7 or COU.CAPACITY > 0    )         
AND COU.ENTITY_ID = ENTS.ID  AND COU.HEARING_DATE  >= sysdate       
and COU.BC_DEGREE_ID = :postponedBindd                
AND COU.CIRCLES_ARCHIVE = 0  and 'Y' = :RDF  and                  
 ( (:pnum = 7 and SYSDATE   < COU.HEARING_DATE) or NVL(TO_DATE(:prevDate, 'yyyy-mm-dd') + 14, SYSDATE)   < COU.HEARING_DATE )  and                  
       INSTR(                  
            cdr.court_day,                  
            TO_CHAR(                  
                cou.hearing_date,                  
                'DY',                  
                'NLS_DATE_LANGUAGE=ENGLISH'                  
            )                  
        ) > 0                  
                          
            order by row_number() over(partition by trunc(cou.ENTITY_ID) order by cou.HEARING_DATE asc) fetch first :pnum  row with ties   )]]></SQLQuery>
