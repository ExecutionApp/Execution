    <SQLQuery><![CDATA[SELECT res.id               
           AS res_id,     
           res.business_case_id,     
           res.circle_hearing_date_id,     
       cd.ENTITY_ID,               
       par.police_number || ' / ' || par.par_year || ' / ' || bct.name               
           AS business_case_number,               
       bc.business_case_name,               
       bcd.name               
           AS business_case_degree,             
           to_date(cd.hearing_date,'dd/mm/rrrr') as hearing_date,         
       cbs.CLASSIFIED_FLAG as CLASSIFIED_FLAG         
  FROM court_bc_hearing_reservation  res,               
       court_circles_dates_hearing   cd,               
       par_police_authority_report   par,               
       business_case_type            bct,               
       business_case                 bc,               
       business_case_degrees         bcd            
       ,EXC_COURT_BC_SESSION_JUDGMENT cbs         
 WHERE     res.circle_hearing_date_id = cd.id               
       AND par.business_case_id = res.business_case_id               
       AND bct.id = par.business_case_type               
       AND bc.id = res.business_case_id               
       AND bcd.id = cd.bc_degree_id               
       AND res.is_active = 'Y'               
       and cbs.COURT_BC_HEARING_RES_ID(+)=res.id         
and par.business_case_type= :businessCaseTypeParam 
and (par.par_year = :parYearParam or :parYearParam is null)  
and (cd.id= :hearingIdParam or :hearingIdParam is null)                    
and (par.origin_entity= :originEntityParam or :originEntityParam is null)               
and cd.bc_degree_id= :businessCaseDegreeParam              
and (par.police_number= :policeNumberParam or :policeNumberParam is null)              
and (cd.entity_id= :circleIdParam or :circleIdParam is null)          
and (nvl(CLASSIFIED_FLAG, -1)= :classifiedFlagParam or :classifiedFlagParam is null)          
and res.id in                        
(select z.COURT_BC_HEARING_RES_ID                         
from court_bc_hearing_res_parties z, par_parties lll                        
where z.party_id=lll.id                        
and (LLL.id_number like '%' || :idNumberParam || '%' or :idNumberParam is null)                       
and (LLL.party_full_name like '%' || :fullNameParam || '%' or :fullNameParam is null))]]></SQLQuery>
