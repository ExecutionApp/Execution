                                <af:column headerText="#{bundle.JUDGMENT_CLASSIFICATION}" id="c32" align="center"
                                           width="100%">
                                    <af:selectOneChoice value="#{row.bindings.JudgmentClassification.inputValue}"
                                                        disabled="#{bindings.JudgementTypeToggle.inputValue eq 2 or bindings.JudgementType.inputValue == 1 or bindings.JudgementType.inputValue == null or pageFlowScope.provisionsInclusionBean.mode == 'view'}"
                                                        label="#{row.bindings.JudgmentClassification.label}"
                                                        required="#{bindings.FormCaseDescriptionDesPartView11.hints.JudgmentClassification.mandatory}"
                                                        shortDesc="#{bindings.FormCaseDescriptionDesPartView11.hints.JudgmentClassification.tooltip}"
                                                        id="soc22" autoSubmit="true"
                                                        partialTriggers=":::l33 :::l44 :::soc8 ::l3 ::l4">
                                        <f:selectItems value="#{row.bindings.JudgmentClassification.items}" id="si22"/>
                                        <f:validator binding="#{row.bindings.JudgmentClassification.validator}"/>
                                    </af:selectOneChoice>
                                </af:column>
                                <af:column headerText="#{bundle.JUDGMENT_CLASSIFICATION_DETAIL}" id="c39" align="center"
                                           width="100%">
                                    <af:selectOneChoice value="#{row.bindings.JudgementClassDetail.inputValue}"
                                                        autoSubmit="true"
                                                        partialTriggers=":::l33 :::l44 :::soc9 soc22 ::l3 ::l4"
                                                        disabled="#{bindings.JudgementTypeToggle.inputValue eq 2 or bindings.JudgementType.inputValue == 1 or row.bindings.JudgmentClassification.inputValue != 3 or bindings.JudgementType.inputValue == null or pageFlowScope.provisionsInclusionBean.mode == 'view'}"
                                                        label="#{row.bindings.JudgementClassDetail.label}"
                                                        required="#{bindings.FormCaseDescriptionDesPartView11.hints.JudgementClassDetail.mandatory}"
                                                        shortDesc="#{bindings.FormCaseDescriptionDesPartView11.hints.JudgementClassDetail.tooltip}"
                                                        id="soc23">
                                        <f:selectItems value="#{row.bindings.JudgementClassDetail.items}" id="si23"/>
                                        <f:validator binding="#{row.bindings.JudgementClassDetail.validator}"/>
                                    </af:selectOneChoice>
                                </af:column>
                                <af:column id="c43" align="center" width="100%">
                                    <af:button text="#{bundle.DELETE}" id="b13" immediate="true"
                                               action="#{pageFlowScope.provisionsInclusionBean.deleteDesPart}"
                                               disabled="#{bindings.JudgementTypeToggle.inputValue eq 2 or pageFlowScope.provisionsInclusionBean.mode == 'view'}"
                                               styleClass="button-danger"/>
                                </af:column>
                            </af:table>
                        </af:showDetailItem>
                        <af:showDetailItem id="tab4" text="معلومات عن تنفيذ اخر جلسة">
                            <af:table value="#{bindings.ExecPartySessionJudgmentsROV1.collectionModel}" var="row"
                                      rows="#{bindings.ExecPartySessionJudgmentsROV1.rangeSize}"
                                      emptyText="#{bindings.ExecPartySessionJudgmentsROV1.viewable ? 'No data to display.' : 'Access Denied.'}"
                                      rowBandingInterval="0"
                                      selectedRowKeys="#{bindings.ExecPartySessionJudgmentsROV1.collectionModel.selectedRow}"
                                      selectionListener="#{bindings.ExecPartySessionJudgmentsROV1.collectionModel.makeCurrent}"
                                      rowSelection="single"
                                      fetchSize="#{bindings.ExecPartySessionJudgmentsROV1.rangeSize}" id="t2"
                                      columnStretching="multiple" scrollPolicy="page">
                                <af:column sortProperty="#{bindings.ExecPartySessionJudgmentsROV1.hints.HearingDate.name}"
                                           sortable="true"
                                           headerText="#{bindings.ExecPartySessionJudgmentsROV1.hints.HearingDate.label}"
                                           id="c15" width="100%">
                                    <af:outputText value="#{row.HearingDate}"
                                                   shortDesc="#{bindings.ExecPartySessionJudgmentsROV1.hints.HearingDate.tooltip}"
                                                   id="ot1">
                                        <af:convertDateTime pattern="#{bindings.ExecPartySessionJudgmentsROV1.hints.HearingDate.format}"/>
                                    </af:outputText>
                                </af:column>
                                <af:column sortProperty="#{bindings.ExecPartySessionJudgmentsROV1.hints.AttendanceName.name}"
                                           sortable="true"
                                           headerText="#{bindings.ExecPartySessionJudgmentsROV1.hints.AttendanceName.label}"
                                           id="c17" width="100%">
                                    <af:outputText value="#{row.AttendanceName}"
                                                   shortDesc="#{bindings.ExecPartySessionJudgmentsROV1.hints.AttendanceName.tooltip}"
                                                   id="ot2"/>
                                </af:column>
                                <af:column sortProperty="#{bindings.ExecPartySessionJudgmentsROV1.hints.PartyJudgementResolution.name}"
                                           sortable="true"
                                           headerText="#{bindings.ExecPartySessionJudgmentsROV1.hints.PartyJudgementResolution.label}"
                                           id="c16" width="100%">
                                    <af:outputText value="#{row.PartyJudgementResolution}"
                                                   shortDesc="#{bindings.ExecPartySessionJudgmentsROV1.hints.PartyJudgementResolution.tooltip}"
                                                   id="ot3"/>
                                </af:column>
                                <af:column sortProperty="#{bindings.ExecPartySessionJudgmentsROV1.hints.SequenceNumber.name}"
                                           sortable="true"
                                           headerText="#{bindings.ExecPartySessionJudgmentsROV1.hints.SequenceNumber.label}"
                                           id="c7" width="100%">
                                    <af:outputText value="#{row.SequenceNumber}"
                                                   shortDesc="#{bindings.ExecPartySessionJudgmentsROV1.hints.SequenceNumber.tooltip}"
                                                   id="ot4">
                                        <af:convertNumber groupingUsed="false"
                                                          pattern="#{bindings.ExecPartySessionJudgmentsROV1.hints.SequenceNumber.format}"/>
                                    </af:outputText>
                                </af:column>
                                <af:column sortProperty="#{bindings.ExecPartySessionJudgmentsROV1.hints.Name.name}"
                                           sortable="true"
                                           headerText="#{bindings.ExecPartySessionJudgmentsROV1.hints.Name.label}"
                                           id="c6" width="100%">
                                    <af:outputText value="#{row.Name}"
                                                   shortDesc="#{bindings.ExecPartySessionJudgmentsROV1.hints.Name.tooltip}"
                                                   id="ot5"/>
                                </af:column>
                            </af:table>
                        </af:showDetailItem>
                    </af:panelTabbed>
                </af:showDetailItem>
            </af:iterator>
        </af:panelAccordion>
    </af:panelHeader>
</ui:composition>
