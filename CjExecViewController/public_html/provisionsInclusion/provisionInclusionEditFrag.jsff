<?xml version='1.0' encoding='UTF-8'?>
<ui:composition xmlns:ui="http://java.sun.com/jsf/facelets" xmlns:h="http://java.sun.com/jsf/html"
                xmlns:af="http://xmlns.oracle.com/adf/faces/rich" xmlns:f="http://java.sun.com/jsf/core">
    <af:panelHeader text="#{bundle.CASE_DETAILS}" id="ph1">
        <f:facet name="context"/>
        <f:facet name="toolbar">
            <af:toolbar id="t4">
                <af:button text="#{bundle.SAVE}" id="b3" action="#{pageFlowScope.provisionsInclusionBean.saveInclusion}"
                           disabled="#{pageFlowScope.provisionsInclusionBean.mode == 'view'}"/>
                <af:button text="#{bundle.SAVE_AND_INCLOSE}" id="b7"
                           action="#{pageFlowScope.provisionsInclusionBean.saveAndInclose}"
                           disabled="#{pageFlowScope.provisionsInclusionBean.mode == 'view'}"/>
                <af:button actionListener="#{bindings.Rollback.execute}" visible="false" text="#{bundle.ROLLBACK}"
                           immediate="true" id="b4" disabled="#{pageFlowScope.provisionsInclusionBean.mode == 'view'}">
                    <af:resetActionListener/>
                </af:button>
                <af:button text="#{bundle.RETURN}" id="b1" action="#{pageFlowScope.provisionsInclusionBean.back}"
                           immediate="true"/>
            </af:toolbar>
        </f:facet>
        <f:facet name="menuBar"/>
        <f:facet name="legend"/>
        <f:facet name="info"/>
        <h:panelGroup layout="block" styleClass="casedata-panel" id="pg66">
            <!--<af:outputText styleClass="casedata-header" value="#{bundle.CASE_DETAILS}" id="ot6"/>-->
            <h:panelGroup layout="block" styleClass="row" id="pg565">
                <h:panelGroup layout="block" styleClass="col-md-4 col-sm-12" id="pg989">
                    <af:outputLabel value="#{bundle.BUSINESS_CASE_NUMBER}" id="ol11"/>
                    <!-- <af:outputText value="#{pageFlowScope.provisionsInclusionBean.businessCaseNumber}" id="ot7"/>-->
                    <af:inputText simple="true" label="#{bundle.BUSINESS_CASE_NUMBER}" id="it29" disabled="true"
                                  value="#{pageFlowScope.provisionsInclusionBean.businessCaseNumber}"/>
                </h:panelGroup>
                <h:panelGroup layout="block" styleClass="col-md-2 col-sm-12" id="pg1" rendered="false">
                    <af:outputLabel value="#{bundle.BUSINESS_CASE_NAME}" id="ol12"/>
                    <!--  <af:outputText value="#{pageFlowScope.provisionsInclusionBean.businessCaseName}" id="ot8"/>-->
                    <af:inputText simple="true" label="#{bundle.BUSINESS_CASE_NAME}" id="it30" disabled="true"
                                  value="#{pageFlowScope.provisionsInclusionBean.businessCaseName}"/>
                </h:panelGroup>
                <h:panelGroup layout="block" styleClass="col-md-2 col-sm-12" id="pg2">
                    <af:outputLabel value="#{bundle.HEARING_DATE}" id="ol13"/>
                    <!-- <af:outputText value="#{pageFlowScope.provisionsInclusionBean.hearingDate}" id="ot9"/>-->
                    <af:inputText simple="true" label="#{bundle.HEARING_DATE}" id="it31" disabled="true"
                                  value="#{pageFlowScope.provisionsInclusionBean.hearingDate}"/>
                </h:panelGroup>
                <h:panelGroup layout="block" styleClass="col-md-2 col-sm-12" id="pg3">
                    <af:outputLabel value="#{bundle.BUSINESS_CASE_DEGREE}" id="ol14"/>
                    <!-- <af:outputText value="#{pageFlowScope.provisionsInclusionBean.businessCaseDegree}" id="ot10"/>-->
                    <af:inputText simple="true" label="#{bundle.BUSINESS_CASE_DEGREE}" id="it32" disabled="true"
                                  value="#{pageFlowScope.provisionsInclusionBean.businessCaseDegree}"/>
                </h:panelGroup>
            </h:panelGroup>
        </h:panelGroup>
    </af:panelHeader>
    <!--<af:panelBox  text="#{bundle.CASE_DETAILS}" id="pb2" showDisclosure="false">
        <f:facet name="toolbar"/>
      
       
    </af:panelBox>-->
    <af:panelHeader text="#{bundle.CASES_VIEW}" id="ph3">
        <f:facet name="context"/>
        <f:facet name="toolbar">
            <af:toolbar id="t6">
                <af:panelLabelAndMessage label="#{bundle.JUDGEMENT_FOR_EACH_CASE}" id="plam2">
                    <af:link disabled="#{pageFlowScope.provisionsInclusionBean.mode == 'view'}" id="l33"
                             rendered="#{bindings.JudgementTypeToggle.inputValue eq 2}" styleClass="tglOn"
                             action="#{pageFlowScope.provisionsInclusionBean.toggleOffSession}">
                        <f:setPropertyActionListener target="#{bindings.JudgementTypeToggle.inputValue}" value="#{1}"/>
                    </af:link>
                    <af:link disabled="#{pageFlowScope.provisionsInclusionBean.mode == 'view'}" id="l44"
                             rendered="#{bindings.JudgementTypeToggle.inputValue eq 1 or bindings.JudgementTypeToggle.inputValue eq null}"
                             styleClass="tglOff" action="#{pageFlowScope.provisionsInclusionBean.toggleOnSession}">
                        <f:setPropertyActionListener target="#{bindings.JudgementTypeToggle.inputValue}" value="#{2}"/>
                    </af:link>
                </af:panelLabelAndMessage>
            </af:toolbar>
        </f:facet>
        <f:facet name="menuBar"/>
        <f:facet name="legend"/>
        <f:facet name="info"/>
        <h:panelGroup layout="block" styleClass="row" id="pg4">
            <h:panelGroup id="pg5" layout="block" styleClass="col-md-2 col-sm-12">
                <af:outputLabel showRequired="true" value="#{bundle.JUDGMENT_TYPE}" id="ol15"/>
                <af:selectOneChoice simple="true" value="#{bindings.JudgmentType.inputValue}"
                                    label="#{bundle.JUDGMENT_TYPE}" required="true"
                                    disabled="#{pageFlowScope.provisionsInclusionBean.mode == 'view'}"
                                    shortDesc="#{bindings.JudgmentType.hints.tooltip}" id="soc4" autoSubmit="true">
                    <f:selectItems value="#{bindings.JudgmentType.items}" id="si4"/>
                    <f:validator binding="#{bindings.JudgmentType.validator}"/>
                </af:selectOneChoice>
            </h:panelGroup>
            <h:panelGroup id="pg6" layout="block" styleClass="col-md-2 col-sm-12">
                <af:outputLabel showRequired="#{bindings.JudgmentSubType.hints.mandatory}"
                                value="#{bundle.JUDGMENT_SUB_TYPE}" id="ol16"/>
                <af:selectOneChoice simple="true" value="#{bindings.JudgmentSubType.inputValue}"
                                    label="#{bundle.JUDGMENT_SUB_TYPE}"
                                    required="#{bindings.JudgmentSubType.hints.mandatory}"
                                    disabled="#{bindings.JudgmentType.inputValue eq 1 or pageFlowScope.provisionsInclusionBean.mode == 'view'}"
                                    shortDesc="#{bindings.JudgmentSubType.hints.tooltip}" id="soc3"
                                    partialTriggers="soc4" autoSubmit="true"
                                    valueChangeListener="#{pageFlowScope.provisionsInclusionBean.judgmentSubTypeVCL}">
                    <f:selectItems value="#{bindings.JudgmentSubType.items}" id="si3"/>
                    <f:validator binding="#{bindings.JudgmentSubType.validator}"/>
                </af:selectOneChoice>
            </h:panelGroup>
            <h:panelGroup id="pg7" layout="block" styleClass="col-md-2 col-sm-12">
                <af:outputLabel showRequired="#{bindings.CircleId.hints.mandatory}" value="#{bundle.FIRST_SESSION}"
                                id="ol17"/>
                <af:selectOneChoice simple="true" value="#{bindings.FirstSessionId.inputValue}"
                                    label="#{bundle.FIRST_SESSION}" partialTriggers="soc3 soc4"
                                    required="#{bindings.FirstSessionId.hints.mandatory}" autoSubmit="true" disabled="#{bindings.JudgmentType.inputValue eq 1
                                    or bindings.JudgmentSubType.inputValue eq null
                                    or bindings.JudgmentSubType.inputValue eq 3
                                    or bindings.JudgmentSubType.inputValue eq 4
                                    or pageFlowScope.provisionsInclusionBean.mode == 'view'}"
                                    shortDesc="#{bindings.FirstSessionId.hints.tooltip}" id="soc2">
                    <f:selectItems value="#{bindings.FirstSessionId.items}" id="si2"/>
                    <f:validator binding="#{bindings.FirstSessionId.validator}"/>
                </af:selectOneChoice>
            </h:panelGroup>
            <h:panelGroup id="pg8" layout="block" styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="#{bundle.SECOND_SESSION}" id="ol18"/>
                <af:selectOneChoice simple="true" value="#{bindings.SecondSessionId.inputValue}"
                                    label="#{bundle.SECOND_SESSION}"
                                    required="#{bindings.SecondSessionId.hints.mandatory}" autoSubmit="true" disabled="#{bindings.JudgmentType.inputValue eq 1
                                    or bindings.JudgmentSubType.inputValue eq null
                                    or bindings.JudgmentSubType.inputValue eq 1
                                    or bindings.JudgmentSubType.inputValue eq 2
                                     or bindings.JudgmentSubType.inputValue eq 3
                                      or bindings.JudgmentSubType.inputValue eq 4
                                      or bindings.JudgmentSubType.inputValue eq 5
                                       or bindings.JudgmentSubType.inputValue eq 6
                                     or pageFlowScope.provisionsInclusionBean.mode == 'view'}"
                                    shortDesc="#{bindings.SecondSessionId.hints.tooltip}" id="soc5"
                                    partialTriggers="soc2 soc3 soc4">
                    <f:selectItems value="#{bindings.SecondSessionId.items}" id="si5"/>
                    <f:validator binding="#{bindings.SecondSessionId.validator}"/>
                </af:selectOneChoice>
            </h:panelGroup>
            <h:panelGroup id="pg9" layout="block" styleClass="col-md-2 col-sm-12">
                <af:outputLabel showRequired="#{bindings.CircleId.hints.mandatory}" value="#{bundle.CIRCLE}" id="ol19"/>
                <af:selectOneChoice simple="true" value="#{bindings.CircleId.inputValue}" label="#{bundle.CIRCLE}"
                                    required="#{bindings.CircleId.hints.mandatory}"
                                    shortDesc="#{bindings.CircleId.hints.tooltip}" id="soc1"
                                    disabled="#{bindings.JudgmentSubType.inputValue != 2 or pageFlowScope.provisionsInclusionBean.mode == 'view'}"
                                    partialTriggers="soc3">
                    <f:selectItems value="#{bindings.CircleId.items}" id="si1"/>
                    <f:validator binding="#{bindings.CircleId.validator}"/>
                </af:selectOneChoice>
            </h:panelGroup>
            <h:panelGroup id="pg10" layout="block" styleClass="col-md-2 col-sm-12">
                <af:outputLabel showRequired="#{bindings.Attendance1.hints.mandatory}" value="#{bundle.ATTENDANCE}"
                                id="ol20"/>
                <af:selectOneChoice simple="true" value="#{bindings.Attendance1.inputValue}"
                                    label="#{bundle.ATTENDANCE}"
                                    disabled="#{bindings.JudgementTypeToggle.inputValue eq 1 or bindings.JudgementTypeToggle.inputValue eq null}"
                                    required="#{bindings.Attendance1.hints.mandatory}" partialTriggers="l33 l44"
                                    shortDesc="#{bindings.Attendance1.hints.tooltip}" id="soc10" autoSubmit="true"
                                    valueChangeListener="#{pageFlowScope.provisionsInclusionBean.attendanceVCLSession}">
                    <f:selectItems value="#{bindings.Attendance1.items}" id="si10"/>
                    <f:validator binding="#{bindings.Attendance1.validator}"/>
                </af:selectOneChoice>
            </h:panelGroup>
            <h:panelGroup id="pg11" layout="block" styleClass="col-md-2 col-sm-12">
                <af:outputLabel showRequired="#{bindings.JudgmentClassification1.hints.mandatory}"
                                value="#{bundle.JUDGMENT_CLASSIFICATION}" id="ol21"/>
                <af:selectOneChoice simple="true" value="#{bindings.JudgmentClassification1.inputValue}"
                                    disabled="#{bindings.JudgementTypeToggle.inputValue eq 1 or bindings.JudgementTypeToggle.inputValue eq null}"
                                    autoSubmit="true" label="#{bundle.JUDGMENT_CLASSIFICATION}"
                                    required="#{bindings.JudgmentClassification1.hints.mandatory}"
                                    shortDesc="#{bindings.JudgmentClassification1.hints.tooltip}" id="soc8"
                                    partialTriggers="l33 l44"
                                    valueChangeListener="#{pageFlowScope.provisionsInclusionBean.judgmentClassificationVCLSession}">
                    <f:selectItems value="#{bindings.JudgmentClassification1.items}" id="si8"/>
                    <f:validator binding="#{bindings.JudgmentClassification1.validator}"/>
                </af:selectOneChoice>
            </h:panelGroup>
            <h:panelGroup id="pg12" layout="block" styleClass="col-md-2 col-sm-12">
                <af:outputLabel showRequired="#{bindings.JudgementClassDetail1.hints.mandatory}"
                                value="#{bundle.JUDGMENT_CLASSIFICATION_DETAIL}" id="ol22"/>
                <af:selectOneChoice simple="true" value="#{bindings.JudgementClassDetail1.inputValue}"
                                    disabled="#{bindings.JudgementTypeToggle.inputValue eq 1 or bindings.JudgementTypeToggle.inputValue eq null or bindings.JudgmentClassification1.inputValue != 3}"
                                    label="#{bundle.JUDGMENT_CLASSIFICATION_DETAIL}"
                                    required="#{bindings.JudgementClassDetail1.hints.mandatory}"
                                    shortDesc="#{bindings.JudgementClassDetail1.hints.tooltip}" id="soc9"
                                    partialTriggers="l33 l44 soc8" autoSubmit="true"
                                    valueChangeListener="#{pageFlowScope.provisionsInclusionBean.judgmentClassificationDetailVCLSession}">
                    <f:selectItems value="#{bindings.JudgementClassDetail1.items}" id="si9"/>
                    <f:validator binding="#{bindings.JudgementClassDetail1.validator}"/>
                </af:selectOneChoice>
            </h:panelGroup>
            <h:panelGroup layout="block" styleClass="col-md-12 col-sm-12" id="pg13">
                <af:outputLabel showRequired="true" value="#{bundle.JUDGMENT_RESOLUTION}" id="ol23"/>
                <af:inputText simple="true" value="#{bindings.JudgementResolution.inputValue}"
                              label="#{bundle.JUDGMENT_RESOLUTION}" required="true" converter="oracle.genericDomain"
                              disabled="#{pageFlowScope.provisionsInclusionBean.mode == 'view'}"
                              maximumLength="#{bindings.JudgementResolution.hints.precision}"
                              shortDesc="#{bindings.JudgementResolution.hints.tooltip}" id="it4" rows="3"
                              autoSubmit="true">
                    <f:validator binding="#{bindings.JudgementResolution.validator}"/>
                </af:inputText>
                <af:popup childCreation="deferred" autoCancel="disabled" id="p1" contentDelivery="lazyUncached">
                    <af:panelWindow id="pw1" modal="true">
                        <af:region value="#{bindings.Par_PartiesTF1.regionModel}" id="r1"/>
                        <af:panelGroupLayout id="pgl7" layout="horizontal" halign="center">
                            <af:button text="حفظ" id="b11"
                                       disabled="#{pageFlowScope.provisionsInclusionBean.mode == 'view'}"
                                       action="#{pageFlowScope.provisionsInclusionBean.saveParty}"/>
                            <af:button text="اغلاق" id="b12" immediate="true"
                                       disabled="#{pageFlowScope.provisionsInclusionBean.mode == 'view'}"
                                       action="#{pageFlowScope.provisionsInclusionBean.closePartyPopup}"/>
                        </af:panelGroupLayout>
                    </af:panelWindow>
                </af:popup>
                <af:popup childCreation="deferred" autoCancel="disabled" id="p2" contentDelivery="lazyUncached">
                    <af:panelWindow id="pw2" modal="true" contentWidth="700" contentHeight="500">
                        <af:panelBox text="#{bundle.DESCRIPTIONS}" id="pb3" showDisclosure="false">
                            <f:facet name="toolbar"/>
                            <af:panelCollection id="pc1" featuresOff="statusBar viewMenu detach">
                                <f:facet name="menus"/>
                                <f:facet name="toolbar">
                                    <af:toolbar id="t5">
                                        <af:button actionListener="#{bindings.CreateInsert1.execute}" immediate="true"
                                                   disabled="#{pageFlowScope.provisionsInclusionBean.mode == 'view'}"
                                                   text="#{bundle.ADD_DES_CASE}" id="b5"/>
                                    </af:toolbar>
                                </f:facet>
                                <f:facet name="statusbar"/>
                                <af:table value="#{bindings.FormCaseDescriptionDesView1.collectionModel}" var="row"
                                          columnStretching="c9" rows="#{bindings.FormCaseDescriptionDesView1.rangeSize}"
                                          emptyText="#{bindings.FormCaseDescriptionDesView1.viewable ? 'No data to display.' : 'Access Denied.'}"
                                          rowBandingInterval="0"
                                          selectedRowKeys="#{bindings.FormCaseDescriptionDesView1.collectionModel.selectedRow}"
                                          selectionListener="#{bindings.FormCaseDescriptionDesView1.collectionModel.makeCurrent}"
                                          rowSelection="single"
                                          fetchSize="#{bindings.FormCaseDescriptionDesView1.rangeSize}" id="t3"
                                          styleClass="AFStrechWidth" autoHeightRows="3" partialTriggers="b6"
                                          scrollPolicy="page">
                                    <af:column headerText="#{bindings.FormCaseDescriptionDesView1.hints.Id.label}"
                                               id="c4" visible="false">
                                        <af:inputText value="#{row.bindings.Id.inputValue}"
                                                      label="#{bindings.FormCaseDescriptionDesView1.hints.Id.label}"
                                                      required="#{bindings.FormCaseDescriptionDesView1.hints.Id.mandatory}"
                                                      columns="#{bindings.FormCaseDescriptionDesView1.hints.Id.displayWidth}"
                                                      maximumLength="#{bindings.FormCaseDescriptionDesView1.hints.Id.precision}"
                                                      shortDesc="#{bindings.FormCaseDescriptionDesView1.hints.Id.tooltip}"
                                                      id="it7">
                                            <f:validator binding="#{row.bindings.Id.validator}"/>
                                            <af:convertNumber groupingUsed="false"
                                                              pattern="#{bindings.FormCaseDescriptionDesView1.hints.Id.format}"/>
                                        </af:inputText>
                                    </af:column>
                                    <af:column headerText="#{bindings.FormCaseDescriptionDesView1.hints.FormCaseDescriptionId.label}"
                                               id="c5" visible="false">
                                        <af:inputText value="#{row.bindings.FormCaseDescriptionId.inputValue}"
                                                      label="#{bindings.FormCaseDescriptionDesView1.hints.FormCaseDescriptionId.label}"
                                                      required="#{bindings.FormCaseDescriptionDesView1.hints.FormCaseDescriptionId.mandatory}"
                                                      columns="#{bindings.FormCaseDescriptionDesView1.hints.FormCaseDescriptionId.displayWidth}"
                                                      maximumLength="#{bindings.FormCaseDescriptionDesView1.hints.FormCaseDescriptionId.precision}"
                                                      shortDesc="#{bindings.FormCaseDescriptionDesView1.hints.FormCaseDescriptionId.tooltip}"
                                                      id="it9">
                                            <f:validator binding="#{row.bindings.FormCaseDescriptionId.validator}"/>
                                            <af:convertNumber groupingUsed="false"
                                                              pattern="#{bindings.FormCaseDescriptionDesView1.hints.FormCaseDescriptionId.format}"/>
                                        </af:inputText>
                                    </af:column>
                                    <af:column headerText="#{bundle.DESCRIPTION}" id="c9" width="520" align="center">
                                        <af:selectOneChoice value="#{row.bindings.DescriptionId.inputValue}"
                                                            disabled="#{pageFlowScope.provisionsInclusionBean.mode == 'view'}"
                                                            label="#{row.bindings.DescriptionId.label}"
                                                            required="#{bindings.FormCaseDescriptionDesView1.hints.DescriptionId.mandatory}"
                                                            shortDesc="#{bindings.FormCaseDescriptionDesView1.hints.DescriptionId.tooltip}"
                                                            id="soc7" autoSubmit="true">
                                            <f:selectItems value="#{row.bindings.DescriptionId.items}" id="si7"/>
                                            <f:validator binding="#{row.bindings.DescriptionId.validator}"/>
                                        </af:selectOneChoice>
                                    </af:column>
                                    <af:column headerText="#{bindings.FormCaseDescriptionDesView1.hints.CreatedBy.label}"
                                               id="c10" visible="false">
                                        <af:inputText value="#{row.bindings.CreatedBy.inputValue}"
                                                      label="#{bindings.FormCaseDescriptionDesView1.hints.CreatedBy.label}"
                                                      required="#{bindings.FormCaseDescriptionDesView1.hints.CreatedBy.mandatory}"
                                                      columns="#{bindings.FormCaseDescriptionDesView1.hints.CreatedBy.displayWidth}"
                                                      maximumLength="#{bindings.FormCaseDescriptionDesView1.hints.CreatedBy.precision}"
                                                      shortDesc="#{bindings.FormCaseDescriptionDesView1.hints.CreatedBy.tooltip}"
                                                      id="it10">
                                            <f:validator binding="#{row.bindings.CreatedBy.validator}"/>
                                        </af:inputText>
                                    </af:column>
                                    <af:column headerText="#{bindings.FormCaseDescriptionDesView1.hints.CreatedDate.label}"
                                               id="c11" visible="false">
                                        <af:inputDate value="#{row.bindings.CreatedDate.inputValue}"
                                                      label="#{bindings.FormCaseDescriptionDesView1.hints.CreatedDate.label}"
                                                      required="#{bindings.FormCaseDescriptionDesView1.hints.CreatedDate.mandatory}"
                                                      columns="#{bindings.FormCaseDescriptionDesView1.hints.CreatedDate.displayWidth}"
                                                      shortDesc="#{bindings.FormCaseDescriptionDesView1.hints.CreatedDate.tooltip}"
                                                      id="id1">
                                            <f:validator binding="#{row.bindings.CreatedDate.validator}"/>
                                            <af:convertDateTime pattern="#{bindings.FormCaseDescriptionDesView1.hints.CreatedDate.format}"/>
                                        </af:inputDate>
                                    </af:column>
                                    <af:column headerText="#{bindings.FormCaseDescriptionDesView1.hints.UpdatedBy.label}"
                                               id="c12" visible="false">
                                        <af:inputText value="#{row.bindings.UpdatedBy.inputValue}"
                                                      label="#{bindings.FormCaseDescriptionDesView1.hints.UpdatedBy.label}"
                                                      required="#{bindings.FormCaseDescriptionDesView1.hints.UpdatedBy.mandatory}"
                                                      columns="#{bindings.FormCaseDescriptionDesView1.hints.UpdatedBy.displayWidth}"
                                                      maximumLength="#{bindings.FormCaseDescriptionDesView1.hints.UpdatedBy.precision}"
                                                      shortDesc="#{bindings.FormCaseDescriptionDesView1.hints.UpdatedBy.tooltip}"
                                                      id="it11">
                                            <f:validator binding="#{row.bindings.UpdatedBy.validator}"/>
                                        </af:inputText>
                                    </af:column>
                                    <af:column headerText="#{bindings.FormCaseDescriptionDesView1.hints.UpdatedDate.label}"
                                               id="c13" visible="false">
                                        <af:inputDate value="#{row.bindings.UpdatedDate.inputValue}"
                                                      label="#{bindings.FormCaseDescriptionDesView1.hints.UpdatedDate.label}"
                                                      required="#{bindings.FormCaseDescriptionDesView1.hints.UpdatedDate.mandatory}"
                                                      columns="#{bindings.FormCaseDescriptionDesView1.hints.UpdatedDate.displayWidth}"
                                                      shortDesc="#{bindings.FormCaseDescriptionDesView1.hints.UpdatedDate.tooltip}"
                                                      id="id2">
                                            <f:validator binding="#{row.bindings.UpdatedDate.validator}"/>
                                            <af:convertDateTime pattern="#{bindings.FormCaseDescriptionDesView1.hints.UpdatedDate.format}"/>
                                        </af:inputDate>
                                    </af:column>
                                    <af:column id="c14" align="center" width="80">
                                        <af:button text="#{bundle.DELETE}" id="b6"
                                                   action="#{pageFlowScope.provisionsInclusionBean.deleteDes}"
                                                   disabled="#{pageFlowScope.provisionsInclusionBean.mode == 'view'}"
                                                   immediate="true"/>
                                    </af:column>
                                </af:table>
                            </af:panelCollection>
                        </af:panelBox>
                        <af:panelGroupLayout id="pgl6" layout="horizontal" halign="center">
                            <af:button text="#{bundle.ADD_DES_PARTY}" id="b14"
                                       disabled="#{pageFlowScope.provisionsInclusionBean.mode == 'view'}"
                                       action="#{pageFlowScope.provisionsInclusionBean.addDesPart}"/>
                            <af:button text="#{bundle.CLOSE}" id="b15"
                                       disabled="#{pageFlowScope.provisionsInclusionBean.mode == 'view'}"
                                       action="#{pageFlowScope.provisionsInclusionBean.closeDesPopup}"
                                       immediate="true"/>
                        </af:panelGroupLayout>
                    </af:panelWindow>
                </af:popup>
            </h:panelGroup>
        </h:panelGroup>
    </af:panelHeader>
    <!--<af:panelBox text="#{bundle.CASES_VIEW}" id="pb1" showDisclosure="false">
        <f:facet name="toolbar"/>
       
 
    </af:panelBox>-->
    <af:inputText value="#{bindings.Id.inputValue}" label="#{bindings.Id.hints.label}"
                  required="#{bindings.Id.hints.mandatory}" maximumLength="#{bindings.Id.hints.precision}"
                  shortDesc="#{bindings.Id.hints.tooltip}" id="it3" visible="false">
        <f:validator binding="#{bindings.Id.validator}"/>
        <af:convertNumber groupingUsed="false" pattern="#{bindings.Id.format}"/>
    </af:inputText>
    <af:inputText value="#{bindings.CourtBcHearingResId.inputValue}" label="#{bindings.CourtBcHearingResId.hints.label}"
                  required="#{bindings.CourtBcHearingResId.hints.mandatory}"
                  maximumLength="#{bindings.CourtBcHearingResId.hints.precision}"
                  shortDesc="#{bindings.CourtBcHearingResId.hints.tooltip}" id="it2" visible="false">
        <f:validator binding="#{bindings.CourtBcHearingResId.validator}"/>
        <af:convertNumber groupingUsed="false" pattern="#{bindings.CourtBcHearingResId.format}"/>
    </af:inputText>
    <af:inputText value="#{bindings.DegreeId.inputValue}" label="#{bindings.DegreeId.hints.label}"
                  required="#{bindings.DegreeId.hints.mandatory}" maximumLength="#{bindings.DegreeId.hints.precision}"
                  shortDesc="#{bindings.DegreeId.hints.tooltip}" id="it16" visible="false">
        <f:validator binding="#{bindings.DegreeId.validator}"/>
        <af:convertNumber groupingUsed="false" pattern="#{bindings.DegreeId.format}"/>
    </af:inputText>
    <af:inputText value="#{bindings.ClassifiedFlag.inputValue}" label="#{bindings.ClassifiedFlag.hints.label}"
                  required="#{bindings.ClassifiedFlag.hints.mandatory}"
                  maximumLength="#{bindings.ClassifiedFlag.hints.precision}"
                  shortDesc="#{bindings.ClassifiedFlag.hints.tooltip}" id="it1" visible="false">
        <f:validator binding="#{bindings.ClassifiedFlag.validator}"/>
        <af:convertNumber groupingUsed="false" pattern="#{bindings.ClassifiedFlag.format}"/>
    </af:inputText>
    <af:panelSplitter id="ps1" disabled="true" splitterPosition="700">
        <f:facet name="first">
            <af:panelBox text="#{bundle.REQUIRED_ATTACHMENTS}" id="pb4" showDisclosure="false"
                         styleClass="AFStretchWidth">
