                            <af:convertNumber groupingUsed="false" pattern="#{bindings.Ledger.format}"/>
                        </af:inputText>
                    </af:panelFormLayout>
                    <h:panelGroup id="pg107" styleClass="row search-case-panel">
                        <af:inputText value="#{bindings.Id.inputValue}" label="#{bindings.Id.hints.label}"
                                      required="#{bindings.Id.hints.mandatory}"
                                      columns="#{bindings.Id.hints.displayWidth}"
                                      maximumLength="#{bindings.Id.hints.precision}"
                                      shortDesc="#{bindings.Id.hints.tooltip}" id="it2" visible="false">
                            <f:validator binding="#{bindings.Id.validator}"/>
                            <af:convertNumber groupingUsed="false" pattern="#{bindings.Id.format}"/>
                        </af:inputText>
                        <h:panelGroup id="pg118">
                            <h:panelGroup id="pg11" styleClass="stop-action-panel checkbox-custom" style="top: 19px;"
                                          rendered="#{sessionScope.userInfo.entityDegree eq '39'}">
                                <af:outputText value="#{bindings.Id.inputValue}"
                                               shortDesc="#{bindings.Id.hints.tooltip}" id="ot6" partialTriggers="t2"
                                               visible="false">
                                    <af:convertNumber groupingUsed="false" pattern="#{bindings.Id.format}"/>
                                </af:outputText>
                                <af:outputLabel styleClass="text-center" value="و المقيدة برقم كلى" id="ol75"
                                                rendered="#{bindings.BusinessCaseType1.inputValue  ne '11'}"/>
                                <af:spacer width="10" height="10" id="s3" partialTriggers="t2"/>
                                <af:spacer width="10" height="10" id="s2" partialTriggers="t2" visible="false"/>
                                <af:outputText value="#{bindings.Id1.inputValue}"
                                               shortDesc="#{bindings.Id1.hints.tooltip}" id="ot2" visible="false">
                                    <af:convertNumber groupingUsed="false" pattern="#{bindings.Id1.format}"/>
                                </af:outputText>
                                <af:spacer width="10" height="10" id="s4" partialTriggers="t2" visible="false"/>
                                <af:spacer width="10" height="10" id="s5" partialTriggers="t2" visible="false"/>
                                <af:outputText value="#{bindings.Id8.inputValue}"
                                               shortDesc="#{bindings.Id8.hints.tooltip}" id="ot5" visible="false">
                                    <af:convertNumber groupingUsed="false" pattern="#{bindings.Id8.format}"/>
                                </af:outputText>
                            </h:panelGroup>
                        </h:panelGroup>
                        <h:panelGroup id="pg109" styleClass="hasr-case-panel d-flex">
                            <h:panelGroup id="pg46" layout="block" styleClass="ml-3">
                                <af:outputLabel value="#{bindings.BusinessCaseDetailsId.inputValue}" id="ol5"
                                                visible="false"/>
                                <af:outputLabel showRequired="#{bindings.PoliceNo.hints.mandatory}" value="رقم"
                                                id="ol30"/>
                                <af:inputText value="#{bindings.Seq.inputValue}" required="true"
                                              maximumLength="#{bindings.Seq.hints.precision}"
                                              shortDesc="#{bindings.Seq.hints.tooltip}" id="it70"
                                              contentStyle="    width: 60px;   " simple="true" autoSubmit="true"
                                              disabled="#{bindings.UpdatedBy.inputValue ne null}" showRequired="true">
                                    <f:validator binding="#{bindings.Seq.validator}"/>
                                    <af:convertNumber groupingUsed="false" pattern="#{bindings.Seq.format}"/>
                                </af:inputText>
                            </h:panelGroup>
                            <h:panelGroup id="pg99" layout="block" styleClass="ml-3">
                                <af:outputLabel showRequired="#{bindings.ParYear1.hints.mandatory}" value="سنة"
                                                id="ol71"/>
                                <af:inputText value="#{bindings.Year1.inputValue}" required="true" maximumLength="4"
                                              shortDesc="#{bindings.Year1.hints.tooltip}" id="it71"
                                              contentStyle="    width: 60px;     min-width: 60px !important;"
                                              simple="true" validator="#{cjValidator.yearValidator}" autoSubmit="true"
                                              disabled="#{bindings.UpdatedBy.inputValue ne null}" showRequired="true">
                                    <f:validator binding="#{bindings.Year1.validator}"/>
                                    <af:convertNumber groupingUsed="false" pattern="#{bindings.Year1.format}"/>
                                </af:inputText>
                            </h:panelGroup>
                            <h:panelGroup id="pg100" layout="block" styleClass="ml-3">
                                <af:outputLabel showRequired="#{bindings.BusinessCaseType1.hints.mandatory}"
                                                value="الجدول" id="ol72"/>
                                <af:inputText value="#{bindings.SchemaId.inputValue}"
                                              required="#{bindings.SchemaId.hints.mandatory}"
                                              columns="#{bindings.SchemaId.hints.displayWidth}"
                                              maximumLength="#{bindings.SchemaId.hints.precision}"
                                              shortDesc="#{bindings.SchemaId.hints.tooltip}" id="it36"
                                              partialTriggers="soc4" rendered="false">
                                    <f:validator binding="#{bindings.SchemaId.validator}"/>
                                    <af:convertNumber groupingUsed="false" pattern="#{bindings.SchemaId.format}"/>
                                </af:inputText>
                                <af:inputText value="#{bindings.CaseSchemaId.inputValue}"
                                              required="#{bindings.CaseSchemaId.hints.mandatory}"
                                              columns="#{bindings.CaseSchemaId.hints.displayWidth}"
                                              maximumLength="#{bindings.CaseSchemaId.hints.precision}"
                                              shortDesc="#{bindings.CaseSchemaId.hints.tooltip}" id="it90"
                                              rendered="false">
                                    <f:validator binding="#{bindings.CaseSchemaId.validator}"/>
                                    <af:convertNumber groupingUsed="false" pattern="#{bindings.CaseSchemaId.format}"/>
                                </af:inputText>
                                <af:selectOneChoice value="#{bindings.LedgerId.inputValue}" required="true"
                                                    shortDesc="#{bindings.LedgerId.hints.tooltip}" id="soc4"
                                                    simple="true"
                                                    valueChangeListener="#{pageFlowScope.AppealDigits.LedgerVCL}"
                                                    autoSubmit="true" readOnly="#{pageFlowScope.search}"
                                                    disabled="#{bindings.UpdatedBy2.inputValue != null}"
                                                    partialTriggers="t2" rendered="false">
                                    <f:selectItems value="#{bindings.LedgerId.items}" id="si4"/>
                                    <f:validator binding="#{bindings.LedgerId.validator}"/>
                                </af:selectOneChoice>
                                <af:selectOneChoice value="#{bindings.LedgerAppeal.inputValue}"
                                                    required="true"
                                                    shortDesc="#{bindings.LedgerAppeal.hints.tooltip}" id="soc1"
                                                    autoSubmit="true"
                                                    valueChangeListener="#{pageFlowScope.AppealDigits.LedgerVCL}"
                                                    disabled="#{bindings.UpdatedBy.inputValue ne null}"
                                                    showRequired="true">
                                    <f:selectItems value="#{bindings.LedgerAppeal.items}" id="si1"/>
                                    <f:validator binding="#{bindings.LedgerAppeal.validator}"/>
                                </af:selectOneChoice>
                                <af:inputText value="#{bindings.UpdatedBy.inputValue}" simple="true"
                                              required="#{bindings.UpdatedBy.hints.mandatory}"
                                              columns="#{bindings.UpdatedBy.hints.displayWidth}"
                                              maximumLength="#{bindings.UpdatedBy.hints.precision}"
                                              shortDesc="#{bindings.UpdatedBy.hints.tooltip}" id="it1" visible="false">
                                    <f:validator binding="#{bindings.UpdatedBy.validator}"/>
                                </af:inputText>
                            </h:panelGroup>
                            <h:panelGroup id="pg5" layout="block" styleClass="ml-3">
                                <af:button text="اعتماد" id="b1"
                                           action="#{pageFlowScope.AppealDigits.confirmAppealDigits}"
                                           disabled="#{bindings.UpdatedBy.inputValue ne null}"/>
                            </h:panelGroup>
                        </h:panelGroup>
                    </h:panelGroup>
                    <af:listView value="#{bindings.AppealsBCParties1.collectionModel}" var="item"
                                 emptyText="#{bindings.AppealsBCParties1.viewable ? 'No data to display.' : 'Access Denied.'}"
                                 fetchSize="#{bindings.AppealsBCParties1.rangeSize}" id="lv1" partialTriggers="::t2">
                        <af:listItem id="li1">
                            <af:panelGroupLayout layout="horizontal" id="pgl1">
                                <f:facet name="separator">
                                    <af:spacer width="30" id="s1"/>
                                </f:facet>
                                <af:panelLabelAndMessage label="الاسم : " id="plam1">
                                    <af:outputText value="#{item.PartyName}"
                                                   shortDesc="#{bindings.AppealsBCParties1.hints.PartyName.tooltip}"
                                                   id="ot1"/>
                                </af:panelLabelAndMessage>
                                <af:panelLabelAndMessage label="الرقم القومى : " id="plam3">
                                    <af:outputText value="#{item.IdNumber}"
                                                   shortDesc="#{bindings.AppealsBCParties1.hints.IdNumber.tooltip}"
                                                   id="ot3"/>
                                </af:panelLabelAndMessage>
                                <af:panelLabelAndMessage label="تاريخ جلسة الاستئناف" id="plam4">
                                    <af:outputText value="#{item.HearingDate}"
                                                   shortDesc="#{bindings.AppealsBCParties1.hints.HearingDate.tooltip}"
                                                   id="ot4"/>
                                </af:panelLabelAndMessage>
                            </af:panelGroupLayout>
                        </af:listItem>
                    </af:listView>
                </af:panelGroupLayout>
            </f:facet>
        </af:panelSplitter>
    </af:panelHeader>
</ui:composition>
