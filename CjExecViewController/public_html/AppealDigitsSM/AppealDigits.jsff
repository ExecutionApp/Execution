    <c:set var="cjexecviewcontrollerBundle" value="#{adfBundle['com.egabi.cjexec.view.CjExecViewControllerBundle']}"/>
    <!-- Search form -->
    <af:panelHeader text="جنح مستانف كلى" id="ph5" styleClass="bcddetail-screen">
        <h:panelGroup id="pg7" layout="block" styleClass="row search-case-panel">
            <h:panelGroup id="pg1" layout="block" styleClass="ml-3">
                <af:outputLabel  value="#{bindings.PoliceNo.hints.label}" id="ol1"/>
                <af:inputText value="#{bindings.PoliceNo.inputValue}" label="#{bindings.PoliceNo.hints.label}" disabled="#{pageFlowScope.disabledValidate}" maximumLength="6" shortDesc="#{bindings.PoliceNo.hints.tooltip}" id="it57" simple="true" contentStyle="    width: 60px;   " autoSubmit="true">
                    <f:validator binding="#{bindings.PoliceNo.validator}"/>
                    <af:convertNumber groupingUsed="false" pattern="#{bindings.PoliceNo.format}"/>
                </af:inputText>
            </h:panelGroup>
            <h:panelGroup id="pg2" layout="block" styleClass="ml-3" rendered="false">
                <af:outputLabel showRequired="#{bindings.ParYear1.hints.mandatory}" value="سنة" id="ol2"/>
                <af:inputText value="#{bindings.ParYear1.inputValue}" required="#{bindings.ParYear1.hints.mandatory}" maximumLength="4" shortDesc="#{bindings.ParYear1.hints.tooltip}" id="it58" simple="true" disabled="#{pageFlowScope.disabledValidate}" contentStyle="    width: 60px;     min-width: 60px !important;" autoSubmit="true" validator="#{cjValidator.yearValidator}">
                    <f:validator binding="#{bindings.ParYear1.validator}"/>
                    <af:convertNumber groupingUsed="false" pattern="#{bindings.ParYear1.format}"/>
                </af:inputText>
            </h:panelGroup>
            <h:panelGroup id="pg3" layout="block" styleClass="col-md-2 col-sm-12" rendered="false">
                <af:outputLabel showRequired="#{bindings.BusinessCaseType1.hints.mandatory}" value="الجدول" id="ol3"/>
                <af:selectOneChoice value="#{bindings.BusinessCaseType1.inputValue}" label="#{bindings.BusinessCaseType1.label}" required="true" disabled="#{pageFlowScope.disabledValidate}" shortDesc="#{bindings.BusinessCaseType1.hints.tooltip}" id="soc9" simple="true">
                    <f:selectItems value="#{bindings.BusinessCaseType1.items}" id="si9"/>
                    <f:validator binding="#{bindings.BusinessCaseType1.validator}"/>
                </af:selectOneChoice>
            </h:panelGroup>
            <h:panelGroup id="pg98" layout="block" styleClass="col-md-2 col-sm-12">
                <af:outputLabel showRequired="true" value="النيابة الكلية" id="ol70"/>
                <af:selectOneChoice value="#{bindings.NeyabKolyaa.inputValue}" required="true" shortDesc="#{bindings.NeyabKolyaa.hints.tooltip}" id="soc28" simple="true" disabled="#{sessionScope.userInfo.entityDegree eq '39' or sessionScope.userInfo.entityDegree eq '3' }" autoSubmit="true">
                    <f:selectItems value="#{bindings.NeyabKolyaa.items}" id="si28"/>
                    <f:validator binding="#{bindings.NeyabKolyaa.validator}"/>
                </af:selectOneChoice>
            </h:panelGroup>
            <h:panelGroup id="pg97" layout="block" styleClass="col-md-2 col-sm-12">
                <af:outputLabel showRequired="true" value="النيابة الجزئية" id="ol54"/>
                <af:selectOneChoice value="#{bindings.NeyabGozayaa.inputValue}" required="true" shortDesc="#{bindings.NeyabGozayaa.hints.tooltip}" id="soc17" partialTriggers="soc28" simple="true" autoSubmit="true" showRequired="true"
                                    immediate="true"
                                    disabled="#{(sessionScope.userInfo.entityDegree eq '3'  or pageFlowScope.disabledValidate) and sessionScope.userInfo.errandEntUser eq '0'}">
                    <f:selectItems value="#{bindings.NeyabGozayaa.items}" id="si17"/>
                    <f:validator binding="#{bindings.NeyabGozayaa.validator}"/>
                </af:selectOneChoice>
            </h:panelGroup>
            <h:panelGroup id="pg4" layout="block" styleClass="col-md-2 col-sm-12" rendered="false">
                <af:outputLabel showRequired="true" value="#{bindings.OrigEntity.label}" id="ol4"/>
                <af:selectOneChoice value="#{bindings.OrigEntity.inputValue}" label="#{bindings.OrigEntity.label}" disabled="#{pageFlowScope.disabledValidate}" shortDesc="#{bindings.OrigEntity.hints.tooltip}" id="soc10" simple="true" partialTriggers="soc17" valueChangeListener="#{pageFlowScope.BCDetails.policeVCL}" showRequired="true" required="#{bindings.NeyabGozayaa.inputValue ne null}" autoSubmit="true"
                                    rendered="false">
                    <f:selectItems value="#{bindings.OrigEntity.items}" id="si10"/>
                    <f:validator binding="#{bindings.OrigEntity.validator}"/>
                </af:selectOneChoice>
            </h:panelGroup>
            <!-- Search toggle -->
            <af:link text="#{bindings.JudgmentType.inputValue}" id="l30" visible="false"/>
            <h:panelGroup id="pg28" layout="block" styleClass="col-md-3 col-sm-12" rendered="#{bindings.OrigEntity.inputValue ne null}">
                <af:link styleClass="btn-search" id="l8" icon="/resources/images/magnifier.png"
                         action="#{pageFlowScope.AppealDigits.searchBC}" disabled="#{pageFlowScope.disabledValidate}">
                    <?audit suppress oracle.jdeveloper.jsp.validate-children?>
                    <!--<af:image  source="/resources/images/accept.png" id="i10"/>-->
                    <af:setPropertyListener from="false" to="#{pageFlowScope.judge}" type="action"/>
                    <af:setPropertyListener from="false" to="#{pageFlowScope.search}" type="action"/>
                </af:link>
                 </h:panelGroup>
            <!-- end Search toggle -->
        </h:panelGroup>
          <af:link text=" #{bindings.Id6.inputValue}" id="l7" visible="false"/>
        <f:facet name="toolbar"/>
        <af:table value="#{bindings.AppealBCROVO1.collectionModel}" var="row" rows="#{bindings.AppealBCROVO1.rangeSize}"
                  emptyText="#{bindings.AppealBCROVO1.viewable ? 'No data to display.' : 'Access Denied.'}"
                  rowBandingInterval="0" selectedRowKeys="#{bindings.AppealBCROVO1.collectionModel.selectedRow}"
                  selectionListener="#{bindings.AppealBCROVO1.collectionModel.makeCurrent}" rowSelection="single"
