                        <af:inputText value="#{bindings.Status.inputValue}" label="#{bindings.Status.hints.label}"
                                      required="#{bindings.Status.hints.mandatory}"
                                      columns="#{bindings.Status.hints.displayWidth}"
                                      maximumLength="#{bindings.Status.hints.precision}"
                                      shortDesc="#{bindings.Status.hints.tooltip}" id="it13">
                            <f:validator binding="#{bindings.Status.validator}"/>
                            <af:convertNumber groupingUsed="false" pattern="#{bindings.Status.format}"/>
                        </af:inputText>
                        <af:inputText value="#{bindings.Action.inputValue}" label="#{bindings.Action.hints.label}"
                                      required="#{bindings.Action.hints.mandatory}"
                                      columns="#{bindings.Action.hints.displayWidth}"
                                      maximumLength="#{bindings.Action.hints.precision}"
                                      shortDesc="#{bindings.Action.hints.tooltip}" id="it14">
                            <f:validator binding="#{bindings.Action.validator}"/>
                            <af:convertNumber groupingUsed="false" pattern="#{bindings.Action.format}"/>
                        </af:inputText>
                        <af:inputText value="#{bindings.TemplateObjectsId.inputValue}"
                                      label="#{bindings.TemplateObjectsId.hints.label}"
                                      required="#{bindings.TemplateObjectsId.hints.mandatory}"
                                      columns="#{bindings.TemplateObjectsId.hints.displayWidth}"
                                      maximumLength="#{bindings.TemplateObjectsId.hints.precision}"
                                      shortDesc="#{bindings.TemplateObjectsId.hints.tooltip}" id="it15">
                            <f:validator binding="#{bindings.TemplateObjectsId.validator}"/>
                            <af:convertNumber groupingUsed="false" pattern="#{bindings.TemplateObjectsId.format}"/>
                        </af:inputText>
                        <af:inputText value="#{bindings.AssignedTo.inputValue}"
                                      label="#{bindings.AssignedTo.hints.label}"
                                      required="#{bindings.AssignedTo.hints.mandatory}"
                                      columns="#{bindings.AssignedTo.hints.displayWidth}"
                                      maximumLength="#{bindings.AssignedTo.hints.precision}"
                                      shortDesc="#{bindings.AssignedTo.hints.tooltip}" id="it16">
                            <f:validator binding="#{bindings.AssignedTo.validator}"/>
                            <af:convertNumber groupingUsed="false" pattern="#{bindings.AssignedTo.format}"/>
                        </af:inputText>
                        <af:inputText value="#{bindings.IntegStatus.inputValue}"
                                      label="#{bindings.IntegStatus.hints.label}"
                                      required="#{bindings.IntegStatus.hints.mandatory}"
                                      columns="#{bindings.IntegStatus.hints.displayWidth}"
                                      maximumLength="#{bindings.IntegStatus.hints.precision}"
                                      shortDesc="#{bindings.IntegStatus.hints.tooltip}" id="it17">
                            <f:validator binding="#{bindings.IntegStatus.validator}"/>
                            <af:convertNumber groupingUsed="false" pattern="#{bindings.IntegStatus.format}"/>
                        </af:inputText>
                        <af:inputText value="#{bindings.ScannedUrl.inputValue}"
                                      label="#{bindings.ScannedUrl.hints.label}"
                                      required="#{bindings.ScannedUrl.hints.mandatory}"
                                      columns="#{bindings.ScannedUrl.hints.displayWidth}"
                                      maximumLength="#{bindings.ScannedUrl.hints.precision}"
                                      shortDesc="#{bindings.ScannedUrl.hints.tooltip}" id="it18">
                            <f:validator binding="#{bindings.ScannedUrl.validator}"/>
                        </af:inputText>
                        <af:inputText value="#{bindings.ActiveDetail.inputValue}"
                                      label="#{bindings.ActiveDetail.hints.label}"
                                      required="#{bindings.ActiveDetail.hints.mandatory}"
                                      columns="#{bindings.ActiveDetail.hints.displayWidth}"
                                      maximumLength="#{bindings.ActiveDetail.hints.precision}"
                                      shortDesc="#{bindings.ActiveDetail.hints.tooltip}" id="it19">
                            <f:validator binding="#{bindings.ActiveDetail.validator}"/>
                            <af:convertNumber groupingUsed="false" pattern="#{bindings.ActiveDetail.format}"/>
                        </af:inputText>
                        <af:inputText value="#{bindings.ParentId.inputValue}" label="#{bindings.ParentId.hints.label}"
                                      required="#{bindings.ParentId.hints.mandatory}"
                                      columns="#{bindings.ParentId.hints.displayWidth}"
                                      maximumLength="#{bindings.ParentId.hints.precision}"
                                      shortDesc="#{bindings.ParentId.hints.tooltip}" id="it20">
                            <f:validator binding="#{bindings.ParentId.validator}"/>
                            <af:convertNumber groupingUsed="false" pattern="#{bindings.ParentId.format}"/>
                        </af:inputText>
                        <af:inputText value="#{bindings.DeleteFlag.inputValue}"
                                      label="#{bindings.DeleteFlag.hints.label}"
                                      required="#{bindings.DeleteFlag.hints.mandatory}"
                                      columns="#{bindings.DeleteFlag.hints.displayWidth}"
                                      maximumLength="#{bindings.DeleteFlag.hints.precision}"
                                      shortDesc="#{bindings.DeleteFlag.hints.tooltip}" id="it21">
                            <f:validator binding="#{bindings.DeleteFlag.validator}"/>
                        </af:inputText>
                        <af:inputText value="#{bindings.ParentCaseDetailsId.inputValue}"
                                      label="#{bindings.ParentCaseDetailsId.hints.label}"
                                      required="#{bindings.ParentCaseDetailsId.hints.mandatory}"
                                      columns="#{bindings.ParentCaseDetailsId.hints.displayWidth}"
                                      maximumLength="#{bindings.ParentCaseDetailsId.hints.precision}"
                                      shortDesc="#{bindings.ParentCaseDetailsId.hints.tooltip}" id="it22">
                            <f:validator binding="#{bindings.ParentCaseDetailsId.validator}"/>
                            <af:convertNumber groupingUsed="false" pattern="#{bindings.ParentCaseDetailsId.format}"/>
                        </af:inputText>
                        <af:inputText value="#{bindings.Ledger.inputValue}" label="#{bindings.Ledger.hints.label}"
                                      required="#{bindings.Ledger.hints.mandatory}"
                                      columns="#{bindings.Ledger.hints.displayWidth}"
                                      maximumLength="#{bindings.Ledger.hints.precision}"
                                      shortDesc="#{bindings.Ledger.hints.tooltip}" id="it23">
