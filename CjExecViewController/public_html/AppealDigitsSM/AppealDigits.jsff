            <af:column headerText="الرقم القضائى" id="c1" width="1250">
                <af:outputText value="#{row.Code}" shortDesc="#{bindings.AppealBCROVO1.hints.Code.tooltip}" id="ot8"/>
            </af:column>
            <f:facet name="detailStamp">
                <h:panelGroup id="pg6" styleClass="row search-case-panel">
                    <af:inputText value="#{bindings.Id.inputValue}" label="#{bindings.Id.hints.label}"
