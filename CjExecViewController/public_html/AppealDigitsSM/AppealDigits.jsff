                                <af:convertNumber groupingUsed="false" pattern="#{bindings.Id8.format}"/>
                            </af:outputText>
                        </h:panelGroup>
                    </h:panelGroup>
                    <h:panelGroup id="pg10" styleClass="hasr-case-panel d-flex">
                        <h:panelGroup id="pg12" layout="block" styleClass="ml-3">
