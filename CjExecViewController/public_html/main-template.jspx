        <af:resource type="javascript" source="/resources/js/pdfobject.min.js"/>
        <af:resource type="javascript">
          function changeTab(actionEvent) {
              var inputTextComponen = actionEvent.getSource();
              AdfCustomEvent.queue(inputTextComponen, "changeTabServer", 
              {
                  one : 't'
              },
              false);
              actionEvent.cancel();
          }
        </af:resource>
        <af:resource type="javascript">
          function viewPdf() {
              var options = {
                  pdfOpenParams :  {
                      toolbar : '0', view : 'FitH'
                  }
              };
              console.log(document.querySelector('[id$="if1"]').src);
              PDFObject.embed(document.querySelector('[id$="if1"]').src, "#pdf", options);
          }

          function printPdf() {
              var iframe = document.querySelector('[id$="pdfPrint"]');
              console.log(iframe);
              iframe.focus();
              iframe.contentWindow.print();
          }

          function doPrint(url) {
              console.log('do print');
              window.open(url);
          }
        </af:resource>
    </af:pageTemplateDef>
</jsp:root>