<?xml version='1.0' encoding='UTF-8'?>
<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.1" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
          xmlns:f="http://java.sun.com/jsf/core" xmlns:h="http://java.sun.com/jsf/html"
          xmlns:c="http://java.sun.com/jsp/jstl/core">
            
    <c:set var="cjexecviewcontrollerBundle" value="#{adfBundle['com.egabi.cjexec.view.CjExecViewControllerBundle']}"/>
    <jsp:directive.page contentType="text/html;charset=UTF-8"/>
    <af:pageTemplateDef var="attrs" definition="private">
        <af:xmlContent>
            <!--StyleSheets-->
            <af:resource type="css" source="/resources/css/fonts.css"/>
            <!--<af:resource type="css" source="https://fonts.googleapis.com/css?family=Cairo"/>-->
            <af:resource type="css" source="/resources/css/font-awesome.min.css"/>
            <af:resource type="css" source="/resources/css/bootstrap.css"/>
            <af:resource type="css" source="/resources/css/bootstrap-rtl.css"/>
            <!--<af:resource type="javascript" source="https://code.jquery.com/jquery-3.4.1.min.js"/>
            <af:resource source="/js/jquery.growl.js" type="javascript"/>
            <af:resource source="/style/jquery.growl.css" type="css"/>-->
            <af:resource type="javascript">
              /*Loader for the website*/
              $(document).ready(function () {
                  setTimeout(function () {
                      $('.overlay').fadeOut('slow');
                  },
                  3000);
              });
            </af:resource>
            <af:resource type="css">
                .af_inputDate_launch-icon-style {
                    top: -5px !important;
                    left: -75px !important;
                }

                .af_inputDate_content {
                    min-width: 0% !important;
                }
            </af:resource>
            <meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" name="viewport"/>
            <component xmlns="http://xmlns.oracle.com/adf/faces/rich/component">
                <description/>
                <display-name>main-template</display-name>
                <facet>
                    <facet-name>header</facet-name>
                </facet>
                <facet>
                    <facet-name>status</facet-name>
                </facet>
                <facet>
                    <facet-name>footer</facet-name>
                </facet>
                <facet>
                    <facet-name>center</facet-name>
                </facet>
                <attribute>
                    <attribute-name>header</attribute-name>
                    <attribute-class>java.lang.String</attribute-class>
                </attribute>
                <attribute>
                    <attribute-name>footer</attribute-name>
                    <attribute-class>java.lang.String</attribute-class>
                </attribute>
            </component>
        </af:xmlContent>
        <h:panelGroup id="pt_pg9" styleClass="overlay" layout="block" rendered="false">
            <h:panelGroup id="pt_pg10" styleClass="loadingWrapper" layout="block">
                <h:panelGroup id="pt_pg11" styleClass="lds-css" layout="block">
                    <h:panelGroup id="pt_pg12" styleClass="lds-dual-ring" layout="block">
                        <af:image source="/resources/img/logo2.png" id="pt_i3"/>
                        <h:panelGroup layout="block" id="pt_pg13"/>
                    </h:panelGroup>
                </h:panelGroup>
            </h:panelGroup>
        </h:panelGroup>
        <h:panelGroup id="pt_pg14" styleClass="h-100" layout="block">
            <h:panelGroup layout="block" styleClass="header  container-fluid" id="pt_pg1">
                <af:facetRef facetName="status"/>
                <af:statusIndicator rendered="#{attrs.showStatusIndicator}" styleClass="" id="status"/>
                <af:facetRef facetName="header"/>
                <h:panelGroup layout="block" styleClass="d-flex header-logo" id="pt_pg6">
                    <af:image styleClass="logo" source="/resources/img/logo.png" id="pt_i1"/>
                    <h:panelGroup layout="block" styleClass="d-flex flex-column logo-txt" id="pt_pg5">
                        <!--Need to be dynamic bundle value-->
                        <af:outputText styleClass="slogan01" value="النيابة العامة" id="pt_ot3"/>
                        <af:outputLabel styleClass="slogan02" value="نظام التنفيذ والمطالبة" id="pt_ol1"/>
                    </h:panelGroup>
                </h:panelGroup>
                <h:panelGroup layout="block" styleClass="welcome-login d-flex align-items-center" id="pt_pg4">
                    <h:panelGroup layout="block" styleClass="userholder" id="pt_pg7">
                        <af:image source="/resources/img/user.png" id="pt_i2" styleClass="userimg"/>
                    </h:panelGroup>
                    <!--Need to be dynamic bundle value-->
                    <!--<af:outputText value="مرحبا بك" id="pt_ot1"/>-->
                    <af:spacer width="10" height="10" id="pt_s1"/>
                    <af:outputText value="#{sessionScope.userInfo.firstName}" id="pt_ot2"/>
                    <br/>
                    <af:outputText value=" #{sessionScope.userInfo.entityName == null? '':' نيابة ' } #{sessionScope.userInfo.entityName}"
                                   id="pt_ot5"/>
                    <af:button immediate="true" text="#{bundle.LOGOUT}" action="#{ExcTemplateBean.logout}" id="b1"/>
                </h:panelGroup>
            </h:panelGroup>
            <h:panelGroup styleClass="menu-holder" id="pt_pg15">
                <h:panelGroup id="pt_pg8" layout="block" styleClass="d-flex">
                    <!-- Simplified Mode action="#{ExcTemplateBean.getNavPage}"-->
                    <af:menuBar id="pt_mb1" inlineStyle="color:white;" styleClass="hover-Effect">
                        <af:menu text="التنفيذ" id="pt_m5">
                            <af:commandMenuItem text="حصر احكام" id="pt_cmi71"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}"
                                                inlineStyle="color:white;" immediate="true" styleClass="hover-Effect"
                                                rendered="#{sessionScope.mode eq '2'}">
                                <af:setPropertyListener from="#{'SimplifiedModeBC'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="إدراج احكام القضايا الغير مدرجة" id="pt_cmi29"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}"
                                                inlineStyle="color:white;" immediate="true" styleClass="hover-Effect"
                                                rendered="#{sessionScope.mode eq '2'}">
                                <af:setPropertyListener from="#{'NewClaims'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="تحديد الجلسات و المؤجلات" id="pt_cmi6"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}"
                                                inlineStyle="color:white;" immediate="true" styleClass="hover-Effect"
                                                rendered="#{sessionScope.mode eq '2'}">
                                <af:setPropertyListener from="#{'SimplifidModeProvisionInclusion'}"
                                                        to="#{ExcTemplateBean.source}" type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="إجراءات تنفيذ الاحكام" id="pt_cmi72" immediate="true"
                                                styleClass="hover-Effect" rendered="#{sessionScope.mode eq '2'}"
                                                inlineStyle="color:white;"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}">
                                <af:setPropertyListener from="#{'goActions'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="متابعه مذكرة الضبط" id="pt_cmi17"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}"
                                                inlineStyle="color:white;" immediate="true" styleClass="hover-Effect"
                                                rendered="#{sessionScope.mode eq '2'}">
                                <af:setPropertyListener from="#{'PreviewArrest'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="جنح مستائنف كلى" id="pt_cmi15" immediate="true"
                                                styleClass="hover-Effect" rendered="#{sessionScope.mode eq '2'}"
                                                inlineStyle="color:white;"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}">
                                <af:setPropertyListener from="#{'AppealDigitsSM'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="الاجراءت المتخذة من خارج النيابة" id="pt_cmi76" immediate="true"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}"
                                                inlineStyle="color:white;" styleClass="hover-Effect"
                                                rendered="#{sessionScope.mode eq '2'}">
                                <af:setPropertyListener from="#{'goInventory'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="إعتماد قرارات النيابة" id="pt_cmi25" immediate="true"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}"
                                                inlineStyle="color:white;" styleClass="hover-Effect"
                                                rendered="#{sessionScope.mode eq '2'}" visible="true">
                                <af:setPropertyListener from="#{'ProsecutorApproveProc'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="إعتماد  إجراءات الطعن على الاحكام" id="pt_cmi31" immediate="true"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}"
                                                inlineStyle="color:white;" styleClass="hover-Effect"
                                                rendered="#{sessionScope.mode eq '2'}" visible="true">
                                <af:setPropertyListener from="#{'goJudgmentAppealApproval'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="إجراءات تنفيذ الوافدين" id="pt_cmi32" immediate="true"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}"
                                                inlineStyle="color:white;" styleClass="hover-Effect"
                                                rendered="#{sessionScope.mode eq '2'}" visible="true">
                                <af:setPropertyListener from="#{'goExpatriateProcedures'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="إعتماد إجراءات الوافدين لنيابة الضبط" id="pt_cmi33" immediate="true"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}"
                                                inlineStyle="color:white;" styleClass="hover-Effect"
                                                rendered="#{sessionScope.mode eq '2'}" visible="true">
                                <af:setPropertyListener from="#{'goExpatriateProcAppealApproval'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="إعتماد إجراءات الوافدين لنيابة الحكم" id="pt_cmi34" immediate="true"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}"
                                                inlineStyle="color:white;" styleClass="hover-Effect"
                                                rendered="#{sessionScope.mode eq '2'}" visible="true">
                                <af:setPropertyListener from="#{'goExpatriateProcSecondApproval'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                        </af:menu>
                        <af:menu text="المطالبات" id="pt_m2">
                            <af:commandMenuItem text="المطالبه" id="pt_cmi78" immediate="true"
                                                styleClass="hover-Effect" inlineStyle="color:white;"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}"
                                                rendered="#{sessionScope.mode eq '2'}">
                                <af:setPropertyListener from="#{'Claim'}" to="#{ExcTemplateBean.source}" type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="إجرات المطالبه" id="pt_cmi73" styleClass="hover-Effect"
                                                immediate="true" action="#{ExcTemplateBean.checkDirtyDataAction}"
                                                inlineStyle="color:white;"
                                                rendered="#{sessionScope.mode eq '2'}">
                                <af:setPropertyListener from="#{'claimProcedure'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="إجرات المطالبه من خارج النيابه" id="pt_cmi75" immediate="true"
                                                styleClass="hover-Effect" inlineStyle="color:white;"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}"
                                                rendered="#{sessionScope.mode eq '2'}" visible="false">
                                <af:setPropertyListener from="#{'claimProcedureLog'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                        </af:menu>
                        <af:menu text="#{bundle.SEARCH}" id="pt_m33">
                            <af:commandMenuItem text="#{bundle.GENERAL_SEARCH}" id="pt_cmi100"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}"
                                                inlineStyle="color:white;" immediate="true" styleClass="hover-Effect"
                                                rendered="#{sessionScope.mode eq '2'}">
                                <af:setPropertyListener from="#{'searchByPartyCaseHasr'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="#{cjexecviewcontrollerBundle.NATIONAL_ID_LOG}" id="pt_cmi5"
                                                inlineStyle="color:white;"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}" immediate="true"
                                                styleClass="hover-Effect"
                                                rendered="#{sessionScope.mode eq '2'}">
                                <af:setPropertyListener from="#{'nIdServiceLog'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                        </af:menu>
                        <af:menu text="#{bundle.MAIN_REPORTS}" id="pt_m3">
                            <af:commandMenuItem text="تفعيل الجلسات" id="pt_cmi23"
                                                inlineStyle="color:white;"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}" immediate="true"
                                                styleClass="hover-Effect" rendered="#{sessionScope.mode eq '2'}"
                                               >
                                <af:setPropertyListener from="#{'ActivateAgenda'}"
                                                        to="#{ExcTemplateBean.source}" type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="متابعة أعمال التنفيذ" id="pt_cmi30" inlineStyle="color:white;"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}" immediate="true"
                                                styleClass="hover-Effect" rendered="#{sessionScope.mode eq '2'}">
                                <af:setPropertyListener from="#{'AgendaReservation'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="يومية التنفيذ" id="pt_cmi26" inlineStyle="color:white;"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}" immediate="true"
                                                styleClass="hover-Effect" rendered="#{sessionScope.mode eq '2'}">
                                <af:setPropertyListener from="#{'ExectionDaily'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="#{bundle.HASR_NOT_IN_DB}" id="pt_cmi4w" inlineStyle="color:white;"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}" immediate="true"
                                                styleClass="hover-Effect" rendered="#{sessionScope.mode eq '2'}">
                                <af:setPropertyListener from="#{'hasrNoInDB'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="#{bundle.TOTAL_PROCEDURES_REPORT}" id="pt_l1"
                                                inlineStyle="color:white;"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}" immediate="true"
                                                styleClass="hover-Effect" rendered="#{sessionScope.mode eq '2'}">
                                <af:setPropertyListener from="#{'goTotalProceduresReport'}"
                                                        to="#{ExcTemplateBean.source}" type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="#{bundle.HASR_REPORT}" id="pt_cmi1" inlineStyle="color:white;"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}" immediate="true"
                                                styleClass="hover-Effect" rendered="#{sessionScope.mode eq '2'}">
                                <af:setPropertyListener from="#{'goHasrReport'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="#{bundle.DETAILS_HASR_REPORT}" id="pt_cmi2"
