                                                action="#{ExcTemplateBean.checkDirtyDataAction}" immediate="true"
                                                styleClass="hover-Effect" rendered="#{sessionScope.mode eq '2'}">
                                <af:setPropertyListener from="#{'goHasrDetailsReport'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="#{bundle.HASR_ID_NUMB_REPORT}" id="pt_cmi3"
                                                inlineStyle="color:white;"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}" immediate="true"
                                                styleClass="hover-Effect" rendered="#{sessionScope.mode eq '2'}">
                                <af:setPropertyListener from="#{'goHasrIdNumbReport'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="#{bundle.TOTAL_MOTALABAT_REPORT}" id="pt_cmi4"
                                                inlineStyle="color:white;"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}" immediate="true"
                                                styleClass="hover-Effect" rendered="#{sessionScope.mode eq '2'}">
                                <af:setPropertyListener from="#{'goTotalMotalabatReport'}"
                                                        to="#{ExcTemplateBean.source}" type="action"/>
                            </af:commandMenuItem>
                        </af:menu>
                        <af:menu text="#{bundle.AUDIT}" id="pt_m1">
                            <af:commandMenuItem text="#{cjexecviewcontrollerBundle.AUDIT_UPDATE}" id="pt_71far"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}"
                                                inlineStyle="color:white;" immediate="true" styleClass="hover-Effect"
                                                rendered="#{sessionScope.mode eq '2'}">
                                <af:setPropertyListener from="#{'auditUpdate'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                            <af:commandMenuItem text="#{cjexecviewcontrollerBundle.DISPLAT_AUDIT}" id="pt_71fara"
                                                action="#{ExcTemplateBean.checkDirtyDataAction}"
                                                inlineStyle="color:white;" immediate="true" styleClass="hover-Effect"
                                                rendered="#{sessionScope.mode eq '2'}">
                                <af:setPropertyListener from="#{'displayAuditUpdate'}" to="#{ExcTemplateBean.source}"
                                                        type="action"/>
                            </af:commandMenuItem>
                        </af:menu>
                        <!-- Full Mode -->
                        <af:commandMenuItem text="#{bundle.ADD_JUDGMENT}"
                                            action="#{ExcTemplateBean.checkDirtyDataAction}" inlineStyle="color:white;"
                                            styleClass="hover-Effect" immediate="true" id="pt_gmi44"
                                            rendered="#{sessionScope.mode eq '1'}">
                            <af:setPropertyListener from="addJudg" to="#{sessionScope.screen_name}" type="action"/>
                            <af:setPropertyListener from="#{'addJudg'}" to="#{ExcTemplateBean.source}" type="action"/>
                        </af:commandMenuItem>
                        <af:commandMenuItem text="#{bundle.UPDATE_CLASS}"
                                            action="#{ExcTemplateBean.checkDirtyDataAction}" inlineStyle="color:white;"
                                            styleClass="hover-Effect" immediate="true" id="pt_gmi555"
                                            rendered="#{sessionScope.mode eq '1'}">
                            <af:setPropertyListener from="updateJudg" to="#{sessionScope.screen_name}" type="action"/>
                            <af:setPropertyListener from="#{'updateJudg'}" to="#{ExcTemplateBean.source}"
                                                    type="action"/>
                        </af:commandMenuItem>
                        <af:commandMenuItem text="#{bundle.JUDG_CLASS}" action="#{ExcTemplateBean.checkDirtyDataAction}"
                                            inlineStyle="color:white;" styleClass="hover-Effect" immediate="true"
                                            id="pt_gmi25" rendered="#{sessionScope.mode eq '1'}">
                            <af:setPropertyListener from="#{'judgClass'}" to="#{ExcTemplateBean.source}" type="action"/>
                        </af:commandMenuItem>
                        <af:commandMenuItem text="#{bundle.FOLDERS}" action="#{ExcTemplateBean.checkDirtyDataAction}"
                                            inlineStyle="color:white;" styleClass="hover-Effect" immediate="true"
                                            id="pt_gmi77" rendered="#{sessionScope.mode eq '1'}">
                            <af:setPropertyListener from="search" to="#{sessionScope.screen_name}" type="action"/>
                            <af:setPropertyListener from="#{'folders'}" to="#{ExcTemplateBean.source}" type="action"/>
                        </af:commandMenuItem>
                        <af:commandMenuItem text="المعارضة من اى نيابة" action="#{ExcTemplateBean.checkDirtyDataAction}"
