                                  shortDesc="#{bindings.JudgementResolutionC1.hints.tooltip}" id="it28">
                        <f:validator binding="#{bindings.JudgementResolutionC1.validator}"/>
                    </af:inputText>
                    <af:inputText value="#{bindings.FolderName.inputValue}" label="#{bindings.FolderName.hints.label}"
                                  required="#{bindings.FolderName.hints.mandatory}" readOnly="true" columns="20"
                                  maximumLength="#{bindings.FolderName.hints.precision}"
                                  shortDesc="#{bindings.FolderName.hints.tooltip}" id="it29">
                        <f:validator binding="#{bindings.FolderName.validator}"/>
                    </af:inputText>
                </af:panelFormLayout>
            </af:dialog>
        </af:popup>
        <af:popup childCreation="deferred" autoCancel="disabled" id="p3" contentDelivery="lazyUncached">
