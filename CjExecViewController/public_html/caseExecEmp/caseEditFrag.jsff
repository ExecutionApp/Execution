<?xml version='1.0' encoding='UTF-8'?>
<ui:composition xmlns:ui="http://java.sun.com/jsf/facelets" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
                xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jsp/jstl/core"
                xmlns:h="http://java.sun.com/jsf/html">
    <c:set var="cjexecviewcontrollerBundle" value="#{adfBundle['com.egabi.cjexec.view.CjExecViewControllerBundle']}"/>
    <af:panelGroupLayout id="pgl1" layout="vertical" partialTriggers="b12 b11">
        <af:panelHeader text="#{cjexecviewcontrollerBundle.BASIC_DATA}" id="ph1">
            <f:facet name="context"/>
            <f:facet name="toolbar">
                <af:toolbar   id="t1" partialTriggers="b12 b11">
                    <af:link text="#{pageFlowScope.caseEditBean.readonly}" id="l11" rendered="false"/>
                    <af:button styleClass="send-btn btn-primary btn-md ripple"
                               disabled="#{pageFlowScope.caseEditBean.readonly}"
                               text="#{bundle.SET_CLASSIFIED}" id="b12"
                               action="#{pageFlowScope.caseEditBean.setClassified}"
                               rendered="#{bindings.FolderDataROV.estimatedRowCount >0}" partialTriggers="b11"/>
                    <af:button disabled="#{pageFlowScope.caseEditBean.readonly}" text="#{bundle.SAVE_AND_VIEW_CHARGES}"
                               id="b11" action="#{pageFlowScope.caseEditBean.createCountingFolder}"
                               styleClass="save-btn"/>
                    <af:button styleClass="save-btn" disabled="#{pageFlowScope.caseEditBean.readonly}"
                               text="#{bundle.SAVE}" id="b6" action="#{pageFlowScope.caseEditBean.save}"/>
                    <af:button styleClass="save-btn" disabled="#{pageFlowScope.caseEditBean.readonly}"
                               text="#{bundle.SAVE_AND_EXIT}" id="b1" action="save"/>
                    <af:button styleClass="back-btn" text="#{bundle.BACK}" id="b2" action="cancel" immediate="true"/>
                </af:toolbar>
            </f:facet>
            <f:facet name="menuBar"/>
            <f:facet name="legend"/>
            <f:facet name="info"/>
            <af:panelGroupLayout id="pgl4">
                <af:panelList id="pl1">
                    <af:iterator id="i1" value="#{bindings.ValidateChargeDecisionsErrROV.collectionModel}" var="error">
                        <af:outputText inlineStyle="color: Red;" value="#{error.ErrMsg}" id="ot23"/>
                    </af:iterator>
                </af:panelList>
            </af:panelGroupLayout>
            <!--Case Data-->
            <h:panelGroup layout="block" styleClass="casedata-panel" id="pg1">
                <af:outputText styleClass="casedata-header" value="#{bundle.CASE_DATA}" id="ot31"/>
                
                <h:panelGroup layout="block" styleClass="row" id="pg2">
                    <h:panelGroup layout="block" styleClass="col-md-2 col-sm-12" id="pg3">
                        <af:outputLabel value="#{bindings.CaseNumber.hints.label}" id="ol1"/>
                        <af:inputText simple="true" value="#{bindings.CaseNumber.inputValue}"
                                      label="#{bindings.CaseNumber.hints.label}"
                                      required="#{bindings.CaseNumber.hints.mandatory}" disabled="true"
                                      maximumLength="#{bindings.CaseNumber.hints.precision}"
                                      shortDesc="#{bindings.CaseNumber.hints.tooltip}" id="it2">
                            <f:validator binding="#{bindings.CaseNumber.validator}"/>
                        </af:inputText>
                    </h:panelGroup>
                    <h:panelGroup layout="block" styleClass="col-md-2 col-sm-12" id="pg4">
                        <af:outputLabel value="#{bindings.HearingDate.hints.label}" id="ol2"/>
                        <af:inputDate simple="true" value="#{bindings.HearingDate.inputValue}" disabled="true"
                                      label="#{bindings.HearingDate.hints.label}"
                                      required="#{bindings.HearingDate.hints.mandatory}"
                                      shortDesc="#{bindings.HearingDate.hints.tooltip}" id="id1">
                            <f:validator binding="#{bindings.HearingDate.validator}"/>
                            <af:convertDateTime pattern="#{bindings.HearingDate.format}"/>
                        </af:inputDate>
                    </h:panelGroup>
                    <h:panelGroup layout="block" styleClass="col-md-2 col-sm-12" id="pg5">
                        <af:outputLabel value="#{bindings.JudgmentType.hints.label}" id="ol3"/>
                        <af:inputText simple="true" value="#{bindings.JudgmentType.inputValue}"
                                      label="#{bindings.JudgmentType.hints.label}" disabled="true"
                                      required="#{bindings.JudgmentType.hints.mandatory}"
                                      maximumLength="#{bindings.JudgmentType.hints.precision}"
                                      shortDesc="#{bindings.JudgmentType.hints.tooltip}" id="it3">
                            <f:validator binding="#{bindings.JudgmentType.validator}"/>
                        </af:inputText>
                    </h:panelGroup>
                    <h:panelGroup layout="block" rendered="false" styleClass="col-md-2 col-sm-12" id="pg6">
                        <af:outputLabel value="#{bindings.HearingResId.hints.label}" id="ol4"/>
                        <af:inputText simple="true" value="#{bindings.HearingResId.inputValue}"
                                      label="#{bindings.HearingResId.hints.label}" disabled="true"
                                      required="#{bindings.HearingResId.hints.mandatory}"
                                      maximumLength="#{bindings.HearingResId.hints.precision}"
                                      shortDesc="#{bindings.HearingResId.hints.tooltip}" id="it4" rendered="false">
                            <f:validator binding="#{bindings.HearingResId.validator}"/>
                            <af:convertNumber groupingUsed="false" pattern="#{bindings.HearingResId.format}"/>
                        </af:inputText>
                    </h:panelGroup>
                    <h:panelGroup layout="block" rendered="false" styleClass="col-md-2 col-sm-12" id="pg7">
                        <af:outputLabel value="#{bindings.HearingDateId.hints.label}" id="ol5"/>
                        <af:inputText simple="true" value="#{bindings.HearingDateId.inputValue}"
                                      label="#{bindings.HearingDateId.hints.label}" disabled="true"
                                      required="#{bindings.HearingDateId.hints.mandatory}"
                                      maximumLength="#{bindings.HearingDateId.hints.precision}"
                                      shortDesc="#{bindings.HearingDateId.hints.tooltip}" id="it5" rendered="false">
                            <f:validator binding="#{bindings.HearingDateId.validator}"/>
                            <af:convertNumber groupingUsed="false" pattern="#{bindings.HearingDateId.format}"/>
                        </af:inputText>
                    </h:panelGroup>
                </h:panelGroup>
            </h:panelGroup>
            <!--END Case Data-->
            <af:panelTabbed position="above" id="pt4">
                <af:showDetailItem id="tab6" text="#{bindings.JudgementResolution.hints.label}" disclosed="true">
                    <h:panelGroup layout="block" styleClass="col-md-12 col-sm-12" id="pg8">
                        <af:inputText simple="true" value="#{bindings.JudgementResolution.inputValue}" disabled="true"
                                      label=" " required="#{bindings.JudgementResolution.hints.mandatory}"
                                      maximumLength="#{bindings.JudgementResolution.hints.precision}"
                                      shortDesc="#{bindings.JudgementResolution.hints.tooltip}" id="it1" rows="2">
                            <f:validator binding="#{bindings.JudgementResolution.validator}"/>
                        </af:inputText>
                    </h:panelGroup>
                </af:showDetailItem>
                <af:showDetailItem id="tab7" text="#{cjexecviewcontrollerBundle.ATTACMENTS}">
                    <af:region value="#{bindings.caseattachmentstf1.regionModel}" id="r1"/>
                </af:showDetailItem>
                <af:showDetailItem id="tab8" text="#{bundle.FEES}">
                    <af:toolbar id="t10" styleClass="float-right">
                        <af:button actionListener="#{bindings.CreateInsert4.execute}" text="#{bundle.ADD}"
                                   disabled="#{pageFlowScope.caseEditBean.readonly}" id="b13"/>
                    </af:toolbar>
                    <af:table value="#{bindings.ExcCourtBcDecisionFeesView.collectionModel}" var="row"
                              rows="#{bindings.ExcCourtBcDecisionFeesView.rangeSize}"
                              emptyText="#{bindings.ExcCourtBcDecisionFeesView.viewable ? 'No data to display.' : 'Access Denied.'}"
                              rowBandingInterval="0"
                              selectedRowKeys="#{bindings.ExcCourtBcDecisionFeesView.collectionModel.selectedRow}"
                              selectionListener="#{bindings.ExcCourtBcDecisionFeesView.collectionModel.makeCurrent}"
                              rowSelection="single" fetchSize="#{bindings.ExcCourtBcDecisionFeesView.rangeSize}"
                              id="t11" partialTriggers="::b13 b14" columnStretching="column:c34"
                              contentDelivery="immediate" scrollPolicy="page">
                        <af:column headerText="#{bindings.ExcCourtBcDecisionFeesView.hints.FeesTypeId.label}" id="c34"
                                   width="300">
                            <af:selectOneChoice value="#{row.bindings.FeesTypeId.inputValue}"
                                                disabled="#{pageFlowScope.caseEditBean.readonly}"
                                                label="#{row.bindings.FeesTypeId.label}"
                                                required="#{bindings.ExcCourtBcDecisionFeesView.hints.FeesTypeId.mandatory}"
                                                shortDesc="#{bindings.ExcCourtBcDecisionFeesView.hints.FeesTypeId.tooltip}"
                                                id="soc6" autoSubmit="true">
                                <f:selectItems value="#{row.bindings.FeesTypeId.items}" id="si6"/>
                                <f:validator binding="#{row.bindings.FeesTypeId.validator}"/>
                            </af:selectOneChoice>
                        </af:column>
                        <af:column headerText="#{bindings.ExcCourtBcDecisionFeesView.hints.RangeId.label}" id="c38">
                            <af:selectOneChoice disabled="#{not (row.CalculationType eq 2)}"
                                                value="#{row.bindings.RangeId.inputValue}"
                                                label="#{row.bindings.RangeId.label}"
                                                required="#{bindings.ExcCourtBcDecisionFeesView.hints.RangeId.mandatory}"
                                                shortDesc="#{bindings.ExcCourtBcDecisionFeesView.hints.RangeId.tooltip}"
                                                id="soc7" partialTriggers="soc6" autoSubmit="true"
                                                readOnly="#{pageFlowScope.caseEditBean.readonly}">
                                <f:selectItems value="#{row.bindings.RangeId.items}" id="si7"/>
                                <f:validator binding="#{row.bindings.RangeId.validator}"/>
                            </af:selectOneChoice>
                        </af:column>
                        <af:column headerText="#{bindings.ExcCourtBcDecisionFeesView.hints.FeesAmount.label}" id="c35"
                                   width="300" rendered="true">
                            <af:inputText value="#{row.bindings.FeesAmount.inputValue}" disabled="true"
                                          partialTriggers="soc6 soc7"
                                          label="#{bindings.ExcCourtBcDecisionFeesView.hints.FeesAmount.label}"
                                          required="#{bindings.ExcCourtBcDecisionFeesView.hints.FeesAmount.mandatory}"
                                          maximumLength="#{bindings.ExcCourtBcDecisionFeesView.hints.FeesAmount.precision}"
                                          shortDesc="#{bindings.ExcCourtBcDecisionFeesView.hints.FeesAmount.tooltip}"
                                          id="it21">
                                <f:validator binding="#{row.bindings.FeesAmount.validator}"/>
                                <af:convertNumber groupingUsed="false"
                                                  pattern="#{bindings.ExcCourtBcDecisionFeesView.hints.FeesAmount.format}"/>
                                <af:validateLongRange minimum="0"/>
                            </af:inputText>
                        </af:column>
                        <af:column id="c36" width="300">
                            <af:button actionListener="#{bindings.Delete4.execute}" text="#{bundle.DELETE}"
                                       disabled="#{pageFlowScope.caseEditBean.readonly}" immediate="true" id="b14"
                                       styleClass="button-danger danger-btn"/>
                        </af:column>
                        <af:column headerText="#{bindings.ExcCourtBcDecisionFeesView.hints.FeesSettingId.label}"
                                   id="c39" rendered="false">
                            <af:outputText value="#{row.FeesSettingId}"
                                           shortDesc="#{bindings.ExcCourtBcDecisionFeesView.hints.FeesSettingId.tooltip}"
                                           id="ot28">
                                <af:convertNumber groupingUsed="false"
                                                  pattern="#{bindings.ExcCourtBcDecisionFeesView.hints.FeesSettingId.format}"/>
                            </af:outputText>
                        </af:column>
                        <af:column rendered="false"
                                   headerText="#{bindings.ExcCourtBcDecisionFeesView.hints.CalculationType.label}"
                                   id="c40">
                            <af:outputText value="#{row.CalculationType}"
                                           shortDesc="#{bindings.ExcCourtBcDecisionFeesView.hints.CalculationType.tooltip}"
                                           id="ot29">
                                <af:convertNumber groupingUsed="false"
                                                  pattern="#{bindings.ExcCourtBcDecisionFeesView.hints.CalculationType.format}"/>
                            </af:outputText>
                        </af:column>
                    </af:table>
                    <af:panelHeader text="   " id="ph5">
                        <f:facet name="toolbar"/>
                    </af:panelHeader>
                </af:showDetailItem>
                <af:showDetailItem id="tab9" text="#{cjexecviewcontrollerBundle.FOLDER_DATA}">
                    <af:panelGroupLayout rendered="#{bindings.FolderDataROV.estimatedRowCount gt 0}" id="pgl19">
                        <af:table value="#{bindings.FolderDataROV.collectionModel}" var="row"
                                  rows="#{bindings.FolderDataROV.rangeSize}"
                                  emptyText="#{bindings.FolderDataROV.viewable ? 'No data to display.' : 'Access Denied.'}"
                                  rowBandingInterval="0"
                                  selectedRowKeys="#{bindings.FolderDataROV.collectionModel.selectedRow}"
                                  selectionListener="#{bindings.FolderDataROV.collectionModel.makeCurrent}"
                                  rowSelection="single" fetchSize="10" id="t8"
                                  columnStretching="multiple" contentDelivery="immediate" styleClass="AFStretchWidth">
                            <af:column headerText="#{bindings.FolderDataROV.hints.SequenceNumber.label}" id="c24"
                                       rendered="false" width="25%">
                                <af:outputText value="#{row.SequenceNumber}"
                                               shortDesc="#{bindings.FolderDataROV.hints.SequenceNumber.tooltip}"
                                               id="ot16">
                                    <af:convertNumber groupingUsed="false"
                                                      pattern="#{bindings.FolderDataROV.hints.SequenceNumber.format}"/>
                                </af:outputText>
                            </af:column>
                            <af:column headerText="#{bindings.FolderDataROV.hints.Year.label}" id="c25" rendered="false"
                                       width="25%">
                                <af:outputText value="#{row.Year}"
                                               shortDesc="#{bindings.FolderDataROV.hints.Year.tooltip}" id="ot17">
                                    <af:convertNumber groupingUsed="false"
                                                      pattern="#{bindings.FolderDataROV.hints.Year.format}"/>
                                </af:outputText>
                            </af:column>
                            <af:column headerText="#{bindings.FolderDataROV.hints.CountNumber.label}" id="c26"
                                       width="25%">
                                <af:outputText value="#{row.CountNumber}"
                                               shortDesc="#{bindings.FolderDataROV.hints.CountNumber.tooltip}"
                                               id="ot18"/>
                            </af:column>
                            <af:column headerText="#{bindings.FolderDataROV.hints.FolderName.label}" id="c37"
                                       width="25%">
                                <af:outputText value="#{row.FolderName}"
                                               shortDesc="#{bindings.FolderDataROV.hints.FolderName.tooltip}"
                                               id="ot27"/>
                            </af:column>
                            <af:column headerText="#{bindings.FolderDataROV.hints.FullName.label}" id="c27" width="25%">
                                <af:outputText value="#{row.FullName}"
                                               shortDesc="#{bindings.FolderDataROV.hints.FullName.tooltip}" id="ot19"/>
                            </af:column>
                            <af:column headerText="#{bindings.FolderDataROV.hints.IdNumber.label}" id="c28" width="25%">
                                <af:outputText value="#{row.IdNumber}"
                                               shortDesc="#{bindings.FolderDataROV.hints.IdNumber.tooltip}" id="ot20"/>
                            </af:column>
                            <af:column headerText="#{bindings.FolderDataROV.hints.JudgementResolutionC.label}" id="c29"
                                       rendered="false" width="25%"/>
                            <af:column headerText="#{bindings.FolderDataROV.hints.JudgmentText.label}" id="c50"
                                       rendered="false" width="25%"/>
                            <af:column id="c41" width="25%">
                                <af:button text="#{bundle.CHANGE_SEQ_NUMBER}" id="b16"
                                           disabled="#{pageFlowScope.caseEditBean.readonly}">
                                    <af:showPopupBehavior popupId="::p2"/>
                                </af:button>
                            </af:column>
                            <f:facet name="detailStamp">
                                <af:panelGroupLayout id="pgl11" layout="scroll">
                                    <af:panelLabelAndMessage label="#{bindings.FolderDataROV.hints.JudgementResolutionC.label}"
                                                             id="plam3">
                                        <af:outputText value="#{row.JudgementResolutionC}"
                                                       shortDesc="#{bindings.FolderDataROV.hints.JudgementResolutionC.tooltip}"
                                                       id="ot21"/>
                                    </af:panelLabelAndMessage>
                                    <af:panelLabelAndMessage label="#{bindings.FolderDataROV.hints.JudgmentText.label}"
                                                             id="plam4">
                                        <af:outputText value="#{row.JudgmentText}"
                                                       shortDesc="#{bindings.FolderDataROV.hints.JudgementResolutionC.tooltip}"
                                                       id="ot30"/>
                                    </af:panelLabelAndMessage>
                                </af:panelGroupLayout>
                            </f:facet>
                        </af:table>
                    </af:panelGroupLayout>
                </af:showDetailItem>
                <af:showDetailItem id="tab10" text="#{bundle.FEES_DETAILS}">
                    <af:panelGroupLayout     rendered="#{bindings.PartyDebtROV.estimatedRowCount gt 0}"  partialTriggers="b12 b11 b6 b1 b2" id="pgl20">
                        <af:table value="#{bindings.PartyDebtROV.collectionModel}" var="row"
                                  rows="#{bindings.PartyDebtROV.rangeSize}"
                                  emptyText="#{bindings.PartyDebtROV.viewable ? 'No data to display.' : 'Access Denied.'}"
                                  rowBandingInterval="0"
                                  selectedRowKeys="#{bindings.PartyDebtROV.collectionModel.selectedRow}"
                                  selectionListener="#{bindings.PartyDebtROV.collectionModel.makeCurrent}"
                                  rowSelection="single" fetchSize="#{bindings.PartyDebtROV.rangeSize}" id="t9"
                                  columnStretching="column:c33" contentDelivery="immediate">
                            <af:column headerText="#{bindings.PartyDebtROV.hints.PartyFullName.label}" id="c33"
                                       width="200">
                                <af:outputText value="#{row.PartyFullName}"
                                               shortDesc="#{bindings.PartyDebtROV.hints.PartyFullName.tooltip}"
                                               id="ot26"/>
                            </af:column>
                            <af:column headerText="#{bindings.PartyDebtROV.hints.FeesTypeName.label}" id="c30"
                                       width="200">
                                <af:outputText value="#{row.FeesTypeName}"
                                               shortDesc="#{bindings.PartyDebtROV.hints.FeesTypeName.tooltip}"
                                               id="ot22"/>
                            </af:column>
                            <af:column headerText="#{bindings.PartyDebtROV.hints.Amount.label}" id="c31" width="200">
                                <af:outputText value="#{row.Amount}"
                                               shortDesc="#{bindings.PartyDebtROV.hints.Amount.tooltip}" id="ot24">
                                    <af:convertNumber groupingUsed="false"
                                                      pattern="#{bindings.PartyDebtROV.hints.Amount.format}"/>
                                </af:outputText>
                            </af:column>
                            <af:column headerText="#{bindings.PartyDebtROV.hints.PaidAmount.label}" id="c32" width="200"
                                       rendered="false">
                                <af:outputText value="#{row.PaidAmount}"
                                               shortDesc="#{bindings.PartyDebtROV.hints.PaidAmount.tooltip}" id="ot25">
                                    <af:convertNumber groupingUsed="false"
                                                      pattern="#{bindings.PartyDebtROV.hints.PaidAmount.format}"/>
                                </af:outputText>
                            </af:column>
                        </af:table>
                    </af:panelGroupLayout>
                </af:showDetailItem>
            </af:panelTabbed>
            <af:panelHeader text=" " id="ph2">
                <f:facet name="context">
                    <af:panelLabelAndMessage label="#{bundle.CHARGE_FOR_EVERY_CONVICTION}" id="plam1">
                        <af:panelGroupLayout id="pgl7" clientComponent="true">
                            <af:link disabled="#{pageFlowScope.caseEditBean.readonly}" id="l1"
                                     rendered="#{bindings.JudgementType.inputValue eq 2}" styleClass="tglOn"
                                     action="#{pageFlowScope.caseEditBean.createChargeForAll}">
                                <!--<f:setPropertyActionListener target="#{bindings.JudgementType.inputValue}" value="#{1}"/>-->
                            </af:link>
                            <af:link disabled="#{pageFlowScope.caseEditBean.readonly}"
                                     action="#{pageFlowScope.caseEditBean.createChargeForEach}" id="l2"
                                     rendered="#{bindings.JudgementType.inputValue eq 1}" styleClass="tglOff">
                                <!--<f:setPropertyActionListener target="#{bindings.JudgementType.inputValue}" value="#{2}"/>-->
                            </af:link>
                        </af:panelGroupLayout>
                    </af:panelLabelAndMessage>
                </f:facet>
                <f:facet name="toolbar"/>
                <f:facet name="menuBar"/>
                <f:facet name="legend"/>
                <f:facet name="info"/>
                <af:panelFormLayout id="pfl1" fieldWidth="200px" labelWidth="150px" rows="1" maxColumns="4"
                                    rendered="false"/>
                <af:panelTabbed position="above" id="pt6">
                    <af:showDetailItem id="tab11" text="#{cjexecviewcontrollerBundle.CONVICTEDS_Tab}" disclosed="true">
                        <af:panelAccordion id="pa1" reorder="enable" discloseNone="true">
                            <af:forEach items="#{bindings.CaseConvictedPartiesROV.children}" var="Parties"
                                        varStatus="vs">
                                <af:showDetailItem text="#{Parties.PartyOrder+1}#{'  / '} #{ Parties.FullName}"
                                                   id="sdi1" stretchChildren="first"
                                                   disclosureListener="#{pageFlowScope.caseEditBean.discolse}">
                                    <f:attribute name="CourtCircleDateId" value="#{Parties.CourtCircleDateId}"/>
                                    <f:attribute name="PartyID" value="#{Parties.PartyId}"/>
                                    <f:attribute name="FolderActionID" value="#{Parties.FolderActionId}"/>
                                    <af:panelTabbed position="above" id="pt2">
                                        <af:showDetailItem text="#{bindings.JudgementResolutionC.hints.label}"
                                                           id="sdi9">
                                            <af:inputText value="#{Parties.JudgementResolutionC}"
                                                          required="#{bindings.JudgementResolutionC.hints.mandatory}"
                                                          columns="100"
                                                          maximumLength="#{bindings.JudgementResolutionC.hints.precision}"
                                                          shortDesc="#{bindings.JudgementResolutionC.hints.tooltip}"
                                                          id="it20" rows="4">
                                                <f:validator binding="#{bindings.JudgementResolutionC.validator}"/>
                                            </af:inputText>
                                        </af:showDetailItem>
                                        <af:showDetailItem id="tab4" text="#{bundle.CHARGED_PERSON_DATA}"
                                                           disclosed="true">
                                            <h:panelGroup id="pg15" layout="block" styleClass="row">
                                                <h:panelGroup id="pg16" styleClass="col-md-2 col-sm-12" layout="block">
                                                    <af:outputLabel value="#{bindings.IdNumber.hints.label}" id="ol9"/>
                                                    <af:inputText value="#{Parties.IdNumber}"
                                                                  label="#{bindings.IdNumber.hints.label}"
                                                                  required="#{bindings.IdNumber.hints.mandatory}"
                                                                  disabled="true"
                                                                  maximumLength="#{bindings.IdNumber.hints.precision}"
                                                                  shortDesc="#{bindings.IdNumber.hints.tooltip}"
                                                                  id="it14" simple="true">
                                                        <f:validator binding="#{bindings.IdNumber.validator}"/>
                                                    </af:inputText>
                                                </h:panelGroup>
                                                <h:panelGroup id="pg17" styleClass="col-md-2 col-sm-12" layout="block">
                                                    <af:outputLabel value="#{bindings.FullName.hints.label}" id="ol10"/>
                                                    <af:inputText value="#{Parties.FullName}"
                                                                  label="#{bindings.FullName.hints.label}"
                                                                  required="#{bindings.FullName.hints.mandatory}"
                                                                  disabled="true"
                                                                  maximumLength="#{bindings.FullName.hints.precision}"
                                                                  shortDesc="#{bindings.FullName.hints.tooltip}"
                                                                  id="it15" simple="true">
                                                        <f:validator binding="#{bindings.FullName.validator}"/>
                                                    </af:inputText>
                                                </h:panelGroup>
                                                <h:panelGroup id="pg18" styleClass="col-md-2 col-sm-12" layout="block">
                                                    <af:outputLabel value="#{bindings.Age.hints.label}" id="ol11"/>
                                                    <af:inputText value="#{Parties.Age}"
                                                                  label="#{bindings.Age.hints.label}"
                                                                  required="#{bindings.Age.hints.mandatory}"
                                                                  disabled="true"
                                                                  maximumLength="#{bindings.Age.hints.precision}"
                                                                  shortDesc="#{bindings.Age.hints.tooltip}" id="it16"
                                                                  simple="true">
                                                        <f:validator binding="#{bindings.Age.validator}"/>
                                                    </af:inputText>
                                                </h:panelGroup>
                                                <h:panelGroup id="pg19" layout="block" styleClass="col-md-2 col-sm-12">
                                                    <af:outputLabel value="#{bindings.Gender.hints.label}" id="ol12"/>
                                                    <af:inputText value="#{Parties.Gender}"
                                                                  label="#{bindings.Gender.hints.label}"
                                                                  required="#{bindings.Gender.hints.mandatory}"
                                                                  disabled="true"
                                                                  maximumLength="#{bindings.Gender.hints.precision}"
                                                                  shortDesc="#{bindings.Gender.hints.tooltip}" id="it17"
                                                                  simple="true">
                                                        <f:validator binding="#{bindings.Gender.validator}"/>
                                                    </af:inputText>
                                                </h:panelGroup>
                                                <h:panelGroup id="pg20" layout="block" styleClass="col-md-2 col-sm-12">
