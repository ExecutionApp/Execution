            <af:button actionListener="#{bindings.Rollback.execute}" disabled="#{!bindings.Rollback.enabled}" immediate="true" id="b2" action="#{pageFlowScope.BCDetails.Cancel}" text="#{cjexecviewcontrollerBundle.cancel}" rendered="false">
