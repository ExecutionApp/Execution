            <af:link text="أضف متهم" styleClass="add-btn-guilty float-left" id="l20" rendered="false" actionListener="#{bindings.addNewconvictedMany.execute}">
                <?audit suppress oracle.jdeveloper.jsp.validate-children?>
                <af:setPropertyListener from="true" to="#{bindings.Flag.inputValue}" type="action"/>
