                           function clickk(){
                        var button = AdfPage.PAGE.findComponentByAbsoluteId("pt1:r1:0:l31");
                       
                        AdfActionEvent.queue(button,true);
                       
                }
                           
                           
                                
                                  function handleEnterEventaddParty(evt) {

                                      var _keyCode = evt.getKeyCode();
                                      //check for Enter Keyi +
                                      console.log()
                                      if (_keyCode == AdfKeyStroke.ENTER_KEY) {

                                          var comp = evt.getSource();
                                          AdfCustomEvent.queue(comp, "EnterEventsAddParty", 
                                          {
                                              fvalue : comp.getSubmittedValue()
                                          },
                                          false);

                                          evt.cancel();
                                      }
                                  }
                                </af:resource>
