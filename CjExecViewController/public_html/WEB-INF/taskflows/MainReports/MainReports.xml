<?xml version="1.0" encoding="UTF-8" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="MainReports">
    <default-activity>resetReports</default-activity>
    <data-control-scope>
      <shared/>
    </data-control-scope>
    <managed-bean id="__1">
      <managed-bean-name>mainReportsBean</managed-bean-name>
      <managed-bean-class>com.egabi.cjexec.view.beans.mainrepotrs.MainReportsBean</managed-bean-class>
      <managed-bean-scope>pageFlow</managed-bean-scope>
    </managed-bean>
    <view id="home">
      <page>/pages/com/egabi/MainRepports/home.jsff</page>
    </view>
    <view id="TotalProceduresReport">
      <page>/pages/com/egabi/MainRepports/procedures/TotalProceduresReport.jsff</page>
    </view>
    <view id="TotalHasrReport">
      <page>/pages/com/egabi/MainRepports/hasr/TotalHasrReport.jsff</page>
    </view>
    <view id="HasrDetailsReport">
      <page>/pages/com/egabi/MainRepports/hasr/HasrDetailsReport.jsff</page>
    </view>
    <view id="HasrIdNumbReport">
      <page>/pages/com/egabi/MainRepports/hasr/HasrIdNumbReport.jsff</page>
    </view>
    <view id="TotalMotalabatReport">
      <page>/pages/com/egabi/MainRepports/motalabat/TotalMotalabatReport.jsff</page>
    </view>
    <method-call id="resetReports">
      <method>#{bindings.resetReports.execute}</method>
      <outcome>
        <fixed-outcome>resetReports</fixed-outcome>
      </outcome>
    </method-call>
    <control-flow-rule id="__4">
      <from-activity-id>home</from-activity-id>
      <control-flow-case id="__5">
        <from-outcome>goProcedureReport</from-outcome>
        <to-activity-id>TotalProceduresReport</to-activity-id>
      </control-flow-case>
      <control-flow-case id="__8">
        <from-outcome>goTotalHasrReport</from-outcome>
        <to-activity-id>TotalHasrReport</to-activity-id>
      </control-flow-case>
      <control-flow-case id="__11">
        <from-outcome>goHasrDetailsReport</from-outcome>
        <to-activity-id>HasrDetailsReport</to-activity-id>
      </control-flow-case>
      <control-flow-case id="__14">
        <from-outcome>goHasrIdNumbReport</from-outcome>
        <to-activity-id>HasrIdNumbReport</to-activity-id>
      </control-flow-case>
      <control-flow-case id="__17">
        <from-outcome>goTotalMotalabatReport</from-outcome>
        <to-activity-id>TotalMotalabatReport</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__6">
      <from-activity-id>TotalProceduresReport</from-activity-id>
      <control-flow-case id="__7">
        <from-outcome>goBack</from-outcome>
        <to-activity-id>resetReports</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__12">
      <from-activity-id>HasrDetailsReport</from-activity-id>
      <control-flow-case id="__13">
        <from-outcome>goBack</from-outcome>
        <to-activity-id>resetReports</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__15">
      <from-activity-id>HasrIdNumbReport</from-activity-id>
      <control-flow-case id="__16">
        <from-outcome>goBack</from-outcome>
        <to-activity-id>resetReports</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__18">
      <from-activity-id>TotalMotalabatReport</from-activity-id>
      <control-flow-case id="__19">
        <from-outcome>goBack</from-outcome>
        <to-activity-id>resetReports</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__20">
      <from-activity-id>resetReports</from-activity-id>
      <control-flow-case id="__21">
        <from-outcome>resetReports</from-outcome>
        <to-activity-id>home</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__2">
      <from-activity-id>TotalHasrReport</from-activity-id>
      <control-flow-case id="__3">
        <from-outcome>goBack</from-outcome>
        <to-activity-id>resetReports</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <use-page-fragments/>
  </task-flow-definition>
</adfc-config>
