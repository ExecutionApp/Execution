<?xml version="1.0" encoding="UTF-8" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="TotalProceduresReport-TF">
    <default-activity>resetReports</default-activity>
    <data-control-scope>
      <shared/>
    </data-control-scope>
    <managed-bean id="__1">
      <managed-bean-name>mainReportsBean</managed-bean-name>
      <managed-bean-class>com.egabi.cjexec.view.beans.mainrepotrs.MainReportsBean</managed-bean-class>
      <managed-bean-scope>pageFlow</managed-bean-scope>
    </managed-bean>
    <view id="TotalProceduresReport">
      <page>/pages/com/egabi/MainRepports/procedures/TotalProceduresReport.jsff</page>
    </view>
    <method-call id="resetReports">
      <method>#{bindings.resetReports.execute}</method>
      <outcome>
        <fixed-outcome>resetReports</fixed-outcome>
      </outcome>
    </method-call>
    <control-flow-rule id="__4">
      <from-activity-id>resetReports</from-activity-id>
      <control-flow-case id="__5">
        <from-outcome>resetReports</from-outcome>
        <to-activity-id>TotalProceduresReport</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <use-page-fragments/>
  </task-flow-definition>
</adfc-config>
