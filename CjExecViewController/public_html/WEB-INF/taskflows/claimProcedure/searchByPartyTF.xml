        <view id="searchByPartyFrag">
            <page>/pages/com/egabi/claimProcedure/searchByPartyFrag.jsff</page>
        </view>
        <task-flow-call id="nIdServiceTF">
            <task-flow-reference>
                <document>/WEB-INF/taskflows/nIdService/nIdServiceTF.xml</document>
                <id>nIdServiceTF</id>
            </task-flow-reference>
            <input-parameter id="__6">
                <name>nIdParam</name>
                <value>#{pageFlowScope.nIdParam}</value>
            </input-parameter>
            <input-parameter id="__7">
                <name>fcnParam</name>
