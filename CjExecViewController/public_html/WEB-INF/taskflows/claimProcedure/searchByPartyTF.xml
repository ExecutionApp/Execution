            </run-as-dialog>
        </task-flow-call>
        <control-flow-rule id="__12">
            <from-activity-id>searchByPartyFrag</from-activity-id>
            <control-flow-case id="__13">
                <from-outcome>nId</from-outcome>
                <to-activity-id>nIdServiceTF</to-activity-id>
            </control-flow-case>
        </control-flow-rule>
        <use-page-fragments/>
    </task-flow-definition>
</adfc-config>
