<?xml version="1.0" encoding="windows-1252" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="Par_Parties-TF">
    <default-activity>ExecuteWithParams</default-activity>
    <data-control-scope>
      <shared/>
    </data-control-scope>
    <input-parameter-definition id="__3">
      <name>partyId</name>
      <value>#{pageFlowScope.partyId}</value>
      <class>java.lang.String</class>
    </input-parameter-definition>
    <managed-bean id="__4">
      <managed-bean-name>partiesBean</managed-bean-name>
      <managed-bean-class>com.egabi.cjexec.view.beans.parties.ParPartiesBean</managed-bean-class>
      <managed-bean-scope>pageFlow</managed-bean-scope>
    </managed-bean>
    <view id="UpdateParty">
      <page>/pages/com/egabi/party/UpdateParty.jsff</page>
    </view>
    <method-call id="ExecuteWithParams">
      <method>#{bindings.ExecuteWithParams.execute}</method>
      <outcome>
        <fixed-outcome>ExecuteWithParams</fixed-outcome>
      </outcome>
    </method-call>
    <control-flow-rule id="__1">
      <from-activity-id>ExecuteWithParams</from-activity-id>
      <control-flow-case id="__2">
        <from-outcome>ExecuteWithParams</from-outcome>
        <to-activity-id>UpdateParty</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <use-page-fragments/>
  </task-flow-definition>
</adfc-config>
