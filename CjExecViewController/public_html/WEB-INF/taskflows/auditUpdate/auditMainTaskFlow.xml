<?xml version="1.0" encoding="windows-1252" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="auditMainTaskFlow">
    <default-activity>ValidatePoliceReportCustom</default-activity>
    <data-control-scope>
      <shared/>
    </data-control-scope>
    <managed-bean id="__1">
      <managed-bean-name>AuditUpdateBean</managed-bean-name>
      <managed-bean-class>cjexecviewcontroller.AuditUpdateBean</managed-bean-class>
      <managed-bean-scope>request</managed-bean-scope>
    </managed-bean>
    <view id="auditMainFrag">
      <page>/pages/com/egabi/auditUpdate/auditMainFrag.jsff</page>
    </view>
    <method-call id="ValidatePoliceReportCustom">
      <method>#{bindings.ValidatePoliceReportCustom.execute}</method>
      <outcome>
        <fixed-outcome>ValidatePoliceReportCustom</fixed-outcome>
      </outcome>
    </method-call>
    <control-flow-rule id="__2">
      <from-activity-id>ValidatePoliceReportCustom</from-activity-id>
      <control-flow-case id="__3">
        <from-outcome>ValidatePoliceReportCustom</from-outcome>
        <to-activity-id>auditMainFrag</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <use-page-fragments/>
  </task-flow-definition>
</adfc-config>
