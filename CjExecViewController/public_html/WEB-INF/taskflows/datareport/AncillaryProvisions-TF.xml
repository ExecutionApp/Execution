<?xml version="1.0" encoding="UTF-8" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="AncillaryProvisions-TF">
    <default-activity>preEnterReportsSearch</default-activity>
    <data-control-scope>
      <shared/>
    </data-control-scope>
       <managed-bean id="__3">
      <managed-bean-name>printDafatertBean</managed-bean-name>
      <managed-bean-class>com.egabi.cjexec.view.beans.reports.PrintDafatertBean</managed-bean-class>
      <managed-bean-scope>request</managed-bean-scope>
    </managed-bean>
   
    <view id="AncillaryProvisions">
      <page>/pages/com/egabi/Reports/AncillaryProvisions.jsff</page>
    </view>
    
    <method-call id="preEnterReportsSearch">
      <method>#{bindings.preEnterReportsSearch.execute}</method>
      <outcome>
        <fixed-outcome>preEnterReportsSearch</fixed-outcome>
      </outcome>
    </method-call>
    <control-flow-rule id="__1">
      <from-activity-id>preEnterReportsSearch</from-activity-id>
      <control-flow-case id="__2">
        <from-outcome>preEnterReportsSearch</from-outcome>
        <to-activity-id>ProceduresScreen</to-activity-id>
      </control-flow-case>
      <control-flow-case id="__4">
        <from-outcome>preEnterReportsSearch</from-outcome>
        <to-activity-id>AncillaryProvisions</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <use-page-fragments/>
    
  </task-flow-definition>
</adfc-config>
