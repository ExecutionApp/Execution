<?xml version="1.0" encoding="UTF-8" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="case-attachments-tf">
    <default-activity>ExecuteWithParams</default-activity>
    <data-control-scope>
      <shared/>
    </data-control-scope>
    <input-parameter-definition id="__1">
      <name>businessCaseId</name>
      <value>#{pageFlowScope.businessCaseId}</value>
      <class>java.math.BigDecimal</class>
      <required/>
    </input-parameter-definition>
    <managed-bean id="__4">
      <managed-bean-name>caseAttachBean</managed-bean-name>
      <managed-bean-class>com.egabi.cjexec.view.beans.caseexecemp.CaseAttach</managed-bean-class>
      <managed-bean-scope>pageFlow</managed-bean-scope>
    </managed-bean>
    <view id="caseAttachFrag">
      <page>/caseExecEmp/caseAttachFrag.jsff</page>
    </view>
    <method-call id="ExecuteWithParams">
      <method>#{bindings.ExecuteWithParams.execute}</method>
      <outcome>
        <fixed-outcome>ExecuteWithParams</fixed-outcome>
      </outcome>
    </method-call>
    <control-flow-rule id="__7">
      <from-activity-id>ExecuteWithParams</from-activity-id>
      <control-flow-case id="__8">
        <from-outcome>ExecuteWithParams</from-outcome>
        <to-activity-id>caseAttachFrag</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <use-page-fragments/>
  </task-flow-definition>
</adfc-config>
