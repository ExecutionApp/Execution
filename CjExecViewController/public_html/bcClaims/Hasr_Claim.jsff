                                          function handleEnterEventSearch(evt) {

                                              var _keyCode = evt.getKeyCode();
                                              //check for Enter Keyi +
                                              console.log()
                                              if (_keyCode == AdfKeyStroke.ENTER_KEY) {

                                                  var comp = evt.getSource();
                                                  AdfCustomEvent.queue(comp, "EnterEvents", 
                                                  {
                                                      fvalue : comp.getSubmittedValue()
                                                  },
                                                  false);

                                                  evt.cancel();
                                              }
                                          }
                                          function addSpace() {

          if (event.keyCode == 32) {
              event.target.value = event.target.value + ' ';
          }
      }
                                             function handleEnterEventSearch2(evt) {

                                              var _keyCode = evt.getKeyCode();
                                              //check for Enter Keyi +
                                              console.log()
                                              if (_keyCode == AdfKeyStroke.ENTER_KEY) {

