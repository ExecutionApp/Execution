            <h:panelGroup id="pg28" layout="block" styleClass="col-md-3 col-sm-12" rendered="#{bindings.OrigEntity.inputValue ne null}">
                <af:link styleClass="btn-search" id="l8" icon="/resources/images/magnifier.png"  
