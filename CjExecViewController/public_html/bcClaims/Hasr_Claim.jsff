                                                  AdfCustomEvent.queue(comp, "EnterEvents2", 
                                                  {
                                                      fvalue : comp.getSubmittedValue()
                                                  },
                                                  false);

                                                  evt.cancel();
                                              }
                                          }
                                        </af:resource>
