                                        <f:selectItems value="#{bindings.ClaimTypeId.items}" id="si22"/>
                                        <f:validator binding="#{bindings.ClaimTypeId.validator}"/>
                                    </af:selectOneChoice>
                                </af:panelFormLayout>
                                <af:inputText value="#{bindings.ClaimTypeId1.inputValue}"
                                              required="#{bindings.ClaimTypeId1.hints.mandatory}"
                                              columns="#{bindings.ClaimTypeId1.hints.displayWidth}"
                                              maximumLength="#{bindings.ClaimTypeId1.hints.precision}"
                                              shortDesc="#{bindings.ClaimTypeId1.hints.tooltip}" id="it128"
                                              visible="false">
                                    <f:validator binding="#{bindings.ClaimTypeId1.validator}"/>
                                    <af:convertNumber groupingUsed="false" pattern="#{bindings.ClaimTypeId1.format}"/>
                                </af:inputText>
                                <af:inputText value="#{bindings.BusinessCaseNumberFull.inputValue}" simple="true"
                                              required="#{bindings.BusinessCaseNumberFull.hints.mandatory}"
                                              columns="#{bindings.BusinessCaseNumberFull.hints.displayWidth}"
                                              maximumLength="#{bindings.BusinessCaseNumberFull.hints.precision}"
                                              shortDesc="#{bindings.BusinessCaseNumberFull.hints.tooltip}" id="it123"
                                              visible="false">
                                    <f:validator binding="#{bindings.BusinessCaseNumberFull.validator}"/>
                                </af:inputText>
                                <af:inputText value="#{bindings.IdNumber1.inputValue}" simple="true"
                                              required="#{bindings.IdNumber1.hints.mandatory}"
                                              columns="#{bindings.IdNumber1.hints.displayWidth}"
                                              maximumLength="#{bindings.IdNumber1.hints.precision}"
                                              shortDesc="#{bindings.IdNumber1.hints.tooltip}" id="it120"
                                              visible="false">
                                    <f:validator binding="#{bindings.IdNumber1.validator}"/>
                                </af:inputText>
                                <af:inputText value="#{bindings.PartyId.inputValue}" simple="true"
                                              required="#{bindings.PartyId.hints.mandatory}"
                                              columns="#{bindings.PartyId.hints.displayWidth}"
                                              maximumLength="#{bindings.PartyId.hints.precision}"
                                              shortDesc="#{bindings.PartyId.hints.tooltip}" id="it110" visible="false">
                                    <f:validator binding="#{bindings.PartyId.validator}"/>
                                </af:inputText>
                                <af:inputText value="#{bindings.PartyName.inputValue}" simple="true"
                                              required="#{bindings.PartyName.hints.mandatory}"
                                              columns="#{bindings.PartyName.hints.displayWidth}"
                                              maximumLength="#{bindings.PartyName.hints.precision}"
                                              shortDesc="#{bindings.PartyName.hints.tooltip}" id="it109"
                                              visible="false">
                                    <f:validator binding="#{bindings.PartyName.validator}"/>
                                </af:inputText>
                                <af:button actionListener="#{bindings.CreateInsert.execute}" text="CreateInsert"
                                           disabled="#{!bindings.CreateInsert.enabled}" id="b5" visible="false"/>
                                <af:inputText value="#{bindings.PenaltyDueDate.inputValue}" simple="true"
                                              required="#{bindings.PenaltyDueDate.hints.mandatory}"
                                              columns="#{bindings.PenaltyDueDate.hints.displayWidth}"
                                              maximumLength="#{bindings.PenaltyDueDate.hints.precision}"
                                              shortDesc="#{bindings.PenaltyDueDate.hints.tooltip}" id="it240"
                                              visible="false">
                                    <f:validator binding="#{bindings.PenaltyDueDate.validator}"/>
                                </af:inputText>
                                <af:inputText value="#{bindings.DailyPenaltyAmount.inputValue}"
                                              required="#{bindings.DailyPenaltyAmount.hints.mandatory}"
                                              columns="#{bindings.DailyPenaltyAmount.hints.displayWidth}"
                                              maximumLength="#{bindings.DailyPenaltyAmount.hints.precision}"
                                              shortDesc="#{bindings.DailyPenaltyAmount.hints.tooltip}" id="it239"
                                              visible="false">
                                    <f:validator binding="#{bindings.DailyPenaltyAmount.validator}"/>
                                    <af:convertNumber groupingUsed="false"
                                                      pattern="#{bindings.DailyPenaltyAmount.format}"/>
                                </af:inputText>
                                <af:inputText value="#{bindings.OriginalPenaltyDueDate.inputValue}" simple="true"
                                              required="#{bindings.OriginalPenaltyDueDate.hints.mandatory}"
                                              columns="#{bindings.OriginalPenaltyDueDate.hints.displayWidth}"
                                              maximumLength="#{bindings.OriginalPenaltyDueDate.hints.precision}"
                                              shortDesc="#{bindings.OriginalPenaltyDueDate.hints.tooltip}" id="it241"
                                              visible="false">
                                    <f:validator binding="#{bindings.OriginalPenaltyDueDate.validator}"/>
                                </af:inputText>
                                <af:inputText value="#{bindings.WorkPenaltyFlag.inputValue}" simple="true"
                                              required="#{bindings.WorkPenaltyFlag.hints.mandatory}"
                                              columns="#{bindings.WorkPenaltyFlag.hints.displayWidth}"
                                              maximumLength="#{bindings.WorkPenaltyFlag.hints.precision}"
                                              shortDesc="#{bindings.WorkPenaltyFlag.hints.tooltip}" id="it130"
                                              visible="false">
                                    <f:validator binding="#{bindings.WorkPenaltyFlag.validator}"/>
                                </af:inputText>
                            </af:showDetailItem>
                        </af:panelTabbed>
                    </af:panelGroupLayout>
                    <af:inputText value="#{row.bindings.UnspecializedFlag.inputValue}"
                                  required="#{bindings.CourtBcHearingResPartiesVO1.hints.UnspecializedFlag.mandatory}"
                                  columns="#{bindings.CourtBcHearingResPartiesVO1.hints.UnspecializedFlag.displayWidth}"
                                  maximumLength="#{bindings.CourtBcHearingResPartiesVO1.hints.UnspecializedFlag.precision}"
                                  shortDesc="#{bindings.CourtBcHearingResPartiesVO1.hints.UnspecializedFlag.tooltip}"
                                  id="it131" visible="false">
                        <f:validator binding="#{row.bindings.UnspecializedFlag.validator}"/>
                        <af:convertNumber groupingUsed="false"
                                          pattern="#{bindings.CourtBcHearingResPartiesVO1.hints.UnspecializedFlag.format}"/>
                    </af:inputText>
                </f:facet>
            </af:table>
        </af:panelGroupLayout>
        <f:facet name="menuBar">
            <af:button text="حفظ" id="b1" action="#{HasrClaim.save}"
                       visible="#{bindings.DecisionDescVO11.estimatedRowCount > 0}" partialTriggers="t1:ilov1"/>
            <af:button text="إلغاء" immediate="true" id="b2" action="#{HasrClaim.cancel}"
                       actionListener="#{HasrClaim.cancelClaim}">
                <af:resetActionListener/>
            </af:button>
            <af:button text="طرف جديد" id="b7" action="#{HasrClaim.newParty}" rendered="false"/>
        </f:facet>
    </af:panelHeader>



</ui:composition>
