                <af:selectOneChoice value="#{bindings.NeyabKolyaa.inputValue}" required="true" shortDesc="#{bindings.NeyabKolyaa.hints.tooltip}" id="soc28" simple="true" disabled="#{sessionScope.userInfo.entityDegree eq '39' or sessionScope.userInfo.entityDegree eq '3' }" autoSubmit="true">
