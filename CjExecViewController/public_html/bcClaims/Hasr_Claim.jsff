                <af:inputText value="#{bindings.PoliceNo.inputValue}" label="#{bindings.PoliceNo.hints.label}" required="#{bindings.PoliceNo.hints.mandatory}" disabled="#{pageFlowScope.disabledValidate}" maximumLength="6" shortDesc="#{bindings.PoliceNo.hints.tooltip}" id="it57" simple="true" contentStyle="    width: 60px;   " autoSubmit="true">
                    <f:validator binding="#{bindings.PoliceNo.validator}"/>
                    <af:convertNumber groupingUsed="false" pattern="#{bindings.PoliceNo.format}"/>
                </af:inputText>
            </h:panelGroup>
            <h:panelGroup id="pg2" layout="block" styleClass="ml-3">
                <af:outputLabel showRequired="#{bindings.ParYear.hints.mandatory}" value="سنة" id="ol2"/>
                <af:inputText value="#{bindings.ParYear.inputValue}" required="#{bindings.ParYear.hints.mandatory}" maximumLength="4" shortDesc="#{bindings.ParYear.hints.tooltip}" id="it58" simple="true" disabled="#{pageFlowScope.disabledValidate}" contentStyle="    width: 60px;     min-width: 60px !important;" autoSubmit="true"
                              validator="#{cjValidator.yearValidator}">
                    <f:validator binding="#{bindings.ParYear.validator}"/>
                    <af:convertNumber groupingUsed="false" pattern="#{bindings.ParYear.format}"/>
                </af:inputText>
