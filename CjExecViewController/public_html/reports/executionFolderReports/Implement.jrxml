	<subDataset name="New Dataset 1" uuid="2ebc3e22-69d4-44b3-8c3f-cf747f00533f">
		<parameter name="RES_PARTY_ID" class="java.math.BigDecimal">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[/* Formatted on 11/16/2019 7:30:04 PM (QP5 v5.227.12220.39754) */
SELECT T.NAME
  FROM EXC_COURT_BC_PARTY_DEBT D, EXC_LKP_FEES_TYPES T
 WHERE D.RES_PARTY_ID = $P{RES_PARTY_ID} AND T.ID = D.FEES_TYPE_ID]]>
		</queryString>
		<field name="NAME" class="java.lang.String"/>
	</subDataset>
	<parameter name="PROCEDURE_ID" class="java.math.BigDecimal"/>
	<parameter name="userId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="REPORT_PATH" class="java.lang.String"/>
	<queryString>
		<![CDATA[/* Formatted on 11/17/2019 10:17:09 AM (QP5 v5.227.12220.39754) */
SELECT FA.PROCEDURE_ID,
       FP.COURT_CIRCLE_DATES_HEARING_ID,
       RP.COURT_BC_HEARING_RES_ID,
       FA.ID ID_FOLDER_ACTIONS,
       FP.PROCEDURE_SERIAL,
       FP.PROSECUTION_ID,
       E.ID,
       E.COURT_ID,
       FP.PROCEDURE_DATE,
       P.PARTY_FULL_NAME,
       P.ID_NUMBER,
       P.ADDRESS,
       DH.HEARING_DATE,
       PR.POLICE_NUMBER,
       PR.PAR_YEAR,
       CT.NAME,
       (SELECT ENTITY_NAME
          FROM ENTITY
         WHERE E.COURT_ID = ENTITY.ID)
          ENTITY_NAME,
       (SELECT ENTITY_NAME
          FROM ENTITY
         WHERE ID = PR.ORIGIN_ENTITY)
          ORIGIN_ENTITY,
  (SELECT ENTITY_NAME
          FROM ENTITY
         WHERE ID = PR.ENTITY_ID)
          ENTITY,
       (SELECT H.HEARING_DATE
          FROM COURT_CIRCLES_DATES_HEARING H
         WHERE RP.COURT_BC_HEARING_RES_ID = H.ID)
          HEARING_DATE_TWO,
       SYSDATE,
       FP.RES_PARTY_ID,
       (SELECT LISTAGG (CRIME_NAME, ',') WITHIN GROUP (ORDER BY CRIME_NAME)
                  AS CRIME_NAMES
          FROM res_party_crimes
         WHERE RES_PARTY_ID = FP.RES_PARTY_ID)
          CRIME_NAME,
       (SELECT T.NAME
          FROM COURT_ANNOUNCEMENT_TYPES T
         WHERE RP.ATTENDANCE = T.ID)
          JUDGEMENT,
       (SELECT D.SEQUENCE_NUMBER
          FROM EXC_FOLDER_DATA D
         WHERE D.RES_PARTY_ID = FP.RES_PARTY_ID)
          COUNTER,
       (SELECT D.YEAR
          FROM EXC_FOLDER_DATA D
         WHERE D.RES_PARTY_ID = FP.RES_PARTY_ID)
          COUNTER_YEAR,
       (SELECT T.FOLDER_NAME
          FROM EXC_FOLDER_DATA D, EXC_LKP_FOLDER_TYPES T
         WHERE D.RES_PARTY_ID = FP.RES_PARTY_ID AND T.ID = D.FOLDER_TYPE)
          FOLDER_TYPE,SYSDATE, (SELECT U.FULL_NAME FROM SEC_USERS U WHERE U.ID = $P{userId}) LOGIN_USER, (SELECT D.JUDGMENT_TEXT FROM EXC_FOLDER_DATA D WHERE D.RES_PARTY_ID = FP.RES_PARTY_ID) JUDGEMENT_TEXT
  FROM EXC_FOLDER_ACTIONS FA,
       EXC_FOLDER_PROCEDURES FP,
       ENTITY E,
       COURT_BC_HEARING_RES_PARTIES RP,
       PAR_PARTIES P,
       COURT_BC_HEARING_RESERVATION HR,
       COURT_CIRCLES_DATES_HEARING DH,
       PAR_POLICE_AUTHORITY_REPORT PR,
       BUSINESS_CASE_TYPE CT
 WHERE     FA.PROCEDURE_ID = $P{PROCEDURE_ID}
       AND FP.ID = FA.PROCEDURE_ID
       AND E.id = FP.PROSECUTION_ID
       AND RP.ID = FP.RES_PARTY_ID
       AND RP.PARTY_ID = P.ID
       AND HR.ID = RP.COURT_BC_HEARING_RES_ID
       AND HR.CIRCLE_HEARING_DATE_ID = DH.ID
       AND HR.BUSINESS_CASE_ID = PR.BUSINESS_CASE_ID
       AND PR.BUSINESS_CASE_TYPE = CT.ID
       AND FA.ACTION_TYPE = 5]]>
	</queryString>
