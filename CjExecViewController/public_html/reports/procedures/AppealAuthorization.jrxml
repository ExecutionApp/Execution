			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToTallestObject" x="240" y="0" width="316" height="20" isRemoveLineWhenBlank="true" uuid="1d3a2e7e-42ba-49f6-a5eb-fd6d5f06156b"/>
				<textElement textAlignment="Right" verticalAlignment="Top">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["وقرر ان يرفع معارضة استئنافية عن الحكم الصادر من هذه المحكمة بتاريخ"+" "+($F{HEARING_DATE}==null?"":new utils.ArabicNumberFormatter().formatTimeStamp($F{HEARING_DATE},new java.lang.String("dd/MM/yyyy")).trim())+" "+" "+"في القضية رقم "+($F{POLICE_NUMBER}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{POLICE_NUMBER}.toString())))+" "+"سنة "+($F{PAR_YEAR}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{PAR_YEAR}.toString())))+" "+($F{NAME}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{NAME}.toString())))+" "+($F{GOZEYA_ENTITY}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{GOZEYA_ENTITY}.toString())))+" والمقيدة برقم كلي "+($F{SEQ}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{SEQ}.toString())))+"/"+($F{SEQ_YEAR}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{SEQ_YEAR}.toString())))]]></textFieldExpression>
