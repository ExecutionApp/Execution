	<property name="ireport.y" value="0"/>
	<parameter name="PROCEDURE_ID" class="java.math.BigDecimal"/>
	<parameter name="userId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="REPORT_PATH" class="java.lang.String"/>
	<parameter name="DID" class="java.math.BigDecimal"/>
	<parameter name="AbroadFlag" class="java.lang.String"/>
	<parameter name="CONTEXT_PATH" class="java.lang.String"/>
	<queryString>
		<![CDATA[/* Formatted on 5/7/2020 3:10:21 PM (QP5 v5.227.12220.39754) */
SELECT POLICE.ENTITY_NAME AS ORIGIN_ENTITY,
       GOZ.ENTITY_NAME ENTITY,
       KOL.ENTITY_NAME,
       COURT.ENTITY_NAME AS COURT,
       COURT.ENTITY_NAME,
       P.PARTY_FULL_NAME,
       P.ID_NUMBER,
       FOLDER.JUDGMENT_TEXT,
       FP.COURT_CIRCLE_DATES_HEARING_ID,
       HEARING2.HEARING_DATE HEARING_DATE_TWO,
       NULL AS HEARING_DATE_TWO,
       HEARING.HEARING_DATE AS HEARING_DATE,
       HEARING.HEARING_DAY,
 TO_CHAR (HEARING.HEARING_DATE, 'Day', 'NLS_DATE_LANGUAGE = arabic') DAY,
       POLICE.ID,
       NULL AS COURT_BC_HEARING_RES_ID,
       NULL AS ID_FOLDER_ACTIONS,
       NULL AS PROCEDURE_SERIAL,
       NULL AS PROSECUTION_ID,
       NULL AS LAWYER_NAME,
       NULL AS LAWYER_NUMBER,
       NULL AS COURT_ID,
       FP.PROCEDURE_DATE,
       PR.PAR_YEAR AS PAR_YEAR,
       NULL AS NAME,
       NULL AS CREATED_BY,
       SYSDATE,
       NULL AS LOGIN_USER,
       NULL AS ENTITY_ID,
       NULL AS CAPACITY,
       NULL AS CREATED_DATE,
          PR.POLICE_NUMBER
       || '/'
       || PR.PAR_YEAR
       || '/'
       || CT.NAME
       || '/'
       || POLICE.ENTITY_NAME
          POLICE_NUMBER,
                   FOLDER.SEQUENCE_NUMBER || '/' || FOLDER.YEAR || '/' || DECODE(FOLDER.FOLDER_TYPE , 2 , 'حبس' , 3 , 'غرامة') || '/' || POLICE.ENTITY_NAME SERIAL_NUMBER,FOLDER.SEQUENTIAL_NUMBER,FOLDER.SEQUENTIAL_YEAR
  FROM EXC_FOLDER_ACTIONS FA,
       EXC_FOLDER_DATA FOLDER,
       EXC_FOLDER_PROCEDURES FP,
       ENTITY POLICE,
       ENTITY GOZ,
       ENTITY KOL,
       ENTITY COURT,
       COURT_BC_HEARING_RES_PARTIES RP,
       PAR_PARTIES P,
       COURT_BC_HEARING_RESERVATION HR,
       PAR_POLICE_AUTHORITY_REPORT PR,
       BUSINESS_CASE_TYPE CT,
       COURT_CIRCLES_DATES_HEARING HEARING,
COURT_CIRCLES_DATES_HEARING HEARING2
 WHERE     FA.FOLDER_RECORD_ID = FOLDER.ID
       AND FA.PROCEDURE_ID = FP.ID
       AND POLICE.ID = FOLDER.POLICE_STATION_ENTITY_ID
       AND GOZ.ID = POLICE.PARENT_ENTITY_ID
       AND KOL.ID = GOZ.PARENT_ENTITY_ID
       AND RP.ID = FOLDER.RES_PARTY_ID
       AND P.ID = RP.PARTY_ID
       AND KOL.COURT_ID = COURT.ID
       AND HR.ID = RP.COURT_BC_HEARING_RES_ID
       AND HR.BUSINESS_CASE_ID = PR.BUSINESS_CASE_ID
       AND PR.BUSINESS_CASE_TYPE = CT.ID
       AND HEARING.ID = HR.CIRCLE_HEARING_DATE_ID
       AND HEARING2.ID = FP.COURT_CIRCLE_DATES_HEARING_ID
       AND FA.PROCEDURE_ID = $P{PROCEDURE_ID}]]>
	</queryString>
