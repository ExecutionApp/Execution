				</reportElement>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="10" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["في يوم "+($F{DAY}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{DAY}.toString())))+" "+"الموافق"+" "+($F{PROCEDURE_DATE}==null?"":new utils.ArabicNumberFormatter().formatTimeStamp($F{PROCEDURE_DATE},new java.lang.String("dd/MM/yyyy")).trim())+" "+"سنة "+($F{PAR_YEAR}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{PAR_YEAR}.toString())))+" "+"تم الطعن بناء علي رغبة المحكوم عليه المثبتة بالطلب المرسل من نيابة "+".........."+" "+"الكلية  محل الضبط و المقيد"+" "+"بدفاترها برقم مسلسل"+" "+".........."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="239" y="25" width="316" height="20" uuid="4aa72528-5f3c-4c47-9746-b955043fe3d7"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["و قرر  ( المعارضة  ) عن الأمر الجنائي الصادر من قاضى المحكمة بتاريخ "+" "+($F{HEARING_DATE}==null?"":new utils.ArabicNumberFormatter().formatTimeStamp($F{HEARING_DATE},new java.lang.String("dd/MM/yyyy")).trim())+" "+"سنة "+($F{PAR_YEAR}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{PAR_YEAR}.toString())))+" "+"في القضية المقيدة بالجدول العمومي رقم "+($F{POLICE_NUMBER}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{POLICE_NUMBER}.toString())))+" "+"سنة"+" "+($F{PAR_YEAR}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{PAR_YEAR}.toString())))+"."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="239" y="45" width="316" height="20" isRemoveLineWhenBlank="true" uuid="6adda0a8-7aa8-4151-af6e-5c5c8ab91d86"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["و قد حدد لنظر المعارضة جلسة "+($F{HEARING_DATE}==null?"":new utils.ArabicNumberFormatter().formatTimeStamp($F{HEARING_DATE},new java.lang.String("dd/MM/yyyy")).trim())+" "+"سنة "+($F{PAR_YEAR}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{PAR_YEAR}.toString())))+" "+"و كلفته بالحضور في هذا اليوم بدون حاجة إلي إعلان أخر"+"."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="239" y="140" width="316" height="20" uuid="17776bbb-4fa5-4fbd-97f1-2a1226b4093f"/>
