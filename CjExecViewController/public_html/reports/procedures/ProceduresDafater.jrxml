<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HasrDafater" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="842" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="261e9ab5-f547-4d50-a61c-d8b74dcc4acd">
	<property name="ireport.zoom" value="1.2100000000000002"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="REPORT_PATH" class="java.lang.String"/>
	<parameter name="year" class="java.lang.String"/>
	<parameter name="gozeyaId" class="java.lang.String"/>
	<parameter name="dateFrom" class="java.lang.String"/>
	<parameter name="dateTo" class="java.lang.String"/>
	<parameter name="procedureTypeId" class="java.lang.String"/>
	<parameter name="procedureTypeName" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT PROC.ID PROC_NUMBER,
         DECODE (
            FOLDER.SEQUENCE_NUMBER,
            NULL, '',
            ( FOLDER.YEAR || '/'
             ||
            FOLDER.SEQUENCE_NUMBER
             || '/'
             || FOLDER_TYPES.FOLDER_NAME
             || '/'
             || ENTS.ENTITY_NAME))
            AS INVENTORY_NUMBER,
             PAR_POLICE.PAR_YEAR || '/'
         || PAR_POLICE.POLICE_NUMBER
         || '/'
         || CAS_TYPE.NAME
         || '/'
         || ENTS.ENTITY_NAME
            AS BUSINESS_CASE_NUMBER,
         TO_CHAR(PROC.PROCEDURE_DATE , 'yyyy/mm/dd') PROCEDURE_DATE ,
         ACTS.ACTION_TYPE PROCEDURE_TYPE,
         TO_CHAR (CIRCLES.HEARING_DATE, 'yyyy-mm-dd') HEARING_DATE,
         PARTIES.PARTY_FULL_NAME PARTY_FULL_NAME,
         ACTION_TYPES.NAME ACTS_TYPES_NAME,
         PAR_POLICE.PAR_YEAR,
         FOLDER.POLICE_STATION_ENTITY_ID,
         ENTS.PARENT_ENTITY_ID ENT_ID,
            TO_CHAR (CIRCLES.HEARING_DATE, 'yyyy-mm-dd')
         || ' '
         || ENTS.ENTITY_NAME
            DATE_ENT_RESERVATION ,
            POLICE_PARENT.ENTITY_NAME GOZEYA_NAME ,
           KOLYEA_ENTITY.ENTITY_NAME KOLYEA_NAME,
           FOLDER.CREATED_BY
    FROM EXC_FOLDER_DATA FOLDER,
         COURT_BC_HEARING_RES_PARTIES RES_PART,
         COURT_BC_HEARING_RESERVATION RES,
         EXC_LKP_FOLDER_TYPES FOLDER_TYPES,
         EXC_FOLDER_PROCEDURES PROC,
         EXC_LKP_ACTION_TYPES ACTION_TYPES,
         EXC_FOLDER_ACTIONS ACTS,
         ENTITY ENTS,
         EXC_LKP_ACTION_TYPES ACTS_TYPES,
         EXC_LKP_FEES_TYPES FEES_TYPES,
         PAR_PARTIES PARTIES,
         BUSINESS_CASE CAS,
         PAR_POLICE_AUTHORITY_REPORT PAR_POLICE,
         COURT_CIRCLES_DATES_HEARING CIRCLES,
         BUSINESS_CASE_TYPE CAS_TYPE ,
         ENTITY POLICE_PARENT ,
         ENTITY KOLYEA_ENTITY

   WHERE     FOLDER.FOLDER_TYPE = FOLDER_TYPES.ID
         AND FOLDER.ID = ACTS.FOLDER_RECORD_ID
         AND ACTS.PROCEDURE_ID = PROC.ID
         AND ACTS.ACTION_TYPE = ACTION_TYPES.ID
         AND RES_PART.ID = FOLDER.RES_PARTY_ID
         AND RES_PART.COURT_BC_HEARING_RES_ID = RES.ID
         AND ACTS_TYPES.ID = ACTS.ACTION_TYPE
         AND FEES_TYPES.id(+) = PROC.FEES_TYPE_ID
         AND PARTIES.ID = RES_PART.PARTY_ID
         AND RES.BUSINESS_CASE_ID = CAS.ID
         AND CAS.ID = PAR_POLICE.BUSINESS_CASE_ID
         AND PAR_POLICE.ORIGIN_ENTITY = ents.ID
         AND CIRCLES.ID(+) = PROC.COURT_CIRCLE_DATES_HEARING_ID
         AND CAS_TYPE.ID = CAS.CASE_TYPE
         AND ENTS.PARENT_ENTITY_ID = POLICE_PARENT.ID
         AND POLICE_PARENT.PARENT_ENTITY_ID = KOLYEA_ENTITY.ID
         AND PAR_POLICE.PAR_YEAR = $P{year}
         AND PROC.PROCEDURE_DATE BETWEEN TO_DATE($P{dateFrom} , 'yyyy/mm/dd')
                                                                       AND TO_DATE($P{dateTo} , 'yyyy/mm/dd')+1
       AND ACTS.ACTION_TYPE = $P{procedureTypeId}
       AND ENTS.PARENT_ENTITY_ID = $P{gozeyaId}
ORDER BY PROC.ID ASC]]>
	</queryString>
	<field name="PROC_NUMBER" class="java.math.BigDecimal"/>
	<field name="INVENTORY_NUMBER" class="java.lang.String"/>
	<field name="BUSINESS_CASE_NUMBER" class="java.lang.String"/>
	<field name="PROCEDURE_DATE" class="java.lang.String"/>
	<field name="PROCEDURE_TYPE" class="java.math.BigDecimal"/>
	<field name="HEARING_DATE" class="java.lang.String"/>
	<field name="PARTY_FULL_NAME" class="java.lang.String"/>
	<field name="ACTS_TYPES_NAME" class="java.lang.String"/>
	<field name="PAR_YEAR" class="java.math.BigDecimal"/>
	<field name="POLICE_STATION_ENTITY_ID" class="java.math.BigDecimal"/>
	<field name="ENT_ID" class="java.math.BigDecimal"/>
	<field name="DATE_ENT_RESERVATION" class="java.lang.String"/>
	<field name="GOZEYA_NAME" class="java.lang.String"/>
	<field name="KOLYEA_NAME" class="java.lang.String"/>
	<field name="CREATED_BY" class="java.lang.String"/>
