	<detail>
		<band height="340" splitType="Stretch">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="500" y="15" width="302" height="20" uuid="1cf2fcb5-79c2-4e84-b7a2-55b93b916c24"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["  في يوم  "+$F{DAYA} +" الموافق "+($F{PROCEDURE_DATE}==null?"":new utils.ArabicNumberFormatter().formatTimeStamp($F{PROCEDURE_DATE},new java.lang.String("dd/MM/yyyy")).trim())+" سنة "+($F{PROCEDURE_DATE}==null?"":new utils.ArabicNumberFormatter().formatTimeStamp($F{PROCEDURE_DATE},new java.lang.String("yyyy")).trim()) + " حضر أمامي بقلم كتاب الجنح والجنايات بمحكمة  :  "  + ($F{ENTITY_NAME}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{ENTITY_NAME}.toString()))) + " ،  المتهم : " + ($F{PARTY_FULL_NAME}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{PARTY_FULL_NAME}.toString())))]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="500" y="45" width="302" height="20" uuid="b2c58600-7a9e-40fa-9532-0dad24e4be25"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["وقرر أن يطعن بطريق النقض في الحكم الصادر من محكمة : " + ($F{ENTITY_NAME}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{ENTITY_NAME}.toString()))) + " بتاريخ : " + ($F{HEARING_DATE}==null?"":new utils.ArabicNumberFormatter().formatTimeStamp($F{HEARING_DATE},new java.lang.String("dd/MM/yyyy")).trim()) + " في القضية المقيدة برقم : " + ($F{CASE_NUMBER} ==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{CASE_NUMBER}.toString())))]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="500" y="111" width="302" height="20" uuid="52a190f5-52bc-47f5-b8e8-15da770acc44"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[" القاضي بـ " + ($F{JUDGMENT_TEXT}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{JUDGMENT_TEXT}.toString())))]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="500" y="141" width="302" height="43" uuid="f7a7aca7-77bf-47e2-aea2-0c1ee0c85170"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["وأنه سيقدم تقريرا ببيان أوجه هذا الطعن في الميعاد القانوني ، وإثباتا لذلك قد تحرر هذا وتوقع عليه منا ومن المقرر"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="695" y="184" width="64" height="20" uuid="d15b34cf-86c2-479f-bec3-11db755c3583"/>
