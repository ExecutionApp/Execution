<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="تقرير طعن بطريق النقض" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a377a761-c5f1-4b84-98d8-0f906b589047">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="REPORT_PATH" class="java.lang.String"/>
	<parameter name="userId" class="java.lang.String"/>
	<parameter name="PROCEDURE_ID" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT to_char(PROC.PROCEDURE_DATE,'fmday','NLS_date_language=arabic') DAYA ,
SYSDATE , PROC.ID , PROC.PROCEDURE_DATE ,
(SELECT ENTITY_NAME
 FROM ENTITY
 WHERE ENTS.COURT_ID = ENTITY.ID) ENTITY_NAME ,
(SELECT H.HEARING_DATE
 FROM COURT_CIRCLES_DATES_HEARING H
 WHERE PROC.COURT_CIRCLE_DATES_HEARING_ID = H.ID) HEARING_DATE ,
(SELECT PAR.PARTY_FULL_NAME
FROM PAR_PARTIES PAR
 WHERE PAR.id = RES_PART.party_id) PARTY_FULL_NAME ,
FOLDER.JUDGMENT_TEXT ,
PAR.PAR_YEAR || '/' || PAR.POLICE_NUMBER || '/' || BCT.NAME || '/' || POLICE.ENTITY_NAME CASE_NUMBER ,
(SELECT U.ENTITY_ID FROM SEC_USERS U WHERE U.ID = $P{userId}) ENTITY_ID ,
(SELECT GET_GOZEY_FROM_KOLY(PAR.POLICE_NUMBER , PAR.PAR_YEAR ,
 (SELECT CASE_SCHEMA_ID FROM BUSINESS_CASE_DETAILS BCD
   WHERE BCD.BUSINESS_CASE_ID = BC.ID
   AND BCD.CASE_SCHEMA_ID IN (3643 , 3646 , 3647 , 3648)) ,
 (SELECT PARN.ID
  FROM ENTITY ENT , ENTITY PARN
  WHERE ENT.ID = BC.ENTITY_ID
  AND ENT.PARENT_ENTITY_ID = PARN.ID)) FROM DUAL) KOLYA_NUMBER
FROM EXC_FOLDER_PROCEDURES PROC , ENTITY ENTS , EXC_FOLDER_DATA FOLDER , EXC_FOLDER_ACTIONS ACTS ,
COURT_BC_HEARING_RES_PARTIES RES_PART , COURT_BC_HEARING_RESERVATION RES , BUSINESS_CASE BC ,
PAR_POLICE_AUTHORITY_REPORT PAR , ENTITY POLICE , BUSINESS_CASE_TYPE BCT
WHERE ENTS.ID = PROC.PROC_PROSECUTION_ID
AND FOLDER.ID = ACTS.FOLDER_RECORD_ID
AND RES_PART.ID = FOLDER.RES_PARTY_ID
AND ACTS.PROCEDURE_ID = PROC.ID
AND RES_PART.COURT_BC_HEARING_RES_ID = RES.ID
AND RES.BUSINESS_CASE_ID = BC.ID
AND BC.ID = PAR.BUSINESS_CASE_ID
AND POLICE.ID = PAR.ORIGIN_ENTITY
AND BC.BUSINESS_CASE_TYPE = BCT.ID
AND PROC.ID = $P{PROCEDURE_ID}]]>
	</queryString>
	<field name="DAYA" class="java.lang.String"/>
	<field name="SYSDATE" class="java.sql.Timestamp"/>
	<field name="ID" class="java.math.BigDecimal"/>
	<field name="PROCEDURE_DATE" class="java.sql.Timestamp"/>
	<field name="ENTITY_NAME" class="java.lang.String"/>
	<field name="HEARING_DATE" class="java.sql.Timestamp"/>
	<field name="PARTY_FULL_NAME" class="java.lang.String"/>
	<field name="JUDGMENT_TEXT" class="java.lang.String"/>
	<field name="CASE_NUMBER" class="java.lang.String"/>
	<field name="ENTITY_ID" class="java.math.BigDecimal"/>
	<field name="KOLYA_NUMBER" class="java.lang.String"/>
