	<parameter name="REPORT_PATH" class="java.lang.String"/>
	<parameter name="year" class="java.lang.String"/>
	<parameter name="gozeyaId" class="java.lang.String"/>
	<parameter name="dateFrom" class="java.lang.String"/>
	<parameter name="dateTo" class="java.lang.String"/>
	<parameter name="folderTypeName" class="java.lang.String"/>
	<parameter name="folderTypeId" class="java.lang.String"/>
	<parameter name="QUERY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="KOLYA_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT  FOLDER.JUDGMENT_TEXT ,
       FOLDER.FOLDER_TYPE,
       PAR_POLICE.PAR_YEAR Case_year,
       FOLDER.Id FOLDER_ID,
       FOLDER.SEQUENCE_NUMBER  AS INVENTORY_NUMBER,
        PAR_POLICE.PAR_YEAR
       || '/'
       || PAR_POLICE.POLICE_NUMBER
       || '/'
       || CAS_TYPE.NAME
       || '/'
       || POLICE.ENTITY_NAME
          AS BUSINESS_CASE_NUMBER,
          PARTIES.FNAME
       || ' '
       || PARTIES.SNAME
       || ' '
       || PARTIES.TNAME
       || ' '
       || PARTIES.FOURTHNAME
          AS PARTY_NAME,
       PARTIES.ADDRESS,
       PARTIES.JOB_TITLE,
       PARTIES.ID_NUMBER,
       DEGREES.NAME ,
       CIRCLES.HEARING_DATE,
       POLICE.PARENT_ENTITY_ID GozayaId ,
       FOLDER.POLICE_STATION_ENTITY_ID ,
       FOLDER.CRIMINAL_TYPE ,
       FOLDER.CREATED_BY,
       FOLDER.YEAR    ,
(SELECT ENTITY_NAME FROM ENTITY WHERE ID =$P{KOLYA_ID})  AS KOLYEA_NAME
  FROM EXC_FOLDER_DATA FOLDER,
       COURT_BC_HEARING_RES_PARTIES RES_PART,
       COURT_BC_HEARING_RESERVATION RES,
       PAR_PARTIES PARTIES,
       BUSINESS_CASE CAS,
       PAR_POLICE_AUTHORITY_REPORT PAR_POLICE,
       ENTITY POLICE,
       BUSINESS_CASE_DEGREES DEGREES,
       BUSINESS_CASE_TYPE CAS_TYPE,
       EXC_LKP_FOLDER_TYPES FOLDER_TYPE,
       COURT_CIRCLES_DATES_HEARING CIRCLES
 WHERE     FOLDER.RES_PARTY_ID = RES_PART.ID
       AND RES_PART.COURT_BC_HEARING_RES_ID = RES.ID
       AND RES_PART.PARTY_ID = PARTIES.ID
       AND RES.BUSINESS_CASE_ID = CAS.ID
       AND CAS.ID = PAR_POLICE.BUSINESS_CASE_ID
       AND PAR_POLICE.ORIGIN_ENTITY = POLICE.ID
       AND RES_PART.BC_DEGREE_SPEC_ID = DEGREES.ID
       AND CAS.CASE_TYPE = CAS_TYPE.ID
       AND FOLDER_TYPE.ID = FOLDER.FOLDER_TYPE
       AND RES.CIRCLE_HEARING_DATE_ID = CIRCLES.id (+)
       $P!{QUERY}
order by  FOLDER.SEQUENCE_NUMBER]]>
	</queryString>
