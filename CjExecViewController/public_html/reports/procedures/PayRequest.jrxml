			<staticText>
				<reportElement stretchType="RelativeToTallestObject" x="151" y="0" width="169" height="25" uuid="d4147a3c-83f4-469b-941c-521e5f66695a">
					<printWhenExpression><![CDATA[$F{FIXED_FINE} != null && $F{FIXED_FINE} != 0]]></printWhenExpression>
