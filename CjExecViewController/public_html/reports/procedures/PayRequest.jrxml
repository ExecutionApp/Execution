<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Appeal" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="bc26958a-de3d-4603-956d-b9ee91971ec6">
	<property name="ireport.zoom" value="1.652892561983471"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="122"/>
	<parameter name="PROCEDURE_ID" class="java.math.BigDecimal"/>
	<parameter name="userId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="REPORT_PATH" class="java.lang.String"/>
	<queryString>
		<![CDATA[/* Formatted on 1/17/2021 12:33:20 PM (QP5 v5.287) */
SELECT ACTS.PROCEDURE_ID,
       PROC.COURT_CIRCLE_DATES_HEARING_ID,
       RES_PART.COURT_BC_HEARING_RES_ID,
       ACTS.ID ID_FOLDER_ACTIONS,
       PROC.PROCEDURE_SERIAL,
       PROC.PROSECUTION_ID,
        (SELECT ENTITY_NAME FROM ENTITY WHERE ID = (SELECT E.PARENT_ENTITY_ID FROM ENTITY E WHERE E.ID = ENTS.ID)) GOZEYA,
        (SELECT ENTITY_NAME FROM ENTITY WHERE ID = (SELECT E1.PARENT_ENTITY_ID FROM ENTITY E1 WHERE E1.ID = (SELECT E.PARENT_ENTITY_ID FROM ENTITY E WHERE E.ID = ENTS.ID))) KOLEYA,
       (SELECT S.SEQ FROM BUSINESS_CASE_LEDGER_SEQ S WHERE S.BUSINESS_CASE_DETAILS_ID =
       (SELECT ID FROM BUSINESS_CASE_DETAILS D WHERE D.BUSINESS_CASE_ID = RES.BUSINESS_CASE_ID AND D.CASE_SCHEMA_ID = 3643)) SEQ,
       (SELECT S.YEAR FROM BUSINESS_CASE_LEDGER_SEQ S WHERE S.BUSINESS_CASE_DETAILS_ID =
       (SELECT ID FROM BUSINESS_CASE_DETAILS D WHERE D.BUSINESS_CASE_ID = RES.BUSINESS_CASE_ID AND D.CASE_SCHEMA_ID = 3643)) SEQ_YEAR,
       (SELECT E.ENTITY_NAME FROM ENTITY E WHERE E.ID = (SELECT S.ENTITY_ID FROM BUSINESS_CASE_LEDGER_SEQ S WHERE S.BUSINESS_CASE_DETAILS_ID =
       (SELECT ID FROM BUSINESS_CASE_DETAILS D WHERE D.BUSINESS_CASE_ID = RES.BUSINESS_CASE_ID AND D.CASE_SCHEMA_ID = 3643))) SEQ_ENTITY,
(SELECT L.NAME FROM PAR_LAWYERS L WHERE L.ID = PROC.PRIMARY_LAWYER_ID) LAWYER_NAME,
(SELECT L.RETAINER_NUMBER FROM PAR_LAWYERS L WHERE L.ID = PROC.PRIMARY_LAWYER_ID) LAWYER_NUMBER,
(SELECT L.COMMENTS FROM PAR_LAWYERS L WHERE L.ID = PROC.PRIMARY_LAWYER_ID) LAWYER_COMMENTS,
       ENTS.ID,
       ENTS.COURT_ID,
       PROC.PROCEDURE_DATE,

       (SELECT PAR.PARTY_FULL_NAME
          FROM PAR_PARTIES PAR
         WHERE PAR.id = RES_PART.party_id)
          PARTY_FULL_NAME,
       (SELECT PAR.ID_NUMBER
          FROM PAR_PARTIES PAR
         WHERE PAR.id = RES_PART.party_id)
          ID_NUMBER,
 (SELECT PAR.ID_TYPE
          FROM PAR_PARTIES PAR
         WHERE PAR.id = RES_PART.party_id)
          ID_TYPE,
       (SELECT did
          FROM (  SELECT DID
                    FROM CRIMINAL_JUSTICE_FILES_DETAILS cj
                   WHERE     CJ.TYPEID = 20
                         AND CJ.PARTY_ID = RES_PART.party_id
                         AND ROWNUM = 1
                ORDER BY ID DESC))
          DID,
       (SELECT POLICE_NUMBER
          FROM par_police_authority_report
         WHERE business_case_id = RES.BUSINESS_CASE_ID)
          POLICE_NUMBER,
       (SELECT PAR_YEAR
          FROM par_police_authority_report
         WHERE business_case_id = RES.BUSINESS_CASE_ID)
          PAR_YEAR,
       (SELECT Name
          FROM BUSINESS_CASE_TYPE
         WHERE id = (SELECT BUSINESS_CASE_TYPE
                       FROM par_police_authority_report
                      WHERE business_case_id = RES.BUSINESS_CASE_ID))
          Name,
       (SELECT ENTITY_NAME
          FROM ENTITY
         WHERE ENTS.COURT_ID = ENTITY.ID)
          ENTITY_NAME,
       (SELECT ENTITY_NAME
          FROM ENTITY
         WHERE ID = FOLDER.POLICE_STATION_ENTITY_ID)
          ENTITY,
       (SELECT ENTITY_NAME
          FROM ENTITY
         WHERE ID = FOLDER.POLICE_STATION_ENTITY_ID)
          ORIGIN_ENTITY,
       (SELECT H.HEARING_DATE
          FROM COURT_CIRCLES_DATES_HEARING H
         WHERE PROC.COURT_CIRCLE_DATES_HEARING_ID = H.ID)
          HEARING_DATE_TWO,
       (SELECT H.HEARING_DATE
          FROM COURT_CIRCLES_DATES_HEARING H
         WHERE RES.CIRCLE_HEARING_DATE_ID = H.ID)
          HEARING_DATE,
      (SELECT U.FULL_NAME FROM SEC_USERS U WHERE U.ID = PROC.CREATED_BY) CREATED_BY,SYSDATE,          (SELECT U.FULL_NAME FROM SEC_USERS U WHERE U.ID = $P{userId}) LOGIN_USER, (select entity_name from entity where id =  ENTS.COURT_ID ) COURT,
(SELECT U.ENTITY_ID FROM SEC_USERS U WHERE U.ID = $P{userId}) ENTITY_ID, (select name from exc_lkp_capacity_type cap where cap.id = PROC.CAPACITY_TYPE) capacity, (select id from exc_lkp_capacity_type cap where cap.id = PROC.CAPACITY_TYPE) capacity_id, PROC.created_date,
(select to_char(PROC.PROCEDURE_DATE,'fmday','NLS_date_language=arabic')from dual) DAYA,FOLDER.SEQUENTIAL_NUMBER,FOLDER.SEQUENTIAL_YEAR, PROC.FIXED_FINE, PROC.DAILY_FINE, PROC.GUARANTEE, PROC.EXPENSES,
PROC.LAWYER_FEES, FOLDER.YEAR, FOLDER.SEQUENCE_NUMBER, FOLDER_TYPES.FOLDER_NAME
  FROM EXC_FOLDER_DATA FOLDER,
       COURT_BC_HEARING_RES_PARTIES RES_PART,
       COURT_BC_HEARING_RESERVATION RES,
       EXC_LKP_FOLDER_TYPES FOLDER_TYPES,
       EXC_FOLDER_PROCEDURES PROC,
       EXC_LKP_ACTION_TYPES ACTION_TYPES,
       EXC_FOLDER_ACTIONS ACTS,
       ENTITY ENTS,
       EXC_LKP_ACTION_TYPES ACTS_TYPES
 WHERE     FOLDER.FOLDER_TYPE = FOLDER_TYPES.ID
       AND FOLDER.ID = ACTS.FOLDER_RECORD_ID
       AND ACTS.PROCEDURE_ID = PROC.ID
       AND ACTS.ACTION_TYPE = ACTION_TYPES.ID
       AND RES_PART.ID = FOLDER.RES_PARTY_ID
       AND RES_PART.COURT_BC_HEARING_RES_ID = RES.ID
       AND ENTS.ID = FOLDER.POLICE_STATION_ENTITY_ID
       AND ACTS_TYPES.ID = ACTS.ACTION_TYPE
       AND ACTS.ACTION_TYPE = 146
      AND PROC.ID = $P{PROCEDURE_ID}]]>
	</queryString>
