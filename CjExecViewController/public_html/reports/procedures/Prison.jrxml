<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Person" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="bc26958a-de3d-4603-956d-b9ee91971ec6">
	<property name="ireport.zoom" value="1.8181818181818181"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="828"/>
	<parameter name="PROCEDURE_ID" class="java.math.BigDecimal"/>
	<queryString>
		<![CDATA[/* Formatted on 11/16/2019 1:24:32 PM (QP5 v5.227.12220.39754) */
SELECT FA.PROCEDURE_ID,
       FP.COURT_CIRCLE_DATES_HEARING_ID,
       RP.COURT_BC_HEARING_RES_ID,
       FA.ID ID_FOLDER_ACTIONS,
       FP.PROCEDURE_SERIAL,
(SELECT ENTITY_NAME FROM ENTITY WHERE ID = PR.JUDICIAL_ENTITY_ID) PAR_ENTITY,
PR.INCIDENT_DATE,
 (SELECT LISTAGG (CRIME_NAME, ',') WITHIN GROUP (ORDER BY CRIME_NAME)
                  AS CRIME_NAMES
          FROM res_party_crimes
         WHERE RES_PARTY_ID = FP.RES_PARTY_ID)
          CRIME_NAME,
P.JOB_TITLE,
       (SELECT C.NAME FROM LKP_CITIES C WHERE C.ID = P.CITY) CITY,
       FP.PROSECUTION_ID,
    (CASE
           WHEN (SELECT D.IMPRISONED_FLAG
                   FROM EXC_FOLDER_DATA D
                  WHERE D.RES_PARTY_ID = FP.RES_PARTY_ID) = 0
           THEN
              'غير محبوس'
           WHEN (SELECT D.IMPRISONED_FLAG
                   FROM EXC_FOLDER_DATA D
                  WHERE D.RES_PARTY_ID = FP.RES_PARTY_ID) = 1
           THEN
              'محبوس'
        END)
          IMPRISONED_FLAG,
(SELECT L.NAME FROM PAR_LAWYERS L WHERE L.ID = FP.PRIMARY_LAWYER_ID) LAWYER_NAME,
(SELECT L.RETAINER_NUMBER FROM PAR_LAWYERS L WHERE L.ID = FP.PRIMARY_LAWYER_ID) LAWYER_NUMBER,
(SELECT L.NAME FROM PAR_LAWYERS L WHERE L.ID = FP.SECONDARY_LAWYER_ID) LAWYER_NAME_TWO,
(SELECT L.RETAINER_NUMBER FROM PAR_LAWYERS L WHERE L.ID = FP.SECONDARY_LAWYER_ID) LAWYER_NUMBER_TWO,
       E.ID,
       E.COURT_ID,
       FP.PROCEDURE_DATE,
       P.PARTY_FULL_NAME,
       P.ID_NUMBER,
       DH.HEARING_DATE,
  (SELECT D.SEQUENCE_NUMBER
          FROM EXC_FOLDER_DATA D
         WHERE D.RES_PARTY_ID = FP.RES_PARTY_ID)
          COUNTER,
       (SELECT D.YEAR
          FROM EXC_FOLDER_DATA D
         WHERE D.RES_PARTY_ID = FP.RES_PARTY_ID)
          COUNTER_YEAR,
  (SELECT D.EXECUTION_NUMBER
          FROM EXC_FOLDER_DATA D
         WHERE D.RES_PARTY_ID = FP.RES_PARTY_ID)
          EXECUTION_NUMBER,
  (SELECT D.EXECUTION_DATE
          FROM EXC_FOLDER_DATA D
         WHERE D.RES_PARTY_ID = FP.RES_PARTY_ID)
          EXECUTION_DATE,
 (SELECT D.JUDGMENT_TEXT
          FROM EXC_FOLDER_DATA D
         WHERE D.RES_PARTY_ID = FP.RES_PARTY_ID)
          JUDGMENT_TEXT,
 (SELECT D.IMPRISONMENT_PLACE
          FROM EXC_FOLDER_DATA D
         WHERE D.RES_PARTY_ID = FP.RES_PARTY_ID)
          IMPRISONMENT_PLACE,
   (SELECT D.IMPRISONMENT_START_DATE
          FROM EXC_FOLDER_DATA D
         WHERE D.RES_PARTY_ID = FP.RES_PARTY_ID)
          IMPRISONMENT_START_DATE,
            (SELECT D.IMPRISONMENT_END_DATE
          FROM EXC_FOLDER_DATA D
         WHERE D.RES_PARTY_ID = FP.RES_PARTY_ID)
          IMPRISONMENT_END_DATE,
       PR.POLICE_NUMBER,
       PR.PAR_YEAR,
       CT.NAME,
  (SELECT SUM (D.AMOUNT - NVL (D.PAID_AMOUNT, 0))
          FROM EXC_COURT_BC_PARTY_DEBT D, EXC_LKP_FEES_SETTINGS S
         WHERE D.RES_PARTY_ID = FP.RES_PARTY_ID
         AND D.FEES_TYPE_ID = S.ID
         AND S.CATEGORY_ID = 3)
          AMOUNT,
       (SELECT ENTITY_NAME
          FROM ENTITY
         WHERE E.COURT_ID = ENTITY.ID)
          ENTITY_NAME,
       (SELECT ENTITY_NAME
          FROM ENTITY
         WHERE ID = PR.ORIGIN_ENTITY)
          ENTITY,
 (SELECT ENTITY_NAME
          FROM ENTITY
         WHERE ID = PR.ENTITY_ID)
          ORIGIN_ENTITY,
  (SELECT ENTITY_NAME
          FROM ENTITY
         WHERE ID = (SELECT PARENT_ENTITY_ID
                       FROM ENTITY
                      WHERE ID = PR.ENTITY_ID))
          PARENT_ENTITY,
       (SELECT H.HEARING_DATE
          FROM COURT_CIRCLES_DATES_HEARING H
         WHERE FP.COURT_CIRCLE_DATES_HEARING_ID = H.ID)
          HEARING_DATE_TWO,(SELECT H.HEARING_DATE
          FROM COURT_CIRCLES_DATES_HEARING H
         WHERE FP.COURT_CIRCLE_DATES_HEARING_ID = H.ID)
          HEARING_DATE_TWO,
          (SELECT U.FULL_NAME FROM SEC_USERS U WHERE U.ID = FP.CREATED_BY) CREATED_BY,SYSDATE, (SELECT D.DESCRIPTION_DES
          FROM FORM_CASE_DESCRIPTION D
         WHERE     D.COURT_FLAG = 1
               AND D.BUSINESS_CASE_ID = PR.BUSINESS_CASE_ID
               AND D.COURT_CIRCLE_DATE_ID = DH.ID)
          DESCRIPTION_DES
  FROM EXC_FOLDER_ACTIONS FA,
       EXC_FOLDER_PROCEDURES FP,
       ENTITY E,
       COURT_BC_HEARING_RES_PARTIES RP,
       PAR_PARTIES P,
       COURT_BC_HEARING_RESERVATION HR,
       COURT_CIRCLES_DATES_HEARING DH,
       PAR_POLICE_AUTHORITY_REPORT PR,
       BUSINESS_CASE_TYPE CT
 WHERE     FA.PROCEDURE_ID = $P{PROCEDURE_ID}
       AND FP.ID = FA.PROCEDURE_ID
       AND E.id = FP.PROSECUTION_ID
       AND RP.ID = FP.RES_PARTY_ID
       AND RP.PARTY_ID = P.ID
       AND HR.ID = RP.COURT_BC_HEARING_RES_ID
       AND HR.CIRCLE_HEARING_DATE_ID = DH.ID
       AND HR.BUSINESS_CASE_ID = PR.BUSINESS_CASE_ID
       AND PR.BUSINESS_CASE_TYPE = CT.ID
       AND FA.ACTION_TYPE = 2]]>
	</queryString>
