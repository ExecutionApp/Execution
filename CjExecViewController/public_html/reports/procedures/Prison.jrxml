				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["استلمت المحكوم عليه المذكور وتقيد بدفتر السجن برقم / "]]></textFieldExpression>
