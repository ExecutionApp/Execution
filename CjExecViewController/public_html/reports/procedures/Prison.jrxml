				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["بمقتضى الحكم الصادر من "+($F{ENTITY_NAME}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{ENTITY_NAME}.toString())))+" "+"بتاريخ "+($F{HEARING_DATE}==null?"":new utils.ArabicNumberFormatter().formatTimeStamp($F{HEARING_DATE},new java.lang.String("dd/MM/yyyy")).trim())]]></textFieldExpression>
