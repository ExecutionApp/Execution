				</textElement>
				<textFieldExpression><![CDATA["قد حكم على المذكور أعلاه الصناعة / "+($F{JOB_TITLE}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{JOB_TITLE}.toString())))]]></textFieldExpression>
