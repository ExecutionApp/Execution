				<textFieldExpression><![CDATA["تحت رقم حبس / "+($F{EXECUTION_NUMBER}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{EXECUTION_NUMBER}.toString())))+" "+"لسنة "+($F{EXECUTION_DATE}==null?"":new utils.ArabicNumberFormatter().formatTimeStamp($F{EXECUTION_DATE},new java.lang.String("yyyy")).trim())+" "+($F{ENTITY}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{ENTITY}.toString())))]]></textFieldExpression>
