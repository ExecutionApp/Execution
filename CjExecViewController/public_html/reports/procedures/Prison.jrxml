			<staticText>
				<reportElement x="0" y="3" width="555" height="20" uuid="57e74ea0-8c76-4a96-83a6-70d4c0be3383"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="14" isBold="true" isUnderline="false"/>
				</textElement>
				<text><![CDATA[( أمر بالقبض )]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="0" y="23" width="555" height="20" uuid="f94690e5-dc08-4551-80bc-ffef3d6eb60a"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["يجب على كل محضر وكل مأمور من مأموري الضبط والربط يكون "+"حاملاً لهذا أن يبادر بالقبض على المحكوم عليه "+"واحضاره الى السجن"]]></textFieldExpression>
			</textField>
		</band>
		<band height="22">
			<line>
				<reportElement x="0" y="1" width="555" height="1" uuid="1129e001-8e37-43fb-9806-f84f9813cfd5"/>
				<graphicElement>
					<pen lineWidth="2.0"/>
				</graphicElement>
			</line>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="0" y="2" width="555" height="20" uuid="92360e4f-d673-4efb-83ff-1023ff83ff4e"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="14" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["السيد / "+"العميد مأمور سجن "+($F{IMPRISONMENT_PLACE}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{IMPRISONMENT_PLACE}.toString())))]]></textFieldExpression>
			</textField>
		</band>
		<band height="20">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="0" y="0" width="555" height="20" uuid="878510fa-d79a-4f78-9065-e2299fcaaef3"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["حيث أن الحكم الموضح بعاليه واجب التنفيذ فوراً طبقاً للمادة "+($F{DESCRIPTION_DES}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{DESCRIPTION_DES}.toString())))+" "+"لعدم استئنافه من المحكوم"+" "+"فنطلب من سيادتكم بموجب هذا ونكلفكم بقبول المحكوم عليه في السجن"+" "+"وتنفيذ هذا الحكم"+" "+"الصادر عليه "+"حسب القوانين والاوامر "+"المتبعة "+"( بعد "+"استنزال "+"مدة الحبس الاحتياطي والتنفيذي الموضح قبله "+")"]]></textFieldExpression>
			</textField>
		</band>
		<band height="20">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="0" y="0" width="555" height="20" uuid="5c835781-52ba-407c-bd8a-007c4315b52d"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["وتكون مدة العقوبة المذكورة اعتباراً من "+($F{IMPRISONMENT_START_DATE}==null?"":new utils.ArabicNumberFormatter().formatTimeStamp($F{IMPRISONMENT_START_DATE},new java.lang.String("dd/MM/yyyy")).trim())+" "+"حتى "+($F{IMPRISONMENT_END_DATE}==null?"":new utils.ArabicNumberFormatter().formatTimeStamp($F{IMPRISONMENT_END_DATE},new java.lang.String("dd/MM/yyyy")).trim())]]></textFieldExpression>
			</textField>
		</band>
		<band height="20">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="0" y="0" width="555" height="20" uuid="19331623-91d7-4f36-89d4-d9781f6ede2d"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["واستأنف المتهم لجلسة "]]></textFieldExpression>
			</textField>
		</band>
		<band height="20">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="0" y="0" width="555" height="20" uuid="f60a6de4-38e8-436f-9bfd-192261fbe56e"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["ويراعى عرض المذكور علينا قبل اخلاء سبيله لتحصيل مبلغ "+($F{AMOUNT}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{AMOUNT}.toString())))+" "+"مصاريف"]]></textFieldExpression>
			</textField>
		</band>
		<band height="20">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="-1" y="0" width="555" height="20" uuid="dbcfc0ec-6c24-463f-9147-ef7a3c982d29"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["ويعد التنفيذ بالعقوبة المدكورة على المحكوم عليه يجب تسليمه الى الشرطة "+"طبقاً لأحكام المادة الموضحة "+"من لائحة السجن للتنفيذ "]]></textFieldExpression>
			</textField>
		</band>
		<band height="20">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="0" y="0" width="555" height="20" uuid="e9a3eddb-d846-4c54-a91a-8389b8030c59"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["بجعله تحت مراقبة الشرطة لمدة / "+"     "+"الصادر بها الحكم المذكور."]]></textFieldExpression>
			</textField>
		</band>
		<band height="20">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="0" y="0" width="555" height="20" uuid="6edbfd4f-d111-4173-90c5-5baaa168c2b0"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["مع العلم بأن المتهم المذكور سبق الحكم عليه : "+"     "+"مرات"]]></textFieldExpression>
			</textField>
		</band>
		<band height="40">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="239" y="0" width="315" height="20" uuid="40c89785-209a-4f09-8d34-492bfd213334"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["تحريراً في : "+($F{SYSDATE}==null?"":new utils.ArabicNumberFormatter().formatTimeStamp($F{SYSDATE},new java.lang.String("dd/MM/yyyy")).trim())]]></textFieldExpression>
			</textField>
