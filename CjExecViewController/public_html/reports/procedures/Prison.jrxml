				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["تنبيه / "+"سيصير إخطار سيادتكم "+"بعد "+"اذا اقتضى الحال ذلك بمدة الحبس التي يجب "+"التنفيذ "+"بها على المحكوم عليه عند عدم قيامه بدفع العقوبات المالية "]]></textFieldExpression>
			</textField>
