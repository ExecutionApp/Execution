					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["رقم الحصر/ "+($F{COUNTER}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{COUNTER}.toString())))+" "+"لسنة "+($F{COUNTER_YEAR}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{COUNTER_YEAR}.toString())))]]></textFieldExpression>
			</textField>
