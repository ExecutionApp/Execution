<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HasrDafater" language="groovy" pageWidth="595" pageHeight="842" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="261e9ab5-f547-4d50-a61c-d8b74dcc4acd">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="REPORT_PATH" class="java.lang.String"/>
	<parameter name="yearBind" class="java.lang.String"/>
	<parameter name="criminalType" class="java.lang.String"/>
	<parameter name="folderTypeBind" class="java.lang.String"/>
	<parameter name="entityIdBind" class="java.lang.String"/>
	<parameter name="gozeya" class="java.lang.String"/>
	<parameter name="koleya" class="java.lang.String"/>
	<parameter name="fromHasr" class="java.lang.String"/>
	<parameter name="toHasr" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT (SELECT ENTITY_NAME FROM ENTITY WHERE ID = $P{gozeya}) GOZEYA, (SELECT ENTITY_NAME FROM ENTITY WHERE ID = $P{koleya}) KOLEYA, $P{yearBind} || '/' || SEQUENCE_NUMBER  || '/'|| decode($P{folderTypeBind},1,'حبس منفذ' ,  2,'حبس غير منفذ',  3, 'غرامة',5,'أمن دولة حبس',6,'أمن دولة غرامة')  SEQUENCE_NUMBER
  FROM (  SELECT SEQUENCE_NUMBER
            FROM (    SELECT LEVEL SEQUENCE_NUMBER
                        FROM DUAL
                  CONNECT BY LEVEL <= (999999))
           WHERE     SEQUENCE_NUMBER NOT IN
                        (SELECT FD.SEQUENCE_NUMBER
                           FROM EXC_FOLDER_DATA FD , ENTITY POLICE , ENTITY GOZEYA , ENTITY PAREN
    WHERE FD.POLICE_STATION_ENTITY_ID = POLICE.ID
    AND POLICE.PARENT_ENTITY_ID = GOZEYA.ID
    AND GOZEYA.PARENT_ENTITY_ID = PAREN.ID
    AND FD.POLICE_STATION_ENTITY_ID = $P{entityIdBind}
    AND FD.CRIMINAL_TYPE = $P{criminalType}
    AND (FD.YEAR = $P{yearBind})
    AND FD.FOLDER_TYPE = $P{folderTypeBind}
    AND FD.SEQUENCE_NUMBER > 0
    )
		    AND (SEQUENCE_NUMBER BETWEEN $P{fromHasr} AND $P{toHasr} OR $P{fromHasr} IS NULL OR $P{toHasr} IS NULL)
    ORDER BY SEQUENCE_NUMBER)]]>
	</queryString>
	<field name="GOZEYA" class="java.lang.String"/>
	<field name="KOLEYA" class="java.lang.String"/>
	<field name="SEQUENCE_NUMBER" class="java.lang.String"/>
	<background>
