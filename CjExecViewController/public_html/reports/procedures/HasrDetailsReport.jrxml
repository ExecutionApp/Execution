<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HasrDafater" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="842" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="261e9ab5-f547-4d50-a61c-d8b74dcc4acd">
	<property name="ireport.zoom" value="1.3310000000000006"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="REPORT_PATH" class="java.lang.String"/>
	<parameter name="createdDateBind" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="gozeyaIdBind" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="createdDateToBind" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select NVL (Gonah.GOZEYA_ENTITY_NAME, Genayat.GOZEYA_ENTITY_NAME)
          GOZEYA_ENTITY_NAME,
       NVL (Genayat.PARENT_ENTITY_NAME, Gonah.PARENT_ENTITY_NAME)
          PARENT_ENTITY_NAME,GONAH_PRISON,GONAH_PENALTY,GENAYAT_DONE,GENAYAT_NOT_DONE,PREV_GONAH,PREV_GENAYAT,TOTAL_GONAH,TOTAL_GENAYAT,AMN_DOAWLA
from
(SELECT COUNT(FD.ID) TOTAL_GONAH, PAREN.id , PAREN.ENTITY_NAME GOZEYA_ENTITY_NAME , master.ENTITY_NAME PARENT_ENTITY_NAME
FROM EXC_FOLDER_DATA FD , ENTITY master , ENTITY GOZEYA , ENTITY PAREN
WHERE  FD.POLICE_STATION_ENTITY_ID = GOZEYA.ID
                 AND GOZEYA.PARENT_ENTITY_ID = PAREN.ID
                 AND PAREN.PARENT_ENTITY_ID = Master.ID
                AND FD.CRIMINAL_TYPE = 1
                 AND ( FD.POLICE_STATION_ENTITY_ID IN
                            (SELECT id
                               FROM entity
                              WHERE PARENT_ENTITY_ID = $P{gozeyaIdBind})
                      OR master.ID = $P{gozeyaIdBind})
                      GROUP BY PAREN.ID, PAREN.ENTITY_NAME , Master.ENTITY_NAME)   Gonah

                      FULL OUTER JOIN

                        (SELECT COUNT(FD.ID) TOTAL_GENAYAT ,GOZEYA.ID,
                                         GOZEYA.ENTITY_NAME GOZEYA_ENTITY_NAME,
                                         GOZEYA.ENTITY_NAME PARENT_ENTITY_NAME

                                    FROM EXC_FOLDER_DATA FD,
                                         ENTITY GOZEYA,
                                         ENTITY PAREN
                                   WHERE     FD.POLICE_STATION_ENTITY_ID = GOZEYA.ID
                                         AND GOZEYA.PARENT_ENTITY_ID = PAREN.ID
                        AND FD.CRIMINAL_TYPE = 2
                                         AND (   (FD.POLICE_STATION_ENTITY_ID =
                                                     (SELECT PARENT_ENTITY_ID
                                                        FROM entity
                                                       WHERE id = $P{gozeyaIdBind}))
                                              OR (FD.POLICE_STATION_ENTITY_ID = $P{gozeyaIdBind}))
                                             GROUP BY GOZEYA.ID,
                                         GOZEYA.ENTITY_NAME,
                                         PAREN.ENTITY_NAME
                                         ) Genayat

              on   Genayat.id = Gonah.id
              FULL OUTER JOIN

(SELECT COUNT(FD.ID) GONAH_PRISON , PAREN.id
FROM EXC_FOLDER_DATA FD , ENTITY master , ENTITY GOZEYA , ENTITY PAREN
WHERE  FD.POLICE_STATION_ENTITY_ID = GOZEYA.ID
                 AND GOZEYA.PARENT_ENTITY_ID = PAREN.ID
                 AND PAREN.PARENT_ENTITY_ID = Master.ID
                 AND (   FD.POLICE_STATION_ENTITY_ID IN
                            (SELECT id
                               FROM entity
                              WHERE PARENT_ENTITY_ID = $P{gozeyaIdBind})
                      OR master.ID = $P{gozeyaIdBind})

  AND FD.CRIMINAL_TYPE = 1
AND FD.FOLDER_TYPE = 2
AND  (  FD.CREATED_DATE BETWEEN TO_DATE($P{createdDateBind} , 'yyyy-MM-dd')
                                                                       AND TO_DATE($P{createdDateToBind} , 'yyyy-MM-dd') +1
                      OR to_char(FD.CREATED_DATE, 'yyyy-MM-dd') =$P{createdDateBind})
GROUP BY PAREN.ID) tab1
           on tab1.id=gonah.id
FULL OUTER JOIN

(SELECT COUNT(fd.ID) GONAH_PENALTY ,PAREN.ID
FROM EXC_FOLDER_DATA FD , ENTITY master , ENTITY GOZEYA , ENTITY PAREN
WHERE FD.POLICE_STATION_ENTITY_ID = GOZEYA.ID
                 AND GOZEYA.PARENT_ENTITY_ID = PAREN.ID
                 AND PAREN.PARENT_ENTITY_ID = Master.ID
                 AND (   FD.POLICE_STATION_ENTITY_ID IN
                            (SELECT id
                               FROM entity
                              WHERE PARENT_ENTITY_ID = $P{gozeyaIdBind})
                      OR master.id = $P{gozeyaIdBind})

     AND FD.CRIMINAL_TYPE = 1
AND FD.FOLDER_TYPE = 3
AND (  FD.CREATED_DATE BETWEEN TO_DATE($P{createdDateBind} , 'yyyy-MM-dd')
                                                                       AND TO_DATE($P{createdDateToBind} , 'yyyy-MM-dd')+1
                      OR to_char(FD.CREATED_DATE, 'yyyy-MM-dd') =$P{createdDateBind})

GROUP BY PAREN.ID) tab2

ON Gonah.ID = TAB2.ID
FULL OUTER JOIN

(SELECT COUNT(FD.ID) GENAYAT_DONE ,GOZEYA.ID
            FROM EXC_FOLDER_DATA FD,
                 ENTITY GOZEYA,
                 ENTITY PAREN
           WHERE     FD.POLICE_STATION_ENTITY_ID = GOZEYA.ID
                 AND GOZEYA.PARENT_ENTITY_ID = PAREN.ID
                 AND (   (FD.POLICE_STATION_ENTITY_ID =
                             (SELECT PARENT_ENTITY_ID
                                FROM entity
                               WHERE id = $P{gozeyaIdBind}))
                      OR (FD.POLICE_STATION_ENTITY_ID = $P{gozeyaIdBind}))
                       AND FD.CRIMINAL_TYPE = 2
       AND FD.FOLDER_TYPE = 1
                 AND  (  FD.CREATED_DATE BETWEEN TO_DATE($P{createdDateBind} , 'yyyy-MM-dd')
                                                                      AND TO_DATE($P{createdDateToBind} , 'yyyy-MM-dd')+1
                     OR to_char(FD.CREATED_DATE, 'yyyy-MM-dd') =$P{createdDateBind})
        GROUP BY GOZEYA.ID

                 ) TAB3

ON GENAYAT.ID = TAB3.ID


FULL OUTER JOIN

(SELECT COUNT(FD.ID) GENAYAT_NOT_DONE ,GOZEYA.ID


            FROM EXC_FOLDER_DATA FD,
                 ENTITY GOZEYA,
                 ENTITY PAREN
           WHERE     FD.POLICE_STATION_ENTITY_ID = GOZEYA.ID
                 AND GOZEYA.PARENT_ENTITY_ID = PAREN.ID
 AND FD.CRIMINAL_TYPE = 2
       AND FD.FOLDER_TYPE =2

                 AND (   (FD.POLICE_STATION_ENTITY_ID =
                             (SELECT PARENT_ENTITY_ID
                                FROM entity
                               WHERE id = $P{gozeyaIdBind}))
                      OR (FD.POLICE_STATION_ENTITY_ID = $P{gozeyaIdBind}))


                 AND (  FD.CREATED_DATE BETWEEN TO_DATE($P{createdDateBind} , 'yyyy-MM-dd')
                                                                       AND TO_DATE($P{createdDateToBind} , 'yyyy-MM-dd')+1
                      OR to_char(FD.CREATED_DATE, 'yyyy-MM-dd') =$P{createdDateBind})
        GROUP BY GOZEYA.ID,
                 GOZEYA.ENTITY_NAME,
                 PAREN.ENTITY_NAME
                 )    tab4

   ON TAB4.ID = GENAYAT.ID
   FULL OUTER JOIN

   (SELECT COUNT(fd.ID) PREV_GONAH ,PAREN.ID
FROM EXC_FOLDER_DATA FD , ENTITY master , ENTITY GOZEYA , ENTITY PAREN
WHERE FD.POLICE_STATION_ENTITY_ID = GOZEYA.ID
                 AND GOZEYA.PARENT_ENTITY_ID = PAREN.ID
                 AND PAREN.PARENT_ENTITY_ID = Master.ID
                 AND ( fd.POLICE_STATION_ENTITY_ID IN
                            (SELECT id
                               FROM entity
                              WHERE PARENT_ENTITY_ID = $P{gozeyaIdBind})
                      OR Master.id = $P{gozeyaIdBind})

     AND FD.CRIMINAL_TYPE = 1
AND  FD.CREATED_DATE  < TO_DATE($P{createdDateBind} , 'yyyy-MM-dd')

 GROUP BY PAREN.ID, PAREN.ENTITY_NAME , Master.ENTITY_NAME) tab5

ON gonah.ID = TAB5.ID
FULL OUTER JOIN

(SELECT COUNT(FD.ID) PREV_GENAYAT ,GOZEYA.ID

            FROM EXC_FOLDER_DATA FD,
                 ENTITY GOZEYA,
                 ENTITY PAREN
           WHERE     FD.POLICE_STATION_ENTITY_ID = GOZEYA.ID
                 AND GOZEYA.PARENT_ENTITY_ID = PAREN.ID
AND FD.CRIMINAL_TYPE = 2
                 AND (   (FD.POLICE_STATION_ENTITY_ID =
                             (SELECT PARENT_ENTITY_ID
                                FROM entity
                               WHERE id = $P{gozeyaIdBind}))
                      OR (FD.POLICE_STATION_ENTITY_ID = $P{gozeyaIdBind}))
AND FD.CREATED_DATE  < TO_DATE($P{createdDateBind} , 'yyyy-MM-dd')

GROUP BY GOZEYA.ID) TAB6

ON GENAYAT.ID = TAB6.ID

FULL OUTER JOIN

(SELECT COUNT(FD.ID) AMN_DOAWLA , PAREN.ID
    FROM EXC_FOLDER_DATA FD , COURT_BC_HEARING_RES_PARTIES RES , COURT_BC_HEARING_RESERVATION HR , ENTITY master , ENTITY GOZEYA ,
    ENTITY PAREN , BUSINESS_CASE BC
    WHERE RES.ID = FD.RES_PARTY_ID
    AND  FD.POLICE_STATION_ENTITY_ID = GOZEYA.ID
                 AND GOZEYA.PARENT_ENTITY_ID = PAREN.ID
                 AND PAREN.PARENT_ENTITY_ID = Master.ID
                AND FD.CRIMINAL_TYPE = 1
                 AND ( FD.POLICE_STATION_ENTITY_ID IN
                            (SELECT id
                               FROM entity
                              WHERE PARENT_ENTITY_ID = $P{gozeyaIdBind})
                      OR master.ID = $P{gozeyaIdBind})
    AND RES.COURT_BC_HEARING_RES_ID = HR.ID
    AND HR.BUSINESS_CASE_ID = BC.ID
    AND BC.CASE_TYPE = 10
    GROUP BY PAREN.ID) TAB9
ON Gonah.ID = TAB9.ID]]>
	</queryString>
	<field name="GOZEYA_ENTITY_NAME" class="java.lang.String"/>
	<field name="PARENT_ENTITY_NAME" class="java.lang.String"/>
	<field name="GONAH_PRISON" class="java.math.BigDecimal"/>
	<field name="GONAH_PENALTY" class="java.math.BigDecimal"/>
	<field name="GENAYAT_DONE" class="java.math.BigDecimal"/>
	<field name="GENAYAT_NOT_DONE" class="java.math.BigDecimal"/>
	<field name="PREV_GONAH" class="java.math.BigDecimal"/>
	<field name="PREV_GENAYAT" class="java.math.BigDecimal"/>
	<field name="TOTAL_GONAH" class="java.math.BigDecimal"/>
	<field name="TOTAL_GENAYAT" class="java.math.BigDecimal"/>
	<field name="AMN_DOAWLA" class="java.math.BigDecimal"/>
