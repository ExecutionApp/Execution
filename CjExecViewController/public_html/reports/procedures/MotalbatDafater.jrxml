	<field name="CLAIM_YEAR" class="java.lang.String"/>
	<field name="CLAIM_TOTAL_ORIGINAL" class="java.math.BigDecimal"/>
	<field name="CLAIM_SEQUENCE_NUMBER" class="java.lang.String"/>
	<field name="ORIGINAL_PENALTY_DUE_DATE" class="java.lang.String"/>
	<field name="CREATED_DATE" class="java.lang.String"/>
	<field name="CASE_NUMBER" class="java.lang.String"/>
	<field name="POLICE_NAME" class="java.lang.String"/>
	<field name="GOZEYA_NAME" class="java.lang.String"/>
	<field name="KOLYEA_NAME" class="java.lang.String"/>
	<field name="CREATED_BY" class="java.lang.String"/>
