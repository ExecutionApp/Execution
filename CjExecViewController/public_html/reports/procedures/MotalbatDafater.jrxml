	<parameter name="REPORT_PATH" class="java.lang.String"/>
	<parameter name="year" class="java.lang.String"/>
	<parameter name="gozeyaId" class="java.lang.String"/>
	<parameter name="dateFrom" class="java.lang.String"/>
	<parameter name="dateTo" class="java.lang.String"/>
	<parameter name="procedureTypeId" class="java.lang.String"/>
	<parameter name="procedureTypeName" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT C.CLAIM_NUMBER ,
C.PARTY_NAME ,
C.CLAIM_FOLDER_ID ,
Y.CLAIM_YEAR,
C.CLAIM_TOTAL_ORIGINAL,
C.CLAIM_SEQUENCE_NUMBER,
C.ORIGINAL_PENALTY_DUE_DATE,
TO_CHAR(C.CREATED_DATE , 'yyyy/mm/dd') CREATED_DATE,
P.PAR_YEAR || '/' || P.POLICE_NUMBER || '/' || T.NAME || '/' || E.ENTITY_NAME AS CASE_NUMBER ,
E.ENTITY_NAME POLICE_NAME ,
POLICE_PARENT.ENTITY_NAME GOZEYA_NAME ,
KOLYEA_ENTITY.ENTITY_NAME KOLYEA_NAME,
(SELECT USERNAME FROM SEC_USERS WHERE ID = C.CREATED_BY) CREATED_BY

FROM EXC_CLAIMS C, BUSINESS_CASE B, EXC_CLAIM_YEARS Y, PAR_POLICE_AUTHORITY_REPORT P, ENTITY E, BUSINESS_CASE_TYPE T ,
ENTITY POLICE_PARENT , ENTITY KOLYEA_ENTITY

WHERE C.BUSINESS_CASE_ID = B.ID
AND C.CLAIM_YEAR = Y.ID
AND C.BUSINESS_CASE_ID = P.BUSINESS_CASE_ID
AND P.ORIGIN_ENTITY = E.ID
AND P.BUSINESS_CASE_TYPE = T.ID
AND E.PARENT_ENTITY_ID = POLICE_PARENT.ID
AND POLICE_PARENT.PARENT_ENTITY_ID = KOLYEA_ENTITY.ID
AND Y.ID = $P{year}
AND E.PARENT_ENTITY_ID = $P{gozeyaId}
AND C.CREATED_DATE BETWEEN TO_DATE($P{dateFrom} , 'yyyy/mm/dd') AND TO_DATE($P{dateTo} , 'yyyy/mm/dd')+1]]>
	</queryString>
	<field name="CLAIM_NUMBER" class="java.lang.String"/>
	<field name="PARTY_NAME" class="java.lang.String"/>
