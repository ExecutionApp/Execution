	<detail>
		<band height="20">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="0" y="0" width="555" height="20" uuid="a89e35ec-5877-4f0b-b929-1e1e6b3f20a8"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["مقدمة لسيادتكم / "+($F{PARTY_FULL_NAME}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{PARTY_FULL_NAME}.toString())))]]></textFieldExpression>
			</textField>
		</band>
		<band height="20">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="1" y="0" width="554" height="20" isRemoveLineWhenBlank="true" uuid="6a746c80-8872-4c28-b337-1d92b0f842d7"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["وأحمل رقم قومي / "+($F{ID_NUMBER}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{ID_NUMBER}.toString())))]]></textFieldExpression>
			</textField>
		</band>
		<band height="20">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="1" y="0" width="554" height="20" isRemoveLineWhenBlank="true" uuid="5b55f524-21ac-4ac7-8fa9-b2a2c82bea46"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["والصادر صدي حكم محكمة / "+($F{COURT}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{COURT}.toString())))+" "+"في القضية رقم / "+($F{POLICE_NUMBER}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{POLICE_NUMBER}.toString())))+" "+"لسنة "+($F{PAR_YEAR}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{PAR_YEAR}.toString())))+" "+"بتاريخ "+($F{HEARING_DATE}==null?"":new utils.ArabicNumberFormatter().formatTimeStamp($F{HEARING_DATE},new java.lang.String("dd/MM/yyyy")).trim())+" "+"والقاضي منطوقه / "+($F{JUDGMENT_TEXT}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{JUDGMENT_TEXT}.toString())))]]></textFieldExpression>
			</textField>
		</band>
		<band height="20">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="1" y="0" width="553" height="20" isRemoveLineWhenBlank="true" uuid="2ff493a5-234e-401e-bbd1-92a0632f8402"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["حيث إنه وفي ضوء المستقر عليه "+"قضاءً من أن القانون "+"لم يشترط في التقرير بالطعن "+"-بوصفه عملاً إجزائياً-"+" "+"سوى إفصاح الطاعن شفاهه عن رغبته "+"في الاعتراض على "+"الحكم بالشكل الذي "+"رسمه القانون، "+"ويترتب على مجرد التقرير بالطعن "+"دخوله في حوزة "+"المحكمة واتصالها به، "+"بصرف النظر عن "+"عدم التوقيع عليه "+"من المقرر."]]></textFieldExpression>
			</textField>
		</band>
		<band height="20">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="0" y="0" width="555" height="20" isRemoveLineWhenBlank="true" uuid="8fa03de8-c19e-4b87-a483-6320740cc124"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["طعن رقم ٢٩٤٣ لسنة ٣٢ ق، جلسة "+"٢٩/١٠/١٩٦٣"]]></textFieldExpression>
			</textField>
		</band>
		<band height="20">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="0" y="0" width="555" height="20" isRemoveLineWhenBlank="true" uuid="1da844bd-d717-463d-b485-865591768c5f"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["طعن رقم ٤٥٣٧ لسنة ٥٧ ق. جلسة "+"١٤/١/١٩٨٨"]]></textFieldExpression>
			</textField>
		</band>
		<band height="20">
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="1" y="0" width="554" height="20" isRemoveLineWhenBlank="true" uuid="43a44ca1-b6b0-4478-b1a2-e5d602ee9c19"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["فبرجاء اتخاذ اللازم "+"نحو تمكيني من إخطار "+"الموظف المختص بقلم كتاب محكمة / "+($F{COURT}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{COURT}.toString())))+" "+"بموجب هذا الطلب "+"عن رغبتي في الطعن "+"بطريق المعارضة على "+"الحكم الصادر ضدي "+"والمشار إليه بعالية، "+"لإعداد تقرير الطعن "+"وتحديد جلسة "+"لنظره امام المحكمة المختصة. "]]></textFieldExpression>
			</textField>
		</band>
