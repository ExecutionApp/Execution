	<field name="DOCUMENT_ID2" class="java.lang.String"/>
	<field name="APPEAL_REQUEST" class="java.lang.String"/>
	<field name="CRIMINAL_REQUEST" class="java.lang.String"/>
	<field name="OPPOSITION_REQUEST" class="java.lang.String"/>
	<field name="PROCEDURE_DATE" class="java.sql.Timestamp"/>
	<field name="LOGGED_ENTITY_NAME" class="java.lang.String"/>
	<field name="CASE_ENTITY_NAME" class="java.lang.String"/>
	<field name="ACTION_TYPE_NAME" class="java.lang.String"/>
	<field name="CASE_TYPE_NAME" class="java.lang.String"/>
	<field name="CASE_NUMBER" class="java.lang.String"/>
	<field name="CASE_TYPE_ID" class="java.math.BigDecimal"/>
	<field name="CASE_YEAR" class="java.math.BigDecimal"/>
	<field name="FULL_NAME" class="java.lang.String"/>
	<field name="SEQUENCE_NUMBER_LONG" class="java.lang.String"/>
