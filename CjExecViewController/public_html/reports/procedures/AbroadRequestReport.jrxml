<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HasrDafater" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="842" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="261e9ab5-f547-4d50-a61c-d8b74dcc4acd">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="REPORT_PATH" class="java.lang.String"/>
	<parameter name="Query" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="mode" class="java.lang.String"/>
	<parameter name="dateFrom" class="java.util.Date"/>
	<parameter name="dateTo" class="java.util.Date"/>
	<parameter name="KOLYA_ID" class="java.lang.String"/>
	<parameter name="gozeyaId" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT EXCPROCEDURESLOGEO.ID,
       EXCPROCEDURESLOGEO.PROCEDURE_ID,
       EXCPROCEDURESLOGEO.ACTION_TYPE_ID,
       EXCPROCEDURESLOGEO.CREATED_BY,
       TRUNC(EXCPROCEDURESLOGEO.CREATED_DATE) AS CREATED_DATE ,
       EXCPROCEDURESLOGEO.ENTITY_ID,
       EXCPROCEDURESLOGEO.BUSINESS_CASE_ID,
       EXCPROCEDURESLOGEO.LOGGED_IN_ENTITY_ID,
       EXCPROCEDURESLOGEO.SEQUENCE_NUMBER,
       EXCPROCEDURESLOGEO.EXC_CLAIM_ID,
       EXCPROCEDURESLOGEO.MODE_TYPE ,
       EXCPROCEDURESLOGEO.DOCUMENT_ID ,
       EXCPROCEDURESLOGEO.FOLDER_TYPE_ID ,
       DECODE(EXCPROCEDURESLOGEO.FOLDER_TYPE_ID , '2' , 'حبس' , '3' , 'غرامة' , '5' , ' حبس غير منفذ ', '6' , 'حبس منفذ ') FOLDER_TYPE_NAME ,
       EXCPROCEDURESLOGEO.REPEATED_FLAG ,
       EXCPROCEDURESLOGEO.SEQUENCE_YEAR ,
       EXCPROCEDURESLOGEO.DOCUMENT_ID2 ,
       EXCPROCEDURESLOGEO.APPEAL_REQUEST ,
       EXCPROCEDURESLOGEO.CRIMINAL_REQUEST ,
       EXCPROCEDURESLOGEO.OPPOSITION_REQUEST ,
       TRUNC(EXCPROCEDURESLOGEO.PROCEDURE_DATE) AS PROCEDURE_DATE ,
       LOGGED_ENTITY.ENTITY_NAME AS LOGGED_ENTITY_NAME ,
       CASE_ENTITY.ENTITY_NAME AS CASE_ENTITY_NAME ,
       ACTION_TYPES.NAME AS ACTION_TYPE_NAME ,
       CASE_TYPE.NAME AS CASE_TYPE_NAME ,
       BUS_CASE.CASE_NUMBER ,
       CASE_TYPE.ID AS CASE_TYPE_ID  ,
       REPO.PAR_YEAR AS CASE_YEAR ,
       SEC.FULL_NAME ,
       EXCPROCEDURESLOGEO.SEQUENCE_YEAR || '/' || EXCPROCEDURESLOGEO.SEQUENCE_NUMBER || '/' || CASE_POLICE_ENTITY.ENTITY_NAME || '/' || CASE_TYPE.NAME || ' ' || DECODE(EXCPROCEDURESLOGEO.REPEATED_FLAG , 'N' , ' ' , 'Y' , 'مكرر') SEQUENCE_NUMBER_LONG

FROM  EXC_PROCEDURES_LOG EXCPROCEDURESLOGEO , ENTITY LOGGED_ENTITY , ENTITY CASE_ENTITY , ENTITY CASE_POLICE_ENTITY ,EXC_LKP_ACTION_TYPES ACTION_TYPES ,
BUSINESS_CASE BUS_CASE , BUSINESS_CASE_TYPE CASE_TYPE , PAR_POLICE_AUTHORITY_REPORT REPO , SEC_USERS SEC
WHERE EXCPROCEDURESLOGEO.LOGGED_IN_ENTITY_ID = LOGGED_ENTITY.ID
AND EXCPROCEDURESLOGEO.ENTITY_ID = CASE_ENTITY.ID
AND REPO.ORIGIN_ENTITY =   CASE_POLICE_ENTITY.ID
AND EXCPROCEDURESLOGEO.ACTION_TYPE_ID = ACTION_TYPES.ID
AND EXCPROCEDURESLOGEO.BUSINESS_CASE_ID = BUS_CASE.ID
AND BUS_CASE.BUSINESS_CASE_TYPE = CASE_TYPE.ID
AND REPO.BUSINESS_CASE_ID = BUS_CASE.ID
AND EXCPROCEDURESLOGEO.CREATED_BY = SEC.ID

AND (TRUNC(EXCPROCEDURESLOGEO.CREATED_DATE) >= TRUNC($P{dateFrom}) OR $P{dateFrom} IS NULL)
AND (TRUNC(EXCPROCEDURESLOGEO.CREATED_DATE) <= TRUNC($P{dateTo}) OR $P{dateTo} IS NULL)
AND ((EXCPROCEDURESLOGEO.LOGGED_IN_ENTITY_ID = $P{KOLYA_ID} OR EXCPROCEDURESLOGEO.LOGGED_IN_ENTITY_ID IN (SELECT ID FROM ENTITY WHERE PARENT_ENTITY_ID = $P{KOLYA_ID})) OR $P{KOLYA_ID} IS NULL)
AND (EXCPROCEDURESLOGEO.LOGGED_IN_ENTITY_ID = $P{gozeyaId} OR $P{gozeyaId} IS NULL)
AND ((EXCPROCEDURESLOGEO.ENTITY_ID = $P{KOLYA_ID} OR EXCPROCEDURESLOGEO.ENTITY_ID IN (SELECT ID FROM ENTITY WHERE PARENT_ENTITY_ID = $P{KOLYA_ID})) OR $P{KOLYA_ID} IS NULL)
AND (EXCPROCEDURESLOGEO.ENTITY_ID = $P{gozeyaId} OR $P{gozeyaId} IS NULL)

ORDER BY EXCPROCEDURESLOGEO.ID DESC]]>
	</queryString>
	<field name="ID" class="java.math.BigDecimal"/>
	<field name="PROCEDURE_ID" class="java.math.BigDecimal"/>
	<field name="ACTION_TYPE_ID" class="java.math.BigDecimal"/>
	<field name="CREATED_BY" class="java.math.BigDecimal"/>
