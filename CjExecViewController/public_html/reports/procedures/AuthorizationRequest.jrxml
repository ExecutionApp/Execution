<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="AuthorizationRequest" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="bc26958a-de3d-4603-956d-b9ee91971ec6">
	<property name="ireport.zoom" value="1.7715610000000022"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="205"/>
	<parameter name="PROCEDURE_ID" class="java.math.BigDecimal"/>
	<parameter name="userId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="REPORT_PATH" class="java.lang.String"/>
	<parameter name="DID" class="java.math.BigDecimal"/>
	<parameter name="CONTEXT_PATH" class="java.lang.String"/>
	<queryString>
		<![CDATA[/* Formatted on 11/16/2019 1:24:32 PM (QP5 v5.227.12220.39754) */
SELECT FA.PROCEDURE_ID,
       FP.COURT_CIRCLE_DATES_HEARING_ID,
       RP.COURT_BC_HEARING_RES_ID,
       FA.ID ID_FOLDER_ACTIONS,
       FP.PROCEDURE_SERIAL,
       FP.PROSECUTION_ID,
       E.ID,
       E.COURT_ID,
       FP.PROCEDURE_DATE,
       P.PARTY_FULL_NAME,
       P.ID_NUMBER,
       DH.HEARING_DATE,
       PR.POLICE_NUMBER,
       PR.PAR_YEAR,
       CT.NAME,
       (SELECT ENTITY_NAME
          FROM ENTITY
         WHERE E.COURT_ID = ENTITY.ID)
          ENTITY_NAME,
       (SELECT ENTITY_NAME
          FROM ENTITY
         WHERE ID = PR.ORIGIN_ENTITY)
          ENTITY,
 (SELECT ENTITY_NAME
          FROM ENTITY
         WHERE ID = PR.ENTITY_ID)
          ORIGIN_ENTITY,
       (SELECT H.HEARING_DATE
          FROM COURT_CIRCLES_DATES_HEARING H
         WHERE FP.COURT_CIRCLE_DATES_HEARING_ID = H.ID)
          HEARING_DATE_TWO,(SELECT H.HEARING_DATE
          FROM COURT_CIRCLES_DATES_HEARING H
         WHERE FP.COURT_CIRCLE_DATES_HEARING_ID = H.ID)
          HEARING_DATE_TWO,
          (SELECT U.FULL_NAME FROM SEC_USERS U WHERE U.ID = FP.CREATED_BY) CREATED_BY,SYSDATE,          (SELECT U.FULL_NAME FROM SEC_USERS U WHERE U.ID = $P{userId}) LOGIN_USER,
(SELECT U.ENTITY_ID FROM SEC_USERS U WHERE U.ID = $P{userId}) ENTITY_ID
  FROM EXC_FOLDER_ACTIONS FA,
       EXC_FOLDER_PROCEDURES FP,
       ENTITY E,
       COURT_BC_HEARING_RES_PARTIES RP,
       PAR_PARTIES P,
       COURT_BC_HEARING_RESERVATION HR,
       COURT_CIRCLES_DATES_HEARING DH,
       PAR_POLICE_AUTHORITY_REPORT PR,
       BUSINESS_CASE_TYPE CT
 WHERE     FA.PROCEDURE_ID = $P{PROCEDURE_ID}
       AND FP.ID = FA.PROCEDURE_ID
       AND E.id = FP.PROSECUTION_ID
       AND RP.ID = FP.RES_PARTY_ID
       AND RP.PARTY_ID = P.ID
       AND HR.ID = RP.COURT_BC_HEARING_RES_ID
       AND HR.CIRCLE_HEARING_DATE_ID = DH.ID
       AND HR.BUSINESS_CASE_ID = PR.BUSINESS_CASE_ID
       AND PR.BUSINESS_CASE_TYPE = CT.ID
       AND FA.ACTION_TYPE = 2]]>
	</queryString>
	<field name="PROCEDURE_ID" class="java.math.BigDecimal"/>
	<field name="COURT_CIRCLE_DATES_HEARING_ID" class="java.math.BigDecimal"/>
	<field name="COURT_BC_HEARING_RES_ID" class="java.math.BigDecimal"/>
