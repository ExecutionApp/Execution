	<subDataset name="Table Dataset 1" uuid="0ce843f3-b7ef-4906-b3e8-76ad545959aa">
		<parameter name="pname" class="java.lang.String"/>
		<parameter name="pnum" class="java.lang.String"/>
		<parameter name="pyear" class="java.math.BigDecimal"/>
		<parameter name="proc" class="java.lang.String"/>
		<parameter name="police" class="java.lang.String"/>
		<queryString>
			<![CDATA[select 1 from dual]]>
		</queryString>
		<field name="1" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="New Dataset 2" uuid="417e8956-6369-4c64-8d70-0b171789d8a5">
		<parameter name="PARTY_ID" class="java.math.BigDecimal">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="JUD_TYPE" class="java.math.BigDecimal"/>
		<queryString>
			<![CDATA[SELECT (   FD.YEAR
        || '/'
        || FD.SEQUENCE_NUMBER
        || '/'
        || decode (fd.FOLDER_TYPE , 2 , 'حبس' ,3 ,'غرامة',5,'امن دوله حبس' ,6,'امن دوله غرامة',7,'براْة')  )
          SEQ_N,
       bcd.name DEGREE_NAME,
       FD.JUDGMENT_TEXT JUDGEMENT_RESOLUTION,
       JUD_TYP.ID JUD_TYPE,
       HEAR.hearing_date hearing_date
  FROM EXC_FOLDER_DATA fd,
       COURT_BC_HEARING_RES_PARTIES rp,
       COURT_BC_HEARING_RESERVATION res,
       COURT_CIRCLES_DATES_HEARING hear,
       business_CASE_DEGrees bcd,
       EXC_COURT_BC_SESSION_JUDGMENT SESS,
       EXC_LKP_JUDGMENT_TYPES JUD_TYP
 WHERE                                  -----------join-----------------------
       FD.RES_PARTY_ID = RP.ID AND RP.PARTY_ID = $P{PARTY_ID}
         AND RES.CIRCLE_HEARING_DATE_ID = HEAR.ID
         AND RP.COURT_BC_HEARING_RES_ID = RES.ID
         AND hear.BC_DEGREE_ID = bcd.id
         AND RES.ID = SESS.COURT_BC_HEARING_RES_ID
AND SESS.JUDGMENT_TYPE = JUD_TYP.ID
ORDER BY hearing_date]]>
		</queryString>
		<field name="DEGREE_NAME" class="java.lang.String"/>
		<field name="JUDGEMENT_RESOLUTION" class="java.lang.String"/>
		<field name="HEARING_DATE" class="java.sql.Timestamp"/>
		<field name="SEQ_N" class="java.lang.String"/>
		<field name="JUD_TYPE" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="New Dataset 3" uuid="e0634a17-1b0a-441d-b0f9-25bcdb2a992b">
		<parameter name="pPartyID" class="java.math.BigDecimal" isForPrompting="false">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[/* Formatted on 9/22/2021 1:50:57 PM (QP5 v5.287) */
SELECT ROWNUM,
       t.name,
       (SELECT NAME FROM EXC_LKP_FEES_TYPES F WHERE F.ID = P.FEES_TYPE_ID) FEES_TYPE,
       P.PROCEDURE_DATE,
       S.FOLDER_RECORD_ID,
       (SELECT TO_CHAR (DATES.HEARING_DATE, 'yyyy-mm-dd')
          FROM COURT_CIRCLES_DATES_HEARING DATES
         WHERE DATES.ID = p.COURT_CIRCLE_DATES_HEARING_ID)
          Hearing_Date
  FROM EXC_FOLDER_ACTIONS s, EXC_LKP_ACTION_TYPES t, EXC_FOLDER_PROCEDURES p
 WHERE     S.FOLDER_RECORD_ID IN
              (SELECT id
                 FROM exc_folder_data
                WHERE EXC_FOLDER_DATA.RES_PARTY_ID IN
                         (SELECT id
                            FROM COURT_BC_HEARING_RES_PARTIES
                           WHERE COURT_BC_HEARING_RES_PARTIES.PARTY_ID =
                                    $P{pPartyID}))
       AND S.ACTION_TYPE = t.id
       AND S.PROCEDURE_ID = P.ID]]>
		</queryString>
		<field name="ROWNUM" class="java.math.BigDecimal"/>
		<field name="NAME" class="java.lang.String"/>
		<field name="FEES_TYPE" class="java.lang.String"/>
		<field name="PROCEDURE_DATE" class="java.sql.Timestamp"/>
		<field name="FOLDER_RECORD_ID" class="java.math.BigDecimal"/>
		<field name="HEARING_DATE" class="java.lang.String"/>
	</subDataset>
	<parameter name="userId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="FOLDER_ID" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT (SELECT ENTITY_NAME
          FROM ENTITY
         WHERE ID IN ( (SELECT ENTITY_ID
                          FROM SEC_USERs
                         WHERE ID =$P{userId})))
          ENTITY_NAME,
          (SELECT ENTITY_ID
                          FROM SEC_USERs
                         WHERE ID =$P{userId}) ENTITY_ID,
       FD.RESUMPTION_PROSECUTION RESUMPTION_PROSECUTION,
       FD.PRIMARY_PROSECUTION PRIMARY_PROSECUTION,
       FD.SECONDARY_PROSECUTION SECONDARY_PROSECUTION,
       ar.police_number || ' ' || bc.NAME || ' ' || ar.par_year police_number,
       ar.police_number num,
       bc.NAME pname,
       ar.par_year pyear,
       fd.sequence_number sequence_number,
       FD.YEAR YEAR,
       FD.YEAR || '/' || FD.SEQUENCE_NUMBER||'/'||decode (fd.FOLDER_TYPE , 2 , 'حبس' ,3 ,'غرامة',5,'امن دوله حبس' ,6,'امن دوله غرامة',7,'براْة')  seq,
       fd.folder_type folder_type,
       pp.party_full_name party_full_name,
       RP.ID RES_PARTY_ID,
 RES.BUSINESS_CASE_ID,
       (SELECT  LISTAGG (P.NAME, ',') WITHIN GROUP (ORDER BY P.NAME)
                  AS CRIME_NAMES
     FROM FORM_CASE_DESCRIPTION cd, FORM_CASE_DESCRIPTION_DES s , PAR_CRIMINAL_TYPES p , FORM_CASE_DESCRIPTION_DES_PART PART , FORM_CASE_DESCRIPTION_PARTIES DP
    WHERE     S.FORM_CASE_DESCRIPTION_ID = CD.ID
    AND p.id = S.DESCRIPTION_ID
    AND PART.FORM_CASE_DES_ID  = S.ID
    AND PART.FORM_CASE_PARTY_ID = DP.ID
    AND DP.FORM_CASE_DESCRIPTION_ID = CD.ID
    AND DP.PARTY_ID = pp.id )
          CRIME_NAME,
       (SELECT ENTITY_NAME
          FROM ENTITY e
         WHERE e.ID = AR.ORIGIN_ENTITY)
          police_name,
       pp.id_number id_number,
       pp.id PP_ID,
       PP.ADDRESS,
       PP.EXTRA_INFORMATION notes,
       AT.NAME attendance,
       PP.job_title JOB_TITLE,
       --------------------------------------
       bcd.name DEGREE_NAME,
       FD.JUDGMENT_TEXT JUDGEMENT_RESOLUTION,
       HEAR.hearing_date hearing_date,
       ------------------------
       (SELECT U.FULL_NAME
          FROM SEC_USERS U
         WHERE U.ID = $P{userId})
          LOGIN_USER,
       FD.ID,
       JUD_TYP.ID JUD_TYPE,
fd.SEQUENTIAL_NUMBER,fd.SEQUENTIAL_YEAR

  FROM EXC_FOLDER_DATA fd,
       COURT_BC_HEARING_RES_PARTIES rp,
       COURT_BC_HEARING_RESERVATION res,
       COURT_CIRCLES_DATES_HEARING hear,
       PAR_POLICE_AUTHORITY_REPORT ar,
       PAR_PARTIES pp,
       business_case_type bc,
       business_CASE_DEGrees bcd,
       court_announcement_types at,
EXC_COURT_BC_SESSION_JUDGMENT SESS, EXC_LKP_JUDGMENT_TYPES JUD_TYP
 WHERE                                  -----------join-----------------------
      FD   .RES_PARTY_ID = RP.ID
       AND RP.COURT_BC_HEARING_RES_ID = RES.ID
       AND RES.CIRCLE_HEARING_DATE_ID = HEAR.ID
       AND AR.BUSINESS_CASE_ID = RES.BUSINESS_CASE_ID
       AND PP.ID = RP.PARTY_ID
       AND ar.BUSINESS_CASE_TYPE = bc.ID
       AND hear.BC_DEGREE_ID = bcd.id
       AND RP.ATTENDANCE = at.id
		       AND RES.ID = SESS.COURT_BC_HEARING_RES_ID
       AND SESS.JUDGMENT_TYPE = JUD_TYP.ID
       ------------------ MANDATORY-------------------
       AND FD.JUDGEMENT_STATUS <> 1
       AND FD.id = $P{FOLDER_ID}]]>
	</queryString>
	<field name="ENTITY_NAME" class="java.lang.String"/>
	<field name="ENTITY_ID" class="java.math.BigDecimal"/>
	<field name="RESUMPTION_PROSECUTION" class="java.math.BigDecimal"/>
	<field name="PRIMARY_PROSECUTION" class="java.math.BigDecimal"/>
	<field name="SECONDARY_PROSECUTION" class="java.math.BigDecimal"/>
	<field name="POLICE_NUMBER" class="java.lang.String"/>
	<field name="NUM" class="java.lang.String"/>
	<field name="PNAME" class="java.lang.String"/>
	<field name="PYEAR" class="java.math.BigDecimal"/>
	<field name="SEQUENCE_NUMBER" class="java.math.BigDecimal"/>
	<field name="YEAR" class="java.math.BigDecimal"/>
	<field name="SEQ" class="java.lang.String"/>
	<field name="FOLDER_TYPE" class="java.math.BigDecimal"/>
	<field name="PARTY_FULL_NAME" class="java.lang.String"/>
	<field name="RES_PARTY_ID" class="java.math.BigDecimal"/>
	<field name="BUSINESS_CASE_ID" class="java.math.BigDecimal"/>
	<field name="CRIME_NAME" class="java.lang.String"/>
	<field name="POLICE_NAME" class="java.lang.String"/>
	<field name="ID_NUMBER" class="java.lang.String"/>
	<field name="PP_ID" class="java.math.BigDecimal"/>
	<field name="ADDRESS" class="java.lang.String"/>
	<field name="NOTES" class="java.lang.String"/>
	<field name="ATTENDANCE" class="java.lang.String"/>
	<field name="JOB_TITLE" class="java.lang.String"/>
	<field name="DEGREE_NAME" class="java.lang.String"/>
	<field name="JUDGEMENT_RESOLUTION" class="java.lang.String"/>
	<field name="HEARING_DATE" class="java.sql.Timestamp"/>
	<field name="LOGIN_USER" class="java.lang.String"/>
	<field name="ID" class="java.math.BigDecimal"/>
	<field name="JUD_TYPE" class="java.math.BigDecimal"/>
	<field name="SEQUENTIAL_NUMBER" class="java.math.BigDecimal"/>
	<field name="SEQUENTIAL_YEAR" class="java.math.BigDecimal"/>
	<variable name="FOLDER_TYPE_1" class="java.math.BigDecimal" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{FOLDER_TYPE}]]></variableExpression>
	</variable>
