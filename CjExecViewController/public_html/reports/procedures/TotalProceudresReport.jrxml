<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TotalProceudresReport" language="groovy" pageWidth="595" pageHeight="842" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="261e9ab5-f547-4d50-a61c-d8b74dcc4acd">
	<property name="ireport.zoom" value="1.2100000000000002"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="REPORT_PATH" class="java.lang.String"/>
	<parameter name="createdDateBind" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="gozeyaIdBind" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="createdDateToBind" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[/* Formatted on 13/08/2020 10:23:24 ص (QP5 v5.287) */
SELECT COUNT (PROC.ID) COUNT_PROCEDURES,
       GOZEYA.ENTITY_NAME GOZEYA_ENTITY_NAME,
       PAREN.ENTITY_NAME PARENT_ENTITY_NAME,
       USR.USERNAME USER_NAME
  FROM EXC_FOLDER_PROCEDURES PROC,
       ENTITY GOZEYA,
       ENTITY PAREN,
       SEC_USERS USR
 WHERE     PROC.PROSECUTION_ID = GOZEYA.ID
       AND GOZEYA.PARENT_ENTITY_ID = PAREN.ID
       AND PROC.CREATED_BY = USR.ID
       AND (PROC.PROSECUTION_ID IN (select id from entity where PARENT_ENTITY_ID = $P{gozeyaIdBind}) or PROC.PROSECUTION_ID = $P{gozeyaIdBind} )
AND (  PROC.CREATED_DATE BETWEEN TO_DATE( $P{createdDateBind}, 'yyyy-MM-dd')
                                                                       AND TO_DATE($P{createdDateToBind}, 'yyyy-MM-dd')+1
                       OR to_char(PROC.CREATED_DATE, 'dd/mm/yyyy') =$P{createdDateBind})
GROUP BY GOZEYA.ENTITY_NAME , PAREN.ENTITY_NAME , USR.USERNAME]]>
	</queryString>
	<field name="COUNT_PROCEDURES" class="java.math.BigDecimal"/>
	<field name="GOZEYA_ENTITY_NAME" class="java.lang.String"/>
	<field name="PARENT_ENTITY_NAME" class="java.lang.String"/>
	<field name="USER_NAME" class="java.lang.String"/>
