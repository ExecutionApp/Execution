<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HasrDafater" language="groovy" pageWidth="595" pageHeight="842" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="261e9ab5-f547-4d50-a61c-d8b74dcc4acd">
	<property name="ireport.zoom" value="1.3310000000000006"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="REPORT_PATH" class="java.lang.String"/>
	<parameter name="createdDateBind" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="gozeyaIdBind" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="createdDateToBind" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[/* Formatted on 17/08/2020 06:08:43 م (QP5 v5.287) */
SELECT NVL (ALL_HASR, 0) COUNT_HASR,
       NVL (HASR_WITH_IDNUM, 0) COUNT_ID_NUMB,
       GOZEYA_ENTITY_NAME,
       PARENT_ENTITY_NAME,
       NVL (ROUND (HASR_WITH_IDNUM * 100 / ALL_HASR), 0) || ' %'
          TOTAL_PERCENTAGE
  FROM (  SELECT COUNT (FD.ID) ALL_HASR,
                 Paren.Id ID,
                 Paren.ENTITY_NAME GOZEYA_ENTITY_NAME,
                 master.ENTITY_NAME PARENT_ENTITY_NAME
            FROM EXC_FOLDER_DATA FD,
                 COURT_BC_HEARING_RES_PARTIES RES,
                 PAR_PARTIES PP,
                 ENTITY master,
                 ENTITY GOZEYA,
                 ENTITY PAREN
           WHERE     RES.ID = FD.RES_PARTY_ID
                 AND RES.PARTY_ID = PP.ID
                 AND FD.POLICE_STATION_ENTITY_ID = GOZEYA.ID
                 AND GOZEYA.PARENT_ENTITY_ID = PAREN.ID
                 AND PAREN.PARENT_ENTITY_ID = Master.ID
                 AND (   GOZEYA.PARENT_ENTITY_ID IN
                            (SELECT id
                               FROM entity
                              WHERE PARENT_ENTITY_ID = $P{gozeyaIdBind})
                      OR GOZEYA.PARENT_ENTITY_ID = $P{gozeyaIdBind})
                 AND (  FD.CREATED_DATE BETWEEN TO_DATE($P{createdDateBind} , 'yyyy-MM-dd')
                                                                       AND TO_DATE($P{createdDateToBind} , 'yyyy-MM-dd')+1
                       OR to_char(FD.CREATED_DATE, 'yyyy-MM-dd') =$P{createdDateBind})
        GROUP BY Paren.Id, PAREN.ENTITY_NAME, master.ENTITY_NAME) TAB1
       FULL OUTER JOIN
       (  SELECT COUNT (FD.ID) HASR_WITH_IDNUM, Paren.ID ID
            FROM EXC_FOLDER_DATA FD,
                 COURT_BC_HEARING_RES_PARTIES RES,
                 PAR_PARTIES PP,
                 ENTITY master,
                 ENTITY GOZEYA,
                 ENTITY PAREN
           WHERE     RES.ID = FD.RES_PARTY_ID
                 AND RES.PARTY_ID = PP.ID
                 AND FD.POLICE_STATION_ENTITY_ID = GOZEYA.ID
                 AND GOZEYA.PARENT_ENTITY_ID = PAREN.ID
                 AND PAREN.PARENT_ENTITY_ID = Master.ID
                 AND (   GOZEYA.PARENT_ENTITY_ID IN
                            (SELECT id
                               FROM entity
                              WHERE PARENT_ENTITY_ID = $P{gozeyaIdBind})
                      OR GOZEYA.PARENT_ENTITY_ID = $P{gozeyaIdBind})
                 AND (  FD.CREATED_DATE BETWEEN TO_DATE($P{createdDateBind} , 'yyyy-MM-dd')
                                                                       AND TO_DATE($P{createdDateToBind} , 'yyyy-MM-dd')+1
                       OR to_char(FD.CREATED_DATE, 'yyyy-MM-dd') =$P{createdDateBind})
                 AND PP.ID_NUMBER IS NOT NULL
        GROUP BY PAREN.Id, PAREN.ENTITY_NAME, Master.ENTITY_NAME) TAB2
          ON TAB1.ID = TAB2.ID]]>
	</queryString>
	<field name="COUNT_HASR" class="java.math.BigDecimal"/>
	<field name="COUNT_ID_NUMB" class="java.math.BigDecimal"/>
	<field name="GOZEYA_ENTITY_NAME" class="java.lang.String"/>
	<field name="PARENT_ENTITY_NAME" class="java.lang.String"/>
	<field name="TOTAL_PERCENTAGE" class="java.lang.String"/>
