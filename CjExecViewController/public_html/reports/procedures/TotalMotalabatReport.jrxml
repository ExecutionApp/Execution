<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HasrDafater" language="groovy" pageWidth="595" pageHeight="842" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="261e9ab5-f547-4d50-a61c-d8b74dcc4acd">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="REPORT_PATH" class="java.lang.String"/>
	<parameter name="createdDateBind" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="gozeyaIdBind" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="createdDateToBind" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT GOZEYA.ENTITY_NAME GOZEYA_ENTITY_NAME , PAREN.ENTITY_NAME PARENT_ENTITY_NAME , USR.USERNAME USER_NAME , COUNT(CLAIM.ID) COUNT_MOTALABAT

FROM EXC_CLAIMS CLAIM , ENTITY POLICE , ENTITY GOZEYA , ENTITY PAREN , SEC_USERS USR
WHERE CLAIM.CLAIM_POLICE_STATION_ID = POLICE.ID
AND CLAIM.CLAIM_PARTIAL_ID = GOZEYA.ID
AND CLAIM.CLAIM_COLYA_ID = PAREN.ID
AND USR.ID = CLAIM.CREATED_BY
AND (CLAIM.CLAIM_POLICE_STATION_ID = $P{gozeyaIdBind} OR CLAIM.CLAIM_PARTIAL_ID = $P{gozeyaIdBind} OR CLAIM.CLAIM_COLYA_ID = $P{gozeyaIdBind})
AND (  CLAIM.CREATED_DATE BETWEEN TO_DATE($P{createdDateBind} , 'yyyy-MM-dd')
                                                                       AND TO_DATE($P{createdDateToBind} , 'yyyy-MM-dd')+1
                       OR to_char(CLAIM.CREATED_DATE, 'yyyy-MM-dd') =$P{createdDateBind})
GROUP BY GOZEYA.ENTITY_NAME , PAREN.ENTITY_NAME , USR.USERNAME]]>
	</queryString>
	<field name="GOZEYA_ENTITY_NAME" class="java.lang.String"/>
	<field name="PARENT_ENTITY_NAME" class="java.lang.String"/>
	<field name="USER_NAME" class="java.lang.String"/>
	<field name="COUNT_MOTALABAT" class="java.math.BigDecimal"/>
