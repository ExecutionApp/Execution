				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["انه في يوم "+($F{PROCEDURE_DATE}==null?"":new utils.ArabicNumberFormatter().formatTimeStamp($F{PROCEDURE_DATE},new java.lang.String("dd/MM/yyyy")).trim())+" حضر بقلم كاتب "+$F{NAME} + " "+($F{ORIGIN_ENTITY}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{ORIGIN_ENTITY}.toString())))]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="332" y="64" width="223" height="20" uuid="4aa72528-5f3c-4c47-9746-b955043fe3d7"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["المتهم/ "+$F{PARTY_FULL_NAME}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement stretchType="RelativeToBandHeight" x="238" y="21" width="316" height="20" uuid="4aaa969c-7154-40c5-88b0-16f187f54aee">
					<printWhenExpression><![CDATA[$P{AbroadFlag} == "Y"]]></printWhenExpression>
				</reportElement>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["  في يوم  "+$F{DAYA} +" الموافق "+($F{PROCEDURE_DATE}==null?"":new utils.ArabicNumberFormatter().formatTimeStamp($F{PROCEDURE_DATE},new java.lang.String("dd/MM/yyyy")).trim())+" سنة "+($F{PROCEDURE_DATE}==null?"":new utils.ArabicNumberFormatter().formatTimeStamp($F{PROCEDURE_DATE},new java.lang.String("yyyy")).trim())+" تم الطعن بناء علي رغبة المحكوم عليه المثبتة بالطلب المرسل من نيابة ........... الكلية محل الضبط و المقيد بدفاترها برقم مسلسل .........  "]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="332" y="84" width="223" height="20" isRemoveLineWhenBlank="true" uuid="6adda0a8-7aa8-4151-af6e-5c5c8ab91d86"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["بشخصه بطاقة رقم قومي "+($F{ID_NUMBER}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{ID_NUMBER}.toString())))]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement positionType="Float" stretchType="RelativeToBandHeight" x="239" y="104" width="316" height="75" isRemoveLineWhenBlank="true" uuid="1d3a2e7e-42ba-49f6-a5eb-fd6d5f06156b"/>
				<textElement textAlignment="Right" verticalAlignment="Top">
					<font fontName="ArialEgabi" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["وقرر ان يرفع (معارضة) عن الحكم الصادر من هذه المحكمة بتاريخ" +" "+($F{HEARING_DATE}==null?"":new utils.ArabicNumberFormatter().formatTimeStamp($F{HEARING_DATE},new java.lang.String("dd/MM/yyyy")).trim())+" في القضية المقيدة بالجدول "+$F{NAME}+" برقم/ "+($F{POLICE_NUMBER}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{POLICE_NUMBER}.toString())))+" لسنة/ "+($F{PAR_YEAR}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{PAR_YEAR}.toString())))+" "+($F{ENTITY}==null?"":new java.lang.String(new utils.ArabicNumberFormatter().format($F{ENTITY}.toString())))+" "+"(وقد حدد لنظر المعارضة جلسة "+($F{HEARING_DATE_TWO}==null?"":new utils.ArabicNumberFormatter().formatTimeStamp($F{HEARING_DATE_TWO},new java.lang.String("dd/MM/yyyy")).trim())+" "+"وكلف بالحضور فيها)"]]></textFieldExpression>
			</textField>
			<staticText>
