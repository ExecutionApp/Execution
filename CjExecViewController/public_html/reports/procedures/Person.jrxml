<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="معارضة بشخصة" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="bc26958a-de3d-4603-956d-b9ee91971ec6">
	<property name="ireport.zoom" value="1.6934217901613318"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="144"/>
	<parameter name="PROCEDURE_ID" class="java.math.BigDecimal"/>
	<parameter name="userId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="REPORT_PATH" class="java.lang.String"/>
	<parameter name="DID" class="java.math.BigDecimal"/>
	<parameter name="AbroadFlag" class="java.lang.String"/>
	<parameter name="CONTEXT_PATH" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT (select VALUE from cj_config where KEY = 'PIC_REPORT') PIC_REPORT , ACTS.PROCEDURE_ID,
       PROC.COURT_CIRCLE_DATES_HEARING_ID,
       RES_PART.COURT_BC_HEARING_RES_ID,
       ACTS.ID ID_FOLDER_ACTIONS,
       PROC.PROCEDURE_SERIAL,
       PROC.PROSECUTION_ID,
       ENTS.ID,
       ENTS.COURT_ID,
       PROC.PROCEDURE_DATE,
       (SELECT PAR.PARTY_FULL_NAME
          FROM PAR_PARTIES PAR
         WHERE PAR.id = RES_PART.party_id) PARTY_FULL_NAME,
       (SELECT PAR.ID_NUMBER
          FROM PAR_PARTIES PAR
         WHERE PAR.id = RES_PART.party_id) ID_NUMBER,
(select did from(select DID from CRIMINAL_JUSTICE_FILES_DETAILS cj where CJ.TYPEID = 20 and CJ.PARTY_ID = RES_PART.party_id and rownum = 1 order by ID desc) ) DID,
      (select  POLICE_NUMBER from par_police_authority_report where business_case_id =RES.BUSINESS_CASE_ID) POLICE_NUMBER,
      (select  PAR_YEAR from par_police_authority_report where business_case_id =RES.BUSINESS_CASE_ID) PAR_YEAR,
       (select Name from BUSINESS_CASE_TYPE where id = (select  BUSINESS_CASE_TYPE from par_police_authority_report where business_case_id =RES.BUSINESS_CASE_ID) ) Name,
       (SELECT ENTITY_NAME
          FROM ENTITY
         WHERE ENTS.COURT_ID = ENTITY.ID)
          ENTITY_NAME,
       (SELECT ENTITY_NAME
          FROM ENTITY
         WHERE ID = FOLDER.POLICE_STATION_ENTITY_ID)
          ENTITY,
 (SELECT ENTITY_NAME
          FROM ENTITY
         WHERE ID = FOLDER.POLICE_STATION_ENTITY_ID)
          ORIGIN_ENTITY,
       (SELECT H.HEARING_DATE
          FROM COURT_CIRCLES_DATES_HEARING H
         WHERE PROC.COURT_CIRCLE_DATES_HEARING_ID = H.ID)
          HEARING_DATE_TWO,(SELECT H.HEARING_DATE
          FROM COURT_CIRCLES_DATES_HEARING H
         WHERE RES.CIRCLE_HEARING_DATE_ID  = H.ID)
          HEARING_DATE,
          (SELECT U.FULL_NAME FROM SEC_USERS U WHERE U.ID = PROC.CREATED_BY) CREATED_BY,SYSDATE,          (SELECT U.FULL_NAME FROM SEC_USERS U WHERE U.ID = $P{userId}) LOGIN_USER,
(SELECT U.ENTITY_ID FROM SEC_USERS U WHERE U.ID = $P{userId}) ENTITY_ID,
(select to_char(PROC.PROCEDURE_DATE,'fmday','NLS_date_language=arabic')from dual) DAYA, FOLDER.SEQUENTIAL_NUMBER,FOLDER.SEQUENTIAL_YEAR
  FROM EXC_FOLDER_DATA FOLDER,
       COURT_BC_HEARING_RES_PARTIES RES_PART,
       COURT_BC_HEARING_RESERVATION RES,
       EXC_LKP_FOLDER_TYPES FOLDER_TYPES,
       EXC_FOLDER_PROCEDURES PROC,
       EXC_LKP_ACTION_TYPES ACTION_TYPES,
       EXC_FOLDER_ACTIONS ACTS,
       ENTITY ENTS,
       EXC_LKP_ACTION_TYPES ACTS_TYPES
 WHERE     FOLDER.FOLDER_TYPE = FOLDER_TYPES.ID
       AND FOLDER.ID = ACTS.FOLDER_RECORD_ID
       AND ACTS.PROCEDURE_ID = PROC.ID
       AND ACTS.ACTION_TYPE = ACTION_TYPES.ID
       AND RES_PART.ID = FOLDER.RES_PARTY_ID
       AND RES_PART.COURT_BC_HEARING_RES_ID = RES.ID
       AND ENTS.ID = FOLDER.POLICE_STATION_ENTITY_ID
       AND ACTS_TYPES.ID = ACTS.ACTION_TYPE
       AND ACTS.ACTION_TYPE in(2,8)
       AND PROC.ID = $P{PROCEDURE_ID}]]>
	</queryString>
