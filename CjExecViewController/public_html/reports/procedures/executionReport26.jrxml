	<subDataset name="New Dataset 3" uuid="e0634a17-1b0a-441d-b0f9-25bcdb2a992b">
		<parameter name="folder_id" class="java.math.BigDecimal">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select ROWNUM, t.name ,P.PROCEDURE_DATE ,S.FOLDER_RECORD_ID
from EXC_FOLDER_ACTIONS s ,EXC_LKP_ACTION_TYPES t, EXC_FOLDER_PROCEDURES p
where S.FOLDER_RECORD_ID=$P{folder_id}
and S.ACTION_TYPE=t.id
and S.PROCEDURE_ID =P.ID]]>
		</queryString>
		<field name="ROWNUM" class="java.math.BigDecimal"/>
		<field name="NAME" class="java.lang.String"/>
		<field name="PROCEDURE_DATE" class="java.sql.Timestamp"/>
		<field name="FOLDER_RECORD_ID" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="userId" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="FOLDER_ID" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT (SELECT ENTITY_NAME
          FROM ENTITY
         WHERE ID IN ( (SELECT ENTITY_ID
                          FROM SEC_USERs
                         WHERE ID =$P{userId})))
          ENTITY_NAME,
          (SELECT ENTITY_ID
                          FROM SEC_USERs
                         WHERE ID =$P{userId}) ENTITY_ID,
    (SELECT S.SEQ FROM BUSINESS_CASE_LEDGER_SEQ S WHERE S.BUSINESS_CASE_DETAILS_ID = (SELECT BD.ID FROM BUSINESS_CASE_DETAILS BD WHERE BD.BUSINESS_CASE_ID = RES.BUSINESS_CASE_ID
       AND BD.CASE_SCHEMA_ID = 3643)) SEQ,
       (SELECT S.YEAR FROM BUSINESS_CASE_LEDGER_SEQ S WHERE S.BUSINESS_CASE_DETAILS_ID = (SELECT BD.ID FROM BUSINESS_CASE_DETAILS BD WHERE BD.BUSINESS_CASE_ID = RES.BUSINESS_CASE_ID
       AND BD.CASE_SCHEMA_ID = 3643)) SEQ_YEAR,
       FD.RESUMPTION_PROSECUTION RESUMPTION_PROSECUTION,
       FD.PRIMARY_PROSECUTION PRIMARY_PROSECUTION,
       FD.SECONDARY_PROSECUTION SECONDARY_PROSECUTION,
       ar.police_number || ' ' || bc.NAME || ' ' || ar.par_year police_number,
       ar.police_number num,
       bc.NAME pname,
       ar.par_year pyear,
       fd.sequence_number sequence_number,
       FD.YEAR YEAR,
       FD.SEQUENCE_NUMBER || '/' || FD.YEAR seq,
       fd.folder_type folder_type,
       pp.party_full_name party_full_name,
       RP.ID RES_PARTY_ID,
       (SELECT  LISTAGG (P.NAME, ',') WITHIN GROUP (ORDER BY P.NAME)
                  AS CRIME_NAMES
     FROM FORM_CASE_DESCRIPTION cd, FORM_CASE_DESCRIPTION_DES s , PAR_CRIMINAL_TYPES p , FORM_CASE_DESCRIPTION_DES_PART PART , FORM_CASE_DESCRIPTION_PARTIES DP
    WHERE     S.FORM_CASE_DESCRIPTION_ID = CD.ID
    AND p.id = S.DESCRIPTION_ID
    AND PART.FORM_CASE_DES_ID  = S.ID
    AND PART.FORM_CASE_PARTY_ID = DP.ID
    AND DP.FORM_CASE_DESCRIPTION_ID = CD.ID
    AND DP.PARTY_ID = pp.id )
          CRIME_NAME,
       (SELECT ENTITY_NAME
          FROM ENTITY e
         WHERE e.ID = AR.ORIGIN_ENTITY)
          police_name,
       pp.id_number id_number,
       PP.ADDRESS,
       PP.EXTRA_INFORMATION notes,
       AT.NAME attendance,
       PP.job_title JOB_TITLE,
       --------------------------------------
       bcd.name DEGREE_NAME,
       FD.JUDGMENT_TEXT JUDGEMENT_RESOLUTION,
       HEAR.hearing_date hearing_date,
       --------------------------
       (SELECT U.FULL_NAME
          FROM SEC_USERS U
         WHERE U.ID = $P{userId})
          LOGIN_USER,
       FD.ID


  FROM EXC_FOLDER_DATA fd,
       COURT_BC_HEARING_RES_PARTIES rp,
       COURT_BC_HEARING_RESERVATION res,
       COURT_CIRCLES_DATES_HEARING hear,
       PAR_POLICE_AUTHORITY_REPORT ar,
       PAR_PARTIES pp,
       business_case_type bc,
       business_CASE_DEGrees bcd,
       CJ_ATTENDEES at
 WHERE                                  -----------join-----------------------
      FD   .RES_PARTY_ID = RP.ID
       AND RP.COURT_BC_HEARING_RES_ID = RES.ID
       AND RES.CIRCLE_HEARING_DATE_ID = HEAR.ID
       AND AR.BUSINESS_CASE_ID = RES.BUSINESS_CASE_ID
       AND PP.ID = RP.PARTY_ID
       AND ar.BUSINESS_CASE_TYPE = bc.ID
       AND hear.BC_DEGREE_ID = bcd.id
       AND RP.ATTENDANCE = at.id
       ------------------ MANDATORY-------------------
       AND FD.JUDGEMENT_STATUS <> 1
       AND FD.id = $P{FOLDER_ID}]]>
	</queryString>
	<field name="ENTITY_NAME" class="java.lang.String"/>
	<field name="ENTITY_ID" class="java.math.BigDecimal"/>
	<field name="SEQ" class="java.math.BigDecimal"/>
	<field name="SEQ_YEAR" class="java.math.BigDecimal"/>
	<field name="RESUMPTION_PROSECUTION" class="java.math.BigDecimal"/>
	<field name="PRIMARY_PROSECUTION" class="java.math.BigDecimal"/>
	<field name="SECONDARY_PROSECUTION" class="java.math.BigDecimal"/>
