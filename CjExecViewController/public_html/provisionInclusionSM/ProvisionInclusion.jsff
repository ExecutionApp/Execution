                                </af:column>
                            </af:table>
                        </af:showDetailItem>
                    </af:panelTabbed>
                </f:facet>
            </af:panelSplitter>
        </af:panelHeader>
        <h:panelGroup id="pg25" styleClass="btn-holder btn-holder-bcd" layout="block">
            <af:button text="#{cjexecviewcontrollerBundle.save}" id="b12"
                       disabled="#{bindings.FormCaseDescriptionDesVO1.estimatedRowCount ==0}"
                       action="#{pageFlowScope.BCDetails.customSave}" partialTriggers="b19 b21" rendered="false"></af:button>
            <af:button text="#{cjexecviewcontrollerBundle.save}" id="b1" action="#{pageFlowScope.BCDetails.saveBC_PI}"
                       binding="#{pageFlowScope.BCDetails.saveBTN}" partialTriggers="b19 b21 b23 l25 t4 t4:b13"
                       disabled="#{bindings.ParPartyAddressVO1.estimatedRowCount eq '0'}"/>
            <af:spacer width="10" height="10" id="s11"/>
            <af:button actionListener="#{bindings.customSaveBeforeCommit.execute}"
                       text="#{cjexecviewcontrollerBundle.save}" disabled="#{!bindings.customSaveBeforeCommit.enabled}"
                       id="b3" rendered="false"/>
            <af:button actionListener="#{bindings.Commit.execute}" text="#{cjexecviewcontrollerBundle.save}"
                       disabled="#{!bindings.Commit.enabled}" id="b14" rendered="false"/>
            <af:link styleClass="add-btn-guilty" text="إلغاء" id="l9" actionListener="#{bindings.Rollback.execute}"
                     action="#{pageFlowScope.BCDetails.cancelPI}" immediate="true" partialSubmit="true">
                <?audit suppress oracle.jdeveloper.jsp.validate-children?>
                <af:resetActionListener/>
            </af:link>
            <af:button actionListener="#{bindings.Rollback.execute}" disabled="#{!bindings.Rollback.enabled}"
                       immediate="true" id="b2" action="#{pageFlowScope.BCDetails.Cancel}"
                       text="#{cjexecviewcontrollerBundle.cancel}" rendered="false">
                <af:resetActionListener/>
            </af:button>
        </h:panelGroup>
        <af:link text=" #{bindings.Id6.inputValue}" id="l7" visible="false"/>
        <f:facet name="toolbar">
            <af:activeOutputText value="القضية مدرجة بالنظام" id="aot1"
                                 binding="#{pageFlowScope.BCDetails.not_Exisit_Label}" visible="false"
                                 partialTriggers="b6 b2 b1" styleClass="alert alert-success alert-custom"/>
            <af:activeOutputText value="القضية غير مدرجة بالنظام" id="aot2"
                                 binding="#{pageFlowScope.BCDetails.exisit_Label}" visible="false"
                                 partialTriggers="b6 b2 b1" styleClass="alert alert-success alert-custom"/>
            <af:activeOutputText value="القضية مُعاد قيدها " id="aot3" binding="#{pageFlowScope.BCDetails.error_label}"
                                 visible="false" partialTriggers="b6 b2 b1"
                                 styleClass="alert alert-success alert-custom"/>
        </f:facet>
    </af:panelHeader>
</ui:composition>
