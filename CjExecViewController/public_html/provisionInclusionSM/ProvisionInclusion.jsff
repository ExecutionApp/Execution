    <!--<c:set var="cjexecviewcontrollerBundle1" value="#{adfBundle['CjExecViewControllerBundle']}"/>-->
    <c:set var="cjexecviewcontrollerBundle" value="#{adfBundle['com.egabi.cjexec.view.CjExecViewControllerBundle']}"/>
    <!-- Search form -->
    <af:panelGroupLayout id="pgl53">
      
    </af:panelGroupLayout>
    <af:panelHeader text="تحديد الجلسات  و المؤجلات" id="ph5" styleClass="bcddetail-screen"
                    partialTriggers="b12 b1">
        <h:panelGroup id="pg7" layout="block" styleClass="row search-case-panel">
            <h:panelGroup id="pg1" layout="block" styleClass="ml-3">
                <af:outputLabel showRequired="#{bindings.PoliceNo.hints.mandatory}"
                                value="#{bindings.PoliceNo.hints.label}" id="ol1"/>
                <af:inputText id="it109" rendered="#{pageFlowScope.disabledValidate}" disabled="true"
                              contentStyle="    width: 60px;   "/>
                <af:inputText value="#{bindings.PoliceNo.inputValue}" label="#{bindings.PoliceNo.hints.label}"
                              required="#{bindings.PoliceNo.hints.mandatory}"
                              disabled="#{pageFlowScope.disabledValidate}" maximumLength="6"
                              shortDesc="#{bindings.PoliceNo.hints.tooltip}" id="it57" simple="true"
                              contentStyle="    width: 60px;   " autoSubmit="true"
                              rendered="#{!pageFlowScope.disabledValidate}">
                    <f:validator binding="#{bindings.PoliceNo.validator}"/>
                    <af:convertNumber groupingUsed="false" pattern="#{bindings.PoliceNo.format}"/>
                </af:inputText>
            </h:panelGroup>
            <h:panelGroup id="pg2" layout="block" styleClass="ml-3">
                <af:outputLabel showRequired="#{bindings.ParYear1.hints.mandatory}" value="سنة" id="ol2"/>
                <af:inputText id="it110" rendered="#{pageFlowScope.disabledValidate}" disabled="true"
                              contentStyle="    width: 60px;     min-width: 60px !important;"/>
                <af:inputText value="#{bindings.ParYear1.inputValue}" required="#{bindings.ParYear1.hints.mandatory}"
                              maximumLength="4" shortDesc="#{bindings.ParYear1.hints.tooltip}" id="it58" simple="true"
                              disabled="#{pageFlowScope.disabledValidate}"
                              contentStyle="    width: 60px;     min-width: 60px !important;" autoSubmit="true"
                              validator="#{cjValidator.yearValidator}" rendered="#{!pageFlowScope.disabledValidate}">
                    <f:validator binding="#{bindings.ParYear1.validator}"/>
                    <af:convertNumber groupingUsed="false" pattern="#{bindings.ParYear1.format}"/>
                </af:inputText>
            </h:panelGroup>
            <h:panelGroup id="pg3" layout="block" styleClass="col-md-2 col-sm-12">
                <af:outputLabel showRequired="#{bindings.BusinessCaseType1.hints.mandatory}" value="الجدول" id="ol3"/>
                <af:selectOneChoice value="#{bindings.BusinessCaseType1.inputValue}"
                                    label="#{bindings.BusinessCaseType1.label}" required="true"
                                    disabled="#{pageFlowScope.disabledValidate}"
                                    shortDesc="#{bindings.BusinessCaseType1.hints.tooltip}" id="soc9" simple="true"
                                    autoSubmit="true">
                    <f:selectItems value="#{bindings.BusinessCaseType1.items}" id="si9"/>
                    <f:validator binding="#{bindings.BusinessCaseType1.validator}"/>
                </af:selectOneChoice>
                <af:selectOneChoice value="#{bindings.PoliceType.inputValue}"
                                    required="#{bindings.PoliceType.hints.mandatory}"
                                    shortDesc="#{bindings.PoliceType.hints.tooltip}" id="soc56" disabled="true"
                                    rendered="false">
                    <f:selectItems value="#{bindings.PoliceType.items}" id="si58"/>
                    <f:validator binding="#{bindings.PoliceType.validator}"/>
                </af:selectOneChoice>
            </h:panelGroup>
            <h:panelGroup id="pg98" layout="block" styleClass="col-md-2 col-sm-12">
                <af:outputLabel showRequired="true" value="النيابة الكلية" id="ol70"/>
                <af:selectOneChoice value="#{bindings.NeyabKolyaa.inputValue}" required="true"
                                    shortDesc="#{bindings.NeyabKolyaa.hints.tooltip}" id="soc28" simple="true"
                                    disabled="#{sessionScope.userInfo.entityDegree eq '39' or sessionScope.userInfo.entityDegree eq '3' }"
                                    autoSubmit="true">
                    <f:selectItems value="#{bindings.NeyabKolyaa.items}" id="si28"/>
                    <f:validator binding="#{bindings.NeyabKolyaa.validator}"/>
                </af:selectOneChoice>
            </h:panelGroup>
            <h:panelGroup id="pg97" layout="block" styleClass="col-md-2 col-sm-12">
                <af:outputLabel showRequired="true" value="النيابة الجزئية" id="ol54"/>
                <af:selectOneChoice value="#{bindings.NeyabGozayaa.inputValue}" required="true"
                                    shortDesc="#{bindings.NeyabGozayaa.hints.tooltip}" id="soc17"
                                    partialTriggers="soc28" simple="true"
                                    disabled="#{sessionScope.userInfo.entityDegree eq '3'  or pageFlowScope.disabledValidate}"
                                    autoSubmit="true" showRequired="true">
                    <f:selectItems value="#{bindings.NeyabGozayaa.items}" id="si17"/>
                    <f:validator binding="#{bindings.NeyabGozayaa.validator}"/>
                </af:selectOneChoice>
            </h:panelGroup>
            <h:panelGroup id="pg4" layout="block" styleClass="col-md-2 col-sm-12">
                <af:outputLabel showRequired="true" value="#{bindings.OrigEntity.label}" id="ol4"/>
                <af:selectOneChoice value="#{bindings.OrigEntity.inputValue}" label="#{bindings.OrigEntity.label}"
                                    disabled="#{pageFlowScope.disabledValidate}"
                                    shortDesc="#{bindings.OrigEntity.hints.tooltip}" id="soc10" simple="true"
                                    partialTriggers="soc17" valueChangeListener="#{pageFlowScope.BCDetails.policeVCL}"
                                    showRequired="true" autoSubmit="true">
                    <f:selectItems value="#{bindings.OrigEntity.items}" id="si10"/>
                    <f:validator binding="#{bindings.OrigEntity.validator}"/>
                </af:selectOneChoice>
                <af:selectOneChoice value="#{bindings.PoliceOriginId.inputValue}"
                                    required="#{bindings.PoliceOriginId.hints.mandatory}"
                                    shortDesc="#{bindings.PoliceOriginId.hints.tooltip}" id="soc55" rendered="false"
                                    disabled="true">
                    <f:selectItems value="#{bindings.PoliceOriginId.items}" id="si57"/>
                    <f:validator binding="#{bindings.PoliceOriginId.validator}"/>
                </af:selectOneChoice>
                <af:inputText id="it111" disabled="true" contentStyle="    width: 60px;   " visible="false"/>
            </h:panelGroup>
            <!-- Search toggle -->
            <af:link text="#{bindings.JudgmentType.inputValue}" id="l30" visible="false"/>
            <h:panelGroup id="pg8" layout="block" styleClass="col-md-2 col-sm-12">
                <af:link styleClass="btn-search" id="l8" icon="/resources/images/magnifier.png"
                         action="#{pageFlowScope.BCDetails.validateBC_PI}" disabled="#{pageFlowScope.disabledValidate}"
                         partialTriggers="l9 b2">
                    <?audit suppress oracle.jdeveloper.jsp.validate-children?>
                    <!--<af:image  source="/resources/images/accept.png" id="i10"/>-->
                    <af:setPropertyListener from="false" to="#{pageFlowScope.judge}" type="action"/>
                    <af:setPropertyListener from="false" to="#{pageFlowScope.search}" type="action"/>
                    <af:setPropertyListener from="false" to="#{pageFlowScope.dimmed}" type="action"/>
                </af:link>
            </h:panelGroup>
            <h:panelGroup id="pg28" layout="block" styleClass="col-md-3 col-sm-12"
                          rendered="#{bindings.OrigEntity.inputValue ne null}">
                <af:button text="التهم   " id="l28" inlineStyle="color:Black; font-size:large;" styleClass="buttonv"
                           visible="false" clientComponent="true" immediate="true">
                    <af:target events="@all" execute="@this" render="@all"/>
                </af:button>
                <af:link actionListener="#{bindings.newProsectionJudgment.execute}" text="newProsectionJudgment"
                         disabled="#{!bindings.newProsectionJudgment.enabled}" id="l27"
                         action="#{pageFlowScope.BCDetails.prosecution}" rendered="false"/>
                <h:panelGroup layout="block" styleClass="search-mode-panel" id="pg82" rendered="false">
                    <af:outputLabel value="تغيير النظام" id="ol15"/>
                    <af:panelLabelAndMessage id="plam2" binding="#{pageFlowScope.BCDetails.btnMode2}">
                        <af:panelGroupLayout id="pgl38" styleClass="tgl-radio-btn">
                            <af:selectOneRadio value="#{bindings.ExistFlag.inputValue}"
                                               required="#{bindings.ExistFlag.hints.mandatory}"
                                               shortDesc="#{bindings.ExistFlag.hints.tooltip}" id="sor1" visible="false"
                                               rendered="false">
                                <f:selectItems value="#{bindings.ExistFlag.items}" id="si29"/>
                                <f:validator binding="#{bindings.ExistFlag.validator}"/>
                            </af:selectOneRadio>
                            <af:button text="قديم" id="b24" type="radio" action="#{pageFlowScope.BCDetails.backLog}"
                                       rendered="#{pageFlowScope.BCFound}" disabled="#{pageFlowScope.back eq '2'}"
                                       partialTriggers="b19 b21 b12 b1 l9" immediate="true" partialSubmit="false"
                                       selected="#{pageFlowScope.back eq '1'}">
                                <af:setPropertyListener from="true" to="#{pageFlowScope.backLog}" type="action"/>
                                <af:setPropertyListener from="true" to="#{pageFlowScope.detail}" type="action"/>
                            </af:button>
                            <af:button text="حديث" id="b277" type="radio" action="#{pageFlowScope.BCDetails.forwardLog}"
                                       rendered="#{pageFlowScope.BCFound and !sessionScope.GnayaatFlag and !sessionScope.ProsecutionCJ}"
                                       disabled="#{pageFlowScope.back eq '1'}" partialTriggers="b19 b21 b12 b1 l9 l8"
                                       immediate="true" selected="#{pageFlowScope.back eq '2'}">
                                <af:setPropertyListener from="false" to="#{pageFlowScope.backLog}" type="action"/>
                                <af:setPropertyListener from="true" to="#{pageFlowScope.detail}" type="action"/>
                            </af:button>
                            <af:button text="حديث" id="b28" type="radio"
                                       action="#{pageFlowScope.BCDetails.forwardLogGnayaat}"
                                       rendered="#{pageFlowScope.BCFound and sessionScope.GnayaatFlag and !sessionScope.ProsecutionCJ}"
                                       disabled="#{pageFlowScope.back eq '1'}" partialTriggers="b19 b21 b12 b1 l9 l8"
                                       immediate="true" selected="#{pageFlowScope.back eq '2'}">
                                <af:setPropertyListener from="false" to="#{pageFlowScope.backLog}" type="action"/>
                                <af:setPropertyListener from="true" to="#{pageFlowScope.detail}" type="action"/>
                            </af:button>
                            <af:button text="حديث" id="b5" type="radio" action="#{pageFlowScope.BCDetails.prosecution}"
                                       rendered="false" disabled="#{pageFlowScope.back eq '1'}"
                                       partialTriggers="b19 b21 b12 b1 l9 l8" immediate="true"
                                       selected="#{pageFlowScope.back eq '2'}">
                                <af:setPropertyListener from="false" to="#{pageFlowScope.backLog}" type="action"/>
                                <af:setPropertyListener from="true" to="#{pageFlowScope.detail}" type="action"/>
                            </af:button>
                        </af:panelGroupLayout>
                    </af:panelLabelAndMessage>
                    <af:panelLabelAndMessage label="" id="plam1" visible="false"
                                             binding="#{pageFlowScope.BCDetails.btNMode}" partialTriggers="b6 b1 b2">
                        <af:panelGroupLayout id="pgl7" styleClass="tgl-radio-btn">
                            <af:button text="#{cjexecviewcontrollerBundle.CHRG_DECISION_ONE_PARTY}" id="b19"
                                       type="radio" action="#{pageFlowScope.BCDetails.radio_OneParty}"
                                       selected="#{pageFlowScope.decision eq '1'}"
                                       disabled="#{pageFlowScope.decision eq '2'}" partialTriggers="b19 b21 l9 b1 b12"
                                       immediate="true">
                                <af:setPropertyListener from="false" to="#{bindings.Flag.inputValue}" type="action"/>
                                <af:setPropertyListener from="true" to="#{pageFlowScope.backLog}" type="action"/>
                                <af:setPropertyListener from="true" to="#{pageFlowScope.detail}" type="action"/>
                                <af:setPropertyListener from="true" to="#{pageFlowScope.judge}" type="action"/>
                            </af:button>
                            <af:button text="#{cjexecviewcontrollerBundle.CHRG_DECISION_MANY_PARTY}" id="b21"
                                       type="radio" action="#{pageFlowScope.BCDetails.radio_ManyParty}"
                                       selected="#{pageFlowScope.decision eq '2'}"
                                       disabled="#{pageFlowScope.decision eq '1' }" partialTriggers="b19 b21 l9 b1 b12"
                                       immediate="true">
                                <af:setPropertyListener from="true" to="#{bindings.Flag.inputValue}" type="action"/>
                                <af:setPropertyListener from="true" to="#{pageFlowScope.backLog}" type="action"/>
                                <af:setPropertyListener from="true" to="#{pageFlowScope.detail}" type="action"/>
                                <af:setPropertyListener from="true" to="#{pageFlowScope.judge}" type="action"/>
                            </af:button>
                            <af:link text="#{bindings.ReturnFlag.inputValue}" id="l13" rendered="false"/>
                            <af:link id="l1" styleClass="tglOn" action="#{pageFlowScope.BCDetails.judgType_1}"
                                     rendered="false"/>
                            <af:link text="#{bindings.Flag.inputValue}" id="l12" rendered="false"/>
                            <af:link action="#{pageFlowScope.BCDetails.JudgType_2}" id="l2" styleClass="tglOff"
                                     rendered="false"/>
                            <af:selectBooleanCheckbox value="#{bindings.ReturnFlag.inputValue}"
                                                      label="#{bindings.ReturnFlag.label}"
                                                      shortDesc="#{bindings.ReturnFlag.hints.tooltip}" id="sbc19"
                                                      binding="#{pageFlowScope.BCDetails.returnFlag}" visible="false"/>
                        </af:panelGroupLayout>
                        <af:selectBooleanCheckbox value="#{bindings.Flag.inputValue}" label="#{bindings.Flag.label}"
                                                  shortDesc="#{bindings.Flag.hints.tooltip}" id="sbc18"
                                                  autoSubmit="true" nullValueMeans="mixed" partialTriggers="b19 b21"
                                                  binding="#{pageFlowScope.BCDetails.checkFlag}" visible="false"/>
                    </af:panelLabelAndMessage>
                </h:panelGroup>
                <af:button id="b6" action="#{pageFlowScope.BCDetails.ValidateBC}" styleClass="btn-search"
                           icon="/resources/images/magnifier.png" rendered="false" partialSubmit="true"/>
            </h:panelGroup>
            <!-- end Search toggle -->
        </h:panelGroup>
        <h:panelGroup id="pg6" layout="block" styleClass="btn-holder btn-holder-search mt-0" rendered="false">
            <af:link actionListener="#{bindings.ValidatePoliceReport.execute}"
