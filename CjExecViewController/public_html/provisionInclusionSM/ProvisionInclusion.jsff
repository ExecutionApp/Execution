                                              var comp = evt.getSource();
                                              AdfCustomEvent.queue(comp, "EnterEvents", 
                                              {
                                                  fvalue : comp.getSubmittedValue()
                                              },
                                              false);

                                              evt.cancel();
                                          }
                                      }
                                    </af:resource>
