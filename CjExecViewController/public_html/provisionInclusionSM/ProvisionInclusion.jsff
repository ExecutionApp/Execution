                <af:outputText value="#{row.Id}" shortDesc="#{bindings.BusinessCase1.hints.Id.tooltip}" id="ot10">
                    <af:convertNumber groupingUsed="false" pattern="#{bindings.BusinessCase1.hints.Id.format}"/>
                </af:outputText>
            </af:column>
        </af:table>
        <af:inputText value="#{bindings.Id8.inputValue}" required="#{bindings.Id8.hints.mandatory}"
