                                              autoSubmit="true"
                                              valueChangeListener="#{pageFlowScope.BCDetails.newHasrBC}" simple="true"
                                              rendered="#{bindings.BusinessCaseType1.inputValue  ne '11'}"
                                              disabled="#{bindings.CreatedBy2.inputValue ne null or !sessionScope.userInfo.userPrevMap[5820]}"
                                              readOnly="#{pageFlowScope.search}">
                        <af:setPropertyListener from="false" to="#{pageFlowScope.search}" type="valueChange"/>
                    </af:selectBooleanCheckbox>
                    <af:spacer width="10" height="10" id="s3"/>
                </h:panelGroup>
            </h:panelGroup>
            <h:panelGroup id="pg109" styleClass="hasr-case-panel d-flex">
                <h:panelGroup id="pg46" layout="block" rendered="#{bindings.Id9.inputValue != null}" styleClass="ml-3">
                    <af:outputLabel showRequired="#{bindings.PoliceNo.hints.mandatory}" value="رقم" id="ol30"/>
                    <af:inputText value="#{bindings.Seq.inputValue}" required="true"
                                  maximumLength="#{bindings.Seq.hints.precision}"
                                  shortDesc="#{bindings.Seq.hints.tooltip}" id="it70" contentStyle="    width: 60px;   "
                                  simple="true" autoSubmit="true" disabled="#{bindings.UpdatedBy2.inputValue != null}">
                        <f:validator binding="#{bindings.Seq.validator}"/>
                        <af:convertNumber groupingUsed="false" pattern="#{bindings.Seq.format}"/>
                    </af:inputText>
                </h:panelGroup>
                <h:panelGroup id="pg99" layout="block" rendered="#{bindings.Id9.inputValue != null}" styleClass="ml-3">
                    <af:outputLabel showRequired="#{bindings.ParYear1.hints.mandatory}" value="سنة" id="ol71"/>
                    <af:inputText value="#{bindings.Year1.inputValue}" required="true" maximumLength="4"
