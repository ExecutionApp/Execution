        <af:table value="#{bindings.BusinessCase1.collectionModel}" var="row" rows="#{bindings.BusinessCase1.rangeSize}"
                  emptyText="#{bindings.BusinessCase1.viewable ? 'No data to display.' : 'Access Denied.'}"
                  rowBandingInterval="0" selectedRowKeys="#{bindings.BusinessCase1.collectionModel.selectedRow}"
                  selectionListener="#{bindings.BusinessCase1.collectionModel.makeCurrent}" rowSelection="single"
