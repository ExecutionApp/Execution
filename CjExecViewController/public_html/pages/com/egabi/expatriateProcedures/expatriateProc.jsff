                            <af:link text="عرض النموذج " id="b110"
                                     visible="#{
    (
        bindings.FActionsActive.inputValue eq 'O'
        and bindings.CapacityType.inputValue eq 'بشخصة'
        and bindings.ActsTypeId.inputValue eq 167
    )
    or
    (
        bindings.FExpatriateApproval.inputValue eq 'O'
        and
        (
            (
                (bindings.CapacityType.inputValue eq 'بشخصة'
                 or bindings.CapacityType.inputValue eq 'توكيل')
                and
                (
                    bindings.ActsTypeId.inputValue eq 21
                    or bindings.ActsTypeId.inputValue eq 35
                )
            )
            or
            bindings.ActsTypeId.inputValue eq 1
            or bindings.ActsTypeId.inputValue eq 2
            or bindings.ActsTypeId.inputValue eq 5
            or bindings.ActsTypeId.inputValue eq 8
            or bindings.ActsTypeId.inputValue eq 9
            or bindings.ActsTypeId.inputValue eq 14
            or bindings.ActsTypeId.inputValue eq 20
            or bindings.ActsTypeId.inputValue eq 23
            or bindings.ActsTypeId.inputValue eq 146
            or bindings.ActsTypeId.inputValue eq 147
            or bindings.ActsTypeId.inputValue eq 152
            or bindings.ActsTypeId.inputValue eq 158
            or bindings.ActsTypeId.inputValue eq 160
            or bindings.ActsTypeId.inputValue eq 163
            or bindings.ActsTypeId.inputValue eq 165
        )
    )}"
                                     action="#{pageFlowScope.expatriateBean.PrintReport}" partialSubmit="false"
                                     shortDesc="#{bindings.ActsTypeId.inputValue}">
