<?xml version='1.0' encoding='UTF-8'?>
<ui:composition xmlns:ui="http://java.sun.com/jsf/facelets" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
                xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jsp/jstl/core">

  <af:panelHeader text="#{bundle.SEARCH_PARTIES}" id="ph1">
    <af:panelGroupLayout id="pgl1">
      <af:panelGridLayout id="pgl2">
        <af:gridRow marginTop="5px" height="auto" id="gr1">
          <af:gridCell marginStart="5px" width="auto" id="gc1">
            <af:outputLabel value="#{bindings.FullName.label}" id="ol1"/>
          </af:gridCell>
          <af:gridCell marginStart="5px" width="auto" id="gc2">
            <af:inputText value="#{bindings.FullName.inputValue}" simple="true"
                          required="#{bindings.FullName.hints.mandatory}" columns="25"
                          maximumLength="#{bindings.FullName.hints.precision}"
                          shortDesc="#{bindings.FullName.hints.tooltip}" id="it1">
              <f:validator binding="#{bindings.FullName.validator}"/>
            </af:inputText>
          </af:gridCell>
          <af:gridCell marginStart="5px" width="auto" id="gc3">
            <af:outputLabel value="#{bindings.IdNumber.label}" id="ol2"/>
          </af:gridCell>
          <af:gridCell marginStart="5px" width="auto" marginEnd="5px" id="gc4">
            <af:inputText value="#{bindings.IdNumber.inputValue}" simple="true"
                          required="#{bindings.IdNumber.hints.mandatory}" columns="25"
                          maximumLength="#{bindings.IdNumber.hints.precision}"
                          shortDesc="#{bindings.IdNumber.hints.tooltip}" id="it2">
              <f:validator binding="#{bindings.IdNumber.validator}"/>
            </af:inputText>
          </af:gridCell>
        </af:gridRow>
        <af:gridRow marginTop="5px" height="auto" marginBottom="5px" id="gr2">
          <af:gridCell marginStart="5px" width="auto" id="gc5"/>
          <af:gridCell marginStart="5px" width="auto" id="gc6"/>
          <af:gridCell marginStart="5px" width="auto" id="gc7"/>
          <af:gridCell marginStart="5px" width="auto" marginEnd="5px" id="gc8"/>
        </af:gridRow>
      </af:panelGridLayout>
      <af:spacer width="10" height="10" id="s1"/>
      <af:panelGroupLayout id="pgl3">
        <af:button text="#{bundle.GENERAL_SEARCH_BUTTON}" id="b1"
                   action="#{pageFlowScope.parPartiesBean.searchParPartiesLog}"/>
        <af:spacer width="10" height="10" id="s3"/>
        <af:button text="#{bundle.CANCEL_BUTTON}" id="b2"
                   action="#{pageFlowScope.parPartiesBean.resetParPartiesLogResult}"/>
      </af:panelGroupLayout>
      <af:spacer width="10" height="10" id="s2"/>
      <af:table value="#{bindings.ParPartiesLogSearchResultRVO1.collectionModel}" var="row"
                rows="#{bindings.ParPartiesLogSearchResultRVO1.rangeSize}"
                emptyText="#{bindings.ParPartiesLogSearchResultRVO1.viewable ? '#{bundle.NO_DATA}' : 'Access Denied.'}"
                rowBandingInterval="0" width="100%" columnStretching="multiple"
                selectedRowKeys="#{bindings.ParPartiesLogSearchResultRVO1.collectionModel.selectedRow}"
                selectionListener="#{bindings.ParPartiesLogSearchResultRVO1.collectionModel.makeCurrent}"
                rowSelection="single" fetchSize="#{bindings.ParPartiesLogSearchResultRVO1.rangeSize}"
                filterModel="#{bindings.ParPartiesLogSearchResultRVO1Query.queryDescriptor}" filterVisible="true"
                queryListener="#{bindings.ParPartiesLogSearchResultRVO1Query.processQuery}" varStatus="vs" id="t1">
        <af:column sortProperty="#{bindings.ParPartiesLogSearchResultRVO1.hints.Id.name}" filterable="true" rendered="false"
                   sortable="true" headerText="#{bindings.ParPartiesLogSearchResultRVO1.hints.Id.label}" id="c1">
          <af:outputText value="#{row.Id}" shortDesc="#{bindings.ParPartiesLogSearchResultRVO1.hints.Id.tooltip}"
                         id="ot1">
            <af:convertNumber groupingUsed="false" pattern="#{bindings.ParPartiesLogSearchResultRVO1.hints.Id.format}"/>
          </af:outputText>
        </af:column>
        <af:column sortProperty="#{bindings.ParPartiesLogSearchResultRVO1.hints.FullName.name}" filterable="true" width="20%" 
                   sortable="true" headerText="#{bindings.ParPartiesLogSearchResultRVO1.hints.FullName.label}" id="c2">
          <af:outputText value="#{row.FullName}"
                         shortDesc="#{bindings.ParPartiesLogSearchResultRVO1.hints.FullName.tooltip}" id="ot2"/>
        </af:column>
        <af:column sortProperty="#{bindings.ParPartiesLogSearchResultRVO1.hints.IdNumber.name}" filterable="true" width="20%"
                   sortable="true" headerText="#{bindings.ParPartiesLogSearchResultRVO1.hints.IdNumber.label}" id="c3">
          <af:outputText value="#{row.IdNumber}"
                         shortDesc="#{bindings.ParPartiesLogSearchResultRVO1.hints.IdNumber.tooltip}" id="ot3"/>
        </af:column>
        <af:column sortProperty="#{bindings.ParPartiesLogSearchResultRVO1.hints.Address.name}" filterable="true" width="17%"
                   sortable="true" headerText="#{bindings.ParPartiesLogSearchResultRVO1.hints.Address.label}" id="c4">
          <af:outputText value="#{row.Address}"
                         shortDesc="#{bindings.ParPartiesLogSearchResultRVO1.hints.Address.tooltip}" id="ot4"/>
        </af:column>
        <af:column sortProperty="#{bindings.ParPartiesLogSearchResultRVO1.hints.Age.name}" filterable="true" width="5%"
                   sortable="true" headerText="#{bindings.ParPartiesLogSearchResultRVO1.hints.Age.label}" id="c5">
          <af:outputText value="#{row.Age}" shortDesc="#{bindings.ParPartiesLogSearchResultRVO1.hints.Age.tooltip}"
                         id="ot5"/>
        </af:column>
        <af:column sortProperty="#{bindings.ParPartiesLogSearchResultRVO1.hints.JobTitle.name}" filterable="true" width="5%"
                   sortable="true" headerText="#{bindings.ParPartiesLogSearchResultRVO1.hints.JobTitle.label}" id="c6">
          <af:outputText value="#{row.JobTitle}"
                         shortDesc="#{bindings.ParPartiesLogSearchResultRVO1.hints.JobTitle.tooltip}" id="ot6"/>
        </af:column>
        <af:column sortProperty="#{bindings.ParPartiesLogSearchResultRVO1.hints.TransactionType.name}" filterable="true" width="13%"
                   sortable="true" headerText="#{bindings.ParPartiesLogSearchResultRVO1.hints.TransactionType.label}"
                   id="c7">
          <af:outputText value="#{row.TransactionType}"
                         shortDesc="#{bindings.ParPartiesLogSearchResultRVO1.hints.TransactionType.tooltip}" id="ot7"/>
        </af:column>
        <af:column sortProperty="#{bindings.ParPartiesLogSearchResultRVO1.hints.CreatedDate.name}" filterable="true" width="5%"
                   sortable="true" headerText="#{bindings.ParPartiesLogSearchResultRVO1.hints.CreatedDate.label}"
                   id="c8">
          <f:facet name="filter">
            <af:inputDate value="#{bindings.ParPartiesLogSearchResultRVO1Query.queryDescriptor.filterConjunctionCriterion.criterionMap.CreatedDate.value}"
                          id="id1">
              <af:convertDateTime pattern="#{bindings.ParPartiesLogSearchResultRVO1.hints.CreatedDate.format}"/>
            </af:inputDate>
          </f:facet>
          <af:outputText value="#{row.CreatedDate}"
                         shortDesc="#{bindings.ParPartiesLogSearchResultRVO1.hints.CreatedDate.tooltip}" id="ot8">
            <af:convertDateTime pattern="#{bindings.ParPartiesLogSearchResultRVO1.hints.CreatedDate.format}"/>
          </af:outputText>
        </af:column>
        <af:column sortProperty="#{bindings.ParPartiesLogSearchResultRVO1.hints.CreatedUser.name}" filterable="true" width="10%"
                   sortable="true" headerText="#{bindings.ParPartiesLogSearchResultRVO1.hints.CreatedUser.label}"
                   id="c9">
          <af:outputText value="#{row.CreatedUser}"
                         shortDesc="#{bindings.ParPartiesLogSearchResultRVO1.hints.CreatedUser.tooltip}" id="ot9"/>
        </af:column>
      </af:table>
    </af:panelGroupLayout>
  </af:panelHeader>
</ui:composition>
