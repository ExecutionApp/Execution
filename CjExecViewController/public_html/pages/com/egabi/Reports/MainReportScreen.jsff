<?xml version='1.0' encoding='UTF-8'?>
<ui:composition xmlns:ui="http://java.sun.com/jsf/facelets" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
                 xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jsp/jstl/core"
                xmlns:h="http://java.sun.com/jsf/html">
<c:set var="bundle" value="#{adfBundle['com.egabi.cjexec.view.CjExecViewControllerBundle_ar']}"/>
  <c:set var="cjexecviewcontrollerBundle" value="#{adfBundle['com.egabi.cjexec.view.CjExecViewControllerBundle']}"/>
  <af:panelGroupLayout id="pgl1">
    <af:panelHeader text="الدفاتر " id="ph1"/>
    <h:panelGroup id="pg1" styleClass="row " layout="block">
     <af:panelGroupLayout id="pgl9" styleClass="col-md-1 col-sm-12"
                             rendered="#{sessionScope.userInfo.entityDegree ne '3'  or sessionScope.userInfo.errandFlag eq 'Y'}">
        <af:panelFormLayout id="pfl2" labelAlignment="top">
          <f:facet name="footer">
                 <af:selectBooleanCheckbox value="#{bindings.EstanafGozayaFlag.inputValue}" 
                                                  text="#{cjexecviewcontrollerBundle.GOZEYA}" label=""  id="sbc2"
                                               autoSubmit="true"   shortDesc="#{bindings.EstanafGozayaFlag.hints.tooltip}"  
                                                  
                                                  valueChangeListener="#{printDafatertBean.gozayOrKoly}"/>
          </f:facet>
        </af:panelFormLayout>
      </af:panelGroupLayout>
       <af:panelGroupLayout id="pgl10" styleClass="col-md-2 col-sm-12" 
            visible="#{sessionScope.userInfo.entityDegree eq '38' or sessionScope.userInfo.entityDegree eq '46'}">
                <af:outputLabel id="ol99" value=""/>
            <af:selectBooleanCheckbox value="#{bindings.MamoreyaFlag.inputValue}"
                                  autoSubmit="true"        
                                 text="#{bindings.MamoreyaFlag.label}"       id="sbc1"
                             valueChangeListener="#{printDafatertBean.mamoreyaCheckBox}"             partialTriggers="sbc2"/>
      </af:panelGroupLayout>
       <af:panelGroupLayout id="pgl91" styleClass="col-md-2 col-sm-12" visible="#{sessionScope.userInfo.errandFlag eq 'Y'}"
                  binding="#{printDafatertBean.mamoreya}"               partialTriggers="sbc1 sbc2">
                <af:outputLabel id="ol81" value="المأمورية"/>
      <af:selectOneChoice value="#{bindings.NeyabaMamoreya.inputValue}"
                          required="#{bindings.NeyabaMamoreya.hints.mandatory}"
                          shortDesc="#{bindings.NeyabaMamoreya.hints.tooltip}" id="soc5">
        <f:selectItems value="#{bindings.NeyabaMamoreya.items}" id="si6"/>
        <f:validator binding="#{bindings.NeyabaMamoreya.validator}"/>
      </af:selectOneChoice>
       </af:panelGroupLayout>
      <af:panelGroupLayout id="pgl2" binding="#{printDafatertBean.niyabaKolya}" styleClass="col-md-2 col-sm-12"
                           visible="#{bindings.MamoreyaFlag.inputValue eq 'N'}">
        <af:outputLabel value="#{cjexecviewcontrollerBundle.PROSECUTION_KOLYA}" id="ol1"/>
        <af:selectOneChoice value="#{bindings.NeyabKolyaa.inputValue}" label="#{bindings.NeyabKolyaa.label}"
                                    required="#{bindings.NeyabKolyaa.hints.mandatory}"
                                    shortDesc="#{bindings.NeyabKolyaa.hints.tooltip}" id="soc1" simple="true"
                                    disabled="#{(sessionScope.userInfo.entityDegree eq '39' and !sessionScope.userInfo.userPrevMap[5051]) or sessionScope.userInfo.entityDegree eq '3'}"
                                    autoSubmit="true" immediate="true">
          <f:selectItems value="#{bindings.NeyabKolyaa.items}" id="si1"/>
          <f:validator binding="#{bindings.NeyabKolyaa.validator}"/>
        </af:selectOneChoice>
      </af:panelGroupLayout>
       <af:panelGroupLayout id="pg45" styleClass="col-md-2 col-sm-12" partialTriggers="sbc2 sbc1"
                                 visible="#{printDafatertBean.gozaySearch}"
                                 binding="#{printDafatertBean.niyabaGozayaa}">
        <af:outputLabel value="#{cjexecviewcontrollerBundle.PROSECUTION_PARTIAL}"
                              
                                 id="ol3" showRequired="true"/>
        <af:selectOneChoice  value="#{bindings.NeyabGozayaa.inputValue}" label="#{bindings.NeyabGozayaa.label}"
                                    shortDesc="#{bindings.NeyabGozayaa.hints.tooltip}" id="soc2" simple="true"
                                    autoSubmit="true" partialTriggers="soc1"
                                    disabled="#{sessionScope.userInfo.entityDegree eq '3'}">
          <f:selectItems value="#{bindings.NeyabGozayaa.items}" id="si2"/>
          <f:validator binding="#{bindings.NeyabGozayaa.validator}"/>
        </af:selectOneChoice>
      </af:panelGroupLayout>
     <af:panelGroupLayout id="pgl7" styleClass="col-md-2 col-sm-12" partialTriggers="sbc2 sbc1"
                visible="#{printDafatertBean.gozaySearch}" binding="#{printDafatertBean.originEntity}">
                <af:outputLabel value="#{bindings.OrigEntity.label}" id="ol6"
                                showRequired="#{printDafatertBean.userGozaya?true:false}"/>
                <af:selectOneChoice value="#{bindings.OrigEntity.inputValue}" partialTriggers="soc2"
                                    label="#{bindings.OrigEntity.label}"  autoSubmit="true" simple="true"
                                    shortDesc="#{bindings.OrigEntity.hints.tooltip}" id="soc3"
                                    valueChangeListener="#{cjValidator.origEntityVCL}">
                    <f:selectItems value="#{bindings.OrigEntity.items}" id="si3"/>
                    <f:validator binding="#{bindings.OrigEntity.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
      <af:panelGroupLayout id="pgl12" styleClass="col-md-2 col-sm-12">
        <af:outputLabel value="درجة التقاضى" id="ol10" />
        <af:selectOneChoice value="#{bindings.DegreeId.inputValue}"
                            required="#{bindings.DegreeId.hints.mandatory}"
                            shortDesc="#{bindings.DegreeId.hints.tooltip}" id="soc7">
          <f:selectItems value="#{bindings.DegreeId.items}" id="si8"/>
          <f:validator binding="#{bindings.DegreeId.validator}"/>
        </af:selectOneChoice>
      </af:panelGroupLayout>
      <af:panelGroupLayout id="pgl11" styleClass="col-md-2 col-sm-12">
        <af:outputLabel value="نوع الحضور" id="ol9" />
        <af:selectOneChoice value="#{bindings.Attendance.inputValue}"
                            required="#{bindings.Attendance.hints.mandatory}"
                            shortDesc="#{bindings.Attendance.hints.tooltip}" id="soc6">
          <f:selectItems value="#{bindings.Attendance.items}" id="si7"/>
          <f:validator binding="#{bindings.Attendance.validator}"/>
        </af:selectOneChoice>
      </af:panelGroupLayout>
      <af:panelGroupLayout id="pgl71" styleClass="col-md-2 col-sm-12">
        <af:outputLabel value="سنة الحصر" id="ol61" showRequired="true"/>
          <af:inputText value="#{bindings.Year.inputValue}"
                                  simple="true" required="true"
                                  maximumLength="4"
                                  shortDesc="#{bindings.Year.hints.tooltip}"
                                  id="it1" autoSubmit="true"
                                  valueChangeListener="#{cjValidator.yearVCL}"
                                  columns="4" rows="1">
                        <f:validator binding="#{bindings.Year.validator}"/>
                    </af:inputText>
      </af:panelGroupLayout>
      <af:panelGroupLayout id="pgl8" styleClass="col-md-2 col-sm-12">
        <af:outputLabel value="النوع" id="ol7" showRequired="true"/>
           <af:selectOneChoice value="#{bindings.CriminalTypeFlag.inputValue}"
                                    simple="true" autoSubmit="true"
                                    label="#{bindings.CriminalTypeFlag.label}"
                                    required="#{!printDafatertBean.userGozaya and sessionScope.NavigationName eq 'MainReport' }"
                                    shortDesc="#{bindings.CriminalTypeFlag.hints.tooltip}"
                                    id="soc4"
                                    valueChangeListener="#{printDafatertBean.criminalTypeFlagListener}">
                    <f:selectItem itemValue="1" itemLabel="جنح" id="si4"/>
                    <f:selectItem itemValue="2" itemLabel="جنايات" id="si5"/>
                </af:selectOneChoice>
      </af:panelGroupLayout>
      <af:spacer width="10" height="20" id="s3"/>
      <af:panelGroupLayout id="pgl19" styleClass="col-md-1 col-sm-12">
        <af:panelLabelAndMessage label="#{bindings.TypeToggle.inputValue ne 2 ? 'بحث بالحصر' : 'بحث بالجلسة'}"
                                 id="plam2">
          <af:link disabled="#{pageFlowScope.provisionsInclusionBean.mode == 'view'}" id="l33"
                   rendered="#{bindings.TypeToggle.inputValue eq 2}" styleClass="tglOn" immediate="true">
            <f:setPropertyActionListener target="#{bindings.TypeToggle.inputValue}" value="#{1}"/>
          </af:link>
          <af:link disabled="#{pageFlowScope.provisionsInclusionBean.mode == 'view'}" id="l44"
                   rendered="#{bindings.TypeToggle.inputValue eq 1 or bindings.TypeToggle.inputValue eq null}"
                   styleClass="tglOff" immediate="true">
            <f:setPropertyActionListener target="#{bindings.TypeToggle.inputValue}" value="#{2}"/>
          </af:link>
        </af:panelLabelAndMessage>
      </af:panelGroupLayout>
      <af:panelGroupLayout id="pgl3" styleClass="col-md-2 col-sm-12" rendered="#{bindings.TypeToggle.inputValue eq 1 or bindings.TypeToggle.inputValue eq null}">
        <af:outputLabel value="من تاريخ جلسة" id="ol4" showRequired="true"/>
        <af:inputDate value="#{bindings.DateFrom.inputValue}" required="#{sessionScope.userInfo.userName ne 'hn'}"
                               simple="true"
                              shortDesc="#{bindings.DateFrom.hints.tooltip}" id="id2" autoSubmit="true"
                              showRequired="false">
          <f:validator binding="#{bindings.DateFrom.validator}"/>
          <af:convertDateTime pattern="#{bindings.DateFrom.format}"/>
        </af:inputDate>
      </af:panelGroupLayout>
      <af:panelGroupLayout id="pgl4" styleClass="col-md-2 col-sm-12" rendered="#{bindings.TypeToggle.inputValue eq 1 or bindings.TypeToggle.inputValue eq null}">
        <af:outputLabel value="الي تاريخ جلسة" id="ol5" showRequired="true"/>
        <af:inputDate value="#{bindings.DateTo.inputValue}" required="#{sessionScope.userInfo.userName ne 'hn'}"
                              simple="true"
                              shortDesc="#{bindings.DateTo.hints.tooltip}" id="id1" autoSubmit="true"
                              showRequired="false">
          <f:validator binding="#{bindings.DateTo.validator}"/>
          <af:convertDateTime pattern="#{bindings.DateTo.format}"/>
        </af:inputDate>
      </af:panelGroupLayout>
      
      <af:panelGroupLayout id="pgl17" styleClass="col-md-2 col-sm-12"  rendered="#{bindings.TypeToggle.inputValue eq 2}">
                <af:outputLabel value="من رقم حصر" id="ol14" showRequired="true"/>
                <af:inputText value="#{bindings.StartNum.inputValue}"
                              columns="#{bindings.StartNum.hints.displayWidth}"
                              maximumLength="#{bindings.StartNum.hints.precision}"
                              shortDesc="#{bindings.StartNum.hints.tooltip}" id="it3"
                              required="#{sessionScope.userInfo.userName ne 'hn'}">
                    <f:validator binding="#{bindings.StartNum.validator}"/>
                    <af:convertNumber groupingUsed="false" pattern="#{bindings.StartNum.format}"/>
                </af:inputText>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl18" styleClass="col-md-2 col-sm-12"  rendered="#{bindings.TypeToggle.inputValue eq 2}">
                <af:outputLabel value="الى رقم الحصر" id="ol15" showRequired="true"/>
                <af:inputText value="#{bindings.EndNum.inputValue}"
                              columns="#{bindings.EndNum.hints.displayWidth}"
                              maximumLength="#{bindings.EndNum.hints.precision}"
                              shortDesc="#{bindings.EndNum.hints.tooltip}" id="it2"
                              required="#{sessionScope.userInfo.userName ne 'hn'}">
                    <f:validator binding="#{bindings.EndNum.validator}"/>
                    <af:convertNumber groupingUsed="false" pattern="#{bindings.EndNum.format}"/>
                </af:inputText>
            </af:panelGroupLayout>
      <af:spacer width="10" height="20" id="s2"/>
      <af:panelGroupLayout id="pgl6" styleClass="col-md-2 col-sm-12">
        <af:outputLabel value="#{bindings.FolderTypesId.label}" id="ol2" showRequired="true"/>
        <af:selectOneChoice value="#{bindings.FolderTypesId.inputValue}"
                            shortDesc="#{bindings.FolderTypesId.hints.tooltip}" id="soc31" required="true"
                            contentStyle="width: 200px; " autoSubmit="true">
          <f:selectItems value="#{bindings.FolderTypesId.items}" id="si31"/>
          <f:validator binding="#{bindings.FolderTypesId.validator}"/>
        </af:selectOneChoice>
      </af:panelGroupLayout>
       <af:spacer width="10" height="20" id="s1"/>
      <af:panelGroupLayout id="pgl13" styleClass="col-md-2 col-sm-12"
                           rendered="#{bindings.FolderTypesId.inputValue eq '22' }" partialTriggers="soc31">
        <af:outputLabel value="الحالة" id="ol11" showRequired="true"/>
        <af:selectOneChoice value="#{bindings.Status.inputValue}" simple="true" autoSubmit="true"
                            label="#{bindings.Status.label}"
                            required="#{!printDafatertBean.userGozaya and sessionScope.NavigationName eq 'MainReport' }"
                            shortDesc="#{bindings.Status.hints.tooltip}" id="soc8"
                             >
          <f:selectItem itemValue="1" itemLabel="الكل" id="si9"/>
          <f:selectItem itemValue="2" itemLabel="المنفذ" id="si10"/>
          <f:selectItem itemValue="3" itemLabel="غير منفذ" id="si11"/>
        </af:selectOneChoice>
      </af:panelGroupLayout>
      <af:panelGroupLayout id="pgl5" styleClass="col-md-2 col-sm-12" layout="scroll">
        <af:outputLabel value=" " id="ol8"/>
          <af:button text="بحث" actionListener="#{printDafatertBean.searchMain}" partialSubmit="true" id="b3"/>
          
      </af:panelGroupLayout>
      <af:panelGroupLayout id="pgl14" styleClass="col-md-2 col-sm-12" layout="scroll">
        <af:outputLabel value=" " id="ol12"/>
        <af:button text="تصدير إلى إكسل" id="b2">
            <af:exportCollectionActionListener type="excelHTML" exportedId="t2" filename="MainReport.xls" charset="UTF-8"
                                               title="MainReport" filterName="MainReport.csv" rowLimit="-1"/>
          </af:button>
      </af:panelGroupLayout>
    </h:panelGroup>
    <af:table value="#{bindings.MainReport1.collectionModel}" var="row" rows="#{bindings.MainReport1.rangeSize}"
              emptyText="#{bindings.MainReport1.viewable ? bundle['NO_DATA'] : 'Access Denied.'}"
              rowBandingInterval="0" selectedRowKeys="#{bindings.MainReport1.collectionModel.selectedRow}"
         styleClass="AFStretchWidth" scrollPolicy="page" autoHeightRows="13"  varStatus="vs" partialTriggers="::b3"  
         selectionListener="#{bindings.MainReport1.collectionModel.makeCurrent}" 
         columnStretching="column:c2"     fetchSize="#{bindings.MainReport1.rangeSize}" id="t1" rendered="false">
    <af:column id="c11" headerText="#" width="50" minimumWidth="12" align="end">
                <af:outputText value="#{vs.index+1}" id="ot11"/>
            </af:column>
      <af:column headerText="#{bindings.MainReport1.hints.ProcNumber.label}" id="c1" align="end">
        <af:outputText value="#{row.ProcNumber}" shortDesc="#{bindings.MainReport1.hints.ProcNumber.tooltip}" id="ot1">
          <af:convertNumber groupingUsed="false" pattern="#{bindings.MainReport1.hints.ProcNumber.format}"/>
        </af:outputText>
      </af:column>
      <af:column headerText="#{bindings.MainReport1.hints.InventoryNumber.label}" id="c2" align="end">
        <af:outputText value="#{row.InventoryNumber}" shortDesc="#{bindings.MainReport1.hints.InventoryNumber.tooltip}"
                       id="ot2"/>
      </af:column>
      <af:column headerText="#{bindings.MainReport1.hints.BusinessCaseNumber.label}" id="c3" align="end" width="200">
        <af:outputText value="#{row.BusinessCaseNumber}"
                       shortDesc="#{bindings.MainReport1.hints.BusinessCaseNumber.tooltip}" id="ot3"/>
      </af:column>
      <af:column headerText="#{bindings.MainReport1.hints.PartyFullName.label}" id="c7" align="end" width="150">
        <af:outputText value="#{row.PartyFullName}" shortDesc="#{bindings.MainReport1.hints.PartyFullName.tooltip}"
                       id="ot7"/>
      </af:column>
      <af:column headerText="#{bindings.MainReport1.hints.ProcedureDate.label}" id="c4" align="end">
        <af:outputText value="#{row.ProcedureDate}" shortDesc="#{bindings.MainReport1.hints.ProcedureDate.tooltip}"
                       id="ot4">
          <af:convertDateTime pattern="#{bindings.MainReport1.hints.ProcedureDate.format}"/>
        </af:outputText>
      </af:column>
      <af:column headerText="#{bindings.MainReport1.hints.DateEntReservation.label}" id="c12" align="end">
        <af:outputText value="#{row.DateEntReservation}"
                       shortDesc="#{bindings.MainReport1.hints.DateEntReservation.tooltip}" id="ot12"/>
      </af:column>
      <af:column headerText="تاريخ الجلسه" id="c6" align="end">
        <af:outputText value="#{row.HearingDate}" shortDesc="#{bindings.MainReport1.hints.HearingDate.tooltip}"
                       id="ot6"/>
      </af:column>
      <af:column headerText="#{bindings.MainReport1.hints.CreatedBy.label}" id="c13" align="end" width="120">
        <af:outputText value="#{row.CreatedBy}" shortDesc="#{bindings.MainReport1.hints.CreatedBy.tooltip}" id="ot13"/>
      </af:column>
    </af:table>
    <af:table value="#{bindings.MainReports1.collectionModel}" var="row" rows="#{bindings.MainReports1.rangeSize}"
              emptyText="#{bindings.MainReports1.viewable ? 'No data to display.' : 'Access Denied.'}"
           columnStretching="column:c15"   rowBandingInterval="0" selectedRowKeys="#{bindings.MainReports1.collectionModel.selectedRow}"
        varStatus="vs"      selectionListener="#{bindings.MainReports1.collectionModel.makeCurrent}" rowSelection="single"
         styleClass="AFStretchWidth" scrollPolicy="page"   fetchSize="#{bindings.MainReports1.rangeSize}" id="t2">
      <af:column id="c121" headerText="#" width="20" minimumWidth="12" align="right">
        <af:outputText value="#{vs.index+1}" id="ot121"/>
      </af:column>
      <af:column headerText="#{bindings.MainReports1.hints.InventoryNumber.label}" id="c14" align="right" width="190">
        <af:outputText value="#{row.InventoryNumber}" shortDesc="#{bindings.MainReports1.hints.InventoryNumber.tooltip}"
                       id="ot18">
          <af:convertNumber groupingUsed="false" pattern="#{bindings.MainReports1.hints.InventoryNumber.format}"/>
        </af:outputText>
      </af:column>
      <af:column headerText="#{bindings.MainReports1.hints.BusinessCaseNumber.label}" id="c15" align="right">
        <af:outputText value="#{row.BusinessCaseNumber}"
                       shortDesc="#{bindings.MainReports1.hints.BusinessCaseNumber.tooltip}" id="ot22"/>
      </af:column>
      <af:column headerText="#{bindings.MainReports1.hints.PartyName.label}" id="c16" align="right" width="150">
        <af:outputText value="#{row.PartyName}" shortDesc="#{bindings.MainReports1.hints.PartyName.tooltip}" id="ot15"/>
      </af:column>
      <af:column headerText="#{bindings.MainReports1.hints.Address.label}" id="c17" align="right" width="130">
        <af:outputText value="#{row.Address}" shortDesc="#{bindings.MainReports1.hints.Address.tooltip}" id="ot26"/>
      </af:column>
      <af:column headerText="الرقم القومى" id="c18" align="right" width="100">
        <af:outputText value="#{row.IdNumber}" shortDesc="#{bindings.MainReports1.hints.IdNumber.tooltip}" id="ot5"/>
      </af:column>
      <af:column headerText="#{bindings.MainReports1.hints.JudgmentText.label}" id="c5" align="right" width="160">
        <af:outputText value="#{row.JudgmentText}" shortDesc="#{bindings.MainReports1.hints.JudgmentText.tooltip}"
                       id="ot8"/>
      </af:column>
      <af:column headerText="الحالة" id="c8" align="right" width="80">
        <af:outputText value="#{row.ExecutionDate eq null ? 'غير منفذ' : 'منفذ'}" shortDesc="#{bindings.MainReports1.hints.IdNumber.tooltip}" id="ot9"/>
      </af:column>
      <af:column headerText="تاريخ التنفيذ" id="c9" align="right" width="100">
        <af:outputText value="#{row.ExecutionDate}" shortDesc="#{bindings.MainReports1.hints.ExecutionDate.tooltip}" id="ot10"/>
      </af:column>
      <af:column headerText="#{bindings.MainReports1.hints.Name.label}" id="c19" align="right" width="70">
        <af:outputText value="#{row.Name}" shortDesc="#{bindings.MainReports1.hints.Name.tooltip}" id="ot23"/>
      </af:column>
      <af:column headerText="#{bindings.MainReports1.hints.HearingDate.label}" id="c21" align="right" width="80">
        <af:outputText value="#{row.HearingDate}" shortDesc="#{bindings.MainReports1.hints.HearingDate.tooltip}"
                       id="ot14">
          <af:convertDateTime pattern="#{bindings.MainReports1.hints.HearingDate.format}"/>
        </af:outputText>
      </af:column>
      <af:column headerText="#{bindings.MainReports1.hints.CreatedBy.label}" id="c26" align="right" width="110">
        <af:outputText value="#{row.CreatedBy}" shortDesc="#{bindings.MainReports1.hints.CreatedBy.tooltip}" id="ot24"/>
      </af:column>
    </af:table>
  </af:panelGroupLayout>
</ui:composition>
