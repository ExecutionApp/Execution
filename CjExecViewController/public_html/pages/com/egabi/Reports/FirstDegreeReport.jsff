<?xml version='1.0' encoding='UTF-8'?>
<ui:composition xmlns:ui="http://java.sun.com/jsf/facelets" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
                xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jsp/jstl/core"
                xmlns:h="http://java.sun.com/jsf/html">
    <c:set var="bundle" value="#{adfBundle['com.egabi.cjexec.view.CjExecViewControllerBundle_ar']}"/>
    <c:set var="cjexecviewcontrollerBundle" value="#{adfBundle['com.egabi.cjexec.view.CjExecViewControllerBundle']}"/>
    <!--<af:resource type="css">.af_inputDate_launch-icon-style {top: 10px !important;
left: 2px !important; }
                                    .af_inputDate_content { min-width: 0% !important; }</af:resource>-->
    <af:panelGroupLayout id="pgl1" visible="#{printDafatertBean.visable}">
        <af:panelHeader text="#{'دفتر اول درجة'}"
                        id="ph1"/>
        <h:panelGroup id="pg12" styleClass="row " layout="block">
        <af:panelGroupLayout id="pgl9" styleClass="col-md-1 col-sm-12"
                             rendered="#{sessionScope.userInfo.entityDegree ne '3'  or sessionScope.userInfo.errandFlag eq 'Y'}">
                <af:panelFormLayout id="pfl2" labelAlignment="top">
                    <f:facet name="footer">
                        <af:selectBooleanCheckbox value="#{bindings.EstanafGozayaFlag.inputValue}" 
                                                  text="#{cjexecviewcontrollerBundle.GOZEYA}" label=""  id="sbc2"
                                               autoSubmit="true"   shortDesc="#{bindings.EstanafGozayaFlag.hints.tooltip}"  
                                                  
                                                  valueChangeListener="#{printDafatertBean.gozayOrKoly}"/>
                    </f:facet>
                </af:panelFormLayout>
            </af:panelGroupLayout>
            
            <af:panelGroupLayout id="pg46" styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="#{cjexecviewcontrollerBundle.PROSECUTION_KOLYA}" id="ol2"/>
                <af:selectOneChoice value="#{bindings.NeyabKolyaa.inputValue}" label="#{bindings.NeyabKolyaa.label}"
                                    required="#{bindings.NeyabKolyaa.hints.mandatory}" autoSubmit="true"
                                    shortDesc="#{bindings.NeyabKolyaa.hints.tooltip}" id="soc1" simple="true"
                                    disabled="#{(sessionScope.userInfo.entityDegree eq '39' and !sessionScope.userInfo.userPrevMap[5051]) or sessionScope.userInfo.entityDegree eq '3' and sessionScope.userInfo.errandFlag ne 'Y'}">
                    <f:selectItems value="#{bindings.NeyabKolyaa.items}" id="si1"/>
                    <f:validator binding="#{bindings.NeyabKolyaa.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pg45" styleClass="col-md-2 col-sm-12" partialTriggers="sbc2"
                                 visible="#{printDafatertBean.gozaySearch}"
                                 binding="#{printDafatertBean.niyabaGozayaa}">
                <af:outputLabel value="#{cjexecviewcontrollerBundle.PROSECUTION_PARTIAL}" id="ol3"
                                showRequired="#{printDafatertBean.userGozaya?true:false}"/>
                <af:selectOneChoice value="#{bindings.NeyabGozayaa.inputValue}" label="#{bindings.NeyabGozayaa.label}"
                                    partialTriggers="soc1" shortDesc="#{bindings.NeyabGozayaa.hints.tooltip}" id="soc2"
                                    simple="true" autoSubmit="true"
                                    disabled="#{printDafatertBean.userGozaya and sessionScope.userInfo.errandFlag ne 'Y'}">
                    <f:selectItems value="#{bindings.NeyabGozayaa.items}" id="si2"/>
                    <f:validator binding="#{bindings.NeyabGozayaa.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl7" styleClass="col-md-2 col-sm-12" partialTriggers="sbc2"
                visible="#{printDafatertBean.gozaySearch}" binding="#{printDafatertBean.originEntity}">
                <af:outputLabel value="#{bindings.OrigEntity.label}" id="ol6"
                                showRequired="#{printDafatertBean.userGozaya?true:false}"/>
                <af:selectOneChoice value="#{bindings.OrigEntity.inputValue}" partialTriggers="soc2"
                                    label="#{bindings.OrigEntity.label}"  autoSubmit="true" simple="true"
                                    shortDesc="#{bindings.OrigEntity.hints.tooltip}" id="soc3"
                                    valueChangeListener="#{cjValidator.origEntityVCL}">
                    <f:selectItems value="#{bindings.OrigEntity.items}" id="si3"/>
                    <f:validator binding="#{bindings.OrigEntity.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <!--<af:spacer width="10" height="10" id="s6"/>-->
            <af:panelGroupLayout id="pgl11">
                <af:outputLabel value="سنة الحصر" id="ol1" showRequired="true"/>
                <af:panelGroupLayout id="pgl2" styleClass="col-md-1 col-sm-12">
                    <af:outputLabel id="ol9"/>
                    <af:inputText value="#{bindings.Year.inputValue}"
                                  simple="true" required="true"
                                  maximumLength="4"
                                  shortDesc="#{bindings.Year.hints.tooltip}"
                                  id="it1" autoSubmit="true"
                                  valueChangeListener="#{cjValidator.yearVCL}"
                                  columns="4" rows="1">
                        <f:validator binding="#{bindings.Year.validator}"/>
                    </af:inputText>
                </af:panelGroupLayout>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl8" styleClass="col-md-1 col-sm-12">
                <af:outputLabel value="النوع" id="ol7" showRequired="true"/>
                <af:selectOneChoice value="#{bindings.CriminalTypeFlag.inputValue}"
                                    simple="true" autoSubmit="true"
                                    label="#{bindings.CriminalTypeFlag.label}"
                                    required="#{!printDafatertBean.userGozaya and sessionScope.NavigationName eq 'HasrPage' }"
                                    shortDesc="#{bindings.CriminalTypeFlag.hints.tooltip}"
                                    id="soc4"
                                    valueChangeListener="#{printDafatertBean.criminalTypeFlagListener}">
                    <f:selectItem itemValue="1" itemLabel="جنح" id="si4"/>
                    <f:selectItem itemValue="2" itemLabel="جنايات" id="si5"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl12" styleClass="col-md-2 col-sm-12"
                                >
                <af:outputLabel value="الدفتر" id="ol8" showRequired="true"/>
                <af:selectOneChoice value="#{bindings.GenayWithoutGharama.inputValue}"
                                    label="#{bindings.GenayWithoutGharama.label}"
                                    simple="true" autoSubmit="true"
                                    shortDesc="#{bindings.GenayWithoutGharama.hints.tooltip}"
                                    id="soc5" required="true">
                    <f:selectItems value="#{bindings.GenayWithoutGharama.items}"
                                   id="si6"/>
                    <f:validator binding="#{bindings.GenayWithoutGharama.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl10" styleClass="col-md-2 col-sm-12"
                                 rendered="false"/>
            <!--<af:panelGroupLayout id="pgl5" styleClass="col-md-1 col-sm-12">
                </af:panelGroupLayout>-->
        </h:panelGroup>
        <h:panelGroup id="pg1" styleClass="row" layout="block">
            <af:panelGroupLayout id="pgl3" styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="من تاريخ جلسة" id="ol4"/>
                <af:inputDate value="#{bindings.DateFrom.inputValue}" simple="true"
                              shortDesc="#{bindings.DateFrom.hints.tooltip}" id="id2" autoSubmit="true"
                              showRequired="false">
                    <f:validator binding="#{bindings.DateFrom.validator}"/>
                    <af:convertDateTime pattern="dd/MM/yyyy"/>
                </af:inputDate>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl4" styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="الي تاريخ جلسة" id="ol5"/>
                <af:inputDate value="#{bindings.DateTo.inputValue}" simple="true"
                              shortDesc="#{bindings.DateTo.hints.tooltip}" id="id1" autoSubmit="true"
                              showRequired="false">
                    <f:validator binding="#{bindings.DateTo.validator}"/>
                    <af:convertDateTime pattern="dd/MM/yyyy"/>
                </af:inputDate>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl5" styleClass="col-md-1 col-sm-12">
                <af:spacer width="10" height="20" id="s1"/>
                <af:button text="بحث" actionListener="#{printDafatertBean.search}" partialSubmit="true" id="b3"/>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl6" styleClass="col-md-1 col-sm-12">
                <af:spacer width="10" height="20" id="s2"/>
                <af:button text="#{cjexecviewcontrollerBundle.PRINT_REPORT}" id="b2"
                           disabled="#{bindings.HasrDataReportView1Iterator.estimatedRowCount eq '0'}"
                           partialTriggers="b3 t1" action="#{printDafatertBean.printDaftarHasrReport}"/>
            </af:panelGroupLayout>
        </h:panelGroup>
        <af:table value="#{bindings.HasrDataReportView1.collectionModel}" var="row"
                  rows="#{bindings.HasrDataReportView1.rangeSize}"
                  emptyText="#{bindings.HasrDataReportView1.viewable ?  bundle['NO_DATA'] : 'Access Denied.'}"
                  rowBandingInterval="1" selectedRowKeys="#{bindings.HasrDataReportView1.collectionModel.selectedRow}"
                  selectionListener="#{bindings.HasrDataReportView1.collectionModel.makeCurrent}" rowSelection="single"
                  fetchSize="#{bindings.HasrDataReportView1.rangeSize}" partialTriggers="::b3"
                  filterModel="#{bindings.HasrDataReportView1Query.queryDescriptor}"
                  queryListener="#{bindings.HasrDataReportView1Query.processQuery}" varStatus="vs" id="t1"
                  styleClass="AFStretchWidth" scrollPolicy="page" autoHeightRows="13" columnStretching="column:c12">
            <af:column id="c1" headerText="#" width="20" minimumWidth="12">
                <af:outputText value="#{vs.index+1}" id="ot1"/>
            </af:column>
            <af:column sortProperty="#{bindings.HasrDataReportView1.hints.InventoryNumber.name}" filterable="true"
                       sortable="true" headerText="#{bindings.HasrDataReportView1.hints.InventoryNumber.label}" id="c4"
                       width="80">
                <af:outputText value="#{row.InventoryNumber}"
                               shortDesc="#{bindings.HasrDataReportView1.hints.InventoryNumber.tooltip}" id="ot4"/>
            </af:column>
            <af:column sortProperty="#{bindings.HasrDataReportView1.hints.BusinessCaseNumber.name}" filterable="true"
                       sortable="true" headerText="#{bindings.HasrDataReportView1.hints.BusinessCaseNumber.label}"
                       id="c5" width="200">
                <af:outputText value="#{row.BusinessCaseNumber}"
                               shortDesc="#{bindings.HasrDataReportView1.hints.BusinessCaseNumber.tooltip}" id="ot5"/>
            </af:column>
            <af:column sortProperty="#{bindings.HasrDataReportView1.hints.PartyName.name}" filterable="true"
                       sortable="true" headerText="#{bindings.HasrDataReportView1.hints.PartyName.label}" id="c6"
                       width="150">
                <af:outputText value="#{row.PartyName}"
                               shortDesc="#{bindings.HasrDataReportView1.hints.PartyName.tooltip}" id="ot6"/>
            </af:column>
            <af:column headerText="#{bindings.HasrDataReportView1.hints.IdNumber.label}" id="c3" width="110">
                <af:outputText value="#{row.IdNumber}"
                               shortDesc="#{bindings.HasrDataReportView1.hints.IdNumber.tooltip}" id="ot3"/>
            </af:column>
            <af:column sortProperty="#{bindings.HasrDataReportView1.hints.Address.name}" filterable="true"
                       sortable="true" headerText="#{bindings.HasrDataReportView1.hints.Address.label}" id="c7"
                       width="150">
                <af:outputText value="#{row.Address}" shortDesc="#{bindings.HasrDataReportView1.hints.Address.tooltip}"
                               id="ot7"/>
            </af:column>
            <af:column sortProperty="#{bindings.HasrDataReportView1.hints.JobTitle.name}" filterable="true"
                       sortable="true" headerText="#{bindings.HasrDataReportView1.hints.JobTitle.label}" id="c8"
                       width="150" visible="false">
                <af:outputText value="#{row.JobTitle}"
                               shortDesc="#{bindings.HasrDataReportView1.hints.JobTitle.tooltip}" id="ot8"/>
            </af:column>
            <af:column headerText="#{bindings.HasrDataReportView1.hints.JudgmentText.label}" id="c12" width="150">
                <af:outputText value="#{row.JudgmentText}"
                               shortDesc="#{bindings.HasrDataReportView1.hints.JudgmentText.tooltip}" id="ot12"/>
            </af:column>
            <af:column sortProperty="#{bindings.HasrDataReportView1.hints.Name.name}" filterable="true" sortable="true"
                       headerText="#{bindings.HasrDataReportView1.hints.Name.label}" id="c9" width="75">
                <af:outputText value="#{row.Name}" shortDesc="#{bindings.HasrDataReportView1.hints.Name.tooltip}"
                               id="ot9"/>
            </af:column>
            <af:column sortProperty="#{bindings.HasrDataReportView1.hints.HearingDate.name}" filterable="true"
                       sortable="true" headerText="#{bindings.HasrDataReportView1.hints.HearingDate.label}" id="c10"
                       width="90">
                <f:facet name="filter">
                    <af:inputDate value="#{bindings.HasrDataReportView1Query.queryDescriptor.filterConjunctionCriterion.criterionMap.HearingDate.value}"
                                  id="id3">
                        <af:convertDateTime pattern="#{bindings.HasrDataReportView1.hints.HearingDate.format}"/>
                    </af:inputDate>
                </f:facet>
                <af:outputText value="#{row.HearingDate}"
                               shortDesc="#{bindings.HasrDataReportView1.hints.HearingDate.tooltip}" id="ot10">
                    <af:convertDateTime pattern="#{bindings.HasrDataReportView1.hints.HearingDate.format}"/>
                </af:outputText>
            </af:column>
            <af:column headerText="#{bindings.HasrDataReportView1.hints.CreatedBy.label}" id="c2" width="110">
                <af:outputText value="#{row.CreatedBy}"
                               shortDesc="#{bindings.HasrDataReportView1.hints.CreatedBy.tooltip}" id="ot2"/>
            </af:column>
        </af:table>
    </af:panelGroupLayout>
</ui:composition>
