<?xml version='1.0' encoding='UTF-8'?>
<ui:composition xmlns:ui="http://java.sun.com/jsf/facelets" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
                 xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jsp/jstl/core"
                xmlns:h="http://java.sun.com/jsf/html">
<c:set var="bundle" value="#{adfBundle['com.egabi.cjexec.view.CjExecViewControllerBundle_ar']}"/>
  <c:set var="cjexecviewcontrollerBundle" value="#{adfBundle['com.egabi.cjexec.view.CjExecViewControllerBundle']}"/>

  
    <af:panelGroupLayout id="pgl1">
        <af:panelHeader text="#{sessionScope.NavigationName eq 'Moarda'? 'دفتر المعارضات':sessionScope.NavigationName eq 'Estanaf'?'دفتر الاستئناف':sessionScope.NavigationName eq 'MoardaEstanafia'?'دفتر المعارضات الاستئنافية':sessionScope.NavigationName eq 'EatradAmrGenaya'?'دفتر الاعتراض علي الاوامر الجنائية':sessionScope.NavigationName eq 'TaanReportPage' ? 'دفتر الطعون بالنقض':''}"
                        id="ph1"/>
        <h:panelGroup id="pg12" styleClass="row " layout="block">
            <af:panelGroupLayout id="pg46" styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="#{cjexecviewcontrollerBundle.PROSECUTION_KOLYA}" id="ol2"/>
                <af:selectOneChoice value="#{bindings.NeyabKolyaa.inputValue}" label="#{bindings.NeyabKolyaa.label}"
                                    required="#{bindings.NeyabKolyaa.hints.mandatory}"
                                    shortDesc="#{bindings.NeyabKolyaa.hints.tooltip}" id="soc1" simple="true"
                                    disabled="#{(sessionScope.userInfo.entityDegree eq '39' and !sessionScope.userInfo.userPrevMap[5051]) or sessionScope.userInfo.entityDegree eq '3'}"
                                    autoSubmit="true" immediate="true">
                    <f:selectItems value="#{bindings.NeyabKolyaa.items}" id="si1"/>
                    <f:validator binding="#{bindings.NeyabKolyaa.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pg45" styleClass="col-md-2 col-sm-12"
                                 rendered="#{sessionScope.NavigationName ne 'TaanReportPage' and sessionScope.NavigationName ne 'EstanafGnayaatReport' }">
                <af:outputLabel value="#{cjexecviewcontrollerBundle.PROSECUTION_PARTIAL}" id="ol3" showRequired="true"/>
                <af:selectOneChoice value="#{bindings.NeyabGozayaa.inputValue}" label="#{bindings.NeyabGozayaa.label}"
                                    shortDesc="#{bindings.NeyabGozayaa.hints.tooltip}" id="soc2" simple="true"
                                    autoSubmit="true" partialTriggers="soc1"
                                    disabled="#{sessionScope.userInfo.entityDegree eq '3'}">
                    <f:selectItems value="#{bindings.NeyabGozayaa.items}" id="si2"/>
                    <f:validator binding="#{bindings.NeyabGozayaa.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl7" styleClass="col-md-2 col-sm-12"
                                 rendered="#{sessionScope.NavigationName eq 'EstanafGnayaatReport' }">
                <af:outputLabel value="الدفتر" id="ol6" showRequired="true"/>
                <af:selectOneChoice value="#{bindings.AppealType.inputValue}" label=" "
                                    required="#{bindings.AppealType.hints.mandatory}"
                                    shortDesc="#{bindings.AppealType.hints.tooltip}" id="soc3">
                    <f:selectItems value="#{bindings.AppealType.items}" id="si3"/>
                    <f:validator binding="#{bindings.AppealType.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            
            <af:spacer width="10" height="10" id="s6"/>
            <af:panelGroupLayout id="pgl2" styleClass="col-md-2 col-sm-12" rendered="false">
                <af:outputLabel value="سنة  الدفتر " id="ol1" showRequired="true"/>
                <af:inputText value="#{bindings.Year.inputValue}" simple="true"
                              required="true" columns="4"
                              maximumLength="4"
                              shortDesc="#{bindings.Year.hints.tooltip}" id="it1" autoSubmit="true"
                              valueChangeListener="#{cjValidator.yearVCL}">
                    <f:validator binding="#{bindings.Year.validator}"/>
                </af:inputText>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl3" styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="من تاريخ الاجراء" id="ol4" showRequired="true"/>
                <af:inputDate value="#{bindings.DateFrom.inputValue}" required="true"
                               simple="true"
                              shortDesc="#{bindings.DateFrom.hints.tooltip}" id="id2" autoSubmit="true"
                              showRequired="false">
                    <f:validator binding="#{bindings.DateFrom.validator}"/>
                    <af:convertDateTime pattern="dd/MM/yyyy"/>
                </af:inputDate>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl4" styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="الي تاريخ الاجراء" id="ol5" showRequired="true"/>
                <af:inputDate value="#{bindings.DateTo.inputValue}" required="true"
                             
                              simple="true"
                              shortDesc="#{bindings.DateTo.hints.tooltip}" id="id1" autoSubmit="true"
                              showRequired="false">
                    <f:validator binding="#{bindings.DateTo.validator}"/>
                    <af:convertDateTime pattern="dd/MM/yyyy"/>
                </af:inputDate>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl5" styleClass="col-md-1 col-sm-12">
                <af:button  styleClass="btn-search" icon="/resources/images/magnifier.png" 
                           disabled="#{!bindings.executeProcedureView1.enabled}" id="b2"
                           action="#{printDafatertBean.validateBeforeSearch}"/>
            </af:panelGroupLayout>
            <af:spacer width="50" height="10" id="s2"/>
        </h:panelGroup>
        <af:link text=" " id="l1" actionListener="#{bindings.executeProcedureView1.execute}" visible="false"/>
        <af:spacer width="10" height="20" id="s3"/>
        <af:panelGroupLayout id="pgl6" styleClass="btn-holder">
            <af:button text="#{cjexecviewcontrollerBundle.PRINT_REPORT}" id="b1"
                       disabled="#{bindings.ProceduresDataReportView1Iterator.estimatedRowCount eq '0'}"
                       partialTriggers="b2 t1" action="#{printDafatertBean.printDaftarProceduresReport}"/>
        </af:panelGroupLayout>
        <af:spacer width="10" height="20" id="s1"/>
        <af:table value="#{bindings.ProceduresDataReportView1.collectionModel}" var="row"
                  rows="#{bindings.ProceduresDataReportView1.rangeSize}"
                  emptyText="#{bindings.ProceduresDataReportView1.viewable ?  bundle['NO_DATA']  : 'Access Denied.'}"
                  rowBandingInterval="1" partialTriggers="::b2"
                  selectedRowKeys="#{bindings.ProceduresDataReportView1.collectionModel.selectedRow}"
                  selectionListener="#{bindings.ProceduresDataReportView1.collectionModel.makeCurrent}"
                  rowSelection="single" fetchSize="#{bindings.ProceduresDataReportView1.rangeSize}"
                  filterModel="#{bindings.ProceduresDataReportView1Query.queryDescriptor}"
                  queryListener="#{bindings.ProceduresDataReportView1Query.processQuery}" varStatus="vs" id="t1"
                  styleClass="AFStretchWidth" scrollPolicy="page" autoHeightRows="13"
                  columnStretching="column:c2">
            <?audit suppress oracle.adf.faces.compreqsummary?><?audit suppress oracle.adf.faces.tableneedsrowheader?>
            <af:column id="c11" headerText="#" width="50" minimumWidth="12">
                <af:outputText value="#{vs.index+1}" id="ot11"/>
            </af:column>
            <!--<af:column sortProperty="#{bindings.ProceduresDataReportView1.hints.DateEntReservation.name}"
                       filterable="true" sortable="true"
                       headerText="#{bindings.ProceduresDataReportView1.hints.DateEntReservation.label}" id="c5"
                       width="200" rendered="false" minimumWidth="12">
                <af:outputText value="#{row.ActsTypesName}"
                               shortDesc="#{bindings.ProceduresDataReportView1.hints.DateEntReservation.tooltip}"
                               id="ot5"/>
            </af:column>-->
            <af:column sortProperty="ProcNumber" filterable="true"
                       sortable="true" headerText="#{bindings.ProceduresDataReportView1.hints.ProcNumber.label}"
                       id="c1" width="100">
                <af:outputText value="#{(bindings.AppealType.inputValue eq '1' || bindings.AppealType.inputValue eq '2' ) ? row.SequentialNumPpo :( (bindings.AppealType.inputValue eq '3' || bindings.AppealType.inputValue eq '4' ) ?row.SequentialNumber :( (bindings.AppealType.inputValue eq '5'  ) ?row.SequentialNumSla :( (bindings.AppealType.inputValue eq '6'  ) ?row.SequentialNumCp :row.ProcNumber)))}"
                               shortDesc="#{bindings.ProceduresDataReportView1.hints.ProcNumber.tooltip}" id="ot1">
                    <af:convertNumber groupingUsed="false"
                                      pattern="#{bindings.ProceduresDataReportView1.hints.ProcNumber.format}"/>
                </af:outputText>
            </af:column>
            <af:column sortProperty="InventoryNumber" filterable="true"
                       sortable="true" headerText="الحصر"
                       id="c2" width="300">
                <af:outputText value="#{row.InventoryNumber}"
                               shortDesc="#{bindings.ProceduresDataReportView1.hints.InventoryNumber.tooltip}"
                               id="ot2"/>
            </af:column>
            <af:column sortProperty="BusinessCaseNumber"
                       filterable="true" sortable="true"
                       headerText="القضية" id="c3"
                       width="250">
                <af:outputText value="#{row.BusinessCaseNumber}"
                               shortDesc="#{bindings.ProceduresDataReportView1.hints.BusinessCaseNumber.tooltip}"
                               id="ot3"/>
            </af:column>
            <af:column sortProperty="PartyFullName" filterable="true"
                       sortable="true" headerText="#{bindings.ProceduresDataReportView1.hints.PartyFullName.label}"
                       id="c4" width="200">
                <af:outputText value="#{row.PartyFullName}"
                               shortDesc="#{bindings.ProceduresDataReportView1.hints.PartyFullName.tooltip}" id="ot4"/>
            </af:column>
            <af:column sortProperty="ProcedureDate" filterable="true"
                       sortable="true" headerText="#{bindings.ProceduresDataReportView1.hints.ProcedureDate.label}"
                       id="c6" width="90">
                <f:facet name="filter">
                    <af:inputDate value="#{bindings.ProceduresDataReportView1Query.queryDescriptor.filterConjunctionCriterion.criterionMap.ProcedureDate.value}"
                                  id="id3">
                        <?audit suppress oracle.adf.faces.compnotlabelled?>
                        <af:convertDateTime pattern="#{bindings.ProceduresDataReportView1.hints.ProcedureDate.format}"/>
                    </af:inputDate>
                </f:facet>
                <af:outputText value="#{row.ProcedureDate}"
                               shortDesc="#{bindings.ProceduresDataReportView1.hints.ProcedureDate.tooltip}" id="ot6">
                    <af:convertDateTime pattern="#{bindings.ProceduresDataReportView1.hints.ProcedureDate.format}"/>
                </af:outputText>
            </af:column>
            <af:column sortProperty="DateEntReservation" filterable="true" sortable="true"
                       headerText="#{bindings.ProceduresDataReportView1.hints.DateEntReservation.label}" id="c5"
                       width="150" rendered="false" minimumWidth="12">
                <af:outputText value="#{row.DateEntReservation}"
                               shortDesc="#{bindings.ProceduresDataReportView1.hints.DateEntReservation.tooltip}"
                               id="ot5"/>
            </af:column>
            <af:column sortProperty="DateEntReservation"
                       filterable="true" sortable="true"
                       headerText="تاريخ الجلسه" id="c7"
                       width="90" minimumWidth="12">
                <af:outputText value="#{row.HearingDate}"
                               shortDesc="#{bindings.ProceduresDataReportView1.hints.DateEntReservation.tooltip}"
                               id="ot7"/>
            </af:column>
            <af:column sortProperty="CreatedBy" filterable="true" sortable="true"
                       headerText="#{bindings.ProceduresDataReportView1.hints.CreatedBy.label}" id="c8"
                       width="140" minimumWidth="12">
                <af:outputText value="#{row.CreatedBy}"
                               shortDesc="#{bindings.ProceduresDataReportView1.hints.CreatedBy.tooltip}"
                               id="ot8"/>
            </af:column>
        </af:table>
    </af:panelGroupLayout>
</ui:composition>
