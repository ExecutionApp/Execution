<?xml version='1.0' encoding='UTF-8'?>
<ui:composition xmlns:ui="http://java.sun.com/jsf/facelets" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
                xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jsp/jstl/core"
                xmlns:h="http://java.sun.com/jsf/html">
<c:set var="bundle" value="#{adfBundle['com.egabi.cjexec.view.CjExecViewControllerBundle_ar']}"/>
  <c:set var="cjexecviewcontrollerBundle" value="#{adfBundle['com.egabi.cjexec.view.CjExecViewControllerBundle']}"/>


<af:panelGroupLayout id="pgl1">
        <af:panelHeader text="دفتر  المصاريف والكفالات"
                        id="ph1"/>
        <h:panelGroup id="pg12" styleClass="row " layout="block">
            <af:panelGroupLayout id="pg46" styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="#{cjexecviewcontrollerBundle.PROSECUTION_KOLYA}" id="ol2"/>
                <af:selectOneChoice value="#{bindings.NeyabKolyaa.inputValue}" label="#{bindings.NeyabKolyaa.label}"
                                    required="#{bindings.NeyabKolyaa.hints.mandatory}"
                                    shortDesc="#{bindings.NeyabKolyaa.hints.tooltip}" id="soc1" simple="true"
                                    disabled="#{(sessionScope.userInfo.entityDegree eq '39' and !sessionScope.userInfo.userPrevMap[5051]) or sessionScope.userInfo.entityDegree eq '3'}"
                                    autoSubmit="true" rendered="false">
                    <f:selectItems value="#{bindings.NeyabKolyaa.items}" id="si1"/>
                    <f:validator binding="#{bindings.NeyabKolyaa.validator}"/>
                </af:selectOneChoice>
                <af:selectOneChoice value="#{bindings.NeyabKolyaa1.inputValue}"  autoSubmit="true" 
                                    required="#{bindings.NeyabKolyaa1.hints.mandatory}"
                                    shortDesc="#{bindings.NeyabKolyaa1.hints.tooltip}" id="soc6"
                                    disabled="#{sessionScope.userInfo.entityDegree eq '39' or sessionScope.userInfo.entityDegree eq '3' }">
                    <f:selectItems value="#{bindings.NeyabKolyaa1.items}" id="si6"/>
                    <f:validator binding="#{bindings.NeyabKolyaa1.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pg45" styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="#{cjexecviewcontrollerBundle.PROSECUTION_PARTIAL}"
                              
                                 id="ol3" showRequired="true"/>
                <af:selectOneChoice value="#{bindings.NeyabGozayaa.inputValue}" label="#{bindings.NeyabGozayaa.label}"
                                    required="true"
                                    shortDesc="#{bindings.NeyabGozayaa.hints.tooltip}" id="soc2" simple="true"
                                    
                                    autoSubmit="true" partialTriggers="soc1"
                                    disabled="#{sessionScope.userInfo.entityDegree eq '3'}" rendered="false">
                    <f:selectItems value="#{bindings.NeyabGozayaa.items}" id="si2"/>
                    <f:validator binding="#{bindings.NeyabGozayaa.validator}"/>
                </af:selectOneChoice>
                <af:selectOneChoice value="#{bindings.NeyabGozayaa1.inputValue}"  autoSubmit="true" 
                                    required="#{bindings.NeyabGozayaa1.hints.mandatory}"
                                    shortDesc="#{bindings.NeyabGozayaa1.hints.tooltip}" id="soc8"
                                    partialTriggers="soc6"
                                    disabled="#{(sessionScope.userInfo.entityDegree eq '3'  )and sessionScope.userInfo.errandEntUser eq '0'}"
                                    valueChangeListener="#{pageFlowScope.printDafatertBean.neyabaaGozayaaVCL}">
                    <f:selectItems value="#{bindings.NeyabGozayaa1.items}" id="si8"/>
                    <f:validator binding="#{bindings.NeyabGozayaa1.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl8" styleClass="col-md-2 col-sm-12" partialTriggers="soc8">
                <af:outputLabel value="قسم الشرطة" id="ol7" showRequired="true"/>
                <af:selectOneChoice value="#{bindings.PoliceStationEntity.inputValue}"
                                      autoSubmit="true"
                                    required="#{bindings.PoliceStationEntity.hints.mandatory}"
                                    shortDesc="#{bindings.PoliceStationEntity.hints.tooltip}" id="soc5"
                                    partialTriggers="si2" rendered="false">
                    <f:selectItems value="#{bindings.PoliceStationEntity.items}" id="si5"/>
                    <f:validator binding="#{bindings.PoliceStationEntity.validator}"/>
                </af:selectOneChoice>
                <af:selectOneChoice value="#{bindings.OrigEntity.inputValue}"  autoSubmit="true" 
                                    required="#{bindings.OrigEntity.hints.mandatory}"
                                    shortDesc="#{bindings.OrigEntity.hints.tooltip}" id="soc7" partialTriggers="soc8">
                    <f:selectItems value="#{bindings.OrigEntity.items}" id="si7"/>
                    <f:validator binding="#{bindings.OrigEntity.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:spacer width="10" height="10" id="s6"/>
            <af:panelGroupLayout id="pgl9" styleClass="col-md-1 col-sm-12">
                <af:outputLabel value="درجة التقاضى" id="ol8" />
                <af:selectOneChoice value="#{bindings.DegreeId.inputValue}"
                                    required="#{bindings.DegreeId.hints.mandatory}"
                                    shortDesc="#{bindings.DegreeId.hints.tooltip}" id="soc4">
                    <f:selectItems value="#{bindings.DegreeId.items}" id="si4"/>
                    <f:validator binding="#{bindings.DegreeId.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:spacer width="10" height="10" id="s3"/>
            <af:panelGroupLayout id="pgl10" styleClass="col-md-1 col-sm-12">
                <af:outputLabel value="نوع الحضور" id="ol9" />
                <af:selectOneChoice value="#{bindings.Attendance.inputValue}" label=" "
                                    required="#{bindings.Attendance.hints.mandatory}"
                                    shortDesc="#{bindings.Attendance.hints.tooltip}" id="soc10">
                    <f:selectItems value="#{bindings.Attendance.items}" id="si10"/>
                    <f:validator binding="#{bindings.Attendance.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl2" styleClass="col-md-1 col-sm-12">
                <af:outputLabel value="النوع" id="ol1" showRequired="true"/>
                <af:selectOneChoice value="#{bindings.CriminalType.inputValue}"
                                    required="true"
                                    shortDesc="#{bindings.CriminalType.hints.tooltip}" id="soc3">
                    <f:selectItems value="#{bindings.CriminalType.items}" id="si3"/>
                    <f:validator binding="#{bindings.CriminalType.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl7" styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="الدفتر" id="ol6" showRequired="true"/>
                <af:selectOneChoice value="#{bindings.FeesFolderType.inputValue}" autoSubmit="true"
                                    required="true"
                                    shortDesc="#{bindings.FeesFolderType.hints.tooltip}" id="soc9">
                    <f:selectItems value="#{bindings.FeesFolderType.items}" id="si9"/>
                    <f:validator binding="#{bindings.FeesFolderType.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl3" styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="من تاريخ جلسة" id="ol4" showRequired="true"/>
                <af:inputDate value="#{bindings.DateFrom.inputValue}" required="true"
                              simple="true"
                              shortDesc="#{bindings.DateFrom.hints.tooltip}" id="id2" autoSubmit="true"
                              showRequired="false">
                    <f:validator binding="#{bindings.DateFrom.validator}"/>
                    <af:convertDateTime pattern="dd/MM/yyyy"/>
                </af:inputDate>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl4" styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="الي تاريخ جلسة" id="ol5" showRequired="true"/>
                <af:inputDate value="#{bindings.DateTo.inputValue}" required="true"
                              simple="true"
                              shortDesc="#{bindings.DateTo.hints.tooltip}" id="id1" autoSubmit="true"
                              showRequired="false">
                    <f:validator binding="#{bindings.DateTo.validator}"/>
                    <af:convertDateTime pattern="dd/MM/yyyy"/>
                </af:inputDate>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl5" styleClass="col-md-1 col-sm-12">
                <!--<af:button styleClass="btn-search" icon="/resources/images/magnifier.png" actionListener="#{bindings.executeProcedureView.execute}" 
                           disabled="#{!bindings.executeProcedureView.enabled}" id="b1"/>-->
                <af:button styleClass="btn-search" icon="/resources/images/magnifier.png"
                           actionListener="#{bindings.executeMotalbatView.execute}"
                           disabled="#{!bindings.executeMotalbatView.enabled}" id="b3" visible="false"/>
                <af:button styleClass="btn-search" icon="/resources/images/magnifier.png"
                 actionListener="#{pageFlowScope.printDafatertBean.searchDafaterFees}"
                            id="b1"/>
            </af:panelGroupLayout>
            <af:spacer width="50" height="10" id="s2"/>
        </h:panelGroup>
        <af:spacer width="10" height="20" id="s1"/>
        <af:panelGroupLayout id="pgl6" styleClass="btn-holder">
            <af:button text="#{cjexecviewcontrollerBundle.PRINT_REPORT}" id="b2"
                       disabled="#{bindings.MotalbatDataReport1Iterator.estimatedRowCount eq '0'}"
                       partialTriggers="b1 t1" action="#{pageFlowScope.printDafatertBean.printDaftarMotalbatReport}"
                     />
        </af:panelGroupLayout>
        <af:spacer width="50" height="10" id="s4"/>
        <af:table value="#{bindings.FeesProcedureROVO1.collectionModel}" var="row"
                  rows="#{bindings.FeesProcedureROVO1.rangeSize}"
                  emptyText="#{bindings.FeesProcedureROVO1.viewable ? 'No data to display.' : 'Access Denied.'}"
                  rowBandingInterval="0" selectedRowKeys="#{bindings.FeesProcedureROVO1.collectionModel.selectedRow}"
                  selectionListener="#{bindings.FeesProcedureROVO1.collectionModel.makeCurrent}" rowSelection="single"
                  fetchSize="#{bindings.FeesProcedureROVO1.rangeSize}" id="t1" scrollPolicy="page">
            <af:column headerText="مسلسل" id="c9" width="80">
                <af:outputText value="#{row.ClaimNumber}"
                               shortDesc="#{bindings.FeesProcedureROVO1.hints.AsBusinessCaseNumberFull.tooltip}"
                               id="ot9"/>
            </af:column>
            <af:column headerText="رقم القضية" id="c1"
                       width="250">
                <af:outputText value="#{row.BusinessCaseNumberFull}"
                               shortDesc="#{bindings.FeesProcedureROVO1.hints.AsBusinessCaseNumberFull.tooltip}"
                               id="ot1"/>
            </af:column>
            <af:column headerText="رقم الحصر" id="c2" width="300">
                <af:outputText value="#{row.SeqNumberFull}"
                               shortDesc="#{bindings.FeesProcedureROVO1.hints.AsSeqNumberFull.tooltip}" id="ot2"/>
            </af:column>
            <af:column headerText="اسم المتهم" id="c3" width="300">
                <af:outputText value="#{row.PartyFixedFullName}"
                               shortDesc="#{bindings.FeesProcedureROVO1.hints.PartyFixedFullName.tooltip}" id="ot3"/>
            </af:column>
            <af:column headerText="الرقم القومى" id="c4" width="130">
                <af:outputText value="#{row.IdNumber}" shortDesc="#{bindings.FeesProcedureROVO1.hints.IdNumber.tooltip}"
                               id="ot4"/>
            </af:column>
            <af:column headerText="المبلغ" id="c5" rendered="#{bindings.FeesFolderType.inputValue eq '4'}"
                       align="center">
                <af:outputText value="#{row.GuranteeAmount}"
                               shortDesc="#{bindings.FeesProcedureROVO1.hints.GuranteeAmount.tooltip}" id="ot5">
                    <af:convertNumber groupingUsed="false"
                                      pattern="#{bindings.FeesProcedureROVO1.hints.GuranteeAmount.format}"/>
                </af:outputText>
            </af:column>
            <af:column headerText="المبلغ" id="c6" rendered="#{bindings.FeesFolderType.inputValue eq '2'}"
                       align="center">
                <af:outputText value="#{row.CourtFees}"
                               shortDesc="#{bindings.FeesProcedureROVO1.hints.CourtFees.tooltip}" id="ot6">
                    <af:convertNumber groupingUsed="false"
                                      pattern="#{bindings.FeesProcedureROVO1.hints.CourtFees.format}"/>
                </af:outputText>
            </af:column>
            <af:column headerText="المبلغ" id="c7" rendered="#{bindings.FeesFolderType.inputValue eq '1'}"
                       align="center">
                <af:outputText value="#{row.LawyerFees}"
                               shortDesc="#{bindings.FeesProcedureROVO1.hints.LawyerFees.tooltip}" id="ot7">
                    <af:convertNumber groupingUsed="false"
                                      pattern="#{bindings.FeesProcedureROVO1.hints.LawyerFees.format}"/>
                </af:outputText>
            </af:column>
            <af:column headerText="ما تم سدادة" id="c8" align="center">
                <af:outputText value="#{row.PaiedGurantee}"
                               shortDesc="#{bindings.FeesProcedureROVO1.hints.PaiedGurantee.tooltip}" id="ot8">
                    <af:convertNumber groupingUsed="false"
                                      pattern="#{bindings.FeesProcedureROVO1.hints.PaiedGurantee.format}"/>
                </af:outputText>
            </af:column>
        </af:table>
    </af:panelGroupLayout>



</ui:composition>
