                                          columns="#{bindings.Age.hints.displayWidth}"
                                          maximumLength="#{bindings.Age.hints.precision}" disabled="true"
                                          shortDesc="#{bindings.Age.hints.tooltip}" id="it6">
                                <f:validator binding="#{bindings.Age.validator}"/>
                            </af:inputText>
                        </h:panelGroup>
                        <h:panelGroup layout="block" id="pg12">
                            <af:outputLabel value="#{bindings.Gender.hints.label}" id="ol10"/>
                            <af:inputText value="#{bindings.Gender.inputValue}" simple="true"
                                          required="#{bindings.Gender.hints.mandatory}" disabled="true"
                                          columns="#{bindings.Gender.hints.displayWidth}"
                                          maximumLength="#{bindings.Gender.hints.precision}"
                                          shortDesc="#{bindings.Gender.hints.tooltip}" id="it11">
                                <f:validator binding="#{bindings.Gender.validator}"/>
                            </af:inputText>
                        </h:panelGroup>
                        <h:panelGroup layout="block" id="pg13">
                            <af:outputLabel value="#{bindings.Address.hints.label}" id="ol11"/>
                            <af:inputText value="#{bindings.Address.inputValue}" simple="true"
                                          required="#{bindings.Address.hints.mandatory}"
                                          columns="#{bindings.Address.hints.displayWidth}" disabled="true"
                                          maximumLength="#{bindings.Address.hints.precision}"
                                          shortDesc="#{bindings.Address.hints.tooltip}" id="it25">
                                <f:validator binding="#{bindings.Address.validator}"/>
                            </af:inputText>
                        </h:panelGroup>
                        <h:panelGroup layout="block" id="pg14">
                            <af:outputLabel value="#{bindings.JobTitle.hints.label}" id="ol12"/>
                            <af:inputText value="#{bindings.JobTitle.inputValue}" disabled="true"
                                          label="#{bindings.JobTitle.hints.label}"
                                          required="#{bindings.JobTitle.hints.mandatory}"
                                          columns="#{bindings.JobTitle.hints.displayWidth}"
                                          maximumLength="#{bindings.JobTitle.hints.precision}"
                                          shortDesc="#{bindings.JobTitle.hints.tooltip}" id="it26">
                                <f:validator binding="#{bindings.JobTitle.validator}"/>
                            </af:inputText>
                        </h:panelGroup>
                    </h:panelGroup>
                </af:showDetailItem>
            </af:panelTabbed>
