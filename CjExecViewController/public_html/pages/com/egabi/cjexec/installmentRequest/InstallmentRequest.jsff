                                    <af:setActionListener from="InstallmentFine" to="#{pageFlowScope.reportName}"/>
                                    <af:setActionListener from="executionFolderReports"
                                                          to="#{pageFlowScope.reportFolder}"/>
                                </af:button>
                            </af:toolbar>
                        </af:toolbox>
