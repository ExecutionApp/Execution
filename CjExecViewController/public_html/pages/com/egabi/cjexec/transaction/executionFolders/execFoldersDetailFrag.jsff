    <af:panelTabbed position="above" id="pt1">
        <af:showDetailItem id="tab1" text="#{bundle.ACTIONS}">
            <af:panelGroupLayout styleClass="btn-holder" id="pgl2" layout="vertical">
            <af:button text="#{bundle.OPPOSITION}" id="b1"
                       action="#{pageFlowScope.ExecutionFoldersBean.validationMethod}">
                <af:setActionListener from="#{bindings.FolderId.inputValue}" to="#{sessionScope.folderID}"/>
                <af:setActionListener from="#{bindings.ResPartyId.inputValue}" to="#{sessionScope.resPartyId}"/>
                <af:setActionListener from="#{bindings.FolderId.inputValue}" to="#{pageFlowScope.FolderID}"/>
                <af:setActionListener from="oppositions" to="#{pageFlowScope.action}"/>
                <af:setActionListener from="1" to="#{pageFlowScope.validationType}"/>
                <af:setActionListener from="1" to="#{sessionScope.oppositionType}"/>
            </af:button>
            <af:button text="#{bundle.DO_OPPOSITION}" id="b2"
                       action="#{pageFlowScope.ExecutionFoldersBean.validationMethod}">
                <af:setActionListener from="#{bindings.FolderId.inputValue}" to="#{sessionScope.folderID}"/>
                <af:setActionListener from="#{bindings.ResPartyId.inputValue}" to="#{sessionScope.resPartyId}"/>
                <af:setActionListener from="#{bindings.FolderId.inputValue}" to="#{pageFlowScope.FolderID}"/>
                <af:setActionListener from="oppositions" to="#{pageFlowScope.action}"/>
                <af:setActionListener from="2" to="#{pageFlowScope.validationType}"/>
                <af:setActionListener from="2" to="#{sessionScope.oppositionType}"/>
            </af:button>
            <!--<af:button text="#{bundle.ENABLE_OPPOSITION}" id="b2"
                       action="#{pageFlowScope.ExecutionFoldersBean.validationMethod}">
                <af:setActionListener from="#{bindings.FolderId.inputValue}" to="#{pageFlowScope.FolderID}"/>
                <af:setActionListener from="enable_opposition" to="#{pageFlowScope.action}"/>
                <af:setActionListener from="2" to="#{pageFlowScope.validationType}"/>
            </af:button>-->
                <af:button text="#{bundle.RESUMPTION}" visible="false" id="b3"/>
            <af:button text="#{bundle.PAYMENT_AMOUNT}" id="b4"
                       action="#{pageFlowScope.ExecutionFoldersBean.validationMethod}">
                <af:setActionListener from="#{bindings.FolderId.inputValue}" to="#{pageFlowScope.FolderID}"/>
                <!--<af:setPropertyListener from="#{bindings.FolderId.inputValue}"  to="#{pageFlowScope.folderID}"
                                            type="action"/>-->
                <af:setActionListener from="paymentAmount" to="#{pageFlowScope.action}"/>
                <af:setActionListener from="3" to="#{pageFlowScope.validationType}"/>
            </af:button>
            <af:button text="#{bundle.DUE_PAYMENT}" id="b5"
                       action="#{pageFlowScope.ExecutionFoldersBean.validationMethod}">
                <af:setActionListener from="#{bindings.FolderId.inputValue}" to="#{pageFlowScope.FolderID}"/>
                <af:setActionListener from="suppRepayment" to="#{pageFlowScope.action}"/>
                <af:setActionListener from="4" to="#{pageFlowScope.validationType}"/>
            </af:button>
            <af:button text="#{bundle.IMPLEMENT_PRISON}" action="#{pageFlowScope.ExecutionFoldersBean.validationMethod}"
                       id="b6">
                <af:setActionListener from="#{bindings.FolderId.inputValue}" to="#{pageFlowScope.FolderID}"/>
                <af:setActionListener from="#{bindings.JudgementId.inputValue}" to="#{pageFlowScope.execution_Flag}"/>
                <af:setActionListener from="execute_prison" to="#{pageFlowScope.action}"/>
                <af:setActionListener from="5" to="#{pageFlowScope.validationType}"/>
            </af:button>
            <af:button text="#{bundle.INSTALLMENT_FINE}" action="#{pageFlowScope.ExecutionFoldersBean.validationMethod}"
                       id="b7">
                <af:setActionListener from="#{bindings.FolderId.inputValue}" to="#{pageFlowScope.FolderID}"/>
                <af:setActionListener from="installment_request" to="#{pageFlowScope.action}"/>
                <af:setActionListener from="6" to="#{pageFlowScope.validationType}"/>
            </af:button>
             <af:button text="#{bundle.INSTALLMENT_FINE_CANCEL}" action="#{pageFlowScope.ExecutionFoldersBean.validationMethod}"
                       id="b9">
                <af:setActionListener from="#{bindings.FolderId.inputValue}" to="#{pageFlowScope.FolderID}"/>
                <!--<af:setActionListener from="installment_request_cancel" to="#{pageFlowScope.action}"/>-->
                <af:setActionListener from="7" to="#{pageFlowScope.validationType}"/>
            </af:button>
            
             <af:button text="#{bundle.CANCEL_IMPLEMENT_PRISON}" action="#{pageFlowScope.ExecutionFoldersBean.validationMethod}"
                       id="b13">
                <af:setActionListener from="#{bindings.FolderId.inputValue}" to="#{pageFlowScope.FolderID}"/>
                <af:setActionListener from="8" to="#{pageFlowScope.validationType}"/>
                <af:setActionListener from="cancel" to="#{pageFlowScope.action}"/>
            </af:button>
        </af:panelGroupLayout>
        </af:showDetailItem>
        <af:showDetailItem id="tab2" text="#{bundle.REPORTS}">
            <af:panelGroupLayout id="pgl1" styleClass="btn-holder" layout="vertical">
                <af:button text="نموذج معارضة" id="b11" actionListener="#{pageFlowScope.ReportsBean.printReports}">
                    <af:setActionListener from="Person" to="#{pageFlowScope.reportName}"/>
                    <af:setActionListener from="2" to="#{pageFlowScope.actionType}"/>
                    <af:setActionListener from="executionFolderReports" to="#{pageFlowScope.reportFolder}"/>
                </af:button>
                <!--<af:spacer width="10" height="10" id="s2"/>-->
                <af:button text="#{bundle.ENABLE_OPPOSITION_REPORT}" id="b12" rendered="false"
                           actionListener="#{pageFlowScope.ReportsBean.printReports}">
                    <af:setActionListener from="3" to="#{pageFlowScope.actionType}"/>
                    <af:setActionListener from="EnableOpposition" to="#{pageFlowScope.reportName}"/>
                    <af:setActionListener from="executionFolderReports" to="#{pageFlowScope.reportFolder}"/>
                </af:button>
                <af:spacer width="10" height="10" id="s5"/>
                <!--<af:button text="نموذج استئناف" id="b13" actionListener="#{pageFlowScope.ReportsBean.printReports}">
                    <af:setActionListener from="executePrison" to="#{pageFlowScope.reportName}"/>
                </af:button>-->
                <!--<af:spacer width="10" height="10" id="s6"/>-->
                <af:button text="#{bundle.PRISON_REPORT}" id="b14" actionListener="#{pageFlowScope.ReportsBean.printReports}">
                    <af:setActionListener from="5" to="#{pageFlowScope.actionType}"/>
                    <af:setActionListener from="Prison" to="#{pageFlowScope.reportName}"/>
                    <af:setActionListener from="executionFolderReports" to="#{pageFlowScope.reportFolder}"/>
                </af:button>
                <af:spacer width="10" height="10" id="s7"/>
                <af:button text="#{bundle.EXECUTION_REPORT}" id="b15" actionListener="#{pageFlowScope.ReportsBean.printReports}">
                    <af:setActionListener from="5" to="#{pageFlowScope.actionType}"/>
                    <af:setActionListener from="Implement" to="#{pageFlowScope.reportName}"/>
                    <af:setActionListener from="executionFolderReports" to="#{pageFlowScope.reportFolder}"/>
                </af:button>
                 <af:spacer width="10" height="10" id="s77"/>
                <af:button text="#{bundle.INSTALLMENT_FINE_REPORT}" id="b155" actionListener="#{pageFlowScope.ReportsBean.printReports}">
                    <af:setActionListener from="4" to="#{pageFlowScope.actionType}"/>
                    <af:setActionListener from="InstallmentFine" to="#{pageFlowScope.reportName}"/>
                    <af:setActionListener from="executionFolderReports" to="#{pageFlowScope.reportFolder}"/>
                </af:button>

            </af:panelGroupLayout>
        </af:showDetailItem>
    </af:panelTabbed>
    <h:panelGroup id="pg17" layout="block" styleClass="btn-holder">
        <af:button text="#{bundle.BACK}" id="b8" action="back"/>
    </h:panelGroup>
        <af:popup childCreation="deferred" id="p1" autoCancel="disabled">
            <af:dialog id="d1" type="ok">
                <af:region value="#{bindings.ExecBcSessionsJudgmentsTF1.regionModel}" id="r1"/>
                <f:facet name="buttonBar"/>
            </af:dialog>
        </af:popup>
        <af:popup childCreation="deferred" id="p2" autoCancel="disabled">
            <af:dialog id="d2" type="ok">
                <af:region value="#{bindings.ExcPrtySessJdgTF1.regionModel}" id="r2"/>
                <f:facet name="buttonBar"/>
            </af:dialog>
        </af:popup>
   
</ui:composition>