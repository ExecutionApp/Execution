                <!--<h:panelGroup styleClass="btn-holder" id="pg18">
                    <af:button text="#{bundle.VIEW_ACTION_INFO}" id="b10">
                        <af:showPopupBehavior popupId="p2"/>
                    </af:button>
                </h:panelGroup>-->
            </af:showDetailItem>
            <af:showDetailItem text="#{bundle.CRIMES}" id="sdi3">
                <af:table value="#{bindings.ResPartyCrimesROV11.collectionModel}" var="row" 
                          rows="#{bindings.ResPartyCrimesROV11.rangeSize}" emptyText="#{bundle.NO_DATA}"
                          rowBandingInterval="0"
                          selectedRowKeys="#{bindings.ResPartyCrimesROV11.collectionModel.selectedRow}"
                          selectionListener="#{bindings.ResPartyCrimesROV11.collectionModel.makeCurrent}"
                          rowSelection="single" fetchSize="#{bindings.ResPartyCrimesROV11.rangeSize}" id="t1"
                          columnStretching="multiple">
                    <af:column headerText="#{bindings.ResPartyCrimesROV11.hints.CrimeName.label}" id="c1" noWrap="false"
                               width="100%">
                        <af:outputText value="#{row.CrimeName}"
                                       shortDesc="#{bindings.ResPartyCrimesROV11.hints.CrimeName.tooltip}" id="ot1"/>
                    </af:column>
                </af:table>
            </af:showDetailItem>
            <af:showDetailItem text="#{bundle.EXECUTION_INFO}" id="sdi4">
                <!--<af:button actionListener="#{bindings.ExecuteWithParams1.execute}" text="ExecuteWithParams1"
                           disabled="#{!bindings.ExecuteWithParams1.enabled}" id="b9"/>-->
                <af:table value="#{bindings.ExecPartySessionJudgmentsROV1.collectionModel}" var="row"
                          rows="#{bindings.ExecPartySessionJudgmentsROV1.rangeSize}"
                          emptyText="#{bindings.ExecPartySessionJudgmentsROV1.viewable ? 'No data to display.' : 'Access Denied.'}"
                          rowBandingInterval="0"
                          selectedRowKeys="#{bindings.ExecPartySessionJudgmentsROV1.collectionModel.selectedRow}"
                          selectionListener="#{bindings.ExecPartySessionJudgmentsROV1.collectionModel.makeCurrent}"
                          rowSelection="single" fetchSize="#{bindings.ExecPartySessionJudgmentsROV1.rangeSize}" id="t2"
                          contentDelivery="immediate" columnStretching="multiple">
                    <af:column sortProperty="#{bindings.ExecPartySessionJudgmentsROV1.hints.HearingDate.name}"
                               sortable="true"
                               headerText="#{bindings.ExecPartySessionJudgmentsROV1.hints.HearingDate.label}" id="c6"
                               width="100%">
                        <af:outputText value="#{row.HearingDate}"
                                       shortDesc="#{bindings.ExecPartySessionJudgmentsROV1.hints.HearingDate.tooltip}"
                                       id="ot6">
                            <af:convertDateTime pattern="#{bindings.ExecPartySessionJudgmentsROV1.hints.HearingDate.format}"/>
                        </af:outputText>
                    </af:column>
                    <af:column sortProperty="#{bindings.ExecPartySessionJudgmentsROV1.hints.AttendanceName.name}"
                               sortable="true"
                               headerText="#{bindings.ExecPartySessionJudgmentsROV1.hints.AttendanceName.label}"
                               id="c2" width="100%">
                        <af:outputText value="#{row.AttendanceName}"
                                       shortDesc="#{bindings.ExecPartySessionJudgmentsROV1.hints.AttendanceName.tooltip}"
                                       id="ot2"/>
                    </af:column>
                    <af:column sortProperty="#{bindings.ExecPartySessionJudgmentsROV1.hints.PartyJudgementResolution.name}"
                               sortable="true"
                               headerText="#{bindings.ExecPartySessionJudgmentsROV1.hints.PartyJudgementResolution.label}"
                               id="c3" width="100%">
                        <af:outputText value="#{row.PartyJudgementResolution}"
                                       shortDesc="#{bindings.ExecPartySessionJudgmentsROV1.hints.PartyJudgementResolution.tooltip}"
                                       id="ot3"/>
                    </af:column>
                    <af:column sortProperty="#{bindings.ExecPartySessionJudgmentsROV1.hints.SequenceNumber.name}"
                               sortable="true"
                               headerText="#{bindings.ExecPartySessionJudgmentsROV1.hints.SequenceNumber.label}"
                               id="c4" width="100%">
                        <af:outputText value="#{row.SequenceNumber} #{'/'} #{row.Year}"
                                       shortDesc="#{bindings.ExecPartySessionJudgmentsROV1.hints.SequenceNumber.tooltip}"
                                       id="ot4">
                            <af:convertNumber groupingUsed="false"
                                              pattern="#{bindings.ExecPartySessionJudgmentsROV1.hints.SequenceNumber.format}"/>
                        </af:outputText>
                    </af:column>
                    <af:column sortProperty="#{bindings.ExecPartySessionJudgmentsROV1.hints.Name.name}" sortable="true"
                               headerText="#{bindings.ExecPartySessionJudgmentsROV1.hints.Name.label}" id="c5"
                               width="100%">
                        <af:outputText value="#{row.Name}"
                                       shortDesc="#{bindings.ExecPartySessionJudgmentsROV1.hints.Name.tooltip}"
                                       id="ot5"/>
                    </af:column>
                </af:table>
            </af:showDetailItem>
        </af:panelTabbed>
    </af:panelHeader>
