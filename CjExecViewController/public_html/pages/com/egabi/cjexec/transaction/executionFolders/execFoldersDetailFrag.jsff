    <af:panelHeader text="#{bundle.VIEW_JUDGMENTS}" id="ph0">
        <?audit suppress oracle.adf.faces.invalidTypeForHeaderComponent?>
        <f:facet name="info"/>
        <!--<af:button text="#{bundle.VIEW_CASE_INFO}" id="b9">
                <af:showPopupBehavior popupId="p1"/>
            </af:button>-->
        <af:panelTabbed position="above" id="ph3">
            <af:showDetailItem text="#{bundle.JUDG_INFO}" id="sdi1">
                <h:panelGroup id="pg7" layout="block" styleClass="row">
                    <h:panelGroup id="pg1" layout="block" styleClass="col-md-2 col-sm-12">
                        <af:outputLabel showRequired="#{bindings.SequenceNumber.hints.mandatory}"
                                        value="#{bindings.SequenceNumber.hints.label}" id="ol2"/>
                        <af:inputText value="#{bindings.Seq.inputValue}"
                                      label="#{bindings.ExecPartySessionJudgmentsROV1.hints.SequenceNumber.label}"
                                      required="#{bindings.SequenceNumber.hints.mandatory}" readOnly="false"
                                      maximumLength="#{bindings.SequenceNumber.hints.precision}"
                                      shortDesc="#{bindings.SequenceNumber.hints.tooltip}" id="it1" simple="true">
                            <f:validator binding="#{bindings.SequenceNumber.validator}"/>
                            <!--<af:convertNumber groupingUsed="false" pattern="#{bindings.SequenceNumber.format}"/>-->
                        </af:inputText>
                    </h:panelGroup>
                    <h:panelGroup id="pg2" layout="block" styleClass="col-md-2 col-sm-12">
                        <af:outputLabel showRequired="#{bindings.PoliceNumber.hints.mandatory}"
                                        value="#{bindings.PoliceNumber.hints.label}" id="ol3"/>
                        <af:inputText value="#{bindings.PoliceNumber.inputValue}"
                                      label="#{bindings.PoliceNumber.hints.label}"
                                      required="#{bindings.PoliceNumber.hints.mandatory}" readOnly="false"
                                      maximumLength="#{bindings.PoliceNumber.hints.precision}"
                                      shortDesc="#{bindings.PoliceNumber.hints.tooltip}" id="it2" simple="true">
                            <f:validator binding="#{bindings.PoliceNumber.validator}"/>
                        </af:inputText>
                    </h:panelGroup>
                    <h:panelGroup id="pg3" layout="block" styleClass="col-md-2 col-sm-12">
                        <af:outputLabel showRequired="#{bindings.HearingDate.hints.mandatory}"
                                        value="#{bindings.HearingDate.hints.label}" id="ol4"/>
                        <af:inputDate value="#{bindings.HearingDate.inputValue}" readOnly="false"
                                      label="#{bindings.HearingDate.hints.label}"
                                      required="#{bindings.HearingDate.hints.mandatory}"
                                      shortDesc="#{bindings.HearingDate.hints.tooltip}" id="id1" simple="true">
                            <f:validator binding="#{bindings.HearingDate.validator}"/>
                            <af:convertDateTime pattern="#{bindings.HearingDate.format}"/>
                        </af:inputDate>
                    </h:panelGroup>
                    <h:panelGroup id="pg4" layout="block" styleClass="col-md-2 col-sm-12">
                        <af:outputLabel showRequired="#{bindings.DegreeName.hints.mandatory}"
                                        value="#{bindings.DegreeName.hints.label}" id="ol6"/>
                        <af:inputText value="#{bindings.DegreeName.inputValue}"
                                      label="#{bindings.DegreeName.hints.label}"
                                      required="#{bindings.DegreeName.hints.mandatory}"
                                      maximumLength="#{bindings.DegreeName.hints.precision}"
                                      shortDesc="#{bindings.DegreeName.hints.tooltip}" id="it13" simple="true"
                                      readOnly="false">
                            <f:validator binding="#{bindings.DegreeName.validator}"/>
                        </af:inputText>
                    </h:panelGroup>
                    <h:panelGroup id="pg5" layout="block" styleClass="col-md-2 col-sm-12">
                        <af:outputLabel showRequired="#{bindings.JudgementStatus.hints.mandatory}"
                                        value="#{bindings.JudgementStatus.hints.label}" id="ol5"/>
                        <af:inputText value="#{bindings.JudgementStatus.inputValue}"
                                      label="#{bindings.JudgementStatus.hints.label}"
                                      required="#{bindings.JudgementStatus.hints.mandatory}" readOnly="false"
                                      maximumLength="#{bindings.JudgementStatus.hints.precision}"
                                      shortDesc="#{bindings.JudgementStatus.hints.tooltip}" id="it10" simple="true">
                            <f:validator binding="#{bindings.JudgementStatus.validator}"/>
                            <!--<af:convertNumber groupingUsed="false" pattern="#{bindings.JudgementStatus.format}"/>-->
                        </af:inputText>
                    </h:panelGroup>
                    <h:panelGroup id="pg6" layout="block" styleClass="col-md-12 col-sm-12">
                        <af:outputLabel showRequired="#{bindings.JudgementResolution.hints.mandatory}"
                                        value="#{bindings.JudgementResolution.hints.label}" id="ol1"/>
                        <af:inputText value="#{bindings.JudgementResolution.inputValue}" rows="3"
                                      required="#{bindings.JudgementResolution.hints.mandatory}" readOnly="false"
                                      maximumLength="#{bindings.JudgementResolution.hints.precision}"
                                      shortDesc="#{bindings.JudgementResolution.hints.tooltip}" id="it9" simple="true">
                            <f:validator binding="#{bindings.JudgementResolution.validator}"/>
                        </af:inputText>
                    </h:panelGroup>
                </h:panelGroup>
            </af:showDetailItem>
            <af:showDetailItem text="#{bundle.CRIMINAL_INFO}" id="sdi2">
                <h:panelGroup styleClass="row" layout="block" id="pg16">
                    <h:panelGroup id="pg8" styleClass="col-md-2 col-sm-12" layout="block">
                        <af:outputLabel showRequired="#{bindings.PartyFullName.hints.mandatory}"
                                        value="#{bindings.PartyFullName.hints.label}" id="ol7"/>
                        <af:inputText value="#{bindings.PartyFullName.inputValue}"
                                      label="#{bindings.PartyFullName.hints.label}"
                                      required="#{bindings.PartyFullName.hints.mandatory}" readOnly="true"
                                      maximumLength="#{bindings.PartyFullName.hints.precision}"
                                      shortDesc="#{bindings.PartyFullName.hints.tooltip}" id="it3" simple="true">
                            <f:validator binding="#{bindings.PartyFullName.validator}"/>
                        </af:inputText>
                    </h:panelGroup>
                    <h:panelGroup id="pg9" styleClass="col-md-2 col-sm-12" layout="block">
                        <af:outputLabel showRequired="#{bindings.IdNumber.hints.mandatory}"
                                        value="#{bindings.IdNumber.hints.label}" id="ol8"/>
                        <af:inputText value="#{bindings.IdNumber.inputValue}" label="#{bindings.IdNumber.hints.label}"
                                      required="#{bindings.IdNumber.hints.mandatory}" readOnly="true"
                                      maximumLength="#{bindings.IdNumber.hints.precision}"
                                      shortDesc="#{bindings.IdNumber.hints.tooltip}" id="it5" simple="true">
                            <f:validator binding="#{bindings.IdNumber.validator}"/>
                        </af:inputText>
                    </h:panelGroup>
                    <h:panelGroup id="pg10" styleClass="col-md-2 col-sm-12" layout="block">
                        <af:outputLabel showRequired="#{bindings.Age.hints.mandatory}"
                                        value="#{bindings.Age.hints.label}" id="ol9"/>
                        <af:inputText value="#{bindings.Age.inputValue}" label="#{bindings.Age.hints.label}"
                                      required="#{bindings.Age.hints.mandatory}" readOnly="true"
                                      maximumLength="#{bindings.Age.hints.precision}"
                                      shortDesc="#{bindings.Age.hints.tooltip}" id="it6" simple="true">
                            <f:validator binding="#{bindings.Age.validator}"/>
                        </af:inputText>
                    </h:panelGroup>
                    <h:panelGroup id="pg11" styleClass="col-md-2 col-sm-12" layout="block">
                        <af:outputLabel showRequired="#{bindings.Gender.hints.mandatory}"
                                        value="#{bindings.Gender.hints.label}" id="ol10"/>
                        <af:inputText value="#{bindings.Gender.inputValue}" label="#{bindings.Gender.hints.label}"
                                      required="#{bindings.Gender.hints.mandatory}" readOnly="true"
                                      maximumLength="#{bindings.Gender.hints.precision}"
                                      shortDesc="#{bindings.Gender.hints.tooltip}" id="it8" simple="true">
                            <f:validator binding="#{bindings.Gender.validator}"/>
                        </af:inputText>
                    </h:panelGroup>
                    <h:panelGroup id="pg12" styleClass="col-md-2 col-sm-12" layout="block">
                        <af:outputLabel showRequired="#{bindings.Nickname.hints.mandatory}"
                                        value="#{bindings.Nickname.hints.label}" id="ol11"/>
                        <af:inputText value="#{bindings.Nickname.inputValue}" label="#{bindings.Nickname.hints.label}"
                                      required="#{bindings.Nickname.hints.mandatory}" readOnly="true"
                                      maximumLength="#{bindings.Nickname.hints.precision}"
                                      shortDesc="#{bindings.Nickname.hints.tooltip}" id="it4" simple="true">
                            <f:validator binding="#{bindings.Nickname.validator}"/>
                        </af:inputText>
                    </h:panelGroup>
                    <h:panelGroup id="pg13" styleClass="col-md-2 col-sm-12" layout="block">
                        <af:outputLabel showRequired="#{bindings.JobTitle.hints.mandatory}"
                                        value="#{bindings.JobTitle.hints.label}" id="ol12"/>
                        <af:inputText value="#{bindings.JobTitle.inputValue}" label="#{bindings.JobTitle.hints.label}"
                                      required="#{bindings.JobTitle.hints.mandatory}"
                                      maximumLength="#{bindings.JobTitle.hints.precision}"
                                      shortDesc="#{bindings.JobTitle.hints.tooltip}" id="it12" simple="true">
                            <f:validator binding="#{bindings.JobTitle.validator}"/>
                        </af:inputText>
                    </h:panelGroup>
                    <h:panelGroup id="pg14" styleClass="col-md-2 col-sm-12" layout="block">
                        <af:outputLabel showRequired="#{bindings.Address.hints.mandatory}"
                                        value="#{bindings.Address.hints.label}" id="ol13"/>
                        <af:inputText value="#{bindings.Address.inputValue}" label="#{bindings.Address.hints.label}"
                                      required="#{bindings.Address.hints.mandatory}" readOnly="true"
                                      maximumLength="#{bindings.Address.hints.precision}"
                                      shortDesc="#{bindings.Address.hints.tooltip}" id="it7" simple="true">
                            <f:validator binding="#{bindings.Address.validator}"/>
                        </af:inputText>
                    </h:panelGroup>
                    <h:panelGroup id="pg15" styleClass="col-md-2 col-sm-12" layout="block">
                        <af:outputLabel showRequired="#{bindings.Attendance.hints.mandatory}"
                                        value="#{bindings.Attendance.hints.label}" id="ol14"/>
                        <af:inputText value="#{bindings.Attendance.inputValue}"
                                      label="#{bindings.Attendance.hints.label}"
                                      required="#{bindings.Attendance.hints.mandatory}" readOnly="true"
                                      maximumLength="#{bindings.Attendance.hints.precision}"
                                      shortDesc="#{bindings.Attendance.hints.tooltip}" id="it11" simple="true">
                            <f:validator binding="#{bindings.Attendance.validator}"/>
                            <af:convertNumber groupingUsed="false" pattern="#{bindings.Attendance.format}"/>
                        </af:inputText>
                    </h:panelGroup>
                </h:panelGroup>
                <af:panelGroupLayout rendered="false" id="pgl3" layout="horizontal">
                    <af:panelFormLayout id="pfl1" rows="4">
                        <f:facet name="footer"/>
                        <!--<af:panelLabelAndMessage label="#{bindings.PartyFullName.hints.label}" id="plam4"
                                                 inlineStyle="min-width:50pt;">
                                </af:panelLabelAndMessage>-->
                        <!--<af:panelLabelAndMessage label="#{bindings.IdNumber.hints.label}" id="plam6">
