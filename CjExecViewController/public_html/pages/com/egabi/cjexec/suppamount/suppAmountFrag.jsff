<?xml version='1.0' encoding='UTF-8'?>
<ui:composition xmlns:ui="http://java.sun.com/jsf/facelets" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
                xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jsp/jstl/core">
  <c:set var="cjexecviewcontrollerBundle" value="#{adfBundle['CjExecViewControllerBundle']}"/>
  
  <!--c:set var="cjexecviewcontrollerBundle" value="#{adfBundle['CjExecViewControllerBundle']}"/-->
  <af:panelBox text="#{bundle.PAYMENT_AMOUNT}" id="pb1">
    <f:facet name="toolbar">
      <af:toolbar id="t1">
        <af:button text="#{bundle.save}" id="b1" 
                   action="#{backingBeanScope.SuppAmountBean.saveAction}"/>
        <af:button text="#{bundle.print}" id="b2"/>
        <af:button text="#{bundle.cancel}" id="b3" action="save"/>
        <af:button actionListener="#{bindings.ExecuteWithParams.execute}" text="ExecuteWithParams"
                   disabled="#{!bindings.ExecuteWithParams.enabled}" visible="false" id="b4"
                   />
        
      </af:toolbar>
    </f:facet>
    <af:panelGroupLayout id="pgl1">
      <af:table value="#{bindings.ExcCourtBcPartyDebt.collectionModel}" var="row"
                rows="#{bindings.ExcCourtBcPartyDebt.rangeSize}"
                emptyText="#{bindings.ExcCourtBcPartyDebt.viewable ? 'No data to display.' : 'Access Denied.'}"
                rowBandingInterval="0" fetchSize="#{bindings.ExcCourtBcPartyDebt.rangeSize}" id="t2"
                columnStretching="column:c2">
        <af:column headerText="#{bindings.ExcCourtBcPartyDebt.hints.Id.label}" id="c3" rendered="false">
          <af:outputText value="#{row.Id}" shortDesc="#{bindings.ExcCourtBcPartyDebt.hints.Id.tooltip}" id="ot2">
            <af:convertNumber groupingUsed="false" pattern="#{bindings.ExcCourtBcPartyDebt.hints.Id.format}"/>
          </af:outputText>
        </af:column>
        <af:column headerText="#{bindings.ExcCourtBcPartyDebt.hints.FeesTypeId.label}" id="c2">
          <af:selectOneChoice value="#{row.bindings.FeesTypeId.inputValue}" label="#{row.bindings.FeesTypeId.label}"
                              required="#{bindings.ExcCourtBcPartyDebt.hints.FeesTypeId.mandatory}"
                              shortDesc="#{bindings.ExcCourtBcPartyDebt.hints.FeesTypeId.tooltip}" readOnly="true"
                              id="soc1">
            <f:selectItems value="#{row.bindings.FeesTypeId.items}" id="si1"/>
            <f:validator binding="#{row.bindings.FeesTypeId.validator}"/>
          </af:selectOneChoice>
        </af:column>
        <af:column headerText="#{bindings.ExcCourtBcPartyDebt.hints.Amount.label}" id="c1">
          <af:outputText value="#{row.Amount}" shortDesc="#{bindings.ExcCourtBcPartyDebt.hints.Amount.tooltip}"
                         id="ot1">
            <af:convertNumber groupingUsed="false" pattern="#{bindings.ExcCourtBcPartyDebt.hints.Amount.format}"/>
          </af:outputText>
        </af:column>
        <af:column headerText="#{bindings.ExcCourtBcPartyDebt.hints.isPaid.label}" id="c4">
          <af:selectBooleanCheckbox value="#{row.bindings.SettlementProcId.inputValue!=null or(row.bindings.FeesTypeId.inputValue==3 and row.bindings.PaidAmount.inputValue==row.bindings.Amount.inputValue)}" readOnly="true"
                                    label="#{row.bindings.isPaid.label}"
                                    shortDesc="#{bindings.ExcCourtBcPartyDebt.hints.isPaid.tooltip}" id="sbc5"/>
        </af:column>
        <af:column headerText="#{bindings.ExcCourtBcPartyDebt.hints.SettlementDate.label}" id="c5">
          <af:outputText value="#{row.SettlementDate}"
                         shortDesc="#{bindings.ExcCourtBcPartyDebt.hints.SettlementDate.tooltip}" id="ot4">
            <af:convertDateTime pattern="#{bindings.ExcCourtBcPartyDebt.hints.SettlementDate.format}"/>
          </af:outputText>
        </af:column>
        <af:column headerText="#{bundle.Choseed}" id="c113">
          <af:selectBooleanCheckbox value="#{row.bindings.SettReqProcId.inputValue!=null}" id="sbc3"/>
        </af:column>
        <af:column id="c6" headerText="">
          <af:selectBooleanCheckbox value="#{row.bindings.isSelected.inputValue}"
                                    label="#{row.bindings.isSelected.label}"
                                    disabled="#{row.bindings.SettlementProcId.inputValue!=null or (row.bindings.FeesTypeId.inputValue==3 and backingBeanScope.SuppAmountBean.haveInstallments)}"
                                    shortDesc="#{bindings.ExcCourtBcPartyDebt.hints.isSelected.tooltip}" id="sbc1"/>
        </af:column>
      </af:table>
      <af:panelBox id="pbl1" visible="#{bindings.rowConts.inputValue>0}"
                   text="#{bundle.Fine_installments}">
        <af:table value="#{bindings.ExcFolderProcInstall.collectionModel}" var="row"
                  rows="#{bindings.ExcFolderProcInstall.rangeSize}"
                  emptyText="#{bindings.ExcFolderProcInstall.viewable ? 'No data to display.' : 'Access Denied.'}"
                  rowBandingInterval="0" fetchSize="#{bindings.ExcFolderProcInstall.rangeSize}" id="t3"
                  columnStretching="column:c9">
          <af:column headerText="#{bindings.ExcFolderProcInstall.hints.InstallmentNumber.label}" id="c10">
            <af:outputText value="#{row.InstallmentNumber}"
                           shortDesc="#{bindings.ExcFolderProcInstall.hints.InstallmentNumber.tooltip}" id="ot8">
              <af:convertNumber groupingUsed="false"
                                pattern="#{bindings.ExcFolderProcInstall.hints.InstallmentNumber.format}"/>
            </af:outputText>
          </af:column>
          <af:column headerText="#{bindings.ExcFolderProcInstall.hints.InstallmentDate.label}" id="c9">
            <af:outputText value="#{row.InstallmentDate}"
                           shortDesc="#{bindings.ExcFolderProcInstall.hints.InstallmentDate.tooltip}" id="ot7">
              <af:convertDateTime pattern="#{bindings.ExcFolderProcInstall.hints.InstallmentDate.format}"/>
            </af:outputText>
          </af:column>
          <af:column headerText="#{bindings.ExcFolderProcInstall.hints.InstallmentAmount.label}" id="c8">
            <af:outputText value="#{row.InstallmentAmount}"
                           shortDesc="#{bindings.ExcFolderProcInstall.hints.InstallmentAmount.tooltip}" id="ot6">
              <af:convertNumber groupingUsed="false"
                                pattern="#{bindings.ExcFolderProcInstall.hints.InstallmentAmount.format}"/>
            </af:outputText>
          </af:column>
          <af:column headerText="#{bindings.ExcFolderProcInstall.hints.SettlementDate.label}" id="c12">
            <af:outputText value="#{row.SettlementDate}"
                           shortDesc="#{bindings.ExcFolderProcInstall.hints.SettlementDate.tooltip}" id="ot3">
              <af:convertDateTime pattern="#{bindings.ExcFolderProcInstall.hints.SettlementDate.format}"/>
            </af:outputText>
          </af:column>
           <af:column headerText="#{bindings.ExcFolderProcInstall.hints.isPaid.label}" id="c11">
          <af:selectBooleanCheckbox value="#{row.bindings.SettlementProcId.inputValue!=null}" readOnly="true"
                                    label="#{row.bindings.isPaid.label}"
                                    shortDesc="#{bindings.ExcFolderProcInstall.hints.isPaid.tooltip}" id="sbc4"/>
        </af:column>
          <af:column headerText="#{bundle.Choseed}" id="c7">
            <af:selectBooleanCheckbox value="#{row.bindings.SettReqProcId.inputValue!=null}" id="sbc6"/>
          </af:column>
          <af:column id="c13" headerText="">
            <af:selectBooleanCheckbox value="#{row.bindings.installSelected.inputValue}"
                                      label="#{row.bindings.installSelected.label}"
                                      disabled="#{row.bindings.SettlementProcId.inputValue!=null}"
                                      
                                      shortDesc="#{bindings.ExcFolderProcInstall.hints.installSelected.tooltip}"
                                      id="sbc2"/>
          </af:column>
        </af:table>
        <f:facet name="toolbar"/>
      </af:panelBox>
    </af:panelGroupLayout>
  </af:panelBox>
</ui:composition>
