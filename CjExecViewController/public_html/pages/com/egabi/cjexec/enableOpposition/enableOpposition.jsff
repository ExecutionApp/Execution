                        <af:panelBox text="" id="pb5">
                            <f:facet name="toolbar"/>
                            <af:panelGridLayout id="pgl9">
                                <af:gridRow marginTop="5px" height="auto" marginBottom="5px" id="gr6">
                                    <af:gridCell marginStart="5px" width="10%" id="gc44">
                                        <af:panelLabelAndMessage label="#{bindings.DECISION_TYPE.hints.label}"
                                                                 id="plam13" showRequired="true"/>
                                    </af:gridCell>
                                    <af:gridCell marginStart="5px" width="30%" marginEnd="5px" id="gc45">
                                        <af:selectOneChoice value="#{bindings.DECISION_TYPE.inputValue}"
                                                            label="#{bindings.DECISION_TYPE.label}"
                                                            shortDesc="#{bindings.DECISION_TYPE.hints.tooltip}"
                                                            id="soc3" simple="true" autoSubmit="true" immediate="false"
                                                            visible="true" showRequired="true">
                                                            -->
                    <!--required="#{pageFlowScope.enableOppositionBean.chefFeilds}"-->
                    <!--
                                            <af:selectItem label="#{bundle.INSTALLMENT_APPROVE}" value="#{'a'}"
                                                           id="si3"/>
                                            <af:selectItem label="#{bundle.INSTALLMENT_REJECT}" value="#{'r'}"
                                                           id="si4"/>
                                            <f:validator binding="#{bindings.DECISION_TYPE.validator}"/>
                                        </af:selectOneChoice>
                                    </af:gridCell>
                                </af:gridRow>
                                <af:gridRow marginTop="5px" height="auto" marginBottom="5px" id="gr9">
                                    <af:gridCell marginStart="5px" width="10%" id="gc41">
                                        <af:panelLabelAndMessage label="#{bindings.Remarks.hints.label}" id="plam10"/>
                                    </af:gridCell>
                                    <af:gridCell marginStart="5px" width="30%" id="gc42">
                                        <af:inputText value="#{bindings.Remarks.inputValue}" simple="true"
                                                      required="#{bindings.Remarks.hints.mandatory}"
                                                      columns="#{bindings.Remarks.hints.displayWidth}"
                                                      maximumLength="#{bindings.Remarks.hints.precision}"
                                                      shortDesc="#{bindings.Remarks.hints.tooltip}" id="it10"
                                                      autoSubmit="true">
                                            <f:validator binding="#{bindings.Remarks.validator}"/>
                                        </af:inputText>
                                    </af:gridCell>
                                    <af:gridCell marginStart="5px" width="2%" id="gc43"/>
                                </af:gridRow>
                            </af:panelGridLayout>
                            <af:toolbox id="t5">
                                <af:toolbar id="t4">
                                    <af:button text="#{bundle.PRINT}" id="b2" immediate="true"
                                                   actionListener="#{pageFlowScope.enableOppositionBean.printReports}">
                                            <af:setActionListener from="EnableOpposition"
                                                                  to="#{pageFlowScope.reportName}"/>
                                            <af:setActionListener from="executionFolderReports"
                                                                  to="#{pageFlowScope.reportFolder}"/>
                                        </af:button>
                                    <af:button text="#{bundle.save}" id="b5"
                                               action="#{pageFlowScope.enableOppositionBean.procedureStatus}"/>
                                    <af:button text="#{bundle.BACK}" id="b6" action="back" immediate="true"
                                               actionListener="#{bindings.Rollback.execute}"/>
                                </af:toolbar>
                            </af:toolbox>
                        </af:panelBox>
                    </af:panelGroupLayout>-->
                </af:panelGroupLayout>
                <af:popup childCreation="deferred" autoCancel="disabled" id="p1">
                    <af:dialog id="d1">
                        <af:region value="#{bindings.ExcPrtySessJdgTF.regionModel}" id="r1"/>
                        <f:facet name="buttonBar"/>
                    </af:dialog>
                </af:popup>
                <af:popup childCreation="deferred" autoCancel="disabled" id="p2">
                    <af:dialog id="d2">
                        <f:facet name="buttonBar"/>
                        <af:region value="#{bindings.ExecBcSessionsJudgmentsTF.regionModel}" id="r2"/>
                    </af:dialog>
                </af:popup>
                <af:popup childCreation="deferred" autoCancel="disabled" id="p3">
                    <af:dialog id="d3">
                        <f:facet name="buttonBar"/>
                        <af:region value="#{bindings.Par_PartiesTF.regionModel}" id="r4"/>
                    </af:dialog>
                </af:popup>
            </af:panelGroupLayout>
        </af:panelHeader>
    </af:panelGroupLayout>
</ui:composition>