<?xml version='1.0' encoding='UTF-8'?>
<ui:composition xmlns:ui="http://java.sun.com/jsf/facelets" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
                xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jsp/jstl/core">
  <af:panelBox text="#{bundle.SuppRepay}" id="pb1">
    <f:facet name="toolbar">
      <af:toolbar id="t1">
       <af:button text="#{bundle.save}" id="b1" 
                   action="#{backingBeanScope.SuppRepayBean.suppRepayActionLis}"/>
        <af:button text="#{bundle.print}" id="b2"/>
        <af:button text="#{bundle.cancel}" id="b3" action="save" immediate="true"/>
        <af:button actionListener="#{bindings.ExecuteWithParams.execute}" text="ExecuteWithParams"
                   disabled="#{!bindings.ExecuteWithParams.enabled}" visible="false" id="b4"/>
        
      </af:toolbar>
    </f:facet>
    <af:panelGroupLayout id="pgl1">
      <af:panelGroupLayout id="pgl2">
        <af:panelGridLayout id="pgl3">
          <af:gridRow marginTop="5px" height="auto" id="gr1">
            <af:gridCell marginStart="5px" width="auto" id="gc1">
              <af:outputLabel id="ol1" value="#{bundle.GROUP_NUMBER_FOR_ALL}"/>
            </af:gridCell>
            <af:gridCell marginStart="5px" width="auto" id="gc2">
              <af:inputText id="it5" simple="true" value="#{backingBeanScope.SuppRepayBean.groupNumberAll}"/>
            </af:gridCell>
            <af:gridCell marginStart="5px" width="auto" id="gc3">
              <af:outputLabel id="ol2" value="#{bundle.RECEIPT_NUMBER_FOR_ALL}"/>
            </af:gridCell>
            <af:gridCell marginStart="5px" width="auto" marginEnd="5px" id="gc4">
              <af:inputText id="it6" simple="true" value="#{backingBeanScope.SuppRepayBean.receiptNumberAll}"/>
            </af:gridCell>
          </af:gridRow>
          <af:gridRow marginTop="5px" height="auto" marginBottom="5px" id="gr2">
            <af:gridCell marginStart="5px" width="auto" id="gc5"/>
            <af:gridCell marginStart="5px" width="auto" id="gc6">
              <af:button text="#{bundle.ADD_TO_ALL}" id="b5" 
                         action="#{backingBeanScope.SuppRepayBean.groupReceiptNumbersToAll}"/>
            </af:gridCell>
            <af:gridCell marginStart="5px" width="auto" id="gc7"/>
            <af:gridCell marginStart="5px" width="auto" marginEnd="5px" id="gc8"/>
          </af:gridRow>
        </af:panelGridLayout>
      </af:panelGroupLayout>
      <af:table value="#{bindings.RepayExcCourtBcPartyDebt.collectionModel}" var="row"
                rows="#{bindings.RepayExcCourtBcPartyDebt.rangeSize}"
                emptyText="#{bindings.RepayExcCourtBcPartyDebt.viewable ? 'No data to display.' : 'Access Denied.'}"
                rowBandingInterval="0" fetchSize="#{bindings.RepayExcCourtBcPartyDebt.rangeSize}" id="t2"
                columnStretching="column:c2">
        <af:column headerText="#{bindings.RepayExcCourtBcPartyDebt.hints.FeesTypeId.label}" id="c1">
          <af:selectOneChoice value="#{row.bindings.FeesTypeId.inputValue}" label="#{row.bindings.FeesTypeId.label}"
                              required="#{bindings.RepayExcCourtBcPartyDebt.hints.FeesTypeId.mandatory}"
                              shortDesc="#{bindings.RepayExcCourtBcPartyDebt.hints.FeesTypeId.tooltip}" readOnly="true"
                              id="soc2">
            <f:selectItems value="#{row.bindings.FeesTypeId.items}" id="si3"/>
            <f:validator binding="#{row.bindings.FeesTypeId.validator}"/>
          </af:selectOneChoice>
        </af:column>
        <af:column headerText="#{bindings.RepayExcCourtBcPartyDebt.hints.Amount.label}" id="c2">
          <af:outputText value="#{row.Amount}" shortDesc="#{bindings.RepayExcCourtBcPartyDebt.hints.Amount.tooltip}"
                         id="ot2">
            <af:convertNumber groupingUsed="false" pattern="#{bindings.RepayExcCourtBcPartyDebt.hints.Amount.format}"/>
          </af:outputText>
        </af:column>
        <af:column headerText="#{bindings.RepayExcCourtBcPartyDebt.hints.GroupNumber.label}" id="c3">
          <af:inputText value="#{row.bindings.GroupNumber.inputValue}"
                        disabled="#{row.bindings.SettlementProcId.inputValue!=null}"
                        label="#{bindings.RepayExcCourtBcPartyDebt.hints.GroupNumber.label}"
                        columns="#{bindings.RepayExcCourtBcPartyDebt.hints.GroupNumber.displayWidth}"
                        maximumLength="#{bindings.RepayExcCourtBcPartyDebt.hints.GroupNumber.precision}"
                        shortDesc="#{bindings.RepayExcCourtBcPartyDebt.hints.GroupNumber.tooltip}" id="it3"
                        partialTriggers="::b5">
            <f:validator binding="#{row.bindings.GroupNumber.validator}"/>
          </af:inputText>
        </af:column>
        <af:column headerText="#{bindings.RepayExcCourtBcPartyDebt.hints.ReceiptNumber.label}" id="c4">
          <af:inputText value="#{row.bindings.ReceiptNumber.inputValue}"
                        disabled="#{row.bindings.SettlementProcId.inputValue!=null}"
                        label="#{bindings.RepayExcCourtBcPartyDebt.hints.ReceiptNumber.label}"
                        columns="#{bindings.RepayExcCourtBcPartyDebt.hints.ReceiptNumber.displayWidth}"
                        maximumLength="#{bindings.RepayExcCourtBcPartyDebt.hints.ReceiptNumber.precision}"
                        shortDesc="#{bindings.RepayExcCourtBcPartyDebt.hints.ReceiptNumber.tooltip}" id="it4"
                        partialTriggers="::b5">
            <f:validator binding="#{row.bindings.ReceiptNumber.validator}"/>
          </af:inputText>
        </af:column>
        <af:column headerText="#{bindings.RepayExcCourtBcPartyDebt.hints.SettlementAuthId.label}" id="c5">
          <af:selectOneChoice value="#{row.bindings.SettlementAuthId.inputValue}"
                              disabled="#{row.bindings.SettlementProcId.inputValue!=null}"
                              label="#{row.bindings.SettlementAuthId.label}"
                              required="#{bindings.RepayExcCourtBcPartyDebt.hints.SettlementAuthId.mandatory}"
                              shortDesc="#{bindings.RepayExcCourtBcPartyDebt.hints.SettlementAuthId.tooltip}" id="soc3">
            <f:selectItems value="#{row.bindings.SettlementAuthId.items}" id="si2"/>
            <f:validator binding="#{row.bindings.SettlementAuthId.validator}"/>
          </af:selectOneChoice>
        </af:column>
        <af:column headerText="#{bindings.RepayExcCourtBcPartyDebt.hints.SettlementDate.label}" id="c6">
          <af:inputDate value="#{row.bindings.SettlementDate.inputValue}"
                        disabled="#{row.bindings.SettlementProcId.inputValue!=null}"
                        required="#{bindings.RepayExcCourtBcPartyDebt.hints.SettlementDate.mandatory}"
                        shortDesc="#{bindings.RepayExcCourtBcPartyDebt.hints.SettlementDate.tooltip}" id="id1">
            <f:validator binding="#{row.bindings.SettlementDate.validator}"/>
            <af:convertDateTime pattern="#{bindings.RepayExcCourtBcPartyDebt.hints.SettlementDate.format}"/>
          </af:inputDate>
        </af:column>
        <af:column headerText="#{bindings.RepayExcCourtBcPartyDebt.hints.PayerName.label}"  id="c14">
          <af:outputText value="#{row.PayerName}"
                         shortDesc="#{bindings.RepayExcCourtBcPartyDebt.hints.PayerName.tooltip}" id="ot1"/>
        </af:column>
      </af:table>
      
      
      
      
      <af:panelBox id="pbl1" visible="#{bindings.rowConts.inputValue>0}"
                   text="#{bundle.Fine_installments}">
        <f:facet name="toolbar"/>
        <af:table value="#{bindings.RepayExcFolderProcInstall.collectionModel}" var="row"
                  rows="#{bindings.RepayExcFolderProcInstall.rangeSize}"
                  emptyText="#{bindings.RepayExcFolderProcInstall.viewable ? 'No data to display.' : 'Access Denied.'}"
                  rowBandingInterval="0" fetchSize="#{bindings.RepayExcFolderProcInstall.rangeSize}" id="t3"
                  columnStretching="column:c11" >
          <af:column headerText="#{bindings.RepayExcFolderProcInstall.hints.InstallmentNumber.label}" id="c7">
            <af:outputText value="#{row.InstallmentNumber}"
                           shortDesc="#{bindings.RepayExcFolderProcInstall.hints.InstallmentNumber.tooltip}" id="ot6">
              <af:convertNumber groupingUsed="false"
                                pattern="#{bindings.RepayExcFolderProcInstall.hints.InstallmentNumber.format}"/>
            </af:outputText>
          </af:column>
          <af:column headerText="#{bindings.RepayExcFolderProcInstall.hints.InstallmentAmount.label}" id="c8">
            <af:outputText value="#{row.InstallmentAmount}"
                           shortDesc="#{bindings.RepayExcFolderProcInstall.hints.InstallmentAmount.tooltip}" id="ot7">
              <af:convertNumber groupingUsed="false"
                                pattern="#{bindings.RepayExcFolderProcInstall.hints.InstallmentAmount.format}"/>
            </af:outputText>
          </af:column>
          <af:column headerText="#{bindings.RepayExcFolderProcInstall.hints.InstallmentDate.label}" id="c9">
            <af:outputText value="#{row.InstallmentDate}"
                           shortDesc="#{bindings.RepayExcFolderProcInstall.hints.InstallmentDate.tooltip}" id="ot8">
              <af:convertDateTime pattern="#{bindings.RepayExcFolderProcInstall.hints.InstallmentDate.format}"/>
            </af:outputText>
          </af:column>
          <af:column headerText="#{bindings.RepayExcFolderProcInstall.hints.GroupNumber.label}" id="c10">
            <af:inputText value="#{row.bindings.GroupNumber.inputValue}"
            disabled="#{row.bindings.SettlementProcId.inputValue!=null}"
                          label="#{bindings.RepayExcFolderProcInstall.hints.GroupNumber.label}"
                          required="#{bindings.RepayExcFolderProcInstall.hints.GroupNumber.mandatory}"
                          columns="#{bindings.RepayExcFolderProcInstall.hints.GroupNumber.displayWidth}"
                          maximumLength="#{bindings.RepayExcFolderProcInstall.hints.GroupNumber.precision}"
                          shortDesc="#{bindings.RepayExcFolderProcInstall.hints.GroupNumber.tooltip}" id="it1">
              <f:validator binding="#{row.bindings.GroupNumber.validator}"/>
            </af:inputText>
          </af:column>
          <af:column headerText="#{bindings.RepayExcFolderProcInstall.hints.ReceiptNumber.label}" id="c11">
            <af:inputText value="#{row.bindings.ReceiptNumber.inputValue}"
            disabled="#{row.bindings.SettlementProcId.inputValue!=null}"
                          label="#{bindings.RepayExcFolderProcInstall.hints.ReceiptNumber.label}"
                          required="#{bindings.RepayExcFolderProcInstall.hints.ReceiptNumber.mandatory}"
                          columns="#{bindings.RepayExcFolderProcInstall.hints.ReceiptNumber.displayWidth}"
                          maximumLength="#{bindings.RepayExcFolderProcInstall.hints.ReceiptNumber.precision}"
                          shortDesc="#{bindings.RepayExcFolderProcInstall.hints.ReceiptNumber.tooltip}" id="it2">
              <f:validator binding="#{row.bindings.ReceiptNumber.validator}"/>
            </af:inputText>
          </af:column>
          <af:column headerText="#{bindings.RepayExcFolderProcInstall.hints.SettlementAuthId.label}" id="c12">
            <af:selectOneChoice value="#{row.bindings.SettlementAuthId.inputValue}"
                                label="#{row.bindings.SettlementAuthId.label}"
                                disabled="#{row.bindings.SettlementProcId.inputValue!=null}"
                                required="#{bindings.RepayExcFolderProcInstall.hints.SettlementAuthId.mandatory}"
                                shortDesc="#{bindings.RepayExcFolderProcInstall.hints.SettlementAuthId.tooltip}"
                                id="soc1">
              <f:selectItems value="#{row.bindings.SettlementAuthId.items}" id="si1"/>
              <f:validator binding="#{row.bindings.SettlementAuthId.validator}"/>
            </af:selectOneChoice>
          </af:column>
          <af:column headerText="#{bindings.RepayExcFolderProcInstall.hints.SettlementDate.label}" id="c13">
            <af:inputDate value="#{row.bindings.SettlementDate.inputValue}"
                          disabled="#{row.bindings.SettlementProcId.inputValue!=null}"
                          label="#{bindings.RepayExcFolderProcInstall.hints.SettlementDate.label}"
                          required="#{bindings.RepayExcFolderProcInstall.hints.SettlementDate.mandatory}"
                          columns="#{bindings.RepayExcFolderProcInstall.hints.SettlementDate.displayWidth}"
                          shortDesc="#{bindings.RepayExcFolderProcInstall.hints.SettlementDate.tooltip}" id="id2">
              <f:validator binding="#{row.bindings.SettlementDate.validator}"/>
              <af:convertDateTime pattern="#{bindings.RepayExcFolderProcInstall.hints.SettlementDate.format}"/>
            </af:inputDate>
          </af:column>
        </af:table>
      </af:panelBox>
    </af:panelGroupLayout>
  </af:panelBox>
</ui:composition>
