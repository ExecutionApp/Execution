<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE html>
<f:view xmlns:f="http://java.sun.com/jsf/core" xmlns:af="http://xmlns.oracle.com/adf/faces/rich" locale="Ar"
        xmlns:c="http://java.sun.com/jsp/jstl/core">
    <c:set var="cjexecviewcontrollerBundle" value="#{adfBundle['com.egabi.cjexec.view.CjExecViewControllerBundle']}"/>
    <af:document title="#{cjexecviewcontrollerBundle.HASR_ID_NUMB_REPORT}" id="d1">
        <af:form id="f1" usesUpload="true">
           
            <af:pageTemplate viewId="/main-template.jspx" id="pt1">
                <f:facet name="center">
                    <af:region value="#{bindings.HasrIdNumbReportTF1.regionModel}" id="r1"/>
                </f:facet>
                <f:facet name="start"/>
                <f:facet name="end"/>
            </af:pageTemplate>
        </af:form>
    </af:document>
</f:view>  