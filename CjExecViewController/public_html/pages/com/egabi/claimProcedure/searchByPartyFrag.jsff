<?xml version='1.0' encoding='UTF-8'?>
<ui:composition xmlns:ui="http://java.sun.com/jsf/facelets" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
                xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jsp/jstl/core">
    <c:set var="cjexecviewcontrollerBundle" value="#{adfBundle['com.egabi.cjexec.view.CjExecViewControllerBundle']}"/>
    <af:selectOneRadio value="#{bindings.SearchType.inputValue}" label="#{bindings.SearchType.label}"
                       required="#{bindings.SearchType.hints.mandatory}" immediate="true"
                       shortDesc="#{bindings.SearchType.hints.tooltip}" id="sor1" simple="true" layout="horizontal"
                       autoSubmit="true"
                       valueChangeListener="#{pageFlowScope.claimProcedureBean.resetSearhPartyHasrCaseVCL}"
                       contentStyle="font-size:large;">
        <f:selectItems value="#{bindings.SearchType.items eq null ? '1' : bindings.SearchType.items}" id="si9"/>
        <f:validator binding="#{bindings.SearchType.validator}"/>
    </af:selectOneRadio>
    <af:panelHeader id="ph1" partialTriggers="sor1" rendered="#{bindings.SearchType.inputValue ne null}">
        <af:activeOutputText value="لا توجد نتائج تطابق محددات البحث" id="aot1" visible="false"
                             styleClass="alert alert-warning alert-custom" partialTriggers="t1"/>
        <af:panelGroupLayout id="pgl1" layout="default" styleClass="row">
            <af:panelGroupLayout id="pgl2" styleClass="col-md-2 col-sm-12" partialTriggers="sor1"
                                 rendered="#{bindings.SearchType.inputValue eq 1}">
                <af:outputLabel value="#{bundle.PART_FULL_NAME}" id="ol1f010"/>
                <af:inputText value="#{bindings.PartyName.inputValue}" label="#{bindings.PartyName.hints.label}"
                              contentStyle="width:200px;" maximumLength="#{bindings.PartyName.hints.precision}"
                              simple="true" shortDesc="#{bindings.PartyName.hints.tooltip}" id="it1">
                    <f:validator binding="#{bindings.PartyName.validator}"/>
                </af:inputText>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl4" styleClass="col-md-2 col-sm-12" partialTriggers="sor1"
                                 rendered="#{bindings.SearchType.inputValue eq 1}">
                <af:outputLabel value="#{bundle.ID_NUMBER}" id="ol1"/>
                <af:inputText value="#{bindings.IdNumber.inputValue}" label="#{bindings.IdNumber.hints.label}"
                              required="false" simple="true" autoSubmit="true" maximumLength="14"
                              contentStyle="width:200px;" shortDesc="#{bindings.IdNumber.hints.tooltip}" id="it2"
                              validator="#{cjValidator.nationalIdValidator}">
                    <f:validator binding="#{bindings.IdNumber.validator}"/>
                </af:inputText>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl78" styleClass="col-md-2 col-sm-12" partialTriggers="sor1"
                                 rendered="#{bindings.SearchType.inputValue eq 2}">
                <af:outputLabel showRequired="true" value="#{bundle.sequence_number}" id="olv1"/>
                <af:inputText value="#{bindings.SequenceNumber.inputValue}" simple="true" columns="15" autoSubmit="true"
                              maximumLength="#{bindings.SequenceNumber.hints.precision}" required="true"
                              shortDesc="#{bindings.SequenceNumber.hints.tooltip}" id="it3">
                    <f:validator binding="#{bindings.SequenceNumber.validator}"/>
                </af:inputText>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl81" styleClass="col-md-2 col-sm-12" partialTriggers="sor1"
                                 rendered="#{bindings.SearchType.inputValue eq 3}">
                <af:outputLabel showRequired="true" value="#{bundle.BUSINESS_CASE_NUMBER}" id="ol7"/>
                <af:inputText value="#{bindings.CaseNumber.inputValue}" simple="true" autoSubmit="true"
                              maximumLength="#{bindings.CaseNumber.hints.precision}" required="true"
                              shortDesc="#{bindings.CaseNumber.hints.tooltip}" id="it5">
                    <f:validator binding="#{bindings.CaseNumber.validator}"/>
                </af:inputText>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl58" styleClass="col-md-2 col-sm-12" partialTriggers="sor1"
                                 rendered="#{bindings.SearchType.inputValue eq 2}">
                <af:outputLabel showRequired="true" value="#{bindings.Year.label}" id="ol8"/>
                <af:inputText value="#{bindings.Year.inputValue}" simple="true" maximumLength="4" required="true"
                              shortDesc="#{bindings.Year.hints.tooltip}" id="it4" autoSubmit="true"
                              validator="#{cjValidator.yearValidator}"></af:inputText>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl7" styleClass="col-md-2 col-sm-12" partialTriggers="sor1"
                                 rendered="#{bindings.SearchType.inputValue eq 3}">
                <af:outputLabel showRequired="true" value="#{bindings.Year.label}" id="ol5"/>
                <af:inputText value="#{bindings.Year.inputValue}" simple="true" maximumLength="4" required="true"
                              shortDesc="#{bindings.Year.hints.tooltip}" id="it6" autoSubmit="true"
                              validator="#{cjValidator.yearValidator}"></af:inputText>
            </af:panelGroupLayout>
            <!-- <af:panelGroupLayout id="pgl5" styleClass="col-md-2 col-sm-12" partialTriggers="sor1"
                                 rendered="#{bindings.SearchType.inputValue eq 2}">
                <af:outputLabel showRequired="true" value="#{bundle.CLAIM_TYPE}" id="ol9"/>
                <af:selectOneChoice value="#{bindings.BusinessCaseTypeId.inputValue}"
                                    label="#{bindings.BusinessCaseTypeId.label}" required="true"
                                    shortDesc="#{bindings.BusinessCaseTypeId.hints.tooltip}" id="soc9" simple="true">
                    <f:selectItems value="#{bindings.BusinessCaseTypeId.items}" id="si12"/>
                    <f:validator binding="#{bindings.BusinessCaseTypeId.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>-->
            <af:panelGroupLayout id="pgl8" styleClass="col-md-2 col-sm-12" partialTriggers="sor1"
                                 rendered="#{bindings.SearchType.inputValue eq 3}">
                <af:outputLabel showRequired="true" value="نوع الجدول " id="ol6"/>
                <af:selectOneChoice value="#{bindings.BusinessCaseTypeId.inputValue}"
                                    label="#{bindings.BusinessCaseTypeId.label}" required="true"
                                    valueChangeListener="#{pageFlowScope.claimProcedureBean.businessCaseTypeVCL}"
                                    autoSubmit="true" shortDesc="#{bindings.BusinessCaseTypeId.hints.tooltip}" id="soc2"
                                    simple="true">
                    <f:selectItems value="#{bindings.BusinessCaseTypeId.items}" id="si6"/>
                    <f:validator binding="#{bindings.BusinessCaseTypeId.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl75" styleClass="col-md-2 col-sm-12" partialTriggers="sor1"
                                 rendered="#{bindings.SearchType.inputValue eq 2}">
                <af:outputLabel value="#{bundle.FOLDER_TYPE}" id="ol2" showRequired="true"/>
                <af:selectOneChoice value="#{bindings.FolderTypeId.inputValue}" label="#{bindings.FolderTypeId.label}"
                                    required="true" autoSubmit="true" shortDesc="#{bindings.FolderTypeId.hints.tooltip}"
                                    id="soc1" simple="true">
                    <f:selectItems value="#{bindings.FolderTypeId.items}" id="si1"/>
                    <f:validator binding="#{bindings.FolderTypeId.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pg98" styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="النيابة الكلية" id="ol70"/>
                <af:selectOneChoice value="#{bindings.NeyabKolyaa.inputValue}"
                                    required="#{bindings.NeyabKolyaa.hints.mandatory}"
                                    shortDesc="#{bindings.NeyabKolyaa.hints.tooltip}" id="soc28" simple="true"
                                    disabled="#{(sessionScope.userInfo.entityDegree eq '39' and !sessionScope.userInfo.userPrevMap[5051]) or sessionScope.userInfo.entityDegree eq '3'}"
                                    autoSubmit="true" immediate="true">
                    <f:selectItems value="#{bindings.NeyabKolyaa.items}" id="si28"/>
                    <f:validator binding="#{bindings.NeyabKolyaa.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pg97" styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="النيابة الجزئية" id="ol54"/>
                <!--or (bindings.SearchType.inputValue eq 2 and bindings.EsteanafFlag.inputValue eq 'Y') sbc1-->
                <af:selectOneChoice value="#{bindings.NeyabGozayaa.inputValue}"
                                    required="#{bindings.NeyabGozayaa.hints.mandatory}"
                                    shortDesc="#{bindings.NeyabGozayaa.hints.tooltip}" id="soc17"
                                    partialTriggers="soc2 soc28 sbc1" simple="true"
                                    disabled="#{(bindings.SearchType.inputValue eq 2 and !bindings.EsteanafFlag.inputValue eq 'Y') or sessionScope.userInfo.entityDegree eq '3'}"
                                    autoSubmit="true" immediate="true">
                    <f:selectItems value="#{bindings.NeyabGozayaa.items}" id="si17"/>
                    <f:validator binding="#{bindings.NeyabGozayaa.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pg43" styleClass="col-md-2 col-sm-12">
                <!--disabled="#{bindings.SearchType.inputValue eq 2 and bindings.EsteanafFlag.inputValue eq 'Y'}" sbc1-->
                <af:outputLabel value="#{bindings.OrigEntity.label}" id="ol43"/>
                <af:selectOneChoice value="#{bindings.OrigEntity.inputValue}" label="#{bindings.OrigEntity.label}"
                                    autoSubmit="true" shortDesc="#{bindings.OrigEntity.hints.tooltip}" id="soc10"
                                    disabled="#{bindings.SearchType.inputValue eq 2 and !bindings.EsteanafFlag.inputValue eq 'Y'}"
                                    simple="true" partialTriggers="soc2 soc17 sbc1" immediate="true">
                    <f:selectItems value="#{bindings.OrigEntity.items}" id="si10"/>
                    <f:validator binding="#{bindings.OrigEntity.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl3" styleClass="col-md-2 col-sm-12" partialTriggers="sor1"
                                 rendered="#{bindings.SearchType.inputValue eq 1}">
                <af:outputLabel value="#{bundle.IS_REQUIRED}" id="ol3"/>
                <!--<af:selectOneRadio value="#{bindings.IsRequired.inputValue}" label="#{bindings.RepeatedFlag.label}"
                                   shortDesc="#{bindings.IsRequired.hints.tooltip}" id="sor2" layout="horizontal"
                                   simple="true">
                    <af:selectItem label="#{bundle.YES_LABEL}" id="si3" value="1"/>
                    <af:selectItem label="#{bundle.NO_LABEL}" id="si5" value="2"/>
                </af:selectOneRadio>-->
                <af:selectOneChoice value="#{bindings.IsRequired.inputValue}" label="#{bindings.IsRequired.label}"
                                    required="#{bindings.IsRequired.hints.mandatory}" simple="true"
                                    shortDesc="#{bindings.IsRequired.hints.tooltip}" id="soc3">
                    <f:selectItems value="#{bindings.IsRequired.items}" id="si7"/>
                    <f:validator binding="#{bindings.IsRequired.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl5" styleClass="col-md-2 col-sm-12" partialTriggers="sor1"
                                 rendered="#{bindings.SearchType.inputValue eq 1}">
                <af:outputLabel value="#{bundle.HAS_CLAIM}" id="ol9"/>
                <af:selectOneRadio value="#{bindings.ClaimFlag.inputValue}" label="#{bindings.ClaimFlag.label}"
                                   shortDesc="#{bindings.ClaimFlag.hints.tooltip}" id="sor2" layout="horizontal"
                                   simple="true" autoSubmit="true">
                    <af:selectItem label="#{bundle.YES_LABEL}" id="si3" value="1"/>
                    <af:selectItem label="#{bundle.NO_LABEL}" id="si5" value="2"/>
                </af:selectOneRadio>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl10" styleClass="col-md-2 col-sm-12" partialTriggers="sor1 sor2"
                                 rendered="#{bindings.SearchType.inputValue eq 1 and bindings.ClaimFlag.inputValue eq 1}">
                <af:outputLabel value="#{bundle.IS_PAID}" id="ol10"/>
                <af:selectOneRadio value="#{bindings.PaidFlag.inputValue}" label="#{bindings.PaidFlag.label}"
                                   shortDesc="#{bindings.PaidFlag.hints.tooltip}" id="sor4" layout="horizontal"
                                   simple="true">
                    <af:selectItem label="#{bundle.YES_LABEL}" id="si8" value="1"/>
                    <af:selectItem label="#{bundle.NO_LABEL}" id="si11" value="2"/>
                </af:selectOneRadio>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl77" partialTriggers="sor1" rendered="#{bindings.SearchType.inputValue eq '2'}"
                                 styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="#{bindings.RepeatedFlag.label}" id="ol4" showRequired="true"/>
                <af:selectOneRadio value="#{bindings.RepeatedFlag.inputValue}" label="#{bindings.RepeatedFlag.label}"
                                   shortDesc="#{bindings.RepeatedFlag.hints.tooltip}" id="sor3" layout="horizontal"
                                   simple="true" autoSubmit="true" required="true">
                    <af:selectItem label="#{bundle.YES_LABEL}" id="si2" value="Y"/>
                    <af:selectItem label="#{bundle.NO_LABEL}" id="si4" value="N"/>
                </af:selectOneRadio>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl9" partialTriggers="sor1"
                                 rendered="#{bindings.SearchType.inputValue eq '2' and (sessionScope.userInfo.entityDegree eq '39'  or sessionScope.userInfo.errandFlag eq 'Y')}"
                                 styleClass="col-md-2 col-sm-12 checkbox-estenaf">
                <!--<af:outputLabel value="#{bundle.ESTEANAF_FLAG}" id="ol10"/>-->
                <af:selectBooleanCheckbox value="#{bindings.EsteanafFlag.inputValue}" text="#{bundle.ESTEANAF_FLAG}"
                                          autoSubmit="true"
                                          valueChangeListener="#{pageFlowScope.claimProcedureBean.esteanafFlagVCL}"
                                          shortDesc="#{bindings.EsteanafFlag.hints.tooltip}" id="sbc1" simple="true"/>
            </af:panelGroupLayout>
        </af:panelGroupLayout>
    </af:panelHeader>
    <af:panelGroupLayout id="pgl6" styleClass="btn-holder" partialTriggers="b1 soc28">
        <af:button text="#{bundle.SEARCH}" id="b1" disabled="#{bindings.SearchType.inputValue eq null}"
                   action="#{pageFlowScope.claimProcedureBean.searchPartyHasrCase}" partialTriggers="sor1">
            <af:setPropertyListener from="1" to="#{pageFlowScope.disableSearch}" type="action"/>
        </af:button>
        <af:button text="#{bundle.RESET_SEARCH}" id="b2" disabled="#{bindings.SearchType.inputValue eq null}"
                   partialTriggers="sor1" action="#{pageFlowScope.claimProcedureBean.resetSearhPartyHasrCase}"
                   immediate="true"/>
        <af:button text="#{bundle.EDIT_PARTY}" id="b3" action="nId" useWindow="true" windowHeight="500"
                   windowWidth="900" returnListener="#{pageFlowScope.claimProcedureBean.getNIDValues}"
                   actionListener="#{pageFlowScope.claimProcedureBean.getParId}" disabled="true"
                   rendered="#{bindings.SearchType.inputValue ne null and bindings.SearchType.inputValue eq 1}"
                   partialTriggers="sor1" binding="#{pageFlowScope.claimProcedureBean.editPartyBind}">
            <af:setPropertyListener to="#{pageFlowScope.nIdParam}" from="#{5}" type="action"/>
            <af:setPropertyListener to="#{pageFlowScope.fcnParam}" from="#{null}" type="action"/>
            <af:setPropertyListener to="#{pageFlowScope.userIdParam}" from="#{sessionScope.userInfo.nidUserId}"
                                    type="action"/>
            <af:setPropertyListener to="#{pageFlowScope.channelIdParam}" from="#{sessionScope.userInfo.nidChannelId}"
                                    type="action"/>
            <af:setPropertyListener to="#{pageFlowScope.tokenIdParam}" from="#{sessionScope.userInfo.nidTokenId}"
                                    type="action"/>
            <af:setPropertyListener to="#{pageFlowScope.callPermissionParam}"
                                    from="#{sessionScope.userInfo.nidCallPermission}" type="action"/>
            <af:setPropertyListener to="#{pageFlowScope.userNameParam}" from="#{sessionScope.userInfo.nidUserName}"
                                    type="action"/>
            <af:setPropertyListener to="#{pageFlowScope.passwordParam}" from="#{sessionScope.userInfo.nidPassword}"
                                    type="action"/>
            <af:setPropertyListener to="#{sessionScope.clickedButton}" from="#{null}" type="action"/>
            <af:target events="@all" render="@all" execute="@this"/>
        </af:button>
    </af:panelGroupLayout>
