        <af:popup childCreation="deferred" autoCancel="disabled" id="p4" contentDelivery="lazyUncached">
        <!-- dialogListener="#{pageFlowScope.caseEditBean.changeEditconvictedDialogListener}"-->
            <af:dialog id="d4" type="none" >
                 <af:table value="#{bindings.searchByPartyResultRVO1.collectionModel}" var="row"
                  rows="#{bindings.searchByPartyResultRVO1.rangeSize}"
                  emptyText="#{bindings.searchByPartyResultRVO1.viewable ? 'No data to display.' : 'Access Denied.'}"
                  rowBandingInterval="0" columnStretching="column:c5" width="100%"
                  selectedRowKeys="#{bindings.searchByPartyResultRVO1.collectionModel.selectedRow}"
                  selectionListener="#{bindings.searchByPartyResultRVO1.collectionModel.makeCurrent}"
                  rowSelection="single" fetchSize="#{bindings.searchByPartyResultRVO1.rangeSize}" id="t1"
                  autoHeightRows="5" scrollPolicy="page"
                  rowDisclosureListener="#{pageFlowScope.claimProcedureBean.rowDisclosureListenerResultsTableParty}">
            <f:facet name="detailStamp">
                <af:panelTabbed position="above" id="pt1">
                    <af:showDetailItem id="tab1" text="العناوين" disclosed="true">
                        <af:table value="#{bindings.PartyAddressesRVO1.collectionModel}" var="row"
                                  rows="#{bindings.PartyAddressesRVO1.rangeSize}"
                                  emptyText="#{bindings.PartyAddressesRVO1.viewable ? 'No data to display.' : 'Access Denied.'}"
                                  rowBandingInterval="0" width="40%"
                                  selectedRowKeys="#{bindings.PartyAddressesRVO1.collectionModel.selectedRow}"
                                  selectionListener="#{bindings.PartyAddressesRVO1.collectionModel.makeCurrent}"
                                  rowSelection="single" fetchSize="#{bindings.PartyAddressesRVO1.rangeSize}" id="t4">
                            <af:column headerText="#{bindings.PartyAddressesRVO1.hints.ParPartyId.label}" id="c67"
                                       rendered="false">
                                <af:outputText value="#{row.ParPartyId}"
                                               shortDesc="#{bindings.PartyAddressesRVO1.hints.ParPartyId.tooltip}"
                                               id="ot30">
                                    <af:convertNumber groupingUsed="false"
