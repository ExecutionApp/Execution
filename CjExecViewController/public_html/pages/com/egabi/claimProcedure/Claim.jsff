                                                      layout="block">
                                            --><!----><!--<af:outputLabel value="#{bindings.RepeatedClaimFlag.hints.label}"
                                                                id="ol13"/>--><!----><!--
                                        </h:panelGroup>--><!--
                                    </af:gridCell>
                                </af:gridRow>
                            </af:panelGridLayout>-->
                            <af:panelGridLayout id="pgl7">
                                <af:gridRow marginTop="5px" height="auto" id="gr1">
                                    <af:gridCell marginStart="5px" width="100%" marginEnd="5px" id="gc1">
                                        <af:inputText value="#{bindings.FixedPenaltyAmount.inputValue}"
                                                      label="#{bindings.FixedPenaltyAmount.hints.label}"
                                                      required="#{bindings.FixedPenaltyAmount.hints.mandatory}"
                                                      maximumLength="#{bindings.FixedPenaltyAmount.hints.precision}"
                                                      shortDesc="#{bindings.FixedPenaltyAmount.hints.tooltip}" id="it15fa"
                                                      simple="false" autoSubmit="true">
                                            <f:validator binding="#{bindings.FixedPenaltyAmount.validator}"/>
                                            <af:validateLongRange minimum="0"/>
                                        </af:inputText>
                                    </af:gridCell>
                                </af:gridRow>
                                <af:gridRow marginTop="5px" height="auto" id="gr2">
                                    <af:gridCell marginStart="5px" width="100%" marginEnd="5px" id="gc2">
                                        <af:selectOneChoice value="#{bindings.ClaimFolderType.inputValue}"
                                                            label="#{bindings.ClaimFolderType.label}"
                                                            required="true"
                                                            shortDesc="#{bindings.ClaimFolderType.hints.tooltip}"
                                                            id="soc13"
                                                            rendered="#{bindings.BusinessCaseTypeId.inputValue ne '4'}">
                                            <f:selectItems value="#{bindings.ClaimFolderType.items}" id="si15"/>
                                            <f:validator binding="#{bindings.ClaimFolderType.validator}"/>
                                        </af:selectOneChoice>
                                        <af:selectOneChoice value="#{bindings.ClaimFolderTypeEcon.inputValue}"
