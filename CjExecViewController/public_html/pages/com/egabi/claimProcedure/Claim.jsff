                                                            simple="false" autoSubmit="true" immediate="true">
                                            <f:selectItems value="#{bindings.ClaimYear.items}" id="si3"/>
                                            <f:validator binding="#{bindings.ClaimYear.validator}"/>
                                        </af:selectOneChoice>
                                    </af:gridCell>
                                </af:gridRow>
                                <af:gridRow marginTop="5px" height="auto" id="gr3">
                                    <af:gridCell marginStart="5px" width="100%" marginEnd="5px" id="gc3">
                                        <af:inputText value="#{bindings.ClaimNumber.inputValue}"
                                                      label="#{bindings.ClaimNumber.hints.label}"
                                                      maximumLength="#{bindings.ClaimNumber.hints.precision}"
                                                      shortDesc="#{bindings.ClaimNumber.hints.tooltip}" id="it22" 
                                                      simple="false"
                                                      partialTriggers="soc12"
                                                      disabled="#{bindings.ClaimYear.inputValue gt '29'}"
                                                      visible="false" rendered="false">
                                            <f:validator binding="#{bindings.ClaimNumber.validator}"/>
                                           
                                        </af:inputText>
                                        <af:inputText value="#{bindings.ClaimNumber.inputValue}"  partialTriggers="soc12"
                                                label="#{bindings.ClaimNumber.hints.label}"        required="#{bindings.ClaimNumber.hints.mandatory}"
                                          disabled="#{bindings.ClaimYear.inputValue gt '29'}"        simple="false"     columns="#{bindings.ClaimNumber.hints.displayWidth}"
                                                      maximumLength="#{bindings.ClaimNumber.hints.precision}"
                                                      shortDesc="#{bindings.ClaimNumber.hints.tooltip}" id="it24">
                                            <f:validator binding="#{bindings.ClaimNumber.validator}"/>
                                            <af:convertNumber groupingUsed="false"
                                                              pattern="#{bindings.ClaimNumber.format}"/>
                                        </af:inputText>
                                    </af:gridCell>
                                </af:gridRow>
                                <af:gridRow marginTop="5px" height="auto" id="gr5">
                                    <af:gridCell marginStart="5px" width="100%" marginEnd="5px" id="gc5">
                                        <!--<af:selectBooleanCheckbox value="#{bindings.RepeatedClaimFlag.inputValue}"
                                                                  label="#{bindings.RepeatedClaimFlag.label}"
                                                                  shortDesc="#{bindings.RepeatedClaimFlag.hints.tooltip}"
                                                                  id="sbc4" autoSubmit="true" rendered="false"/>-->
                                        <af:selectOneChoice value="#{bindings.RepeatedClaimFlag1.inputValue}"
                                                            label="#{bindings.RepeatedClaimFlag1.label}"
                                                            required="#{bindings.RepeatedClaimFlag1.hints.mandatory}"
                                                            shortDesc="#{bindings.RepeatedClaimFlag1.hints.tooltip}"
                                                            id="soc18" autoSubmit="true">
                                            <f:selectItems value="#{bindings.RepeatedClaimFlag1.items}" id="si20"/>
                                            <f:validator binding="#{bindings.RepeatedClaimFlag1.validator}"/>
                                        </af:selectOneChoice>
                                    </af:gridCell>
                                </af:gridRow>
                                <af:gridRow marginTop="5px" height="auto" marginBottom="5px" id="gr6">
                                    <af:gridCell marginStart="5px" width="100%" marginEnd="5px" id="gc6">
                                        <af:selectBooleanCheckbox value="#{bindings.AddAllFees.inputValue}"
                                                                  label="#{bindings.AddAllFees.label}"
                                                                  shortDesc="#{bindings.AddAllFees.hints.tooltip}"
                                                                  id="sbc5" rendered="false"/>
                                        <af:selectBooleanCheckbox value="#{bindings.WorkPenaltyFlag.inputValue}"
                                                                  label="إضافة الغرامة اليومية"
                                                                  shortDesc="#{bindings.WorkPenaltyFlag.hints.tooltip}"
                                                                  id="sbc6" autoSubmit="true"
                                                                  valueChangeListener="#{pageFlowScope.claimBean.workVCL}"/>
                                    </af:gridCell>
                                </af:gridRow>
                            </af:panelGridLayout>
                        </af:dialog>
                    </af:popup>
                    <af:popup childCreation="deferred" autoCancel="disabled" id="p2" contentDelivery="lazyUncached">
                        <af:dialog id="d2" dialogListener="#{pageFlowScope.claimBean.createClaimForFolderCombained}" resize="on"
