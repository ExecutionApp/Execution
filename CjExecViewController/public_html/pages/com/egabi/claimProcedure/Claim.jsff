                                <af:gridRow marginTop="5px" height="auto" marginBottom="5px" id="gr1">
                                    <af:gridCell marginStart="5px" width="34%" id="gc1">
                                        --><!--<h:panelGroup id="pg15" styleClass="col-md-2 col-sm-12" layout="block">
                                            <af:outputLabel value="#{bindings.ClaimNumber.hints.label}" id="ol11"/>
                                        </h:panelGroup>--><!--
                                    </af:gridCell>
                                    <af:gridCell marginStart="5px" width="33%" id="gc2">
                                        --><!--<h:panelGroup id="pg16" styleClass="col-md-2 col-sm-12" layout="block">
                                            <af:outputLabel value="#{bindings.ClaimYear.hints.label}" id="ol12"/>
                                        </h:panelGroup>--><!--
                                    </af:gridCell>
                                    <af:gridCell marginStart="5px" width="33%" marginEnd="5px" id="gc3">
