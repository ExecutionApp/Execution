<?xml version='1.0' encoding='UTF-8'?>
<ui:composition xmlns:ui="http://java.sun.com/jsf/facelets" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
                xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jsp/jstl/core"
                xmlns:h="http://java.sun.com/jsf/html">
    <c:set var="cjexecviewcontrollerBundle" value="#{adfBundle['com.egabi.cjexec.view.CjExecViewControllerBundle']}"/>
    <af:selectOneRadio value="#{bindings.SearchType.inputValue}" label="#{bindings.SearchType.label}"
                       required="#{bindings.SearchType.hints.mandatory}"
                       shortDesc="#{bindings.SearchType.hints.tooltip}" id="sor1" simple="true" layout="horizontal"
                       autoSubmit="true" immediate="true"
                       valueChangeListener="#{pageFlowScope.claimBean.resetSearhResults}"
                       contentStyle="font-size:large;" rendered="false">
        <f:selectItems value="#{bindings.SearchType.items eq null ? '1' : bindings.SearchType.items}" id="si9"/>
        <f:validator binding="#{bindings.SearchType.validator}"/>
    </af:selectOneRadio>
    <af:panelHeader id="ph1">
        <af:activeOutputText value="لا توجد نتائج تطابق محددات البحث" id="aot1" visible="false"
                             styleClass="alert alert-warning alert-custom" partialTriggers="t1"/>
        <af:panelGroupLayout id="pgl1">
            <af:panelGroupLayout id="pgl5" partialTriggers="sor1 b2" rendered="#{bindings.SearchType.inputValue eq 2}">
                <h:panelGroup id="pg6" layout="block" styleClass="row">
                    <h:panelGroup id="pg1" layout="block" styleClass="col-md-2 col-sm-12">
                        <af:outputLabel value="#{bundle.sequence_number}" id="ol1" showRequired="true"/>
                        <af:inputText value="#{bindings.SequenceNumber.inputValue}" required="true"
                                      maximumLength="#{bindings.SequenceNumber.hints.precision}"
                                      shortDesc="#{bindings.SequenceNumber.hints.tooltip}" id="it1" simple="true"
                                      partialTriggers="b2">
                            <f:validator binding="#{bindings.SequenceNumber.validator}"/>
                            <af:convertNumber groupingUsed="false" pattern="#{bindings.SequenceNumber.format}"/>
                        </af:inputText>
                    </h:panelGroup>
                    <h:panelGroup id="pg2" layout="block" styleClass="col-md-2 col-sm-12">
                        <af:outputLabel value="#{bindings.Year.label}" id="ol2" showRequired="true"/>
                        <af:inputText value="#{bindings.Year.inputValue}" simple="true" required="true"
                                      maximumLength="#{bindings.Year.hints.precision}"
                                      shortDesc="#{bindings.Year.hints.tooltip}" id="it2"
                                      validator="#{cjValidator.yearValidator}">
                            <af:convertNumber groupingUsed="false" pattern="#{bindings.Year.format}"/>
                        </af:inputText>
                    </h:panelGroup>
                    <h:panelGroup id="pg3" layout="block" styleClass="col-md-2 col-sm-12">
                        <af:outputLabel value="#{bundle.FOLDER_TYPE}" id="ol3" showRequired="true"/>
                        <af:selectOneChoice value="#{bindings.FolderTypeId.inputValue}"
                                            label="#{bindings.FolderTypeId.label}" required="true"
                                            shortDesc="#{bindings.FolderTypeId.hints.tooltip}" id="soc1" simple="true">
                            <f:selectItems value="#{bindings.FolderTypeId.items}" id="si1"/>
                            <f:validator binding="#{bindings.FolderTypeId.validator}"/>
                        </af:selectOneChoice>
                    </h:panelGroup>
                    <h:panelGroup id="pg46" layout="block" styleClass="col-md-2 col-sm-12">
                        <af:outputLabel value="نيابة كلية" id="ol46"/>
                        <af:selectOneChoice value="#{bindings.NeyabKolyaa.inputValue}"
                                            label="#{bindings.NeyabKolyaa.label}"
                                            disabled="#{sessionScope.userInfo.entityDegree eq '3' or (sessionScope.userInfo.entityDegree eq '39' and !sessionScope.userInfo.userPrevMap[5080])}"
                                            required="#{bindings.NeyabKolyaa.hints.mandatory}"
                                            shortDesc="#{bindings.NeyabKolyaa.hints.tooltip}" id="soc10"
                                            autoSubmit="true" simple="true">
                            <f:selectItems value="#{bindings.NeyabKolyaa.items}" id="si13"/>
                            <f:validator binding="#{bindings.NeyabKolyaa.validator}"/>
                        </af:selectOneChoice>
                    </h:panelGroup>
                    <h:panelGroup id="pg45" layout="block" styleClass="col-md-2 col-sm-12">
                        <af:outputLabel value="نيابة جزئية" id="ol45"/>
                        <af:selectOneChoice value="#{bindings.NeyabGozayaa.inputValue}"
                                            label="#{bindings.NeyabGozayaa.label}"
                                            required="#{bindings.NeyabGozayaa.hints.mandatory}"
                                            shortDesc="#{bindings.NeyabGozayaa.hints.tooltip}" id="soc8"
                                            disabled="#{sessionScope.userInfo.entityDegree eq '3' or !bindings.EsteanafFlag.inputValue eq 'Y'}"
                                            partialTriggers="soc10 sbc1" autoSubmit="true" simple="true">
                            <f:selectItems value="#{bindings.NeyabGozayaa.items}" id="si11"/>
                            <f:validator binding="#{bindings.NeyabGozayaa.validator}"/>
                        </af:selectOneChoice>
                    </h:panelGroup>
                    <h:panelGroup id="pg44" layout="block" styleClass="col-md-2 col-sm-12">
                        <af:outputLabel value="قسم شرطة" id="ol41"/>
                        <af:selectOneChoice value="#{bindings.OrigEntity.inputValue}"
                                            label="#{bindings.OrigEntity.label}"
                                            required="#{bindings.OrigEntity.hints.mandatory}"
                                            shortDesc="#{bindings.OrigEntity.hints.tooltip}" id="soc7"
                                            disabled="#{pageFlowScope.disabledValidate or !bindings.EsteanafFlag.inputValue eq 'Y'}"
                                            partialTriggers="soc8 sbc1" simple="true" autoSubmit="true">
                            <f:selectItems value="#{bindings.OrigEntity.items}" id="si10"/>
                            <f:validator binding="#{bindings.OrigEntity.validator}"/>
                        </af:selectOneChoice>
                    </h:panelGroup>
                    <h:panelGroup id="pg4" layout="block" styleClass="col-md-2 col-sm-12">
                        <af:outputLabel value="#{bindings.RepeatedFlag.label}" id="ol4" showRequired="true"/>
                        <af:selectOneRadio value="#{bindings.RepeatedFlag.inputValue}"
                                           label="#{bindings.RepeatedFlag.label}" required="true"
                                           shortDesc="#{bindings.RepeatedFlag.hints.tooltip}" id="sor3"
                                           layout="horizontal" simple="true">
                            <af:selectItem label="#{bundle.YES_LABEL}" id="si2" value="Y"/>
                            <af:selectItem label="#{bundle.NO_LABEL}" id="si4" value="N"/>
                        </af:selectOneRadio>
                    </h:panelGroup>
                    <h:panelGroup id="pg54" layout="block" styleClass="col-md-2 col-sm-12"
                                  rendered="#{sessionScope.userInfo.entityDegree eq '39'  or sessionScope.userInfo.errandFlag eq 'Y'}">
                        <af:outputLabel value="#{bundle.ESTEANAF_FLAG}" id="ol10"/>
                        <af:selectBooleanCheckbox value="#{bindings.EsteanafFlag.inputValue}"
                                                  label="#{bindings.EsteanafFlag.label}" autoSubmit="true"
                                                  shortDesc="#{bindings.EsteanafFlag.hints.tooltip}" id="sbc1"
                                                  simple="true"
                                                  valueChangeListener="#{pageFlowScope.claimBean.esteanafFlagVCL}"/>
                    </h:panelGroup>
                </h:panelGroup>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl6" partialTriggers="sor1">
                <h:panelGroup id="pg12" styleClass="row" layout="block">
                    <h:panelGroup id="pg7" styleClass="col-md-2 col-sm-12" layout="block">
                        <af:outputLabel value="#{bundle.BUSINESS_CASE_NUMBER}" id="ol7" showRequired="true"/>
                        <af:inputText value="#{bindings.CaseNumber.inputValue}" simple="true" required="true"
                                      maximumLength="#{bindings.CaseNumber.hints.precision}"
                                      shortDesc="#{bindings.CaseNumber.hints.tooltip}" id="it5">
                            <f:validator binding="#{bindings.CaseNumber.validator}"/>
                        </af:inputText>
                    </h:panelGroup>
                    <h:panelGroup id="pg8" styleClass="col-md-2 col-sm-12" layout="block">
                        <af:outputLabel value="#{bindings.Year.label}" id="ol8" showRequired="true"/>
                        <af:inputText value="#{bindings.Year.inputValue}" simple="true" required="true"
                                      maximumLength="#{bindings.Year.hints.precision}"
                                      shortDesc="#{bindings.Year.hints.tooltip}" id="it4" autoSubmit="true"
                                      validator="#{cjValidator.yearValidator}">
                            <af:convertNumber groupingUsed="false" pattern="#{bindings.Year.format}"/>
                        </af:inputText>
                    </h:panelGroup>
                    <!-- rendered="#{sessionScope.userInfo.entityDegree eq '39'}" -->
                    <h:panelGroup id="pg9" styleClass="col-md-2 col-sm-12" layout="block">
                        <af:outputLabel value="#{bindings.BusinessCaseTypeId.label}" id="ol9" showRequired="true"/>
                        <af:selectOneChoice value="#{bindings.BusinessCaseTypeId.inputValue}"
                                            label="#{bindings.BusinessCaseTypeId.label}"
                                            shortDesc="#{bindings.BusinessCaseTypeId.hints.tooltip}" id="soc9"
                                            simple="true" required="true"
                                            valueChangeListener="#{pageFlowScope.claimBean.businessCaseTypeVCL}"
                                            autoSubmit="true">
                            <f:selectItems value="#{bindings.BusinessCaseTypeId.items}" id="si12"/>
                            <!--<af:forEach items="#{bindings.BusinessCaseTypeId.items}" var="item">
                                <af:selectItem value="#{item.value}" label="#{item.label}" id="si34"
                                               disabled="#{sessionScope.userInfo.entityDegree eq '3' and(item.value eq 3646 or item.value eq 3647 or item.value eq 3648 or item.value eq 5015)}"/>
                            </af:forEach>-->
                            <f:validator binding="#{bindings.BusinessCaseTypeId.validator}"/>
                        </af:selectOneChoice>
                    </h:panelGroup>
                    <h:panelGroup id="pg41" layout="block" styleClass="col-md-2 col-sm-12">
                        <af:outputLabel value="نيابة كلية" id="ol26"/>
                        <af:selectOneChoice value="#{bindings.NeyabKolyaa.inputValue}"
                                            label="#{bindings.NeyabKolyaa.label}"
                                            disabled="#{sessionScope.userInfo.entityDegree eq '39' or sessionScope.userInfo.entityDegree eq '3' }"
                                            required="#{bindings.NeyabKolyaa.hints.mandatory}"
                                            shortDesc="#{bindings.NeyabKolyaa.hints.tooltip}" id="soc4"
                                            autoSubmit="true" simple="true">
                            <f:selectItems value="#{bindings.NeyabKolyaa.items}" id="si6"/>
                            <f:validator binding="#{bindings.NeyabKolyaa.validator}"/>
                        </af:selectOneChoice>
                    </h:panelGroup>
                    <h:panelGroup id="pg42" layout="block" styleClass="col-md-2 col-sm-12">
                        <af:outputLabel value="نيابة جزئية" id="ol27"/>
                        <af:selectOneChoice value="#{bindings.NeyabGozayaa.inputValue}"
                                            label="#{bindings.NeyabGozayaa.label}"
                                            required="true"
                                            shortDesc="#{bindings.NeyabGozayaa.hints.tooltip}" id="soc5"
                                            disabled="#{sessionScope.userInfo.entityDegree eq '3' }"
                                            partialTriggers="soc4" autoSubmit="true" simple="true">
                            <f:selectItems value="#{bindings.NeyabGozayaa.items}" id="si7"/>
                            <f:validator binding="#{bindings.NeyabGozayaa.validator}"/>
                        </af:selectOneChoice>
                    </h:panelGroup>
                    <h:panelGroup id="pg43" layout="block" styleClass="col-md-2 col-sm-12">
                        <af:outputLabel value="قسم شرطة" id="ol32"/>
                        <af:selectOneChoice value="#{bindings.OrigEntity.inputValue}"
                                            label="#{bindings.OrigEntity.label}"
                                            shortDesc="#{bindings.OrigEntity.hints.tooltip}" id="soc6"
                                            disabled="#{pageFlowScope.disabledValidate}" partialTriggers="soc5"
                                            simple="true" autoSubmit="true">
                            <f:selectItems value="#{bindings.OrigEntity.items}" id="si8"/>
                            <f:validator binding="#{bindings.OrigEntity.validator}"/>
                        </af:selectOneChoice>
                    </h:panelGroup>
                </h:panelGroup>
            </af:panelGroupLayout>
            <af:panelGroupLayout id="pgl3" styleClass="btn-holder">
                <af:button actionListener="#{bindings.filterClaimsFoldersRO.execute}" text="بحث على مستوى الدفاتر"
                           disabled="#{!bindings.filterClaimsFoldersRO.enabled}" id="b3"
                           action="#{pageFlowScope.claimBean.searchBtn}"/>
                <af:button text="#{bundle.SEARCH}" id="b1" action="#{pageFlowScope.claimBean.doSearch}"
                           disabled="#{bindings.SearchType.inputValue eq null}" partialTriggers="sor1"
                           rendered="false"/>
                <af:button text="#{bundle.RESET_SEARCH}" id="b2" disabled="#{bindings.SearchType.inputValue eq null}"
                           partialTriggers="sor1" >
                    <af:setPropertyListener from="#{null}" to="#{bindings.CaseNumber.inputValue}" type="action"/>
                   <af:setPropertyListener from="#{null}" to="#{bindings.Year.inputValue}" type="action"/>
                    <af:setPropertyListener from="#{null}" to="#{bindings.BusinessCaseTypeId.inputValue}" type="action"/>
                    <af:setPropertyListener from="#{null}" to="#{bindings.OrigEntity.inputValue}" type="action"/>
                </af:button>
            </af:panelGroupLayout>
            <af:spacer width="10" height="10" id="s1"/>
            <af:panelTabbed id="pt19" partialTriggers="b3">
                <af:showDetailItem text="#{cjexecviewcontrollerBundle.CONVICTEDS_Tab}" id="sdi1" visible="false">
                    <af:button text="حصر مطالبة متضامنين" id="b5" visible="#{bindings.ClaimsFoldersROIterator.estimatedRowCount > 1}"
                               partialTriggers="t2 b3">
                        <af:showPopupBehavior popupId="::p2"/>
                    </af:button>
                    <af:popup childCreation="deferred" autoCancel="disabled" id="p1" contentDelivery="lazyUncached">
                        <af:dialog id="d1" dialogListener="#{pageFlowScope.claimBean.createClaimForFolder}" resize="on"
                                   contentWidth="500">
                            <f:facet name="buttonBar"/>
