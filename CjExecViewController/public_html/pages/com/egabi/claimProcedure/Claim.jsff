                                                            shortDesc="#{bindings.ClaimFolderTypeEcon.hints.tooltip}"
                                                            id="soc20"
                                                            rendered="#{bindings.BusinessCaseTypeId.inputValue eq '4'}">
                                            <f:selectItems value="#{bindings.ClaimFolderTypeEcon.items}" id="si22"/>
                                            <f:validator binding="#{bindings.ClaimFolderTypeEcon.validator}"/>
                                        </af:selectOneChoice>
                                    </af:gridCell>
                                </af:gridRow>
                                <af:gridRow marginTop="5px" height="auto" id="gr4">
                                    <af:gridCell marginStart="5px" width="100%" marginEnd="5px" id="gc4">
                                        <af:selectOneChoice value="#{bindings.ClaimYear.inputValue}"
                                                            label="#{bindings.ClaimYear.label}"
                                                            required="#{bindings.ClaimYear.hints.mandatory}"
