                       rendered="false" returnListener="#{pageFlowScope.claimProcedureBean.getNIDValues}">
                <af:setPropertyListener to="#{pageFlowScope.nIdParam}" from="28007280102512" type="action"/>
                <af:setPropertyListener to="#{pageFlowScope.fcnParam}" from="#{null}" type="action"/>
                <!--<af:setPropertyListener to="#{pageFlowScope.userIdParam}" from="agile.test" type="action"/>
                <af:setPropertyListener to="#{pageFlowScope.channelIdParam}" from="10" type="action"/>
                <af:setPropertyListener to="#{pageFlowScope.tokenIdParam}" from="541f4a29c53a03a0e1cca968acebec64" type="action"/>
                <af:setPropertyListener to="#{pageFlowScope.callPermissionParam}" from="Y" type="action"/>
                <af:setPropertyListener to="#{pageFlowScope.userNameParam}" from="Prosec_User" type="action"/>
                <af:setPropertyListener to="#{pageFlowScope.passwordParam}" from="+@{e4wRPeb." type="action"/>-->
