                                                   id="ot20">
                                        <af:convertNumber groupingUsed="false"
                                                          pattern="#{bindings.ExcProcedureClaimVO1.hints.ClaimId.format}"/>
                                    </af:outputText>
                                </af:column>
                                <af:column headerText="#{bundle.PROCEDURE_TYPE}" id="c21" width="300px">
                                    <af:selectOneChoice value="#{row.bindings.ProcedureTypeId.inputValue}"
                                                        label="#{row.bindings.ProcedureTypeId.label}"
                                                        required="#{bindings.ExcProcedureClaimVO1.hints.ProcedureTypeId.mandatory}"
                                                        shortDesc="#{bindings.ExcProcedureClaimVO1.hints.ProcedureTypeId.tooltip}"
                                                        readOnly="true" id="soc2">
