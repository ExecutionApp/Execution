                                      selectionListener="#{bindings.ExcProcedureClaimVO1.collectionModel.makeCurrent}"
                                      rowSelection="single" fetchSize="#{bindings.ExcProcedureClaimVO1.rangeSize}"
                                      id="t2" partialTriggers=":b2" columnStretching="column:c21" width="95%"
                                      styleClass="table-inside-table" scrollPolicy="page" autoHeightRows="3">
                                <af:column headerText="#{bindings.ExcProcedureClaimVO1.hints.Id.label}" id="c18"
                                           visible="false">
                                    <af:outputText value="#{row.Id}"
