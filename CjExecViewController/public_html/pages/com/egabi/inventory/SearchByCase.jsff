        <h:panelGroup id="pg1" layout="block" styleClass="row">
         
          <af:panelGroupLayout id="pgl10" styleClass="col-md-2 col-sm-12">
            <af:outputLabel value="#{bindings.DateFrom.label}" id="ol2"/>
            <af:inputDate value="#{bindings.DateFrom.inputValue}" required="#{bindings.DateFrom.hints.mandatory}" disabled="#{pageFlowScope.inventoryBean.toDay eq 'true'}"
                          shortDesc="#{bindings.DateFrom.hints.tooltip}" id="id2" simple="true" partialTriggers="sbc1">
              <f:validator binding="#{bindings.DateFrom.validator}"/>
              <af:convertDateTime pattern="#{bindings.DateFrom.format}"/>
            </af:inputDate>
          </af:panelGroupLayout>
          <af:panelGroupLayout id="pgl11" styleClass="col-md-2 col-sm-12">
            <af:outputLabel value="#{bindings.DateTo.label}" id="ol3"/>
            <af:inputDate value="#{bindings.DateTo.inputValue}" required="#{bindings.DateTo.hints.mandatory}"
