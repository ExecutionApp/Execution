      <af:panelGroupLayout id="pgl3" styleClass="btn-holder">
        <af:button text="#{bundle.GENERAL_SEARCH_BUTTON}" id="b1" action="#{pageFlowScope.inventoryBean.doSearch}"/>
      </af:panelGroupLayout>
      
      <af:panelGroupLayout id="pgl4" visible="true"
                           partialTriggers="b1">
        <af:table value="#{bindings.ExcProceduresLogView1.collectionModel}" var="row"
                  rows="#{bindings.ExcProceduresLogView1.rangeSize}"
                  emptyText="#{bindings.ExcProceduresLogView1.viewable ? bundle.NO_DATA : 'Access Denied.'}"
                  rowBandingInterval="0" selectedRowKeys="#{bindings.ExcProceduresLogView1.collectionModel.selectedRow}"
                  selectionListener="#{bindings.ExcProceduresLogView1.collectionModel.makeCurrent}"
                  rowSelection="single" fetchSize="#{bindings.ExcProceduresLogView1.rangeSize}"
                  width="100%" columnStretching="column:c3"
                  filterModel="#{bindings.ExcProceduresLogView1Query.queryDescriptor}" filterVisible="true"
                  queryListener="#{bindings.ExcProceduresLogView1Query.processQuery}" varStatus="vs" id="t1"
                  scrollPolicy="page" partialTriggers="::b1">
          <af:column sortProperty="#{bindings.ExcProceduresLogView1.hints.ProcedureDate.name}" filterable="true"
                     sortable="true" headerText="#{bindings.ExcProceduresLogView1.hints.ProcedureDate.label}" id="c5">
            <af:outputText value="#{row.ProcedureDate}"
                           shortDesc="#{bindings.ExcProceduresLogView1.hints.ProcedureDate.tooltip}" id="ot5">
              <af:convertDateTime pattern="yyyy-MM-dd"/>
            </af:outputText>
            <f:facet name="filter">
              <af:inputDate value="#{bindings.ExcProceduresLogView1Query.queryDescriptor.filterConjunctionCriterion.criterionMap.ProcedureDate.value}"
                            id="id1">
                <af:convertDateTime pattern="yyyy-MM-dd"/>
              </af:inputDate>
            </f:facet>
          </af:column>
          <af:column sortProperty="#{bindings.ExcProceduresLogView1.hints.LoggedEntityName.name}" filterable="true"
                     sortable="true" headerText="#{bindings.ExcProceduresLogView1.hints.LoggedEntityName.label}"
                     id="c6">
            <af:outputText value="#{row.LoggedEntityName}"
                           shortDesc="#{bindings.ExcProceduresLogView1.hints.LoggedEntityName.tooltip}" id="ot6"/>
          </af:column>
          <af:column sortProperty="#{bindings.ExcProceduresLogView1.hints.FullName.name}" filterable="true"
                     sortable="true" headerText="#{bindings.ExcProceduresLogView1.hints.FullName.label}" id="c1">
            <af:outputText value="#{row.FullName}" shortDesc="#{bindings.ExcProceduresLogView1.hints.FullName.tooltip}"
                           id="ot1"/>
          </af:column>
          <af:column sortProperty="#{bindings.ExcProceduresLogView1.hints.CreatedDate.name}" filterable="true"
                     sortable="true" headerText="#{bindings.ExcProceduresLogView1.hints.CreatedDate.label}" id="c4">
            <f:facet name="filter">
              <af:inputDate value="#{bindings.ExcProceduresLogView1Query.queryDescriptor.filterConjunctionCriterion.criterionMap.CreatedDate.value}"
                            id="id4">
                <af:convertDateTime pattern="yyyy-MM-dd"/>
              </af:inputDate>
              <!--<af:inputDate value="#{vs.filterCriteria.CreatedDate}"
                            id="id4">
                --><!--<af:convertDateTime pattern="dd/MM/yyyy"/>--><!--
              </af:inputDate>-->
            </f:facet>
            <af:outputText value="#{row.bindings.CreatedDate.inputValue}"
                           shortDesc="#{bindings.ExcProceduresLogView1.hints.CreatedDate.tooltip}" id="ot2">
              <af:convertDateTime pattern="yyyy-MM-dd"/>
            </af:outputText>
          </af:column>
          <af:column sortProperty="#{bindings.ExcProceduresLogView1.hints.ActionTypeName.name}" filterable="true"
                     sortable="true" headerText="#{bindings.ExcProceduresLogView1.hints.ActionTypeName.label}" id="c8">
            <af:outputText value="#{row.ActionTypeName}"
                           shortDesc="#{bindings.ExcProceduresLogView1.hints.ActionTypeName.tooltip}" id="ot8"/>
          </af:column>
          <af:column sortProperty="#{bindings.ExcProceduresLogView1.hints.SequenceNumberLong.name}" filterable="true"
                     sortable="true" headerText="#{bindings.ExcProceduresLogView1.hints.SequenceNumberLong.label}"
                     id="c3">
            <af:outputText value="#{row.SequenceNumberLong}"
                           shortDesc="#{bindings.ExcProceduresLogView1.hints.SequenceNumberLong.tooltip}" id="ot3"/>
          </af:column>
          <af:column sortProperty="#{bindings.ExcProceduresLogView1.hints.CaseEntityName.name}" filterable="true"
                     visible="false" sortable="true"
                     headerText="#{bindings.ExcProceduresLogView1.hints.CaseEntityName.label}" id="c7">
            <af:outputText value="#{row.CaseEntityName}"
                           shortDesc="#{bindings.ExcProceduresLogView1.hints.CaseEntityName.tooltip}" id="ot7"/>
          </af:column>
          <af:column sortProperty="#{bindings.ExcProceduresLogView1.hints.CaseTypeName.name}" filterable="true"
                     sortable="true" headerText="#{bindings.ExcProceduresLogView1.hints.CaseTypeName.label}" id="c9">
            <af:outputText value="#{row.CaseTypeName}"
                           shortDesc="#{bindings.ExcProceduresLogView1.hints.CaseTypeName.tooltip}" id="ot9"/>
          </af:column>
          <af:column sortProperty="#{bindings.ExcProceduresLogView1.hints.AppealRequest.name}" filterable="false"
                     sortable="false" headerText="التقارير" id="c11">
            <af:panelGroupLayout id="pgl5">
              <af:link text="#{bundle.DOWNLOAD_REPORT}" id="l1x" rendered="#{row.AppealRequest ne null}">
                <af:fileDownloadActionListener filename="تقرير طلب الإستئناف"
                                               method="#{pageFlowScope.inventoryBean.downloadAppealRequest}"/>
              </af:link>
              <af:link text="#{bundle.DOWNLOAD_REPORT}" id="l3" rendered="#{row.CriminalRequest ne null}">
                <af:fileDownloadActionListener filename="تقرير طلب الأعتراض على الأمر الجنائي"
                                               method="#{pageFlowScope.inventoryBean.downloadCriminalRequest}"/>
              </af:link>
              <af:link text="#{bundle.DOWNLOAD_REPORT}" id="l4" rendered="#{row.OppositionRequest ne null}">
                <af:fileDownloadActionListener filename="#{row.FileName}"
                                               method="#{pageFlowScope.inventoryBean.downloadOppositionRequest}"/>
              </af:link>
            </af:panelGroupLayout>
          </af:column>
          <af:column sortProperty="#{bindings.ExcProceduresLogView1.hints.CriminalRequest.name}" filterable="true"
                     sortable="true" headerText="#{bindings.ExcProceduresLogView1.hints.CriminalRequest.label}" rendered="false"
                     id="c12">
            <af:link text="#{bundle.DOWNLOAD_REPORT}" id="l12x" disabled="#{row.CriminalRequest eq null}">
                <af:fileDownloadActionListener filename="تقرير طلب الأعتراض على الأمر الجنائي"
                                             method="#{pageFlowScope.inventoryBean.downloadCriminalRequest}">                
               </af:fileDownloadActionListener>
              </af:link>
          </af:column>
          <af:column sortProperty="#{bindings.ExcProceduresLogView1.hints.OppositionRequest.name}" filterable="true"
                     sortable="true" headerText="#{bindings.ExcProceduresLogView1.hints.OppositionRequest.label}" rendered="false"
                     id="c13">
            <af:link text="#{bundle.DOWNLOAD_REPORT}" id="l13x" disabled="#{row.OppositionRequest eq null}">
                <af:fileDownloadActionListener filename="تقرير طلب المعارضة"
                                             method="#{pageFlowScope.inventoryBean.downloadOppositionRequest}">                
                </af:fileDownloadActionListener>
              </af:link>
          </af:column>
          <af:column sortProperty="#{bindings.ExcProceduresLogView1.hints.DocumentId.name}" filterable="true"
                     sortable="true" headerText="#{bindings.ExcProceduresLogView1.hints.DocumentId.label}" id="c2"
                     rendered="false">
            <af:link text="#{bundle.DOWNLOAD_REPORT}" id="l1" disabled="#{row.DocumentId eq null}">
              <af:fileDownloadActionListener filename="نموذج المعارضة"
                                             method="#{pageFlowScope.inventoryBean.downloadReport}"/>
            </af:link>
          </af:column>
          <af:column sortProperty="#{bindings.ExcProceduresLogView1.hints.DocumentId2.name}" filterable="true"
                     sortable="true" headerText="#{bindings.ExcProceduresLogView1.hints.DocumentId2.label}" id="c10"
                     rendered="false">
            <af:link text="#{bundle.DOWNLOAD_REPORT}" id="l2" disabled="#{row.DocumentId2 eq null}">
              <af:fileDownloadActionListener filename="نموذج 26"
                                             method="#{pageFlowScope.inventoryBean.downloadReport26}"/>
            </af:link>
          </af:column>
        </af:table>
      </af:panelGroupLayout>
    </af:panelGroupLayout>
  </af:panelHeader>
</ui:composition>
