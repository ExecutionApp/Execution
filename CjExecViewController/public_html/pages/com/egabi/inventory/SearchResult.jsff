                              maximumLength="#{bindings.ProcedureText.hints.precision}"
                              shortDesc="#{bindings.ProcedureText.hints.tooltip}" id="it1">
                  <f:validator binding="#{bindings.ProcedureText.validator}"/>
                </af:inputText>
              </h:panelGroup>
            </h:panelGroup>
            <af:panelGridLayout id="pgl4" rendered="false">
              <af:gridRow marginTop="5px" height="auto" id="gr1">
                <af:gridCell marginStart="5px" width="auto" id="gc1"/>
                <af:gridCell marginStart="5px" width="auto" id="gc2"/>
                <af:gridCell marginStart="5px" width="auto" id="gc3"/>
                <af:gridCell marginStart="5px" width="auto" marginEnd="5px" id="gc4"/>
              </af:gridRow>
              <af:gridRow marginTop="5px" height="auto" marginBottom="5px" id="gr2">
                <af:gridCell marginStart="5px" width="auto" id="gc5"/>
                <af:gridCell marginStart="5px" width="auto" id="gc6"/>
                <af:gridCell marginStart="5px" width="auto" id="gc7"/>
                <af:gridCell marginStart="5px" width="auto" marginEnd="5px" id="gc8"/>
              </af:gridRow>
            </af:panelGridLayout>
            <af:panelGridLayout id="pgl9" rendered="false">
              <af:gridRow id="gr7">
                <af:gridCell id="gc9"/>
                <af:gridCell id="gc10"/>
                <af:gridCell id="gc11"/>
                <af:gridCell id="gc12"/>
              </af:gridRow>
              <af:gridRow id="gr9">
                <af:gridCell id="gc29"/>
                <af:gridCell id="gc30"/>
                <af:gridCell id="gc31"/>
                <af:gridCell id="gc32"/>
              </af:gridRow>
            </af:panelGridLayout>
            <af:panelGroupLayout id="pgl10">
              <af:selectBooleanCheckbox value="#{bindings.AccusedRequired.inputValue}"
                                        label="#{bindings.AccusedRequired.label}"
                                        shortDesc="#{bindings.AccusedRequired.hints.tooltip}" id="sbc2"
                                        partialTriggers="soc1"
                                        visible="#{bindings.ActionTypeId.inputValue eq '10' or bindings.ActionTypeId.inputValue eq '2' 
                                                or bindings.ActionTypeId.inputValue eq '5' or bindings.ActionTypeId.inputValue eq '11' 
                                                or bindings.ActionTypeId.inputValue eq '1' or bindings.ActionTypeId.inputValue eq '13'}"/>
            </af:panelGroupLayout>
          </af:panelGroupLayout>
        </af:column>
      </af:table>
    </af:panelGroupLayout>
    <h:panelGroup id="pg9" styleClass="btn-holder" layout="block">
      <af:button text="#{bundle.save}" id="b2" action="#{pageFlowScope.inventoryBean.saveOpposition}"/>
      <af:button text="#{bundle.BACK}" id="b1" action="back"/>
    </h:panelGroup>
  </af:panelGroupLayout>
</ui:composition>
