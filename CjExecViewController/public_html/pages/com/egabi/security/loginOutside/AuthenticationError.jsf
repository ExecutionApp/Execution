        <af:form id="f1">
            <af:panelGridLayout id="pgl2">
                <af:gridRow marginTop="5px" height="100%" marginBottom="5px" id="gr3">
                    <af:gridCell marginStart="5px" width="100%" marginEnd="5px" id="gc3" halign="center"
                                 valign="middle">
                        <af:panelGridLayout id="pgl1" dimensionsFrom="parent">
                            <af:gridRow id="gr4">
                                <af:gridCell id="gc4" valign="middle" halign="center" width="100%">
                                    <af:image source="/resources/images/faild-256.png" shortDesc="Login Failed"
                                              id="i1"/>
                                </af:gridCell>
                            </af:gridRow>
                            <af:gridRow marginTop="20px" id="gr1" rendered="#{!sessionScope.userInfo.isUserSignedIn}">
                                <af:gridCell marginStart="5px" width="100%" marginEnd="5px" id="gc1" halign="center"
                                             valign="middle">
                                    <af:outputText id="ot3" value="#{sessionScope.userInfo.loginErrorMsg == null ? 'Url is wrong' : sessionScope.userInfo.loginErrorMsg}"
                                                   inlineStyle="font-size:32px;color:#CCC"/>
                                </af:gridCell>
                            </af:gridRow>
                        </af:panelGridLayout>
                    </af:gridCell>
                </af:gridRow>
            </af:panelGridLayout>
        </af:form>
    </af:document>
</f:view>