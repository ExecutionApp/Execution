            <!-- Search toggle -->
            <af:link text="#{bindings.JudgmentType.inputValue}" id="l30" visible="false"/>
            <h:panelGroup id="pg28" layout="block" styleClass="col-md-3 col-sm-12" rendered="#{bindings.OrigEntity.inputValue ne null}">
                <af:link styleClass="btn-search" id="l8" icon="/resources/images/magnifier.png"
                         action="#{pageFlowScope.PreviewArrestWarrants.search}" disabled="#{pageFlowScope.disabledValidate}">
                    <?audit suppress oracle.jdeveloper.jsp.validate-children?>
                    <!--<af:image  source="/resources/images/accept.png" id="i10"/>-->
                    <af:setPropertyListener from="false" to="#{pageFlowScope.judge}" type="action"/>
                    <af:setPropertyListener from="false" to="#{pageFlowScope.search}" type="action"/>
                    <af:setPropertyListener from="false" to="#{pageFlowScope.dimmed}" type="action"/>
                </af:link>
                <af:button text="التهم   " id="l28" inlineStyle="color:Black; font-size:large;" styleClass="buttonv"
                           visible="false" clientComponent="true" immediate="true">
                    <af:target events="@all" execute="@this" render="@all"/>
                </af:button>
                <af:link actionListener="#{bindings.newProsectionJudgment.execute}" text="newProsectionJudgment"
                         disabled="#{!bindings.newProsectionJudgment.enabled}" id="l27"
                         action="#{pageFlowScope.BCDetails.prosecution}" rendered="false"/>
                <af:button id="b6" action="#{pageFlowScope.BCDetails.ValidateBC}" styleClass="btn-search" icon="/resources/images/magnifier.png" rendered="false" partialSubmit="true"/>
            </h:panelGroup>
            <!-- end Search toggle -->
        </h:panelGroup>
        <af:table value="#{bindings.PreviewArrestWarrantsROVO1.collectionModel}" var="row"
                  rows="#{bindings.PreviewArrestWarrantsROVO1.rangeSize}"
