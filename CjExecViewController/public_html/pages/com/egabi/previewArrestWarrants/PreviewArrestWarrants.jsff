                <af:selectOneChoice value="#{bindings.OrigEntity.inputValue}" label="#{bindings.OrigEntity.label}" disabled="#{pageFlowScope.disabledValidate}" shortDesc="#{bindings.OrigEntity.hints.tooltip}" id="soc10" simple="true" partialTriggers="soc17"
