                        <f:validator binding="#{row.bindings.OriginEntityId.validator}"/>
                    </af:selectOneChoice>
                    <f:facet name="separator">
                        <af:separator id="s1"/>
                    </f:facet>
                </af:panelGroupLayout>
            </af:column>
            <af:column headerText="رقم الحصر" id="c2" width="400">
