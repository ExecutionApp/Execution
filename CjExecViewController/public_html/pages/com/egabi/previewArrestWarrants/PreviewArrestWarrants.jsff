                                                                    <af:selectOneChoice value="#{row.bindings.BirthGovId.inputValue}"
                                                                                        label="#{row.bindings.BirthGovId.label}"
                                                                                        required="#{bindings.PreviewArrestWarrantsROVO1.hints.BirthGovId.mandatory}"
                                                                                        shortDesc="#{bindings.PreviewArrestWarrantsROVO1.hints.BirthGovId.tooltip}"
                                                                                        id="soc107" disabled="true">
                                                                        <f:selectItems value="#{row.bindings.BirthGovId.items}"
                                                                                       id="si30"/>
                                                                        <f:validator binding="#{row.bindings.BirthGovId.validator}"/>
                                                                    </af:selectOneChoice>
                                                                </af:panelGroupLayout>
                                                            </af:panelGroupLayout>
                                                            <af:panelGroupLayout id="pgl32" styleClass="row">
                                                                <af:panelGroupLayout id="pgl63"
                                                                                     styleClass="col-md-2 col-sm-12">
                                                                    <af:outputLabel value="تاريخ الميلاد"
                                                                                    id="ol50"/>
                                                                    <af:inputText value="#{row.bindings.DateOfBirth.inputValue}"
                                                                                  shortDesc="#{bindings.PreviewArrestWarrantsROVO1.hints.DateOfBirth.tooltip}"
                                                                                  id="id7" label="Label 2" simple="true"
                                                                                  disabled="true">
                                                                        <af:convertDateTime pattern="#{bindings.PreviewArrestWarrantsROVO1.hints.DateOfBirth.format}"/>
                                                                    </af:inputText>
                                                                </af:panelGroupLayout>
                                                                <af:panelGroupLayout id="pgl64"
                                                                                     styleClass="col-md-2 col-sm-12">
                                                                    <af:outputLabel value="العنوان"
                                                                                    id="ol51"/>
                                                                    <af:inputText value="#{row.bindings.Address.inputValue}"
                                                                                  disabled="true"
                                                                                  shortDesc="#{bindings.PreviewArrestWarrantsROVO1.hints.Address.tooltip}"
                                                                                  id="it13" label="Label 3"/>
                                                                </af:panelGroupLayout>
                    </af:panelGroupLayout>
                                                        </af:panelGroupLayout>
            
            
            
            
            
                <af:panelFormLayout id="pfl1" rows="9" maxColumns="1" rendered="false">
                    <f:facet name="footer"/>
                    <af:inputText value="#{row.bindings.JudgmentText.inputValue}" label="نص الحكم"
                                  required="#{bindings.PreviewArrestWarrantsROVO1.hints.Address.mandatory}"
                                  columns="100"
                                  maximumLength="#{bindings.PreviewArrestWarrantsROVO1.hints.Address.precision}"
                                  shortDesc="#{bindings.PreviewArrestWarrantsROVO1.hints.Address.tooltip}" id="it6"
                                  rows="2">
                        <f:validator binding="#{row.bindings.Address.validator}"/>
                    </af:inputText>
                    <af:inputDate value="#{row.bindings.DateOfBirth.inputValue}"
                                  label="تاريخ الميلاد"
                                  required="#{bindings.PreviewArrestWarrantsROVO1.hints.DateOfBirth.mandatory}"
                                  columns="#{bindings.PreviewArrestWarrantsROVO1.hints.DateOfBirth.displayWidth}"
                                  shortDesc="#{bindings.PreviewArrestWarrantsROVO1.hints.DateOfBirth.tooltip}" id="id1">
                        <f:validator binding="#{row.bindings.DateOfBirth.validator}"/>
                        <af:convertDateTime pattern="#{bindings.PreviewArrestWarrantsROVO1.hints.DateOfBirth.format}"/>
                    </af:inputDate>
                    <af:inputText value="#{row.bindings.Address.inputValue}"
                                  label="العنوان"
                                  required="#{bindings.PreviewArrestWarrantsROVO1.hints.Address.mandatory}"
                                  columns="#{bindings.PreviewArrestWarrantsROVO1.hints.Address.displayWidth}"
                                  maximumLength="#{bindings.PreviewArrestWarrantsROVO1.hints.Address.precision}"
                                  shortDesc="#{bindings.PreviewArrestWarrantsROVO1.hints.Address.tooltip}" id="it11">
                        <f:validator binding="#{row.bindings.Address.validator}"/>
                    </af:inputText>
                    <af:inputDate value="#{row.bindings.ArrestDate.inputValue}"
                                  label="تاريخ الضبط"
                                  required="#{bindings.PreviewArrestWarrantsROVO1.hints.ArrestDate.mandatory}"
                                  columns="#{bindings.PreviewArrestWarrantsROVO1.hints.ArrestDate.displayWidth}"
                                  shortDesc="#{bindings.PreviewArrestWarrantsROVO1.hints.ArrestDate.tooltip}" id="id2">
                        <f:validator binding="#{row.bindings.ArrestDate.validator}"/>
                        <af:convertDateTime pattern="#{bindings.PreviewArrestWarrantsROVO1.hints.ArrestDate.format}"/>
                    </af:inputDate>
                    <af:inputText value="#{row.bindings.ArrestHoure.inputValue}"
                                  label="ساعه الضبط"
                                  required="#{bindings.PreviewArrestWarrantsROVO1.hints.ArrestHoure.mandatory}"
                                  columns="#{bindings.PreviewArrestWarrantsROVO1.hints.ArrestHoure.displayWidth}"
                                  maximumLength="#{bindings.PreviewArrestWarrantsROVO1.hints.ArrestHoure.precision}"
                                  shortDesc="#{bindings.PreviewArrestWarrantsROVO1.hints.ArrestHoure.tooltip}"
                                  id="it23">
                        <f:validator binding="#{row.bindings.ArrestHoure.validator}"/>
                        <af:convertNumber groupingUsed="false"
                                          pattern="#{bindings.PreviewArrestWarrantsROVO1.hints.ArrestHoure.format}"/>
                    </af:inputText>
                    <af:inputText value="#{row.bindings.ArrestAddress.inputValue}"
                                  label="محل الضبط"
                                  required="#{bindings.PreviewArrestWarrantsROVO1.hints.ArrestAddress.mandatory}"
                                  columns="#{bindings.PreviewArrestWarrantsROVO1.hints.ArrestAddress.displayWidth}"
                                  maximumLength="#{bindings.PreviewArrestWarrantsROVO1.hints.ArrestAddress.precision}"
                                  shortDesc="#{bindings.PreviewArrestWarrantsROVO1.hints.ArrestAddress.tooltip}"
                                  id="it204">
                        <f:validator binding="#{row.bindings.ArrestAddress.validator}"/>
                    </af:inputText>
                    <af:link text=" مذكرة الضبط" id="l9" disabled="#{row.Did eq null}"
                             windowEmbedStyle="inlineDocument">
                        <af:fileDownloadActionListener filename="#{row.FileName}"
                                                       method="#{pageFlowScope.PreviewArrestWarrants.downloadArrestWarrantsFile}"/>
                    </af:link>
                </af:panelFormLayout>
            </f:facet>
        </af:table>
    </af:panelHeader>
</ui:composition>
