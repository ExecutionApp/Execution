                                        </af:gridRow>
                                    </af:panelGridLayout>
                                </af:listItem>
                            </af:listView>-->
                            <h:panelGroup layout="block" styleClass="row notes-panel" id="pg26">
                                <h:panelGroup id="pg300" layout="block" styleClass="col-md-12 col-sm-12">
                                    <af:panelGroupLayout id="pgl4" layout="horizontal">
                                        <af:outputLabel value=" قرار النيابة المتخذ :  " id="ol2000"/>
                                        <af:outputFormatted value="#{row.bindings.DescDecision.inputValue}" id="of1"/>
                                    </af:panelGroupLayout>
                                    <af:inputText value="#{row.bindings.ProcedureText.inputValue}" id="of5" rows="3"
                                                  disabled="true" rendered="false"/>
                                    <af:selectOneChoice value="#{row.bindings.DecisionId.inputValue}"
                                                        label=" قرار النيابة المتخذ :-"
                                                        required="#{bindings.JudgmentAppealApprovalRVO1.hints.DecisionId.mandatory}"
                                                        shortDesc="#{bindings.JudgmentAppealApprovalRVO1.hints.DecisionId.tooltip}"
                                                        id="soc2" simple="true" rendered="false">
                                        <f:selectItems value="#{row.bindings.DecisionId.items}" id="si2"/>
                                        <f:validator binding="#{row.bindings.DecisionId.validator}"/>
                                    </af:selectOneChoice>
                                </h:panelGroup>
                            </h:panelGroup>
                        </f:facet>
                    </af:table>
                    <af:table value="#{bindings.JudgmentAppealApprovalRVO1.collectionModel}" var="row"
