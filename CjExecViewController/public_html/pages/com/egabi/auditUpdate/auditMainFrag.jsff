                                          id="it23">
                                <f:validator binding="#{row.bindings.Entityid.validator}"/>
                                <af:convertNumber groupingUsed="false"
                                                  pattern="#{bindings.CriminalJusticeFilesDetailsVO6.hints.Entityid.format}"/>
                            </af:inputText>
                        </af:column>
                        <af:column sortProperty="#{bindings.CriminalJusticeFilesDetailsVO6.hints.Typeid.name}"
                                   filterable="true" sortable="true"
                                   headerText="#{bindings.CriminalJusticeFilesDetailsVO6.hints.Typeid.label}" id="c26"
                                   width="200">
                            <af:selectOneChoice value="#{row.bindings.Typeid.inputValue}"
                                                label="#{row.bindings.Typeid.label}" autoSubmit="true"
                                                required="#{bindings.CriminalJusticeFilesDetailsVO6.hints.Typeid.mandatory}"
                                                shortDesc="#{bindings.CriminalJusticeFilesDetailsVO6.hints.Typeid.tooltip}"
                                                id="soc3">
                                <f:selectItems value="#{row.bindings.Typeid.items}" id="si3"/>
                                <f:validator binding="#{row.bindings.Typeid.validator}"/>
                            </af:selectOneChoice>
                        </af:column>
                        <af:column sortProperty="#{bindings.CriminalJusticeFilesDetailsVO6.hints.ReservaionId.name}"
                                   filterable="true" sortable="true"
                                   headerText="#{bindings.CriminalJusticeFilesDetailsVO6.hints.ReservaionId.label}"
                                   id="c27" width="200">
                            <af:selectOneChoice value="#{row.bindings.ReservaionId.inputValue}"
                                                label="#{row.bindings.ReservaionId.label}" autoSubmit="true"
                                                required="#{bindings.CriminalJusticeFilesDetailsVO6.hints.ReservaionId.mandatory}"
                                                shortDesc="#{bindings.CriminalJusticeFilesDetailsVO6.hints.ReservaionId.tooltip}"
                                                id="soc14">
                                <f:selectItems value="#{row.bindings.ReservaionId.items}" id="si14"/>
                                <f:validator binding="#{row.bindings.ReservaionId.validator}"/>
                            </af:selectOneChoice>
                        </af:column>
                        <af:column sortProperty="#{bindings.CriminalJusticeFilesDetailsVO6.hints.Filename.name}"
                                   sortable="true" inlineStyle="background-color:#e8e8e8; grid-row-span:0;"
                                   headerText="تحميل الملف الجديد" id="c1" rendered="true" width="300"
                                   displayIndex="-1">
                            <af:inputFile label="أستعرض الملفات" id="if5" value="#{row.AttachFile}" simple="true"
                                          autoSubmit="true" inlineStyle="background-color: #EFEFF1 !important;"
                                          contentStyle="background-color: #EFEFF1 !important;"
                                          labelAndAccessKey="أستعرض الملفات"
                                          valueChangeListener="#{AuditUpdateBean.reuploadFileListener}"
                                          validator="#{cjValidator.fileFormatValidator}"/>
                        </af:column>
                        <af:column id="c28" filterable="true" width="200" headerText="الملف الحالي">
                            <af:link text="#{row.Filename}" id="l9"
                                     disabled="#{row.Did eq null or row.RowStatus == 0 }">
                                <af:fileDownloadActionListener filename="#{row.Filename}"
                                                               method="#{AuditUpdateBean.downloadAllAttachedFiles}"/>
                            </af:link>
                        </af:column>
                        <!--<af:column id="c28" width="200" inlineStyle="background-color:#e8e8e8; grid-row-span:0;" 
			  headerText="#{bindings.PreviousProceduresRVO4.hints.AttachFile.label}" 
                                     displayIndex="-1"/>-->
                    </af:table>
                </af:showDetailItem>
            </af:panelTabbed>
            <af:panelGroupLayout id="pgl2" styleClass="btn-holder"
                                 rendered="#{bindings.BusinessCase1Iterator.estimatedRowCount gt 0}">
                <af:button actionListener="#{AuditUpdateBean.saveAction}" text="حفظ" id="l2">
                    <af:setActionListener from="#{bindings.IdToBC.inputValue}" to="#{pageFlowScope.IdToBCAudit}"/>
                    <af:setActionListener from="#{bindings.IdFolderData.inputValue}"
                                          to="#{pageFlowScope.IdToHasrBCAudit}"/>
                </af:button>
            </af:panelGroupLayout>
            <!-- ExcFolderData -->
        </af:panelGroupLayout>
    </af:panelHeader>
    <!--oracle-jdev-comment:preferred-managed-bean-name:cjValidator-->
</ui:composition>
