<?xml version='1.0' encoding='UTF-8'?>
<ui:composition xmlns:ui="http://java.sun.com/jsf/facelets" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
                xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jsp/jstl/core">
  <c:set var="cjexecviewcontrollerBundle" value="#{adfBundle['com.egabi.cjexec.view.CjExecViewControllerBundle']}"/>
  <af:panelGroupLayout id="pgl1">
   

   <af:panelHeader text="#{cjexecviewcontrollerBundle.CASE_DETAILS}" id="pb1">
   
  
	  
	  
	  
	  
	  <af:panelGroupLayout id="id99" styleClass="row">
	    <af:panelGroupLayout id="id100" styleClass="col-md-3 col-sm-12">
			<af:outputLabel value="#{bindings.CaseNumber.hints.label}" id="p01"></af:outputLabel>
		<af:inputText simple="true"
                value="#{bindings.CaseNumber.inputValue} / #{bindings.ParYear.inputValue} / #{ bindings.Name.inputValue}/  #{bindings.EntityName1.inputValue}"
                    label="#{bindings.CaseNumber.hints.label}" required="#{bindings.CaseNumber.hints.mandatory}"
                   
                    maximumLength="#{bindings.CaseNumber.hints.precision}"
                    shortDesc="#{bindings.CaseNumber.hints.tooltip}" id="it1">
        <f:validator binding="#{bindings.CaseNumber.validator}"/>
      </af:inputText>
		</af:panelGroupLayout>
	    <af:panelGroupLayout id="id101" styleClass="col-md-3 col-sm-12">
		<af:outputLabel value="#{bindings.EntityName.hints.label}" id="p00"></af:outputLabel>
		 <af:inputText simple="true" value="#{bindings.EntityName.inputValue}" label="#{bindings.EntityName.hints.label}"
                    required="#{bindings.EntityName.hints.mandatory}"
                    
                    maximumLength="#{bindings.EntityName.hints.precision}"
                    shortDesc="#{bindings.EntityName.hints.tooltip}" id="it5">
        <f:validator binding="#{bindings.EntityName.validator}"/>
      </af:inputText>
	  
		
		</af:panelGroupLayout>
		 
	  
	  </af:panelGroupLayout>
      


     
	  
    </af:panelHeader>
	
	 <af:panelGroupLayout id="pgl2" styleClass="btn-holder">
	  <af:button text="رجوع" id="b1" action="back"/>
	 	</af:panelGroupLayout>
	 
	
	
    <af:panelTabbed position="above" id="pt1">
      <af:showDetailItem id="tab1" text="تعديلات بيانات القضية و المحضر">
        <af:table value="#{bindings.AuditSimpleUpdateRo.collectionModel}" var="row"
                  rows="#{bindings.AuditSimpleUpdateRo.rangeSize}"
                  autoHeightRows="8" scrollPolicy="page" 
                  emptyText="#{bindings.AuditSimpleUpdateRo.viewable ? 'No data to display.' : 'Access Denied.'}"
                  rowBandingInterval="0" selectedRowKeys="#{bindings.AuditSimpleUpdateRo.collectionModel.selectedRow}"
                  selectionListener="#{bindings.AuditSimpleUpdateRo.collectionModel.makeCurrent}" rowSelection="single"
                  fetchSize="#{bindings.AuditSimpleUpdateRo.rangeSize}" id="t1" styleClass="AFStretchWidth"
                  columnStretching="column:c3">
          <af:column headerText="#{bindings.AuditSimpleUpdateRo.hints.CreatedBy.label}" id="c3">
            <af:inputText value="#{row.bindings.CreatedBy.inputValue}"
                          label="#{bindings.AuditSimpleUpdateRo.hints.CreatedBy.label}"
                          required="#{bindings.AuditSimpleUpdateRo.hints.CreatedBy.mandatory}"
                         
                          maximumLength="#{bindings.AuditSimpleUpdateRo.hints.CreatedBy.precision}"
                          shortDesc="#{bindings.AuditSimpleUpdateRo.hints.CreatedBy.tooltip}" id="it8">
              <f:validator binding="#{row.bindings.CreatedBy.validator}"/>
            </af:inputText>
          </af:column>
          <af:column headerText="#{bindings.AuditSimpleUpdateRo.hints.CreationDate.label}" id="c4" width="100">
            <af:inputDate value="#{row.bindings.CreationDate.inputValue}"
                          label="#{bindings.AuditSimpleUpdateRo.hints.CreationDate.label}"
                          required="#{bindings.AuditSimpleUpdateRo.hints.CreationDate.mandatory}"
                          
                          shortDesc="#{bindings.AuditSimpleUpdateRo.hints.CreationDate.tooltip}" id="id1">
              <f:validator binding="#{row.bindings.CreationDate.validator}"/>
              <af:convertDateTime pattern="#{bindings.AuditSimpleUpdateRo.hints.CreationDate.format}"/>
            </af:inputDate>
          </af:column>
          <af:column headerText="#{bindings.AuditSimpleUpdateRo.hints.EditedAttribute.label}" id="c5" width="200">
            <af:inputText value="#{row.bindings.EditedAttribute.inputValue}"
                          label="#{bindings.AuditSimpleUpdateRo.hints.EditedAttribute.label}"
                          required="#{bindings.AuditSimpleUpdateRo.hints.EditedAttribute.mandatory}"
                         
                          maximumLength="#{bindings.AuditSimpleUpdateRo.hints.EditedAttribute.precision}"
                          shortDesc="#{bindings.AuditSimpleUpdateRo.hints.EditedAttribute.tooltip}" id="it9">
              <f:validator binding="#{row.bindings.EditedAttribute.validator}"/>
            </af:inputText>
          </af:column>
          <af:column headerText="#{bindings.AuditSimpleUpdateRo.hints.OldValue.label}" id="c6">
            <af:panelGroupLayout id="pgl3">
              <af:inputText value="#{row.bindings.OldValue.inputValue}" rendered="#{row.TechnicalName ne 'DID'}"
                            label="#{bindings.AuditSimpleUpdateRo.hints.OldValue.label}"
                            required="#{bindings.AuditSimpleUpdateRo.hints.OldValue.mandatory}"
                            maximumLength="#{bindings.AuditSimpleUpdateRo.hints.OldValue.precision}"
                            shortDesc="#{bindings.AuditSimpleUpdateRo.hints.OldValue.tooltip}" id="it10">
                <f:validator binding="#{row.bindings.OldValue.validator}"/>
              </af:inputText>
              <af:link text="#{row.OldValue}" id="l9" rendered="#{row.TechnicalName eq 'DID'}"
                       shortDesc="عند الضغط  علي رقم الملف  يتم تحميل الملف القديم قبل تعديله">
                <af:fileDownloadActionListener filename="#{row.OldValue}"
                                               method="#{displayAuditDetails.downloadOldValueMethod}"/>
              </af:link>
            </af:panelGroupLayout>
          </af:column>
          <af:column headerText="#{bindings.AuditSimpleUpdateRo.hints.NewValue.label}" id="c7">
            <af:panelGroupLayout id="pgl4">
              <af:inputText value="#{row.bindings.NewValue.inputValue}" rendered="#{row.TechnicalName ne 'DID'}"
