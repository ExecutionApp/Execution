                            required="#{bindings.AuditSimpleUpdateRo.hints.NewValue.mandatory}"
                            maximumLength="#{bindings.AuditSimpleUpdateRo.hints.NewValue.precision}"
                            shortDesc="#{bindings.AuditSimpleUpdateRo.hints.NewValue.tooltip}" id="it11">
                <f:validator binding="#{row.bindings.NewValue.validator}"/>
              </af:inputText>
              <af:link text="#{row.NewValue}" id="l1" rendered="#{row.TechnicalName eq 'DID'}"
                       shortDesc="عند الضغط  علي رقم الملف يتم تحميل الملف الجديد بعد تحميله">
                <af:fileDownloadActionListener filename="#{row.NewValue}"
                                               method="#{displayAuditDetails.downloadNewValueMethod}"/>
              </af:link>
            </af:panelGroupLayout>
          </af:column>
          <af:column headerText="#{bindings.AuditSimpleUpdateRo.hints.EntityName.label}" id="c11" width="200"
