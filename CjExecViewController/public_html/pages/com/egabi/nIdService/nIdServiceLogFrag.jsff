<?xml version='1.0' encoding='UTF-8'?>
<ui:composition xmlns:ui="http://java.sun.com/jsf/facelets" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
                xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jsp/jstl/core">
    <c:set var="cjexecviewcontrollerBundle" value="#{adfBundle['com.egabi.cjexec.view.CjExecViewControllerBundle']}"/>
    <af:panelHeader text="#{bundle.NATIONAL_ID_LOG}" id="ph1">
        <f:facet name="context"/>
        <f:facet name="toolbar"/>
        <f:facet name="menuBar"/>
        <f:facet name="legend"/>
        <f:facet name="info"/>
        <af:activeOutputText value="لا توجد نتائج تطابق محددات البحث" id="aot1" visible="false"
                             styleClass="alert alert-warning alert-custom" partialTriggers="t1"/>
        <af:panelGroupLayout id="pgl1" layout="default" styleClass="row">
            <af:panelGroupLayout id="pgl6" styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="النيابة الكلية" id="ol70"/>
                <af:selectOneChoice value="#{bindings.NeyabKolyaa.inputValue}"
                                    disabled="#{sessionScope.userInfo.entityDegree eq '3' or (sessionScope.userInfo.entityDegree eq '39' and !sessionScope.userInfo.userPrevMap[6344])}"
                                    required="#{bindings.NeyabKolyaa.hints.mandatory}"
                                    shortDesc="#{bindings.NeyabKolyaa.hints.tooltip}" id="soc28" simple="true"
                                    autoSubmit="true" immediate="true">
                    <f:selectItems value="#{bindings.NeyabKolyaa.items}" id="si28"/>
                    <f:validator binding="#{bindings.NeyabKolyaa.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:spacer width="30" height="10" id="s2"/>
            <af:panelGroupLayout id="pgl10" styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="النيابة الجزئية" id="ol54"/>
                <af:selectOneChoice value="#{bindings.NeyabGozayaa.inputValue}"
                                    required="#{bindings.NeyabGozayaa.hints.mandatory}"
                                    shortDesc="#{bindings.NeyabGozayaa.hints.tooltip}" id="soc17"
                                    partialTriggers="soc28" simple="true"
                                    disabled="#{sessionScope.userInfo.entityDegree eq '3' and !sessionScope.userInfo.userPrevMap[6344]}"
                                    autoSubmit="true" immediate="true">
                    <f:selectItems value="#{bindings.NeyabGozayaa.items}" id="si17"/>
                    <f:validator binding="#{bindings.NeyabGozayaa.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:spacer width="30" height="10" id="s5"/>
            <af:panelGroupLayout id="pgl4" styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="حالة الطلب" id="ol1"/>
                <af:selectOneChoice value="#{bindings.CallType.inputValue}" label="#{bindings.CallType.label}"
                                    required="#{bindings.CallType.hints.mandatory}" simple="true"
                                    contentStyle="width:120px" shortDesc="#{bindings.CallType.hints.tooltip}" id="soc3">
                    <f:selectItems value="#{bindings.CallType.items}" id="si3"/>
                    <f:validator binding="#{bindings.CallType.validator}"/>
                </af:selectOneChoice>
            </af:panelGroupLayout>
            <af:spacer width="30" height="10" id="s6"/>
            <af:panelGroupLayout id="pgl2" styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="#{bundle.FROM_DATE}" id="ol8"/>
                <af:inputDate value="#{bindings.FromDate.inputValue}" label="#{bindings.FromDate.hints.label}"
                              required="#{bindings.FromDate.hints.mandatory}" simple="true" columns="20"
                              disabled="#{bindings.Today.inputValue eq true}" contentStyle="width:200px"
                              partialTriggers="sbc2" shortDesc="#{bindings.FromDate.hints.tooltip}" id="id1"
                              autoSubmit="true">
                    <f:validator binding="#{bindings.FromDate.validator}"/>
                </af:inputDate>
            </af:panelGroupLayout>
            <af:spacer width="30" height="10" id="s3"/>
            <af:panelGroupLayout id="pgl3" styleClass="col-md-2 col-sm-12">
                <af:outputLabel value="#{bundle.TO_DATE}" id="ol7"/>
                <af:inputDate value="#{bindings.ToDate.inputValue}" label="#{bindings.ToDate.hints.label}"
                              disabled="#{bindings.Today.inputValue eq true or bindings.FromDate.inputValue eq null}"
                              simple="true" required="#{bindings.ToDate.hints.mandatory}" autoSubmit="true" columns="20"
                              contentStyle="width:200px" shortDesc="#{bindings.ToDate.hints.tooltip}" id="id2"
                              partialTriggers="sbc2 id1" minValue="#{bindings.FromDate.inputValue}">
                    <f:validator binding="#{bindings.ToDate.validator}"/>
                </af:inputDate>
            </af:panelGroupLayout>
            <af:spacer width="30" height="10" id="s1"/>
            <af:panelGroupLayout id="pgl11" layout="vertical">
                <af:outputLabel value="#{bundle.TODAY}" id="ol9"/>
                <af:selectBooleanCheckbox value="#{bindings.Today.inputValue eq null ? 'N' : bindings.Today.inputValue}"
                                          label="#{bindings.Today.label}" simple="true"
                                          shortDesc="#{bindings.Today.hints.tooltip}" id="sbc2" autoSubmit="true"
                                          partialTriggers="id2 id1"
                                          valueChangeListener="#{pageFlowScope.nIdBean.todayCBChanged}"/>
            </af:panelGroupLayout>
        </af:panelGroupLayout>
        <af:panelGroupLayout id="pgl5" styleClass="btn-holder">
            <af:button text="#{bundle.SEARCH}" id="b1" action="#{pageFlowScope.nIdBean.searchNIdLog}"/>
            <af:spacer width="10" id="s4"/>
            <af:button text="#{bundle.RESET_SEARCH}" id="b2" action="#{pageFlowScope.nIdBean.resetSearchNIdLog}"
                       immediate="true"/>
        </af:panelGroupLayout>
    </af:panelHeader>
    <af:panelHeader text="#{bundle.CLAIMS_SEARCH_RESULTS}" id="ph2">
        <f:facet name="context"/>
        <f:facet name="toolbar"/>
        <f:facet name="menuBar"/>
        <f:facet name="legend"/>
        <f:facet name="info"/>
        <af:table value="#{bindings.NIdServiceLogVO1.collectionModel}" var="row"
                  rows="#{bindings.NIdServiceLogVO1.rangeSize}"
                  emptyText="#{bindings.NIdServiceLogVO1.viewable ? 'No data to display.' : 'Access Denied.'}"
                  rowBandingInterval="0" selectedRowKeys="#{bindings.NIdServiceLogVO1.collectionModel.selectedRow}"
                  selectionListener="#{bindings.NIdServiceLogVO1.collectionModel.makeCurrent}" rowSelection="single"
                  fetchSize="#{bindings.NIdServiceLogVO1.rangeSize}" id="t1" columnStretching="last" width="100%">
            <af:column headerText="#{bundle.USER}" width="250px" id="c10" align="right">
                <af:selectOneChoice value="#{row.bindings.UserId.inputValue}" label="#{row.bindings.UserId.label}"
                                    required="#{bindings.NIdServiceLogVO1.hints.UserId.mandatory}"
                                    shortDesc="#{bindings.NIdServiceLogVO1.hints.UserId.tooltip}" id="soc1"
                                    readOnly="true">
                    <f:selectItems value="#{row.bindings.UserId.items}" id="si1"/>
                    <f:validator binding="#{row.bindings.UserId.validator}"/>
                </af:selectOneChoice>
            </af:column>
            <af:column headerText="#{bundle.ENTITY_USER}" width="250px" id="c2" align="right">
                <af:selectOneChoice value="#{row.bindings.EntityId.inputValue}" label="#{row.bindings.EntityId.label}"
                                    required="#{bindings.NIdServiceLogVO1.hints.EntityId.mandatory}"
                                    shortDesc="#{bindings.NIdServiceLogVO1.hints.EntityId.tooltip}" id="soc2"
                                    readOnly="true">
                    <f:selectItems value="#{row.bindings.EntityId.items}" id="si2"/>
                    <f:validator binding="#{row.bindings.EntityId.validator}"/>
                </af:selectOneChoice>
            </af:column>
            <af:column headerText="#{bundle.NATIONAL_ID}" width="200px" id="c6" align="right">
                <af:outputText value="#{row.NationalId}"
                               shortDesc="#{bindings.NIdServiceLogVO1.hints.NationalId.tooltip}" id="ot6"/>
            </af:column>
            <af:column headerText="#{bundle.CREATION_DATE}" width="200px" id="c1" align="right">
                <af:outputText value="#{row.CallDate}" shortDesc="#{bindings.NIdServiceLogVO1.hints.CallDate.tooltip}"
                               id="ot1">
                    <af:convertDateTime pattern="#{bindings.NIdServiceLogVO1.hints.CallDate.format}"/>
                </af:outputText>
            </af:column>
            <af:column headerText="#{bindings.NIdServiceLogVO1.hints.Id.label}" id="c5" rendered="false" width="200px"
                       align="right">
                <af:outputText value="#{row.Id}" shortDesc="#{bindings.NIdServiceLogVO1.hints.Id.tooltip}" id="ot5">
                    <af:convertNumber groupingUsed="false" pattern="#{bindings.NIdServiceLogVO1.hints.Id.format}"/>
                </af:outputText>
            </af:column>
            <af:column headerText="#{bundle.REQUEST_STATUS}" id="c9" width="200px" align="right">
                <af:outputText value="#{row.CallType eq 'N' ? 'استعلام' : 'اجراء'}"
                               shortDesc="#{bindings.NIdServiceLogVO1.hints.CallType.tooltip}" id="ot9"/>
            </af:column>
        </af:table>
    </af:panelHeader>
</ui:composition>
